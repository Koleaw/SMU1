# Local admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-long-random-string
ADMIN_API_PORT=8787
ADMIN_ALLOWED_ORIGIN=http://localhost:4321
CONTENT_WRITE_MODE=local

# Publish branches
ADMIN_DEFAULT_DEPLOY_TARGET=test
ADMIN_PREVIEW_BRANCH=preview
ADMIN_PRODUCTION_BRANCH=main
ADMIN_GIT_REMOTE=origin

# Future production deployment. Leave disabled until the real domain/hosting is connected.
PRODUCTION_DEPLOY_ENABLED=false
SITE_URL=
BASE_PATH=/

# Test publication. For GitHub Pages project sites usually:
# TEST_SITE_URL=https://<github-user-or-org>.github.io
# TEST_BASE_PATH=/SMU1
TEST_SITE_URL=
TEST_BASE_PATH=/SMU1
DEPLOY_TARGET=test

# GitHub API access for reading workflow status/logs from the local admin API.
# Use one token only. Do not expose it in the browser.
GITHUB_REPOSITORY=owner/repo
GITHUB_DEPLOY_TOKEN=
GITHUB_TOKEN=

# Legacy flag kept for older local setups. Production publish is controlled by
# PRODUCTION_DEPLOY_ENABLED=true plus SITE_URL.
ADMIN_ALLOW_PRODUCTION_PUBLISH=false
