# Не используйте этот файл как готовый конфиг и не храните пароль открытым текстом.
# `npm run admin:setup` создаёт ignored `.env.admin.local` с scrypt-хэшем
# выбранного пароля и случайным session secret.
ADMIN_USERNAME=owner
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
ADMIN_API_HOST=127.0.0.1
ADMIN_API_PORT=8787
ADMIN_UI_HOST=127.0.0.1
ADMIN_UI_PORT=4321
ADMIN_ALLOWED_ORIGINS=http://127.0.0.1:4321
PUBLIC_ADMIN_API_BASE=/api/admin
CONTENT_WRITE_MODE=local
ADMIN_EXPECTED_BRANCH=v4-product-final-candidate

# H6 публикует только один exact SHA одновременно в candidate и preview.
ADMIN_GIT_REMOTE=origin

# Future production deployment. Leave disabled until the real domain/hosting is connected.
PRODUCTION_DEPLOY_ENABLED=false
SITE_URL=
BASE_PATH=/

# Test publication. For GitHub Pages project sites usually:
# TEST_SITE_URL=https://<github-user-or-org>.github.io
# TEST_BASE_PATH=/SMU1
TEST_SITE_URL=
TEST_BASE_PATH=/SMU1
DEPLOY_TARGET=test

# GitHub repository нужен для статуса exact-SHA workflow.
# Не добавляйте GITHUB_TOKEN/GITHUB_DEPLOY_TOKEN: локальный API сначала читает
# public status анонимно, а для rate-limit/rerun использует системный Git Credential Manager.
GITHUB_REPOSITORY=owner/repo

# Production/main в H6 всегда запрещены, включая legacy-флаг.
ADMIN_ALLOW_PRODUCTION_PUBLISH=false
