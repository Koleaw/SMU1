{
  "name": "smu1-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "admin:api": "node tools/admin-api/server.mjs",
    "test:admin-import": "node --test tools/admin-api/content-json.test.mjs tools/admin-api/project-media.test.mjs tools/admin-api/server-routes.test.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "qa:deploy-isolation": "node tools/migration/deploy-isolation-qa.mjs",
    "qa:final:static": "node tools/migration/final-design-qa.mjs",
    "qa:h2:motion": "node tools/migration/h2-motion-qa.mjs && npm run qa:deploy-isolation",
    "qa:final:browser": "node tools/migration/browser-final-design-qa.mjs && npm run qa:h2:motion",
    "qa:admin-browser": "node tools/admin-api/admin-browser-roundtrip.mjs",
    "qa:final": "npm run check && npm run test:admin-import && npm run build && npm run qa:final:static && npm run qa:final:browser"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.2.1",
    "astro": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "typescript": "^5.9.3"
  }
}
