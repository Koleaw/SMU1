---
import settings from '../../content/site-settings/global.json';
import PracticalV2Layout from '../../components/v2/practical/PracticalV2Layout.astro';
import V2PrivacyPolicy from '../../components/v2/practical/V2PrivacyPolicy.astro';
import { adminBinding } from '../../admin/bindings/adminBinding';

const policy = settings.privacyPolicy;
const shellCtaBinding = (occurrence: string) => adminBinding(Astro.url, {
  renderer: { family: 'global-shell', variant: 'privacy' }, owner: { collection: 'site-settings', slug: 'global' },
  fieldPath: 'privacyPolicy.shellCtaLabel', stableItemId: `privacy-shell-cta-${occurrence}`, scope: 'legal',
  tool: 'button-label', affectedRoutes: ['/politika-konfidencialnosti/']
});
---

<PracticalV2Layout
  title={policy.seoTitle}
  description={policy.seoDescription}
  canonicalPath="/politika-konfidencialnosti/"
  currentPath={Astro.url.pathname}
  kind="legal"
  contactHref="/kontakty/"
  ctaLabel={policy.shellCtaLabel}
  headerCtaBinding={shellCtaBinding('header-desktop')}
  headerMobileCtaBinding={shellCtaBinding('header-mobile')}
  mobileCtaBinding={shellCtaBinding('footer-mobile')}
>
  <V2PrivacyPolicy />
</PracticalV2Layout>
