---
import { getCollection } from 'astro:content';
import HomeV2 from '../components/v2/home-v2/HomeV2.astro';
import PublicV2Layout from '../layouts/PublicV2Layout.astro';

const homePage = (await getCollection('static-pages')).find(({ data }) => data.slug === 'home')?.data;
if (!homePage) throw new Error('static-pages collection must contain home.json.');
---

<PublicV2Layout
  title={homePage.seoTitle}
  description={homePage.seoDescription}
  canonicalPath="/"
  ogImage={homePage.heroMediaPoster ?? homePage.image}
>
  <HomeV2 />
</PublicV2Layout>
