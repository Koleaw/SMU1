---
import type { V2ProjectRecord } from '../../components/v2/mediaRoleAdapter';
import { getV2ProjectPresentation } from '../../components/v2/mediaRoleAdapter';
import V2ProjectDetail from '../../components/v2/projects/V2ProjectDetail.astro';
import V2ProjectsLayout from '../../components/v2/projects/V2ProjectsLayout.astro';
import { loadPublishedV2Projects } from '../../components/v2/projects/projectV2Data';

export async function getStaticPaths() {
  const projects = await loadPublishedV2Projects();
  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: {
      project,
      previousProject: projects[index - 1],
      nextProject: projects[index + 1]
    }
  }));
}

interface Props {
  project: V2ProjectRecord;
  previousProject?: V2ProjectRecord;
  nextProject?: V2ProjectRecord;
}

let { project, previousProject, nextProject } = Astro.props as Partial<Props>;
if (!project) {
  const projects = await loadPublishedV2Projects();
  const index = projects.findIndex((candidate) => candidate.slug === String(Astro.params.slug || ''));
  if (index >= 0) {
    project = projects[index];
    previousProject = projects[index - 1];
    nextProject = projects[index + 1];
  }
}
if (!project) return Astro.rewrite('/404.html');
const presentation = getV2ProjectPresentation(project);
const previous = previousProject ? getV2ProjectPresentation(previousProject) : undefined;
const next = nextProject ? getV2ProjectPresentation(nextProject) : undefined;
---

<V2ProjectsLayout
  title={project.seoTitle}
  description={project.seoDescription}
  canonicalPath={presentation.productionRoute}
  currentPath={Astro.url.pathname}
  ogImage={presentation.heroMedia?.src}
>
  <V2ProjectDetail presentation={presentation} previous={previous} next={next} />
</V2ProjectsLayout>
