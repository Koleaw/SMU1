---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ObjectCardCarousel from '../../components/ObjectCardCarousel.astro';
import { getProjectImages } from '../../utils/projectImages';
import { projectCategory, projectLocation } from '../../utils/projectContent';
import { withBase } from '../../utils/withBase';

const objects = (await getCollection('projects'))
  .map(({ data }) => data)
  .filter((item) => item.isActive)
  .sort((a, b) => a.order - b.order);

const page = (await getCollection('static-pages')).find(({ data }) => data.slug === 'vypolnennye-obekty')?.data;

if (!page) {
  throw new Error('static-pages collection must contain vypolnennye-obekty.json.');
}

const displayObjects = objects.map((obj) => {
  const meta = [projectLocation(obj), obj.year].filter(Boolean).join(', ');
  const workType = projectCategory(obj);
  const description = obj.shortDescription || '';

  return {
    ...obj,
    href: withBase(`/vypolnennye-obekty/${obj.slug}/`),
    images: getProjectImages(obj),
    meta,
    workType,
    description
  };
});
---
<BaseLayout title={page.seoTitle} description={page.seoDescription}>
  <div class="breadcrumbs-bar">
    <div class="container">
      <Breadcrumbs items={[{ title: 'Главная', href: withBase('/') }, { title: page.title }]} />
    </div>
  </div>

  <Hero
    kicker={page.showBadge === false ? undefined : page.heroKicker}
    className="hero--trust hero--catalog-clean objects-hero"
    title={page.heroTitle}
    description={page.heroDescription}
  />
  <section class="section objects-list-section">
    <div class="container object-list-grid">
      {displayObjects.map((obj) => (
        <ObjectCardCarousel
          title={obj.title}
          href={obj.href}
          images={obj.images}
          meta={obj.meta}
          workType={obj.workType}
          description={obj.description}
        />
      ))}
    </div>
  </section>
</BaseLayout>
