---
import { getCollection } from 'astro:content';
import V2Breadcrumbs from '../../components/v2/V2Breadcrumbs.astro';
import V2DirectContact from '../../components/v2/V2DirectContact.astro';
import V2ProjectArchive from '../../components/v2/projects/V2ProjectArchive.astro';
import V2ProjectsLayout from '../../components/v2/projects/V2ProjectsLayout.astro';
import { loadPublishedV2ProjectPresentations } from '../../components/v2/projects/projectV2Data';

const projects = await loadPublishedV2ProjectPresentations();
const page = (await getCollection('static-pages')).find(({ data }) => data.slug === 'vypolnennye-obekty')?.data;
if (!page) throw new Error('Published projects V2 requires the existing vypolnennye-obekty static-page record.');
const ogImage = projects.find((project) => project.archiveCoverMedia)?.archiveCoverMedia?.src;
---

<V2ProjectsLayout
  title={page.seoTitle}
  description={page.seoDescription}
  canonicalPath="/vypolnennye-obekty/"
  currentPath={Astro.url.pathname}
  ogImage={ogImage}
>
  <V2Breadcrumbs items={[
    { title: 'Главная', href: '/' },
    { title: page.title }
  ]} />

  <header class="v2-project-archive-hero">
    <div class="hv2-shell v2-project-archive-hero__grid">
      <div data-v2-reveal>
        <p class="hv2-eyebrow">Работы СМУ-1</p>
        <h1>{page.heroTitle || page.title}</h1>
      </div>
      <p data-v2-reveal>{page.seoDescription}</p>
    </div>
  </header>

  <V2ProjectArchive projects={projects} />

  <V2DirectContact
    eyebrow="Прямая связь"
    title="Обсудим задачу для вашего объекта"
    description="Кратко опишите задачу и приложите имеющиеся исходные материалы — обсудим решение и подготовим расчёт."
    primaryLabel="Написать в Telegram"
    secondaryLabel="Главная"
    secondaryHref="/"
  />
</V2ProjectsLayout>
