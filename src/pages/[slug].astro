---
import { getCollection } from 'astro:content';
import CatalogSectionV2 from '../components/v2/CatalogSectionV2.astro';
import {
  createCatalogV2Links,
  getActiveSectionCategories,
  getCategoryProducts,
  loadCatalogV2Snapshot
} from '../components/v2/catalogV2Data';
import CanopiesV2Page from '../components/v2/pages/CanopiesV2Page.astro';
import ConstructionV2Page from '../components/v2/pages/ConstructionV2Page.astro';
import LandscapingV2Page from '../components/v2/pages/LandscapingV2Page.astro';
import MetalworksV2Page from '../components/v2/pages/MetalworksV2Page.astro';
import TopiaryV2Page from '../components/v2/pages/TopiaryV2Page.astro';
import PracticalV2Layout from '../components/v2/practical/PracticalV2Layout.astro';
import V2CompanyPage from '../components/v2/practical/V2CompanyPage.astro';
import { loadPublishedV2ProjectPresentations } from '../components/v2/projects/projectV2Data';

export async function getStaticPaths() {
  const [productSections, services, staticPages] = await Promise.all([
    getCollection('product-sections'),
    getCollection('services'),
    getCollection('static-pages')
  ]);

  const productSectionPaths = productSections
    .filter(({ data }) => data.isActive && data.slug !== 'ulichnaya-mebel')
    .map(({ data }) => ({ params: { slug: data.slug }, props: { item: data, itemType: 'product-section' } }));
  const servicePaths = services
    .filter(({ data }) => data.isActive)
    .map(({ data }) => ({ params: { slug: data.slug }, props: { item: data, itemType: 'service' } }));
  const occupiedSlugs = new Set([
    ...productSectionPaths.map((path) => path.params.slug),
    ...servicePaths.map((path) => path.params.slug)
  ]);
  const staticPagePaths = staticPages
    .filter(({ data }) => !['home', 'custom-order', 'vypolnennye-obekty'].includes(data.slug))
    .filter(({ data }) => data.isActive !== false)
    .filter(({ data }) => !occupiedSlugs.has(data.slug))
    .map(({ data }) => ({ params: { slug: data.slug }, props: { item: data, itemType: 'static-page' } }));

  return [...productSectionPaths, ...servicePaths, ...staticPagePaths];
}

const { item, itemType } = Astro.props as { item: any; itemType: string };
const supportedSlugs = new Set([
  'navesy-i-kozyrki',
  'metallokonstruktsii-dlya-biznesa',
  'topiarii',
  'ograzhdeniya-i-zabory',
  'blagoustroystvo-territoriy',
  'stroitelstvo-i-remonty',
  'o-nas'
]);
if (!supportedSlugs.has(item.slug)) {
  throw new Error(`Production V2 dispatcher has no approved renderer for /${item.slug}/ (${itemType}).`);
}

const snapshot = await loadCatalogV2Snapshot();
const catalogSection = item.slug === 'ograzhdeniya-i-zabory'
  ? snapshot.sections.find((section) => section.slug === item.slug)
  : undefined;
if (item.slug === 'ograzhdeniya-i-zabory' && !catalogSection) {
  throw new Error('Active product section ograzhdeniya-i-zabory was not found.');
}
const categories = catalogSection ? getActiveSectionCategories(snapshot, catalogSection.slug) : [];
const categoryProductCounts = Object.fromEntries(categories.map((category) => [
  category.slug,
  getCategoryProducts(snapshot, category.slug).length
]));
const catalogLinks = catalogSection ? createCatalogV2Links(snapshot, catalogSection.slug) : undefined;

const projectOrder = [
  'kompleks-rabot-na-proizvodstvennoy-territorii',
  'blagoustroystvo-naberezhnoy-reki-tobol'
];
const publishedProjects = item.slug === 'o-nas' ? await loadPublishedV2ProjectPresentations() : [];
const companyProjects = projectOrder
  .map((slug) => publishedProjects.find((project) => project.project.slug === slug))
  .filter((project): project is NonNullable<typeof project> => Boolean(project));
const companyOgImage = companyProjects[0]?.publicGallery[0]?.src ?? companyProjects[0]?.detailHeroMedia?.src;
---

{item.slug === 'navesy-i-kozyrki' && <CanopiesV2Page />}
{item.slug === 'metallokonstruktsii-dlya-biznesa' && <MetalworksV2Page />}
{item.slug === 'topiarii' && <TopiaryV2Page />}
{item.slug === 'blagoustroystvo-territoriy' && <LandscapingV2Page />}
{item.slug === 'stroitelstvo-i-remonty' && <ConstructionV2Page />}
{catalogSection && catalogLinks && (
  <CatalogSectionV2
    section={catalogSection}
    categories={categories}
    categoryProductCounts={categoryProductCounts}
    links={catalogLinks}
    currentPath={Astro.url.pathname}
    productFinalPrototype="hub"
  />
)}
{item.slug === 'o-nas' && (
  <PracticalV2Layout
    title={item.seoTitle}
    description={item.seoDescription}
    canonicalPath="/o-nas/"
    currentPath={Astro.url.pathname}
    ogImage={companyOgImage}
    kind="company"
    contactHref="#contact"
    ctaLabel="Получить расчёт"
  >
    <V2CompanyPage page={item} projects={companyProjects} />
  </PracticalV2Layout>
)}
