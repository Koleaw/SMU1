---
import {getCollection} from 'astro:content';
import CatalogV2Layout from '../../components/v2/CatalogV2Layout.astro';
import {withBase} from '../../utils/withBase';
import {adminBinding,adminDisposition} from '../../admin/bindings/adminBinding';
import '../../styles/tools.css';
const tools=(await getCollection('tools')).map(x=>x.data).sort((a,b)=>a.order-b.order);
const symbols=['M','↔','▱','⌑','▦','▤','⌂'];
const fixed=adminDisposition(Astro.url,{kind:'template-fixed',reason:'Подписи навигации и инструкции локального сохранения задаются шаблоном раздела инструментов.',source:'src/pages/instrumenty/index.astro'});
const card=adminDisposition(Astro.url,{kind:'derived',reason:'Ссылка определяется стабильным ID инструмента, номер — порядком коллекции. Название и описание редактируются отдельно.',source:'tools.id + tools.order'});
const binding=(id:string,fieldPath:string)=>adminBinding(Astro.url,{renderer:{family:'tool',variant:'archive'},owner:{collection:'tools',slug:id},fieldPath,stableItemId:id,scope:'shared',tool:fieldPath==='title'?'heading':'long-text',affectedRoutes:['/instrumenty/',`/instrumenty/${id}/`]});
---
<CatalogV2Layout title="Строительные инструменты и калькуляторы — СМУ-1" description="Семь инструментов для комплектации, раскроя и подготовки строительных задач. Схемы, ведомости, сохранение расчётов и печать." canonicalPath="/instrumenty/" currentPath="/instrumenty/" contactHref={withBase('/kontakty/')} rootClass="tools-page">
  <div class="tools-container"><nav class="tool-breadcrumb" aria-label="Хлебные крошки" {...fixed}><a href={withBase('/')}>Главная</a><span>/</span><span>Инструменты</span></nav><header class="tool-heading" {...fixed}><p class="tool-kicker">Из практики цеха и стройки</p><h1>Сначала посчитать.<br/>Потом изготовить.</h1><p>Семь инструментов для вашей задачи: от веса металла до задания на здание. Схема, понятная ведомость и расчёты, которые можно продолжить позже.</p></header><div class="tool-grid">{tools.map((tool,i)=><a class="tool-card" href={withBase(`/instrumenty/${tool.id}/`)} {...card}><span class="tool-card-top"><span class="tool-symbol" aria-hidden="true">{symbols[i]}</span><span>0{i+1} / 07</span></span><h2 {...binding(tool.id,'title')}>{tool.title}</h2><p {...binding(tool.id,'description')}>{tool.description}</p><span class="tool-card-link">Открыть инструмент <span aria-hidden="true">↗</span></span></a>)}</div><section class="tool-export" {...fixed}><h2>Ваши расчёты остаются у вас</h2><p>Откройте «Мои расчёты» в любом инструменте. В папке можно переименовать, дублировать и удалить расчёт с отменой. Для переноса между устройствами и доменами используйте файл проекта.</p><p class="tool-hint">Регистрация не нужна. Локальное сохранение не заменяет резервную копию: очистка браузера может удалить данные.</p></section></div>
</CatalogV2Layout>
