---
import { getCollection } from 'astro:content';
import PracticalV2Layout from '../../../../components/v2/practical/PracticalV2Layout.astro';
import V2ContactsPage from '../../../../components/v2/practical/V2ContactsPage.astro';
import settings from '../../../../content/site-settings/global.json';
import { adminBinding } from '../../../../admin/bindings/adminBinding';

const customOrder = (await getCollection('static-pages')).find(({ data }) => data.slug === 'custom-order')?.data;
const taskInputs = (customOrder?.customOrderSourceMaterials ?? [])
  .filter((item) => item.isActive !== false && Boolean(item.label.trim()))
  .sort((a, b) => a.order - b.order)
  .map((item) => item.label.trim());
const currentPath = '/design-lab/v2/kontakty/';
const copy = settings.contactsPage;
const shellCtaBinding = (occurrence: string) => adminBinding(Astro.url, {
  renderer: { family: 'global-shell', variant: 'contacts' },
  owner: { collection: 'site-settings', slug: 'global' },
  fieldPath: 'contactsPage.shellCtaLabel', stableItemId: `contacts-shell-cta-${occurrence}`,
  scope: 'local', tool: 'link-label', affectedRoutes: ['/kontakty/']
});
---

<PracticalV2Layout
  title={copy.seoTitle}
  description={copy.seoDescription}
  canonicalPath="/kontakty/"
  currentPath={currentPath}
  kind="contacts"
  contactHref="#contact-methods"
  ctaLabel={copy.shellCtaLabel}
  headerCtaBinding={shellCtaBinding('header-desktop')}
  headerMobileCtaBinding={shellCtaBinding('header-mobile')}
  mobileCtaBinding={shellCtaBinding('footer-mobile')}
>
  <V2ContactsPage taskInputs={taskInputs} />
</PracticalV2Layout>
