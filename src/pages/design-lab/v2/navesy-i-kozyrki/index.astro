---
import V2Breadcrumbs from '../../../../components/design-lab/v2/V2Breadcrumbs.astro';
import DirectionV2Brief from '../../../../components/design-lab/v2/directions/DirectionV2Brief.astro';
import DirectionV2FinalCTA from '../../../../components/design-lab/v2/directions/DirectionV2FinalCTA.astro';
import DirectionV2Gallery from '../../../../components/design-lab/v2/directions/DirectionV2Gallery.astro';
import DirectionV2Hero from '../../../../components/design-lab/v2/directions/DirectionV2Hero.astro';
import DirectionV2Intro from '../../../../components/design-lab/v2/directions/DirectionV2Intro.astro';
import DirectionV2Layout from '../../../../components/design-lab/v2/directions/DirectionV2Layout.astro';
import DirectionV2Related from '../../../../components/design-lab/v2/directions/DirectionV2Related.astro';
import DirectionV2Scope from '../../../../components/design-lab/v2/directions/DirectionV2Scope.astro';
import DirectionV2Types from '../../../../components/design-lab/v2/directions/DirectionV2Types.astro';
import {
  extractConfirmedBriefInputs,
  getDirectionBlock,
  getDirectionCardItems,
  getDirectionGalleryImages,
  getDirectionListItems,
  loadDirectionV2Snapshot
} from '../../../../components/design-lab/v2/directions/directionV2Data';

const currentPath = '/design-lab/v2/navesy-i-kozyrki/';
const data = await loadDirectionV2Snapshot({
  sectionSlug: 'navesy-i-kozyrki',
  catalogCategorySlug: 'navesy'
});
const { section, catalogCategory, catalogProducts, catalog, services } = data;
const typesBlock = getDirectionBlock(section, 'cardGrid');
const scopeBlock = getDirectionBlock(section, 'listPanel');
const types = getDirectionCardItems(typesBlock);
const scope = getDirectionListItems(scopeBlock);
const galleryImages = getDirectionGalleryImages(catalogProducts);
const briefInputs = extractConfirmedBriefInputs(catalogProducts.map((product) => product.customProjectText));
const heroImage = catalogCategory?.image?.trim() || galleryImages[0] || '';
const heroImageView = catalogCategory?.imageView
  ? { ...catalogCategory.imageView, fit: 'contain' as const }
  : { fit: 'contain' as const, positionX: 50, positionY: 50, scale: 1 };
const fences = catalog.sections.find((item) => item.slug === 'ograzhdeniya-i-zabory');
const landscaping = services.find((item) => item.slug === 'blagoustroystvo-territoriy');
const related = [
  catalogCategory ? {
    eyebrow: 'Каталог изделий',
    title: `${catalogCategory.title} в каталоге`,
    href: '/design-lab/v2/ulichnaya-mebel/navesy/'
  } : null,
  fences ? {
    eyebrow: 'Конструкции для территории',
    title: fences.title,
    description: fences.shortDescription,
    href: '/design-lab/v2/ograzhdeniya-i-zabory/'
  } : null,
  landscaping ? {
    eyebrow: 'Комплексная задача',
    title: landscaping.title,
    description: landscaping.shortDescription,
    href: `/design-lab/v2/${landscaping.slug}/`
  } : null
].filter((item): item is NonNullable<typeof item> => Boolean(item));
---

<DirectionV2Layout
  title={section.seoTitle}
  description={section.seoDescription}
  canonicalPath={`/${section.slug}/`}
  currentPath={currentPath}
  ogImage={heroImage}
  variant="engineering-visual"
>
  <V2Breadcrumbs items={[
    { title: 'Главная', href: '/design-lab/home-v2/' },
    { title: 'Навесы и козырьки' }
  ]} />

  <DirectionV2Hero
    eyebrow="Навесы и козырьки"
    title="Навесы и козырьки под объект"
    description="Проектируем и изготавливаем навесы и козырьки для входных групп, зон ожидания, велопарковок, контейнерных площадок, хозяйственных зон и общественных пространств под размеры и условия объекта."
    image={heroImage}
    imageAlt={catalogCategory?.title || section.title}
    imageView={heroImageView}
    layout="split-right"
  />

  <DirectionV2Intro
    title="Решение под задачу объекта"
    lead={section.shortDescription}
    variant="engineering"
  />

  <DirectionV2Types
    eyebrow="Структура направления"
    title="Какие навесы и козырьки делаем"
    items={types}
    variant="engineering"
  />

  <DirectionV2Gallery
    title="Примеры навесов и козырьков"
    description="Визуальные примеры из связанных карточек навесов."
    images={galleryImages}
    galleryTitle="Навесы и козырьки — примеры"
    caption="Изображения сохранены в исходном порядке опубликованных галерей."
  />

  <DirectionV2Scope
    eyebrow="Контекст объекта"
    title={scopeBlock?.title || 'Для каких объектов'}
    items={scope}
    variant="engineering"
  />

  <DirectionV2Brief
    title="Что можно прислать"
    description="Для первоначального обсуждения отправьте те исходные материалы, которые уже есть."
    items={briefInputs}
    variant="engineering"
  />

  <DirectionV2Related items={related} />

  <DirectionV2FinalCTA
    title="Обсудим навес или козырёк для вашего объекта"
    description="Опишите задачу и приложите имеющиеся исходные материалы — обсудим решение и подготовим расчёт."
  />
</DirectionV2Layout>
