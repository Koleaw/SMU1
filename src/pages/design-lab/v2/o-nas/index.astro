---
import { getCollection } from 'astro:content';
import PracticalV2Layout from '../../../../components/v2/practical/PracticalV2Layout.astro';
import V2CompanyPage from '../../../../components/v2/practical/V2CompanyPage.astro';
import { loadPublishedV2ProjectPresentations } from '../../../../components/v2/projects/projectV2Data';
import { adminBinding } from '../../../../admin/bindings/adminBinding';

const currentPath = '/design-lab/v2/o-nas/';
const page = (await getCollection('static-pages')).find(({ data }) => data.slug === 'o-nas' && data.isActive !== false)?.data;
if (!page) throw new Error('Company V2 requires the active o-nas static-page record.');

const projectOrder = page.relatedProjectSlugs ?? [];
const publishedProjects = await loadPublishedV2ProjectPresentations();
const projects = projectOrder
  .map((slug) => publishedProjects.find((item) => item.project.slug === slug))
  .filter((item): item is NonNullable<typeof item> => Boolean(item));
const ogImage = projects[0]?.publicGallery[0]?.src ?? projects[0]?.detailHeroMedia?.src;
const shellCtaBinding = (occurrence: string) => adminBinding(Astro.url, {
  renderer: { family: 'global-shell', variant: 'company' }, owner: { collection: 'static-pages', slug: 'o-nas' },
  fieldPath: 'shellCtaLabel', stableItemId: `company-shell-cta-${occurrence}`, scope: 'local', tool: 'button-label',
  affectedRoutes: ['/o-nas/']
});
---

<PracticalV2Layout
  title={page.seoTitle}
  description={page.seoDescription}
  canonicalPath="/o-nas/"
  currentPath={currentPath}
  ogImage={ogImage}
  kind="company"
  contactHref="#contact"
  ctaLabel={page.shellCtaLabel}
  headerCtaBinding={shellCtaBinding('header-desktop')}
  headerMobileCtaBinding={shellCtaBinding('header-mobile')}
  mobileCtaBinding={shellCtaBinding('footer-mobile')}
  headerMode="overlay"
  catalogRootClass="catalog-v2--company"
>
  <V2CompanyPage page={page} projects={projects} />
</PracticalV2Layout>
