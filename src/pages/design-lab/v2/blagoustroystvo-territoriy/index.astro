---
import V2Breadcrumbs from '../../../../components/design-lab/v2/V2Breadcrumbs.astro';
import DirectionV2FinalCTA from '../../../../components/design-lab/v2/directions/DirectionV2FinalCTA.astro';
import DirectionV2Related from '../../../../components/design-lab/v2/directions/DirectionV2Related.astro';
import { getDirectionCardItems, getDirectionListItems } from '../../../../components/design-lab/v2/directions/directionV2Data';
import {
  getV2ProjectPresentation,
  selectV2ProjectMedia,
  selectV2ProjectMediaItems
} from '../../../../components/design-lab/v2/mediaRoleAdapter';
import PlaceDirectionBrief from '../../../../components/design-lab/v2/place/PlaceDirectionBrief.astro';
import PlaceDirectionContexts from '../../../../components/design-lab/v2/place/PlaceDirectionContexts.astro';
import PlaceDirectionHero from '../../../../components/design-lab/v2/place/PlaceDirectionHero.astro';
import PlaceDirectionIntro from '../../../../components/design-lab/v2/place/PlaceDirectionIntro.astro';
import PlaceDirectionProjects from '../../../../components/design-lab/v2/place/PlaceDirectionProjects.astro';
import PlaceDirectionScope from '../../../../components/design-lab/v2/place/PlaceDirectionScope.astro';
import PlaceDirectionV2Layout from '../../../../components/design-lab/v2/place/PlaceDirectionV2Layout.astro';
import {
  getProjectDirectionBlock,
  loadProjectDirectionV2Snapshot,
  selectProject
} from '../../../../components/design-lab/v2/project/projectDirectionV2Data';

const currentPath = '/design-lab/v2/blagoustroystvo-territoriy/';
const data = await loadProjectDirectionV2Snapshot('blagoustroystvo-territoriy');
const { service, projects, catalog, services } = data;
const scopeBlock = getProjectDirectionBlock(service, 'cardGrid');
const contextsBlock = getProjectDirectionBlock(service, 'listPanel');
const scopeItems = getDirectionCardItems(scopeBlock).map(({ title, text }) => ({ title, text }));
const contexts = getDirectionListItems(contextsBlock);

const embankment = selectProject(projects, 'blagoustroystvo-naberezhnoy-reki-tobol');
const squareRepair = selectProject(projects, 'remont-skvera-na-ulitse-gogolya');
const heroImage = selectV2ProjectMedia(embankment, {
  allOf: ['landscaping', 'finished-result', 'hero']
})[0];
const proofImages = selectV2ProjectMedia(embankment, {
  allOf: ['landscaping', 'finished-result', 'proof']
});
const proofMedia = selectV2ProjectMediaItems(embankment, {
  allOf: ['landscaping', 'finished-result', 'proof']
});

if (!embankment || !heroImage || proofImages.length === 0) {
  throw new Error('Landscaping V2 requires the approved finished-result media from the embankment project.');
}

const streetFurniture = catalog.sections.find((item) => item.slug === 'ulichnaya-mebel');
const fences = catalog.sections.find((item) => item.slug === 'ograzhdeniya-i-zabory');
const canopies = catalog.sections.find((item) => item.slug === 'navesy-i-kozyrki');
const construction = services.find((item) => item.slug === 'stroitelstvo-i-remonty');
const related = [
  streetFurniture ? {
    eyebrow: 'Элементы для пространства',
    title: streetFurniture.title,
    description: 'Лавочки, урны, вазоны и велопарковки для конкретной территории.',
    href: '/design-lab/v2/ulichnaya-mebel/'
  } : null,
  fences ? {
    eyebrow: 'Зонирование территории',
    title: fences.title,
    description: 'Ограждения и заборы как отдельное направление для объекта.',
    href: '/design-lab/v2/ograzhdeniya-i-zabory/'
  } : null,
  canopies ? {
    eyebrow: 'Защищённые зоны',
    title: 'Навесы и козырьки',
    description: 'Конструкции для входных, хозяйственных и других зон объекта.',
    href: '/design-lab/v2/navesy-i-kozyrki/'
  } : null,
  construction ? {
    eyebrow: 'Более широкий комплекс',
    title: construction.heroTitle || construction.title,
    description: 'Для задачи, где главным результатом становится готовый или преобразованный объект.',
    href: `/design-lab/v2/${construction.slug}/`
  } : null
].filter((item): item is NonNullable<typeof item> => Boolean(item));

const proofProjects = [embankment, squareRepair]
  .filter((project): project is NonNullable<typeof project> => Boolean(project))
  .map(getV2ProjectPresentation);
const proofMediaBySlug = {
  [embankment.slug]: proofMedia
};
const briefInputs = ['Описание задачи', 'Фотография территории', 'Размеры', 'Эскиз', 'Чертёж', 'ТЗ'];
---

<PlaceDirectionV2Layout
  title={service.seoTitle}
  description={service.seoDescription}
  canonicalPath={`/${service.slug}/`}
  currentPath={currentPath}
  ogImage={heroImage}
>
  <V2Breadcrumbs items={[
    { title: 'Главная', href: '/design-lab/home-v2/' },
    { title: service.heroTitle || service.title }
  ]} />

  <PlaceDirectionHero
    eyebrow="Территория как единое пространство"
    title="Благоустройство территорий"
    description="Благоустраиваем частные, коммерческие и общественные территории — от отдельных элементов до цельного результата для конкретного пространства."
    image={heroImage}
    imageAlt="Готовая благоустроенная набережная с лестницей, лавочками и ограждениями"
    caption={embankment.title}
  />

  <PlaceDirectionIntro
    title="Пространство, собранное в одно целое"
    lead="Благоустройство — это результат на всей территории: во дворе, у входной группы, в зоне отдыха или общественном пространстве."
    text="Состав работ определяется задачей объекта и тем, какой результат нужен конкретной территории."
  />

  <PlaceDirectionScope
    title={scopeBlock?.title || 'Что делаем'}
    description="Состав благоустройства может включать один или несколько видов работ — в зависимости от территории и задачи."
    items={scopeItems}
  />

  <PlaceDirectionContexts
    title={contextsBlock?.title || 'Для каких объектов'}
    description="Частные, коммерческие и общественные пространства, где важен цельный и аккуратный результат."
    items={contexts}
  />

  <PlaceDirectionProjects
    title="Примеры благоустройства"
    projects={proofProjects}
    mediaBySlug={proofMediaBySlug}
  />

  <PlaceDirectionBrief
    title="Что можно прислать"
    description="Для первого разговора достаточно тех материалов, которые уже есть. Они помогут предметно обсудить территорию и задачу."
    items={briefInputs}
  />

  <DirectionV2Related title="Смежные направления" items={related} variant="compact" />

  <DirectionV2FinalCTA
    title="Обсудим благоустройство вашей территории"
    description="Пришлите описание задачи и имеющиеся материалы — обсудим подходящий состав работ и подготовим расчёт."
    secondaryLabel="Обсудить территорию"
  />
</PlaceDirectionV2Layout>
