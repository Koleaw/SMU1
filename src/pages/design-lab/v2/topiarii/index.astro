---
import V2Breadcrumbs from '../../../../components/design-lab/v2/V2Breadcrumbs.astro';
import DirectionV2Brief from '../../../../components/design-lab/v2/directions/DirectionV2Brief.astro';
import DirectionV2FinalCTA from '../../../../components/design-lab/v2/directions/DirectionV2FinalCTA.astro';
import DirectionV2Hero from '../../../../components/design-lab/v2/directions/DirectionV2Hero.astro';
import DirectionV2Intro from '../../../../components/design-lab/v2/directions/DirectionV2Intro.astro';
import DirectionV2Layout from '../../../../components/design-lab/v2/directions/DirectionV2Layout.astro';
import DirectionV2Related from '../../../../components/design-lab/v2/directions/DirectionV2Related.astro';
import DirectionV2Scope from '../../../../components/design-lab/v2/directions/DirectionV2Scope.astro';
import DirectionV2Types from '../../../../components/design-lab/v2/directions/DirectionV2Types.astro';
import {
  extractConfirmedBriefInputs,
  getDirectionBlock,
  getDirectionCardItems,
  getDirectionListItems,
  loadDirectionV2Snapshot
} from '../../../../components/design-lab/v2/directions/directionV2Data';

const currentPath = '/design-lab/v2/topiarii/';
const data = await loadDirectionV2Snapshot({ sectionSlug: 'topiarii' });
const { section, services } = data;
const typesBlock = getDirectionBlock(section, 'cardGrid');
const scopeBlock = getDirectionBlock(section, 'listPanel');
const types = getDirectionCardItems(typesBlock).map(({ image: _image, ...item }) => item);
const scope = getDirectionListItems(scopeBlock);
const referenceText = types.find((item) => /референс/iu.test(item.title))?.text;
const briefInputs = extractConfirmedBriefInputs([
  referenceText,
  section.contactDescription,
  section.heroDescription
]);
const landscaping = services.find((item) => item.slug === 'blagoustroystvo-territoriy');
const related = landscaping ? [{
  eyebrow: 'Связанное направление',
  title: landscaping.title,
  description: landscaping.shortDescription,
  href: `/design-lab/v2/${landscaping.slug}/`
}] : [];
const heroImageView = section.imageView
  ? { ...section.imageView, fit: 'contain' as const }
  : { fit: 'contain' as const, positionX: 50, positionY: 50, scale: 1 };
---

<DirectionV2Layout
  title={section.seoTitle}
  description={section.seoDescription}
  canonicalPath={`/${section.slug}/`}
  currentPath={currentPath}
  ogImage={section.image}
  variant="visual"
>
  <V2Breadcrumbs items={[
    { title: 'Главная', href: '/design-lab/home-v2/' },
    { title: section.title }
  ]} />

  <DirectionV2Hero
    eyebrow="Топиарии"
    title={section.heroTitle}
    description={section.heroDescription}
    image={section.image}
    imageAlt={section.title}
    imageView={heroImageView}
    layout="full"
  />

  <DirectionV2Types
    eyebrow="Формы и композиции"
    title={typesBlock?.title || 'Что изготавливаем'}
    items={types}
    variant="visual"
  />

  <DirectionV2Intro
    eyebrow="Образ направления"
    title="Форма для конкретного пространства"
    lead={section.shortDescription}
    variant="visual"
  />

  <DirectionV2Scope
    eyebrow="Сценарии применения"
    title={scopeBlock?.title || 'Где используют топиарии'}
    items={scope}
    variant="visual"
  />

  <DirectionV2Brief
    eyebrow="Собственная идея"
    title="Покажите желаемый образ"
    description="Для первоначального обсуждения можно передать идею и те исходные материалы, которые уже есть."
    items={briefInputs}
    variant="visual"
  />

  <DirectionV2Related title="Топиарии в благоустройстве" items={related} variant="compact" />

  <DirectionV2FinalCTA
    title={section.contactTitle?.trim() || 'Обсудим топиарий для вашего объекта'}
    description="Пришлите идею или имеющиеся исходные материалы — обсудим форму и подготовим расчёт."
  />
</DirectionV2Layout>
