---
import CatalogCategoryV2 from '../../components/v2/CatalogCategoryV2.astro';
import {
  createCatalogV2Links,
  getCategoryProducts,
  loadCatalogV2Snapshot
} from '../../components/v2/catalogV2Data';

export async function getStaticPaths() {
  const snapshot = await loadCatalogV2Snapshot();
  return snapshot.categories
    .filter((category) => category.parentSectionSlug !== 'ulichnaya-mebel')
    .map((category) => ({
      params: { section: category.parentSectionSlug, slug: category.slug },
      props: { sectionSlug: category.parentSectionSlug, categorySlug: category.slug }
    }));
}

const { sectionSlug, categorySlug } = Astro.props as { sectionSlug: string; categorySlug: string };
const snapshot = await loadCatalogV2Snapshot();
const section = snapshot.sections.find((item) => item.slug === sectionSlug);
const category = snapshot.categories.find((item) => (
  item.slug === categorySlug && item.parentSectionSlug === section?.slug
));
if (!section || !category) throw new Error(`Active catalog category route ${sectionSlug}/${categorySlug} was not found.`);
const products = getCategoryProducts(snapshot, category.slug);
const links = createCatalogV2Links(snapshot, section.slug);
---

<CatalogCategoryV2
  section={section}
  category={category}
  products={products}
  links={links}
  currentPath={Astro.url.pathname}
/>
