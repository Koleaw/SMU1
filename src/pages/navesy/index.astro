---
import CatalogV2Layout from '../../components/v2/CatalogV2Layout.astro';
import LegacyV2Fallback from '../../components/v2/LegacyV2Fallback.astro';
const target = '/navesy-i-kozyrki/';
---
<CatalogV2Layout
  title="Навесы и козырьки — основной адрес"
  description="Страница направления «Навесы и козырьки» доступна по основному адресу."
  canonicalPath={target}
  currentPath={Astro.url.pathname}
  noindex
  refreshTarget={target}
  contactHref="/kontakty/"
>
  <LegacyV2Fallback title="Навесы и козырьки" target={target} />
</CatalogV2Layout>
