                    itemDescription = node('p');
                    card.append(itemDescription);
                  }
                  itemEyebrow.textContent = item.eyebrow || 'Направление';
                  itemTitle.textContent = item.title;
                  if (itemDescription instanceof HTMLElement) {
                    itemDescription.textContent = item.description;
                    itemDescription.hidden = !item.description;
                  }
                  retargetDirectionChild(itemEyebrow, 'eyebrow', item);
                  retargetDirectionChild(itemTitle, 'title', item);
                  retargetDirectionChild(itemDescription, 'description', item);
                  currentById.set(item.id, card);
                  return card;
                });
                grid.replaceChildren(...rows);
              } else {
                let links = shell.querySelector(':scope > .direction-related__links');
                if (!(links instanceof HTMLElement)) {
                  shell.querySelector(':scope > .direction-related__grid')?.remove();
                  links = node('ul', 'direction-related__links');
                  shell.append(links);
                }
                const currentById = links.__smu1DirectionRelatedRows instanceof Map
                  ? links.__smu1DirectionRelatedRows
                  : new Map();
                Array.from(links.querySelectorAll(':scope > li')).forEach((row) => {
                  const id = stableIdOf(row);
                  if (id) currentById.set(id, row);
                });
                links.__smu1DirectionRelatedRows = currentById;
                const rows = safeItems.map((item) => {
                  const existingRow = currentById.get(item.id);
                  const row = existingRow || node('li');
                  if (!existingRow) copyEditorAttributes(row);
                  row.dataset.smu1LiveDirectionId = item.id;
                  let anchor = row.querySelector(':scope > .direction-related__link');
                  if (!(anchor instanceof HTMLAnchorElement)) {
                    anchor = node('a', 'direction-related__link');
                    row.replaceChildren(anchor);
                  }
                  anchor.href = item.href;
                  anchor.dataset.v2TransitionLabel = item.title;
                  let itemEyebrow = anchor.querySelector(':scope > .direction-related__link-eyebrow');
                  if (!(itemEyebrow instanceof HTMLElement)) {
                    itemEyebrow = node('span', 'direction-related__link-eyebrow');
                    anchor.prepend(itemEyebrow);
                  }
                  let linkCopy = anchor.querySelector(':scope > .direction-related__link-copy');
                  if (!(linkCopy instanceof HTMLElement)) {
                    linkCopy = node('span', 'direction-related__link-copy');
                    itemEyebrow.after(linkCopy);
                  }
                  let itemTitle = linkCopy.querySelector(':scope > strong');
                  if (!(itemTitle instanceof HTMLElement)) {
                    itemTitle = node('strong');
                    linkCopy.prepend(itemTitle);
                  }
                  let itemDescription = linkCopy.querySelector(':scope > span');
                  if (!(itemDescription instanceof HTMLElement) && item.description) {
                    itemDescription = node('span');
                    linkCopy.append(itemDescription);
                  }
                  if (!anchor.querySelector(':scope > svg')) {
                    const icon = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
                    icon.setAttribute('viewBox', '0 0 16 16');
                    icon.setAttribute('aria-hidden', 'true');
                    const iconPath = document.createElementNS('http://www.w3.org/2000/svg', 'path');
                    iconPath.setAttribute('d', 'M4 12 12 4M6 4h6v6');
                    icon.append(iconPath);
                    anchor.append(icon);
                  }
                  itemEyebrow.textContent = item.eyebrow || 'Направление';
                  itemTitle.textContent = item.title;
                  if (itemDescription instanceof HTMLElement) {
                    itemDescription.textContent = item.description;
                    itemDescription.hidden = !item.description;
                  }
                  retargetDirectionChild(itemEyebrow, 'eyebrow', item);
                  retargetDirectionChild(itemTitle, 'title', item);
                  retargetDirectionChild(itemDescription, 'description', item);
                  currentById.set(item.id, row);
                  return row;
                });
                links.replaceChildren(...rows);
              }
              if (element !== section) element.replaceWith(section);
              return;
            }
            if (value && typeof value === 'object' && value.__smu1ProjectDirectionProjection === true && element instanceof HTMLElement) {
              const eyebrowText = String(value.eyebrow ?? element.dataset.smu1ProjectRelationsEyebrow ?? 'Направления проекта');
              const titleText = String(value.title ?? element.dataset.smu1ProjectRelationsTitle ?? 'Связанные направления');
              const updateProjectDirectionHeading = (host) => {
                if (!(host instanceof HTMLElement)) return;
                const header = host.matches('.v2-project-detail__section-heading')
                  ? host
                  : host.querySelector('.v2-project-detail__section-heading');
                if (!(header instanceof HTMLElement)) return;
                const eyebrow = header.querySelector(':scope > .hv2-eyebrow');
                const heading = header.querySelector(':scope > #v2-project-directions-title');
                if (eyebrow instanceof HTMLElement) eyebrow.textContent = eyebrowText;
                if (heading instanceof HTMLElement) heading.textContent = titleText;
              };
              const items = (Array.isArray(value.items) ? value.items : [])
                .filter((item) => item
                  && /^[a-z0-9][a-z0-9-]*$/u.test(String(item.id || ''))
                  && Number.isSafeInteger(item.sourceIndex)
                  && item.sourceIndex >= 0
                  && /^\/(?!\/)[a-z0-9а-яё/_-]*\/?$/iu.test(String(item.href || '')))
                .slice()
                .sort((left, right) => Number(left.order || 0) - Number(right.order || 0));
              const copyEditorAttributes = (next) => {
                for (const name of [
                  'data-smu1-binding',
                  'data-smu1-binding-id',
                  'data-smu1-project-relations-eyebrow',
                  'data-smu1-project-relations-title'
                ]) {
                  const attribute = element.getAttribute(name);
                  if (attribute !== null) next.setAttribute(name, attribute);
                }
              };
              if (!items.length) {
                setSectionNavItemVisibility('project-directions', false);
                if (element.matches('[data-smu1-editor-affordance="empty-project-directions"]')) return;
                const affordance = document.createElement('button');
                affordance.type = 'button';
                affordance.className = 'v2-editor-fixed-affordance';
                affordance.dataset.smu1EditorAffordance = 'empty-project-directions';
                affordance.setAttribute('aria-label', 'Добавить связанные направления');
                affordance.textContent = 'Добавить связанные направления';
                copyEditorAttributes(affordance);
                const host = element.closest('.v2-project-detail__directions') || element;
                affordance.__smu1DetachedProjectDirectionsHost = host;
                host.replaceWith(affordance);
                return;
              }
              const detachedHost = element.__smu1DetachedProjectDirectionsHost;
              const cachedGrid = detachedHost instanceof HTMLElement
                ? detachedHost.querySelector('.v2-project-detail__direction-grid')
                : null;
              const grid = element.matches('.v2-project-detail__direction-grid')
                ? element
                : cachedGrid instanceof HTMLElement
                  ? cachedGrid
                  : document.createElement('div');
              if (!grid.classList.contains('v2-project-detail__direction-grid')) {
                grid.className = 'v2-project-detail__direction-grid';
                grid.setAttribute('role', 'list');
                copyEditorAttributes(grid);
              }
              const current = Array.from(grid.querySelectorAll(':scope > a'));
              const cachedRows = grid.__smu1ProjectDirectionRows instanceof Map
                ? grid.__smu1ProjectDirectionRows
                : new Map();
              current.forEach((row) => {
                const id = String(row.dataset.smu1LiveDirectionId || '');
                if (id) cachedRows.set(id, row);
              });
              grid.__smu1ProjectDirectionRows = cachedRows;
              const currentById = new Map(current
                .map((row) => [String(row.dataset.smu1LiveDirectionId || ''), row])
                .filter(([id]) => id));
              const rows = items.map((item, index) => {
                const keyed = currentById.get(String(item.id || '')) || cachedRows.get(String(item.id || ''));
                const row = keyed instanceof HTMLAnchorElement
                  ? keyed
                  : current[index] instanceof HTMLAnchorElement && !current[index].dataset.smu1LiveDirectionId
                    ? current[index]
                    : document.createElement('a');
                if (!keyed && !(current[index] instanceof HTMLAnchorElement && !current[index].dataset.smu1LiveDirectionId)) {
                  copyEditorAttributes(row);
                }
                row.setAttribute('role', 'listitem');
                row.href = item.href;
                row.dataset.v2TransitionLabel = String(item.label || '');
                row.dataset.smu1LiveDirectionId = String(item.id || '');
                let context = row.querySelector(':scope > span');
                if (!(context instanceof HTMLElement)) {
                  context = document.createElement('span');
                  row.prepend(context);
                }
                let label = row.querySelector(':scope > strong');
                if (!(label instanceof HTMLElement)) {
                  label = document.createElement('strong');
                  row.append(label);
                }
                context.textContent = String(item.context || '');
                label.textContent = String(item.label || '');
                const retargetChildBinding = (child, field) => {
                  if (!(child instanceof HTMLElement)) return;
                  let childBinding;
                  try { childBinding = JSON.parse(child.getAttribute('data-smu1-binding') || 'null'); } catch { return; }
                  if (!childBinding
                    || childBinding.ownerCollection !== binding.ownerCollection
                    || childBinding.recordSlug !== binding.recordSlug
                    || childBinding.stableItemId !== `${binding.recordSlug}-${item.id}-direction-${field}`) return;
                  childBinding.fieldPath = `presentation.relatedDirections[${item.sourceIndex}].${field}`;
                  child.setAttribute('data-smu1-binding', JSON.stringify(childBinding));
                };
                retargetChildBinding(context, 'context');
                retargetChildBinding(label, 'label');
                cachedRows.set(String(item.id || ''), row);
                return row;
              });
              grid.replaceChildren(...rows);
              setSectionNavItemVisibility('project-directions', true);
              if (detachedHost instanceof HTMLElement && grid === cachedGrid) {
                element.replaceWith(detachedHost);
                updateProjectDirectionHeading(detachedHost);
              } else if (grid !== element) {
                const section = document.createElement('section');
                section.className = 'v2-project-detail__directions';
                section.id = 'project-directions';
                section.setAttribute('aria-labelledby', 'v2-project-directions-title');
                const shell = document.createElement('div');
                shell.className = 'hv2-shell';
                const header = document.createElement('header');
                header.className = 'v2-project-detail__section-heading';
                header.dataset.smu1EditorAffordance = 'project-directions-structural';
                copyEditorAttributes(header);
                const eyebrow = document.createElement('p');
                eyebrow.className = 'hv2-eyebrow';
                eyebrow.textContent = eyebrowText;
                const heading = document.createElement('h2');
                heading.id = 'v2-project-directions-title';
                heading.textContent = titleText;
                header.append(eyebrow, heading);
                shell.append(header, grid);
                section.append(shell);
                element.replaceWith(section);
              } else {
                updateProjectDirectionHeading(grid.closest('.v2-project-detail__directions'));
              }
              return;
            }
            if (value && typeof value === 'object' && value.__smu1CropProjection === true && element instanceof HTMLElement) {
              const fit = value.fit === 'contain' ? 'contain' : 'cover';
              const positionX = Math.min(100, Math.max(0, Number(value.positionX ?? 50)));
              const positionY = Math.min(100, Math.max(0, Number(value.positionY ?? 50)));
              const scale = Math.min(3, Math.max(1, Number(value.scale ?? 1)));
              element.style.setProperty('--v2-image-source-x', `${positionX}%`);
              element.style.setProperty('--v2-image-source-y', `${positionY}%`);
              element.style.setProperty('--v2-image-source-scale', String(scale));
              element.style.setProperty('--v2-media-fit', fit);
              element.style.setProperty('--v2-media-x', `${positionX}%`);
              element.style.setProperty('--v2-media-y', `${positionY}%`);
              element.style.setProperty('--v2-media-scale', String(scale));
              element.style.objectFit = fit;
              element.style.objectPosition = `${positionX}% ${positionY}%`;
              element.style.transform = `scale(${scale})`;
              element.style.transformOrigin = 'center';
              return;
            }
            if (value && typeof value === 'object' && value.__smu1RelationMediaProjection === true) {
              const bindingId = String(value.mediaBindingId || '');
              const selectorValue = window.CSS?.escape
                ? CSS.escape(bindingId)
                : bindingId.replace(/["\\]/g, '\\$&');
              const mediaElement = element.querySelector(`[data-smu1-binding-id="${selectorValue}"]`);
              const image = mediaElement instanceof HTMLImageElement
                ? mediaElement
                : mediaElement?.querySelector('img');
              if (!(image instanceof HTMLImageElement) || !validRetargetedMediaBinding(value.mediaBinding, bindingId)) return;
              mediaElement.setAttribute('data-smu1-binding', JSON.stringify(value.mediaBinding));
              if (value.item?.src) writeLiveImage(image, value.item);
              else clearLiveImage(image, { preserveGeometry: true });
              for (const position of Array.isArray(value.positions) ? value.positions : []) {
                if (/^--[a-z][a-z0-9-]*$/u.test(String(position?.cssProperty || ''))) {
                  image.style.setProperty(position.cssProperty, String(position.value || '50% 50%'));
                }
              }
              if (/^(?:\d{1,3}%|left|center|right)\s+(?:\d{1,3}%|top|center|bottom)$/u.test(String(value.objectPosition || ''))) {
                image.style.objectPosition = value.objectPosition;
              }
              return;
            }
            if (value && typeof value === 'object' && value.__smu1VideoProjection === true && element instanceof HTMLVideoElement) {
              const desktop = typeof value.desktop === 'string' ? value.desktop : '';
              const mobile = typeof value.mobile === 'string' ? value.mobile : desktop;
              element.dataset.v2DesktopSrc = desktop;
              element.dataset.v2MobileSrc = mobile;
              element.dataset.hfDesktopSrc = desktop;
              element.dataset.hfMobileSrc = mobile;
              const next = window.matchMedia('(max-width: 760px)').matches ? mobile : desktop;
              if (next && element.currentSrc !== next && element.src !== next) {
                element.src = next;
                element.load();
              }
              return;
            }
            if (value && typeof value === 'object' && value.__smu1LinkProjection === true) {
              if (element instanceof HTMLAnchorElement && typeof value.href === 'string' && value.href) element.href = value.href;
              const text = value.text == null ? '' : String(value.text);
              if (element instanceof HTMLAnchorElement) {
                const strong = element.querySelector('strong');
                const label = strong || (element.children.length === 1 ? element.firstElementChild : null);
                if (label) label.textContent = text;
                else if (!element.children.length) element.textContent = binding.hrefPath === 'telegram' ? `${text} · Telegram` : text;
              }
              return;
            }
            if (value && typeof value === 'object' && value.__smu1ListProjection === true) {
              projectListValue(element, binding, value);
              return;
            }
            if (value && typeof value === 'object' && value.__smu1MediaProjection === true && Array.isArray(value.paths)) {
              if (projectLiveGallery(element, value)) return;
              const items = (Array.isArray(value.items) ? value.items : value.paths)
                .map((item) => typeof item === 'string' ? { src: item, alt: '', caption: '' } : item)
                .filter((item) => item && typeof item.src === 'string' && item.src);
              const images = element instanceof HTMLImageElement
                ? [element]
                : Array.from(element.querySelectorAll('img'));
              images.forEach((image, index) => {
                const next = items[index];
                if (!next && image.dataset.smu1LiveMedia === 'true') image.remove();
                else if (!next) clearLiveImage(image);
                else writeLiveImage(image, next);
              });
              for (const next of items.slice(images.length)) {
                const image = document.createElement('img');
                image.src = next.src;
                image.alt = next.alt || '';
                image.dataset.smu1LiveMedia = 'true';
                image.style.cssText = 'display:block;width:100%;height:auto;object-fit:cover;';
                element.append(image);
              }
              return;
            }
            if (target === 'src' && element instanceof HTMLImageElement && typeof value === 'string') {
              writeLiveImage(element, { src: value, alt: element.alt });
              return;
            }
            if (target === 'href' && element instanceof HTMLAnchorElement && typeof value === 'string') {
              element.href = value;
              return;
            }
            if (target === 'style-image' && element instanceof HTMLElement && typeof value === 'string') {
              element.style.backgroundImage = `url("${value.replace(/["\\]/g, '\\$&')}")`;
              return;
            }
            if (target === 'attribute:aria-label' && element instanceof HTMLElement && typeof value === 'string') {
              element.setAttribute('aria-label', value);
              return;
            }
            if (target === 'paragraphs' && element instanceof HTMLElement && typeof value === 'string') {
              const paragraphs = value.split(/\n{2,}/u).map((item) => item.trim()).filter(Boolean);
              element.replaceChildren(...paragraphs.map((text) => {
                const paragraph = document.createElement('p');
                paragraph.textContent = text;
                return paragraph;
              }));
              return;
            }
            if (value === null || value === undefined || typeof value === 'object') return;
            element.textContent = String(value);
          };

          window.addEventListener('message', (event) => {
            if (event.origin !== parentOrigin || event.source !== window.parent) return;
            const message = event.data;
            if (!message || message.protocol !== PROTOCOL || message.version !== VERSION) return;
            if (message.nonce !== bridgeNonce || message.revision !== bridgeRevision) return;
            if (!Number.isSafeInteger(message.sequence) || message.sequence <= inboundSequence) return;
            inboundSequence = message.sequence;
            if (message.type === 'mode') {
              mode = message.mode === 'preview' ? 'preview' : 'edit';
              document.documentElement.dataset.smu1EditorMode = mode;
              return;
            }
            if (message.type === 'request-geometry') {
              queueGeometry();
              return;
            }
            if (message.type === 'projection' && Array.isArray(message.projections)) {
              for (const projection of message.projections) {
                const selectorValue = window.CSS?.escape
                  ? CSS.escape(String(projection.bindingId || ''))
                  : String(projection.bindingId || '').replace(/["\\]/g, '\\$&');
                document.querySelectorAll(`[data-smu1-binding-id="${selectorValue}"]`).forEach((element) => {
                  const binding = parseBinding(element);
                  if (binding) projectValue(element, binding, projection.value);
                });
              }
              queueGeometry();
              return;
            }
            if (message.type === 'reorder-projection' && Array.isArray(message.orderedSlugs)) {
              const zoneId = String(message.zoneId || '');
              const rows = bindingElements().flatMap((element) => {
                const binding = parseBinding(element);
                if (!binding || binding.tool !== 'reorder-item' || String(binding.zoneId || '') !== zoneId) return [];
                const style = window.getComputedStyle(element);
                const rect = element.getBoundingClientRect();
                if (style.display === 'none' || style.visibility === 'hidden' || rect.width < 1 || rect.height < 1) return [];
                const root = element.closest('[role="listitem"]') || element;
                return [{ slug: String(binding.stableItemId || binding.recordSlug || ''), root }];
              });
              const rowBySlug = new Map(rows.map((row) => [row.slug, row]));
              const roots = message.orderedSlugs.map((slug) => rowBySlug.get(String(slug))?.root).filter(Boolean);
              const parent = roots[0]?.parentElement;
              if (parent && roots.length === rows.length && roots.every((root) => root.parentElement === parent)) {
                roots.forEach((root) => parent.append(root));
              }
              queueGeometry();
            }
          });

          window.addEventListener('scroll', queueGeometry, { passive: true });
          window.addEventListener('resize', queueGeometry, { passive: true });
          if ('ResizeObserver' in window) new ResizeObserver(queueGeometry).observe(document.documentElement);
          if ('MutationObserver' in window) new MutationObserver(queueGeometry).observe(document.body, { childList: true, subtree: true });

          const ready = () => window.requestAnimationFrame(() => window.requestAnimationFrame(() => sendGeometry('ready')));
          if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', ready, { once: true });
          else ready();
        })();
      </script>
    )}
  </body>
</html>
