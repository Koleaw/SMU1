---
import { safeInlineJson } from '../utils/safeInlineJson.mjs';
import '../styles/v2/home-v2.css';
import '../styles/v2/cookie-banner-v2.css';
import '../styles/v2/visual-polish-v2.css';
import '../styles/v2/motion-v2.css';
import '../styles/v2/page-transition-v2.css';
import entranceV2Url from '../styles/v2/entrance-v2.css?url';
import finalArtDirectionUrl from '../styles/v2/final-art-direction-v2.css?url';
import h4ScaleV2Url from '../styles/v2/h4-scale-v2.css?url';
import CookieBanner from '../components/CookieBanner.astro';
import V2EntryExperience from '../components/v2/motion/V2EntryExperience.astro';
import V2PageTransition from '../components/v2/motion/V2PageTransition.astro';
import siteSettings from '../content/site-settings/global.json';
import yandex from '../data/yandex.json';
import { isProductionDeploy, isTestDeploy, NOINDEX_ROBOTS } from '../utils/deployEnvironment';
import { loadV2TransitionRouteRegistryJson } from '../utils/v2RouteRegistry';
import { withBase } from '../utils/withBase';
import { getV2Scope, productionV2Path, type V2Scope } from '../utils/v2Routes';
import { adminDisposition, isLocalAdminCanvas } from '../admin/bindings/adminBinding';
import editorCanvasAffordancesCss from '../admin/styles/editor-canvas-affordances.css?raw';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogImage?: string;
  scope?: V2Scope;
  robots?: string;
  noindex?: boolean;
  noCanonical?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  refreshTarget?: string;
  entryMotion?: 'preview';
  blockingStylesheetUrls?: string[];
}

const {
  title,
  description,
  canonicalPath,
  ogImage = '/assets/images/placeholders/og-default.svg',
  scope = getV2Scope(Astro.url.pathname),
  robots,
  noindex = false,
  noCanonical = false,
  structuredData,
  refreshTarget = '',
  entryMotion,
  blockingStylesheetUrls = []
} = Astro.props as Props;

const isProduction = scope === 'production';
const isEditorCanvas = isLocalAdminCanvas(Astro.url);
const isEntryPreview = entryMotion === 'preview';
const stylesheetUrl = (value: string) => import.meta.env.DEV
  ? `${value}${value.includes('?') ? '&' : '?'}direct`
  : value;
const entranceV2StylesheetUrl = stylesheetUrl(entranceV2Url);
const finalArtDirectionStylesheetUrl = stylesheetUrl(finalArtDirectionUrl);
const h4ScaleV2StylesheetUrl = stylesheetUrl(h4ScaleV2Url);
const fontStylesheetUrl = 'https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=optional';
const entrySessionKey = 'smu1:entry-intro:v2';
const currentProductionPath = productionV2Path(Astro.url.pathname).split(/[?#]/, 1)[0];
const compatibilityRoutes = new Set(['/lavochki-i-skameyki/', '/urny/', '/navesy/']);
const isPublicV2Motion = isProduction
  && !isEditorCanvas
  && !refreshTarget
  && !compatibilityRoutes.has(currentProductionPath);
const isEntryEnabled = isPublicV2Motion || isEntryPreview;
const entryMode = isPublicV2Motion ? 'public' : isEntryPreview ? 'preview' : undefined;
const transitionRouteRegistryJson = isPublicV2Motion
  ? await loadV2TransitionRouteRegistryJson()
  : '';
const v2BasePath = withBase('/');
const pageTitle = title?.trim() || 'СМУ-1';
const pageDescription = description?.trim()
  || 'СМУ-1: производство металлоконструкций, уличной мебели, ограждений и изделий для благоустройства.';
const resolvedCanonicalPath = canonicalPath === undefined
  ? productionV2Path(Astro.url.pathname)
  : canonicalPath;
const canonicalUrl = !isTestDeploy && !noCanonical && resolvedCanonicalPath
  ? new URL(withBase(resolvedCanonicalPath), Astro.site).toString()
  : '';
const isSearchExcluded = isTestDeploy || !isProduction || noindex;
const robotsContent = isSearchExcluded ? NOINDEX_ROBOTS : robots || 'index, follow';
const isMetrikaEnabled = isProductionDeploy && !isSearchExcluded && !robotsContent.toLowerCase().includes('noindex');
const toAbsoluteUrl = (path: string) => /^https?:\/\//i.test(path)
  ? path
  : new URL(withBase(path), Astro.site).toString();
const ogImageUrl = ogImage ? toAbsoluteUrl(ogImage) : '';

const siteRoot = new URL(withBase('/'), Astro.site).toString();
const isHomePage = isProduction && productionV2Path(Astro.url.pathname) === '/';
const organizationData = {
  '@type': 'LocalBusiness',
  '@id': `${siteRoot}#organization`,
  name: siteSettings.companyName || 'СМУ-1',
  url: siteRoot,
  telephone: siteSettings.phonePrimary,
  email: siteSettings.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: siteSettings.address || siteSettings.legalAddress,
    addressLocality: siteSettings.city || 'Курган',
    addressCountry: 'RU'
  },
  sameAs: [siteSettings.telegram].filter(Boolean)
};
const websiteData = isHomePage ? {
  '@type': 'WebSite',
  '@id': `${siteRoot}#website`,
  name: siteSettings.companyName || 'СМУ-1',
  url: siteRoot,
  publisher: { '@id': `${siteRoot}#organization` }
} : null;
const extraStructuredData = Array.isArray(structuredData)
  ? structuredData
  : structuredData
    ? [structuredData]
    : [];
const jsonLdGraph = [organizationData, websiteData, ...extraStructuredData].filter(Boolean);
---

<!doctype html>
<html
  lang="ru"
  class="home-v2-html"
  data-home-v2-theme="engineering"
  data-v2-entry-enabled={entryMode}
  data-v2-public-route={isProduction ? 'true' : undefined}
  data-v2-base={v2BasePath}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={robotsContent} />
    <meta name="description" content={pageDescription} />
    {refreshTarget && !isEditorCanvas && <meta http-equiv="refresh" content={`0;url=${withBase(refreshTarget)}`} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    <meta name="theme-color" content="#101720" data-home-v2-theme-color />
    {isPublicV2Motion && (
      <script
        type="application/json"
        data-v2-route-registry
        set:html={transitionRouteRegistryJson}
      />
    )}
    {isPublicV2Motion && <V2PageTransition part="head" />}
    {isPublicV2Motion && (
      <script is:inline>
        (() => {
          const root = document.documentElement;
          const connection = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
          const profile = window.matchMedia('(prefers-reduced-motion: reduce)').matches
            ? 'reduce'
            : connection && connection.saveData
              ? 'save-data'
              : 'normal';

          root.dataset.v2MotionProfile = profile;
          root.dataset.v2EntranceState = 'armed';
          window.__smu1EntranceFailSafe = window.setTimeout(() => {
            if (root.dataset.v2EntranceController === 'ready') return;

            const reason = 'controller-timeout';
            [
              '__smu1PageTransitionFailSafe',
              '__smu1EntryFailSafe',
              '__smu1EntryFailSafeCleanup'
            ].forEach((key) => {
              const timer = window[key];
              if (typeof timer === 'number') window.clearTimeout(timer);
              delete window[key];
            });

            root.dataset.v2EntranceState = 'fail-open';
            root.dataset.v2EntranceController = 'fail-open';
            root.dataset.v2EntryBootstrap = 'fail-open';
            root.dataset.v2MotionState = 'fail-open';
            root.dataset.v2PageBootstrap = 'fail-open';
            root.dataset.v2PageBootstrapReason = reason;
            root.dataset.v2PageState = 'fail-open';
            delete root.dataset.v2MotionProfile;
            delete root.dataset.v2ScrollLocked;
            delete root.dataset.v2EntryLock;
            delete root.dataset.v2PageLock;
            root.classList.remove('v2-entry-js', 'v2-entry-scroll-locked', 'v2-page-transition-locked');

            document.querySelector('[data-v2-page-bootstrap-overlay]')?.remove();
            const pageOverlay = document.querySelector('[data-v2-page-transition]');
            if (pageOverlay instanceof HTMLElement) {
              pageOverlay.dataset.v2PageState = 'fail-open';
              pageOverlay.dataset.v2PageFailure = reason;
              pageOverlay.dataset.v2PageSettled = 'true';
              delete pageOverlay.dataset.v2PageLock;
            }

            const motionRoot = document.querySelector('[data-v2-motion-root][data-v2-entry-mode="public"]');
            if (motionRoot instanceof HTMLElement) {
              motionRoot.dataset.v2EntranceState = 'fail-open';
              motionRoot.dataset.v2EntranceController = 'fail-open';
              motionRoot.dataset.v2MotionStatic = 'true';
              motionRoot.dataset.v2MotionState = 'fail-open';
              motionRoot.dataset.v2EntrySettled = 'true';
              delete motionRoot.dataset.v2ScrollLocked;
              delete motionRoot.dataset.v2EntranceActivation;
              delete motionRoot.dataset.v2EntranceActivationId;
              motionRoot.dispatchEvent(new CustomEvent('v2:entry-cancel', {
                detail: { state: 'fail-open', reason }
              }));
              motionRoot.dispatchEvent(new CustomEvent('v2:entry-done', {
                detail: { state: 'fail-open', reason }
              }));
            }

            document.querySelectorAll('[data-v2-entry-root], [data-v2-entry-overlay]')
              .forEach((element) => {
                if (element instanceof HTMLElement) element.dataset.v2EntryState = 'fail-open';
              });

            document.querySelectorAll('[data-v2-entrance-role], [data-v2-entrance-runtime-role]')
              .forEach((element) => {
                if (!(element instanceof HTMLElement)) return;
                element.dataset.v2EntranceNode = 'settled';
                delete element.dataset.v2EntranceRuntimeRole;
                element.style.removeProperty('--v2-entrance-duration');
                element.style.removeProperty('will-change');
                element.style.removeProperty('pointer-events');
              });
            document.querySelectorAll('[data-v2-scroll-state], [data-v2-scroll-group-state]')
              .forEach((element) => {
                if (!(element instanceof HTMLElement)) return;
                if (element.hasAttribute('data-v2-scroll-state')) element.dataset.v2ScrollState = 'settled';
                if (element.hasAttribute('data-v2-scroll-group-state')) element.dataset.v2ScrollGroupState = 'settled';
                element.style.removeProperty('--v2-scroll-delay');
                element.style.removeProperty('--v2-scroll-duration');
                element.style.removeProperty('will-change');
                element.style.removeProperty('pointer-events');
              });
            document.body?.classList.remove('v2-entry-scroll-locked');
            if (document.body) {
              delete document.body.dataset.v2EntryLock;
              document.body.style.removeProperty('overflow');
            }

            document.dispatchEvent(new CustomEvent('v2:entrance-fail-open', {
              detail: { state: 'fail-open', reason }
            }));
            delete window.__smu1EntranceFailSafe;
          }, 1200);
        })();
      </script>
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.gstatic.com/s/manrope/v20/xn7gYHE41ni1AdIRggexSvfedN4.woff2"
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      href={fontStylesheetUrl}
      rel="preload"
      as="style"
    />
    <link
      href={fontStylesheetUrl}
      rel="stylesheet"
      media="print"
      data-v2-font-stylesheet
    />
    <script is:inline>
      (() => {
        const stylesheet = document.querySelector('[data-v2-font-stylesheet]');
        if (!(stylesheet instanceof HTMLLinkElement)) return;
        const activate = () => {
          stylesheet.media = 'all';
          stylesheet.dataset.v2FontState = 'loaded';
        };
        const fail = () => { stylesheet.dataset.v2FontState = 'error'; };
        if (stylesheet.sheet) activate();
        else {
          stylesheet.addEventListener('load', activate, { once: true });
          stylesheet.addEventListener('error', fail, { once: true });
        }
      })();
    </script>
    {isEntryEnabled && (
      <script is:inline define:vars={{ entrySessionKey }}>
        (() => {
          const root = document.documentElement;
          const params = new URLSearchParams(window.location.search);
          const forcedReplay = params.get('intro') === 'replay' || params.get('intro') === 'slow';
          const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          const connection = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
          const saveData = Boolean(connection && connection.saveData);
          let bootstrap = 'armed';

          try {
            if (root.dataset.v2PageBootstrap === 'arrival') {
              window.sessionStorage.setItem(entrySessionKey, 'seen');
              bootstrap = 'static';
            } else if (window.location.hash) {
              window.sessionStorage.setItem(entrySessionKey, 'seen');
              bootstrap = 'skipped';
            } else if (reducedMotion || saveData) {
              window.sessionStorage.setItem(entrySessionKey, 'seen');
              bootstrap = 'static';
            } else {
              const alreadySeen = window.sessionStorage.getItem(entrySessionKey) === 'seen';
              if (!forcedReplay && alreadySeen) {
                bootstrap = 'static';
              } else {
                window.sessionStorage.setItem(entrySessionKey, 'seen');
              }
            }
          } catch {
            bootstrap = 'fail-open';
          }

          root.dataset.v2EntryBootstrap = bootstrap;
          root.dataset.v2MotionState = bootstrap;
          if (bootstrap !== 'armed') return;

          root.classList.add('v2-entry-js');
          root.classList.add('v2-entry-scroll-locked');
          root.dataset.v2ScrollLocked = 'true';
          window.__smu1EntryFailSafe = window.setTimeout(() => {
            root.dataset.v2EntryBootstrap = 'fail-open';
            root.dataset.v2MotionState = 'fail-open';
            const motionRoot = document.querySelector('[data-v2-motion-root]');
            const entryRoot = document.querySelector('[data-v2-entry-root]');
            const header = document.querySelector('[data-home-v2-header]');
            if (motionRoot instanceof HTMLElement) {
              motionRoot.dataset.v2MotionState = 'fail-open';
              motionRoot.dataset.v2MotionStatic = 'true';
              motionRoot.dataset.v2CriticalStatus = 'controller-timeout';
              motionRoot.querySelectorAll('[data-v2-reveal]').forEach((element) => {
                if (element instanceof HTMLElement) element.dataset.v2RevealState = 'visible';
              });
              motionRoot.dispatchEvent(new CustomEvent('v2:entry-opening', {
                detail: { state: 'fail-open' }
              }));
            }
            if (entryRoot instanceof HTMLElement) entryRoot.dataset.v2EntryState = 'opening';
            if (header instanceof HTMLElement) header.classList.add('is-ready');

            window.__smu1EntryFailSafeCleanup = window.setTimeout(() => {
              delete root.dataset.v2ScrollLocked;
              delete root.dataset.v2EntryLock;
              root.classList.remove('v2-entry-js', 'v2-entry-scroll-locked');
              if (motionRoot instanceof HTMLElement) {
                motionRoot.dataset.v2EntrySettled = 'true';
                delete motionRoot.dataset.v2ScrollLocked;
                motionRoot.dispatchEvent(new CustomEvent('v2:entry-done', {
                  detail: { state: 'fail-open' }
                }));
              }
              if (entryRoot instanceof HTMLElement) entryRoot.dataset.v2EntryState = 'fail-open';
              document.body?.classList.remove('v2-entry-scroll-locked');
              if (document.body) delete document.body.dataset.v2EntryLock;
            }, 800);
          }, 3900);
        })();
      </script>
    )}
    <noscript>
      <link
        href={fontStylesheetUrl}
        rel="stylesheet"
      />
    </noscript>
    <link rel="icon" type="image/svg+xml" href={withBase('/assets/brand/favicon.svg')} />
    <link rel="preload" href={finalArtDirectionStylesheetUrl} as="style" />
    <title>{pageTitle}</title>
    {!isSearchExcluded && (
      <script type="application/ld+json" set:html={safeInlineJson({ '@context': 'https://schema.org', '@graph': jsonLdGraph })} />
    )}
    {scope === 'design-lab' && (
      <script is:inline>
        (() => {
          const root = document.documentElement;
          const requestedTheme = new URLSearchParams(window.location.search).get('palette');
          let savedTheme = '';
          try { savedTheme = window.localStorage.getItem('smu1-home-v2-palette') || ''; } catch { savedTheme = ''; }
          root.dataset.homeV2Theme = requestedTheme === 'steel' || requestedTheme === 'olive'
            ? requestedTheme
            : savedTheme === 'steel' ? 'steel' : 'olive';
        })();
      </script>
    )}
    {isMetrikaEnabled && (
      <script
        is:inline
        define:vars={{
          metrikaCounterId: yandex.metrika.counterId,
          metrikaScriptSrc: yandex.metrika.scriptSrc,
          metrikaInit: yandex.metrika.init,
          metrikaDelayMs: 7000
        }}
      >
        (() => {
          const stateKey = '__smu1MetrikaState';
          window[stateKey] = window[stateKey] || { loaded: false, timer: null };
          const state = window[stateKey];

          const loadMetrika = () => {
            if (state.loaded || !metrikaCounterId || !metrikaScriptSrc) return;
            state.loaded = true;
            (function(m, e, t, r, i, k, a) {
              m[i] = m[i] || function() { (m[i].a = m[i].a || []).push(arguments); };
              m[i].l = 1 * new Date();
              for (let j = 0; j < document.scripts.length; j++) {
                if (document.scripts[j].src === r) return;
              }
              k = e.createElement(t);
              a = e.getElementsByTagName(t)[0];
              k.async = 1;
              k.src = r;
              a.parentNode.insertBefore(k, a);
            })(window, document, 'script', metrikaScriptSrc, 'ym');
            window.ym(metrikaCounterId, 'init', { ...metrikaInit, referrer: document.referrer, url: location.href });
          };

          const scheduleMetrika = () => {
            if (state.loaded || state.timer) return;
            state.timer = window.setTimeout(() => { state.timer = null; loadMetrika(); }, metrikaDelayMs);
          };

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', scheduleMetrika, { once: true });
          } else {
            scheduleMetrika();
          }
          document.addEventListener('astro:page-load', scheduleMetrika);
        })();
      </script>
    )}
    <link rel="stylesheet" href={finalArtDirectionStylesheetUrl} data-final-art-direction />
    {isPublicV2Motion && <link rel="stylesheet" href={entranceV2StylesheetUrl} data-v2-entrance-styles />}
    {isProduction && <link rel="stylesheet" href={h4ScaleV2StylesheetUrl} data-v2-h4-scale-styles />}
    {blockingStylesheetUrls.map((href) => (
      <link rel="stylesheet" href={href} data-v2-route-styles />
    ))}
    {isEditorCanvas && (
      <style is:inline set:html={editorCanvasAffordancesCss} data-smu1-editor-canvas-styles />
    )}
  </head>
  <body class="home-v2-body">
    {isPublicV2Motion && <V2PageTransition />}
    {isEntryEnabled ? (
      <div
        data-v2-motion-root
        data-v2-entry-mode={entryMode}
        data-v2-motion-state="armed"
      >
        <a class="v2-entry-skip-link" href="#main-content" data-v2-entry-skip-link {...adminDisposition(Astro.url, {
          kind: 'template-fixed',
          reason: 'Accessibility-control переводит фокус к основному содержимому и не является бизнес-текстом страницы.',
          source: 'src/layouts/PublicV2Layout.astro#entry-skip-link'
        })}>
          К основному содержанию
        </a>
        <V2EntryExperience />
        <slot />
      </div>
    ) : (
      <slot />
    )}
    {isProduction && !isEditorCanvas && <CookieBanner />}
    <script>
      const initV2HeroScroll = () => {
        if (document.documentElement.dataset.v2HeroScrollReady === 'true') return;
        const heroes = Array.from(document.querySelectorAll<HTMLElement>('[data-v2-hero-scroll]'));
        if (heroes.length === 0) return;
        document.documentElement.dataset.v2HeroScrollReady = 'true';

        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        const desktopMotion = window.matchMedia('(min-width: 761px)');
        let frame = 0;

        const reset = () => {
          heroes.forEach((hero) => {
            hero.style.setProperty('--v2-hero-scroll-y', '0px');
            hero.style.setProperty('--v2-hero-media-scroll-y', '0px');
            hero.style.setProperty('--v2-hero-scroll-opacity', '1');
          });
        };

        const sync = () => {
          frame = 0;
          if (reducedMotion.matches || !desktopMotion.matches) {
            reset();
            return;
          }

          heroes.forEach((hero) => {
            const copy = hero.querySelector<HTMLElement>('[data-v2-hero-scroll-copy]');
            const media = hero.querySelector<HTMLElement>('[data-v2-hero-scroll-media]');
            if (!copy && !media) return;
            const rect = hero.getBoundingClientRect();
            const height = Math.max(rect.height, 1);
            const progress = Math.min(1, Math.max(0, -rect.top / height));
            const copyTravel = Math.min(180, height * 0.2) * progress;
            const mediaTravel = Math.min(270, height * 0.3) * progress;
            // Let the next section cover the media while the copy clears the
            // persistent header before their visual layers can intersect.
            const fadeProgress = Math.min(1, Math.max(0, (progress - 0.32) / 0.2));
            hero.style.setProperty('--v2-hero-scroll-y', `${copyTravel.toFixed(2)}px`);
            hero.style.setProperty('--v2-hero-media-scroll-y', `${mediaTravel.toFixed(2)}px`);
            hero.style.setProperty('--v2-hero-scroll-opacity', String(1 - fadeProgress));
          });
        };

        const queue = () => {
          if (frame) return;
          frame = window.requestAnimationFrame(sync);
        };

        window.addEventListener('scroll', queue, { passive: true });
        window.addEventListener('resize', queue);
        reducedMotion.addEventListener('change', queue);
        desktopMotion.addEventListener('change', queue);
        if ('ResizeObserver' in window) {
          const observer = new ResizeObserver(queue);
          heroes.forEach((hero) => observer.observe(hero));
        }
        sync();
      };

      initV2HeroScroll();
      document.addEventListener('astro:page-load', initV2HeroScroll);
    </script>
    <script>
      import { initializeV2EntranceController } from '../scripts/v2EntranceController';
      import { initializeV2MotionController } from '../scripts/v2MotionController';
      import { initializeV2PageTransitionController } from '../scripts/v2PageTransitionController';

      initializeV2PageTransitionController();
      initializeV2EntranceController();
      initializeV2MotionController();
      document.addEventListener('astro:page-load', initializeV2PageTransitionController);
      document.addEventListener('astro:page-load', initializeV2EntranceController);
      document.addEventListener('astro:page-load', initializeV2MotionController);
    </script>
    {isEditorCanvas && (
      <script
        is:inline
        define:vars={{
          bridgeNonce: Astro.url.searchParams.get('editorSession'),
          bridgeRevision: Number(Astro.url.searchParams.get('editorRevision') || 0),
          initialEditorMode: Astro.url.searchParams.get('editorMode') === 'preview' ? 'preview' : 'edit'
        }}
      >
        (() => {
          const PROTOCOL = 'smu1-editor-bridge';
          const VERSION = 1;
          const parentOrigin = window.location.origin;
          let mode = initialEditorMode;
          let outboundSequence = 0;
          let inboundSequence = -1;
          let geometryFrame = 0;

          document.documentElement.dataset.smu1EditorCanvas = 'true';
          document.documentElement.dataset.smu1EditorMode = mode;

          const post = (type, payload = {}) => {
            if (window.parent === window) return;
            window.parent.postMessage({
              protocol: PROTOCOL,
              version: VERSION,
              nonce: bridgeNonce,
              revision: bridgeRevision,
              sequence: outboundSequence++,
              type,
              ...payload
            }, parentOrigin);
          };

          const parseBinding = (element) => {
            try {
              const binding = JSON.parse(element.getAttribute('data-smu1-binding') || 'null');
              if (!binding || typeof binding !== 'object' || !binding.bindingId) return null;
              return { ...binding, route: window.location.pathname, currentDraftRevision: bridgeRevision };
            } catch { return null; }
          };

          const bindingElements = () => Array.from(document.querySelectorAll('[data-smu1-binding-id][data-smu1-binding]'));
          const bindingsWithGeometry = () => bindingElements().flatMap((element) => {
            const binding = parseBinding(element);
            if (!binding) return [];
            const rect = element.getBoundingClientRect();
            const style = window.getComputedStyle(element);
            if (style.display === 'none' || style.visibility === 'hidden') return [];
            return [{
              binding,
              rect: {
                left: rect.left,
                top: rect.top,
                right: rect.right,
                bottom: rect.bottom,
                width: rect.width,
                height: rect.height
              }
            }];
          });

          const sendGeometry = (type = 'geometry') => post(type, {
            bindings: bindingsWithGeometry(),
            viewport: { width: window.innerWidth, height: window.innerHeight },
            scroll: { x: window.scrollX, y: window.scrollY }
          });

          const queueGeometry = () => {
            if (geometryFrame) return;
            geometryFrame = window.requestAnimationFrame(() => {
              geometryFrame = 0;
              sendGeometry();
            });
          };

          const findBindingElement = (target) => target instanceof Element
            ? target.closest('[data-smu1-binding-id][data-smu1-binding]')
            : null;

          document.addEventListener('click', (event) => {
            if (mode !== 'edit') return;
            const element = findBindingElement(event.target);
            if (element) {
              const binding = parseBinding(element);
              if (!binding) return;
              event.preventDefault();
              event.stopImmediatePropagation();
              const rect = element.getBoundingClientRect();
              post('select', {
                binding,
                rect: { left: rect.left, top: rect.top, right: rect.right, bottom: rect.bottom, width: rect.width, height: rect.height }
              });
              return;
            }
            const anchor = event.target instanceof Element ? event.target.closest('a[href]') : null;
            if (anchor instanceof HTMLAnchorElement && anchor.href) {
              event.preventDefault();
              event.stopImmediatePropagation();
              post('navigate', { href: anchor.href });
            }
          }, true);

          document.addEventListener('submit', (event) => {
            event.preventDefault();
            event.stopImmediatePropagation();
            const form = event.target instanceof HTMLFormElement ? event.target : null;
            post('interaction-blocked', { interaction: 'form-submit', formId: form?.id || '' });
          }, true);

          const scalarParts = (value) => {
            if (value === null || value === undefined) return [];
            if (typeof value !== 'object') return [String(value)];
            return ['label', 'title', 'text', 'value', 'format', 'context', 'href']
              .filter((key) => typeof value[key] === 'string' && value[key].trim())
              .map((key) => String(value[key]));
          };

          const leafElements = (element) => Array.from(element.querySelectorAll('*'))
            .filter((node) => node.children.length === 0 && !['IMG', 'SOURCE', 'SVG', 'PATH'].includes(node.tagName))
            .filter((node) => !node.closest('[aria-hidden="true"],[inert]'));

          const writeParts = (element, parts) => {
            const explicit = [
              ...(element.matches?.('[data-smu1-list-value]') ? [element] : []),
              ...element.querySelectorAll('[data-smu1-list-value]')
            ];
            if (explicit.length) {
              explicit.forEach((target, index) => {
                if (index < parts.length) target.textContent = parts[index];
              });
              return;
            }
            const leaves = leafElements(element);
            leaves.forEach((leaf, index) => {
              if (index < parts.length) leaf.textContent = parts[index];
            });
            if (leaves.length) return;
            const directText = Array.from(element.childNodes).filter((node) => node.nodeType === Node.TEXT_NODE && node.nodeValue?.trim());
            if (directText.length) {
              directText[0].nodeValue = parts.join(' · ');
              directText.slice(1).forEach((node) => node.remove());
              return;
            }
            element.append(document.createTextNode(parts.join(' · ')));
          };

          const directListItems = (element) => {
            const marked = Array.from(element.children).filter((node) => node.hasAttribute('data-smu1-list-item'));
            return marked.length
              ? marked
              : Array.from(element.children).filter((node) => ['LI', 'ARTICLE', 'SECTION', 'DIV', 'DL'].includes(node.tagName));
          };

          const fieldElements = (itemElement, fieldPath) => {
            const escaped = window.CSS?.escape ? CSS.escape(fieldPath) : fieldPath.replace(/["\\]/g, '\\$&');
            const candidates = [
              ...(itemElement.getAttribute('data-smu1-list-field') === fieldPath ? [itemElement] : []),
              ...itemElement.querySelectorAll(`[data-smu1-list-field="${escaped}"]`)
            ];
            return candidates.filter((node) => node === itemElement || node.closest('[data-smu1-list-item]') === itemElement);
          };

          const projectStructuredItem = (itemElement, item, fields, index) => {
            if (!item || typeof item !== 'object') return;
            const itemId = String(item.id || '').trim();
            if (!itemId) {
              itemElement.removeAttribute('data-smu1-list-item');
              itemElement.hidden = true;
              return;
            }
            itemElement.setAttribute('data-smu1-list-item', itemId);
            for (const field of fields) {
              const targets = fieldElements(itemElement, field.fieldPath);
              if (field.tool === 'computed') {
                if (field.fieldPath === 'ordinal') targets.forEach((target) => { target.textContent = String(index + 1).padStart(2, '0'); });
                continue;
              }
              const fieldValue = field.fieldPath.split('.').reduce((current, part) => current?.[part], item);
              if (field.tool === 'list') {
                targets.forEach((target) => projectStructuredArray(target, Array.isArray(fieldValue) ? fieldValue : [], field.itemFields || []));
                continue;
              }
              if (field.tool === 'media') {
                targets.forEach((target) => {
                  const image = target instanceof HTMLImageElement ? target : target.querySelector('img');
                  if (!(image instanceof HTMLImageElement)) return;
                  const mediaHost = target.closest('[data-smu1-list-media-host]');
                  if (fieldValue?.src) {
                    if (mediaHost instanceof HTMLElement) mediaHost.hidden = false;
                    writeLiveImage(image, fieldValue);
                    const editorial = itemElement.closest('.direction-type-editorial');
                    if (editorial instanceof HTMLElement) {
                      editorial.classList.add('direction-type-editorial--has-media');
                      editorial.classList.remove('direction-type-editorial--no-media');
                      editorial.dataset.directionTypeState = 'has-media';
                    }
                  } else {
                    clearLiveImage(image, { preserveGeometry: mediaHost === null });
                    if (mediaHost instanceof HTMLElement) mediaHost.hidden = true;
                    const editorial = itemElement.closest('.direction-type-editorial');
                    if (editorial instanceof HTMLElement) {
                      editorial.classList.remove('direction-type-editorial--has-media', 'direction-type-editorial--featured', 'direction-type-editorial--media-end');
                      editorial.classList.add('direction-type-editorial--no-media');
                      editorial.dataset.directionTypeState = 'no-media';
                    }
                  }
                });
                continue;
              }
              if (['generated-id', 'generated-order', 'visibility'].includes(field.tool)) continue;
              targets.forEach((target) => {
                const optionalField = target.hasAttribute('data-smu1-list-optional-field') ? target : null;
                if (optionalField instanceof HTMLElement) optionalField.hidden = !String(fieldValue ?? '').trim();
                if (target.dataset.smu1ListTransform === 'line') {
                  const lines = String(fieldValue ?? '').split(/\r?\n+/u).map((part) => part.trim()).filter(Boolean);
                  const lineIndex = Number(target.dataset.smu1ListLine || 0);
                  target.textContent = lines[lineIndex] || '';
                  if (target instanceof HTMLElement) target.hidden = lineIndex >= lines.length;
                  return;
                }
                if (target.dataset.smu1ListTransform === 'lines') {
                  const lines = String(fieldValue ?? '').split(/\r?\n+/u).map((part) => part.trim()).filter(Boolean);
                  const template = target.querySelector('span');
                  const spans = Array.from(target.querySelectorAll(':scope > span'));
                  while (spans.length < lines.length && template) {
                    const copy = template.cloneNode(false);
                    target.append(copy);
                    spans.push(copy);
                  }
                  while (spans.length > lines.length) spans.pop()?.remove();
                  spans.forEach((span, lineIndex) => { span.textContent = lines[lineIndex]; });
                  if (!template && !lines.length) target.textContent = '';
                  else if (!template && lines.length) lines.forEach((line) => {
                    const span = document.createElement('span');
                    span.textContent = line;
                    target.append(span);
                  });
                  return;
                }
                if (field.tool === 'link' && target instanceof HTMLAnchorElement && typeof fieldValue === 'string') target.href = fieldValue;
                else target.textContent = fieldValue == null ? '' : String(fieldValue);
              });
            }
            itemElement.hidden = item.isActive === false;
          };

          const projectStructuredArray = (element, value, fields) => {
            const directItems = directListItems(element);
            const template = directItems.at(-1);
            while (directItems.length < value.length && template) {
              const copy = template.cloneNode(true);
              copy.removeAttribute('data-smu1-binding');
              copy.removeAttribute('data-smu1-binding-id');
              copy.querySelectorAll('[data-smu1-binding],[data-smu1-binding-id]').forEach((node) => {
                node.removeAttribute('data-smu1-binding');
                node.removeAttribute('data-smu1-binding-id');
              });
              element.append(copy);
              directItems.push(copy);
            }
            while (directItems.length > value.length) directItems.pop()?.remove();
            directItems.forEach((itemElement, index) => projectStructuredItem(itemElement, value[index], fields, index));
          };

          const projectStructuredMarkers = (element, value, fields) => {
            const marked = directListItems(element).filter((item) => (
              item.hasAttribute('data-smu1-list-item')
              && item.closest('[data-smu1-binding-id][data-smu1-binding]') === element
            ));
            const template = marked.at(-1);
            if (!template) return;
            const byId = new Map(marked.map((item) => [item.getAttribute('data-smu1-list-item') || '', item]));
            const used = new Set();
            const ordered = value.flatMap((item, index) => {
              if (!item || typeof item !== 'object') return [];
              const itemId = String(item.id || '').trim();
              if (!itemId) return [];
              let itemElement = byId.get(itemId);
              if (!itemElement) {
                itemElement = template.cloneNode(true);
                itemElement.removeAttribute('data-smu1-binding');
                itemElement.removeAttribute('data-smu1-binding-id');
                itemElement.querySelectorAll('[data-smu1-binding],[data-smu1-binding-id]').forEach((node) => {
                  node.removeAttribute('data-smu1-binding');
                  node.removeAttribute('data-smu1-binding-id');
                });
              }
              used.add(itemElement);
              projectStructuredItem(itemElement, item, fields, index);
              return [itemElement];
            });
            marked.filter((item) => !used.has(item)).forEach((item) => item.remove());
            ordered.forEach((item) => element.append(item));
          };

          const projectProductSpecifications = (element, value, binding) => {
            const genericLabels = new Set(['размеры и характеристики', 'размеры', 'характеристики']);
            const normalized = value
              .filter((item) => item && typeof item === 'object' && item.isActive !== false)
              .map((item, sourceIndex) => {
                const label = String(item.label || '').trim();
                const lines = String(item.value || '').split(/\r?\n+/u).map((line) => line.trim()).filter(Boolean);
                const generic = genericLabels.has(label.toLocaleLowerCase('ru-RU'));
                return {
                  id: String(item.id || ''), label, lines, sourceIndex,
                  order: Number.isFinite(Number(item.order)) ? Number(item.order) : 0,
                  pair: Boolean(label && lines.length && !generic), generic
                };
              })
              .filter((item) => item.id && (item.label || item.lines.length))
              .sort((left, right) => left.order - right.order || left.sourceIndex - right.sourceIndex);
            const pairs = normalized.filter((item) => item.pair);
            const textual = normalized.flatMap((item) => {
              if (item.pair) return [];
              if (item.lines.length) return item.lines.map((text, lineIndex) => ({
                id: item.id, text, lineIndex, field: 'value', contextField: 'label'
              }));
              return item.label && !item.generic ? [{
                id: item.id, text: item.label, lineIndex: 0, field: 'label', contextField: 'value'
              }] : [];
            });
            const hasVisibleSpecifications = pairs.length > 0 || textual.length > 0;
            const specificationsPanel = binding.renderer?.variant === 'standard'
              ? element.closest('.v2-technical-panel--specs')
              : element;
            if (specificationsPanel instanceof HTMLElement) specificationsPanel.hidden = !hasVisibleSpecifications;
            const node = (tag, attributes = {}, text = '') => {
              const created = document.createElement(tag);
              Object.entries(attributes).forEach(([name, attributeValue]) => {
                if (attributeValue !== '' && attributeValue !== null && attributeValue !== undefined) created.setAttribute(name, String(attributeValue));
              });
              if (text) created.textContent = text;
              return created;
            };
            const lineNode = (tag, item, className = '') => node(tag, {
              ...(className ? { class: className } : {}),
              'data-smu1-list-item': item.id,
              'data-smu1-list-field': item.field,
              'data-smu1-list-transform': 'line',
              'data-smu1-list-line': item.lineIndex,
              'data-smu1-list-context-field': item.contextField
            }, item.text);
            const definitions = pairs.length ? node('dl', binding.renderer?.variant === 'standard' ? { class: 'v2-spec-definitions' } : {}) : null;
            pairs.forEach((item) => {
              const row = node('div', { 'data-smu1-list-item': item.id });
              row.append(node('dt', { 'data-smu1-list-field': 'label' }, item.label));
              const value = node('dd', { 'data-smu1-list-field': 'value', 'data-smu1-list-transform': 'lines' });
              item.lines.forEach((line) => value.append(node('span', {}, line)));
              row.append(value);
              definitions?.append(row);
            });
            if (binding.renderer?.variant === 'premium') {
              Array.from(element.children).filter((child) => ['DL', 'UL'].includes(child.tagName)).forEach((child) => child.remove());
              if (definitions) element.append(definitions);
              if (textual.length) {
                const list = node('ul');
                textual.forEach((item) => list.append(lineNode('li', item)));
                element.append(list);
              }
              return;
            }
            element.replaceChildren();
            if (definitions) element.append(definitions);
            if (textual.length === 1) element.append(lineNode('p', textual[0], 'v2-spec-copy'));
            else if (textual.length > 1) {
              const list = node('ul', { class: 'v2-spec-points' });
              textual.forEach((item) => list.append(lineNode('li', item)));
              element.append(list);
            }
          };

          const projectListValue = (element, binding, payload) => {
            const value = payload.items;
            const fields = Array.isArray(payload.itemFields) ? payload.itemFields : [];
            if (payload.itemKind === 'object' && fields.length) {
              if (Array.isArray(value) && payload.projectionTarget === 'product-specifications') projectProductSpecifications(element, value, binding);
              else if (Array.isArray(value) && payload.projectionTarget === 'structured-markers') projectStructuredMarkers(element, value, fields);
              else if (Array.isArray(value)) projectStructuredArray(element, value, fields);
              else projectStructuredItem(element, value, fields, 0);
              return;
            }
            if (!Array.isArray(value)) {
              writeParts(element, scalarParts(value));
              return;
            }
            if (binding.fieldPath === 'regions' && !['UL', 'OL'].includes(element.tagName)) {
              const joined = value.map((item) => scalarParts(item)[0]).filter(Boolean).join(' · ');
              if (element.children.length === 0 || ['STRONG', 'DD'].includes(element.tagName)) element.textContent = joined;
              else {
                Array.from(element.childNodes).filter((node) => node.nodeType === Node.TEXT_NODE).forEach((node) => node.remove());
                element.append(document.createTextNode(` ${joined}`));
              }
              return;
            }
            const directItems = directListItems(element);
            if (!directItems.length) {
              element.textContent = value.map((item) => scalarParts(item).join(' · ')).join(' · ');
              return;
            }
            const template = directItems.at(-1);
            while (directItems.length < value.length && template) {
              const copy = template.cloneNode(true);
              copy.removeAttribute('data-smu1-binding');
              copy.removeAttribute('data-smu1-binding-id');
              copy.querySelectorAll('[data-smu1-binding],[data-smu1-binding-id]').forEach((node) => {
                node.removeAttribute('data-smu1-binding');
                node.removeAttribute('data-smu1-binding-id');
              });
              element.append(copy);
              directItems.push(copy);
            }
            while (directItems.length > value.length) directItems.pop()?.remove();
            directItems.forEach((itemElement, index) => writeParts(itemElement, scalarParts(value[index])));
          };

          const writeLiveImage = (image, item) => {
            if (!(image instanceof HTMLImageElement) || !item?.src) return;
            image.hidden = false;
            if (image.dataset.smu1LiveMediaEmpty === 'true') {
              delete image.dataset.smu1LiveMediaEmpty;
              image.style.removeProperty('opacity');
            }
            image.src = item.src;
            image.alt = item.alt || '';
            image.removeAttribute('srcset');
            image.closest('picture')?.querySelectorAll('source').forEach((source) => source.removeAttribute('srcset'));
          };

          const clearLiveImage = (image, { preserveGeometry = false } = {}) => {
            if (!(image instanceof HTMLImageElement)) return;
            image.hidden = !preserveGeometry;
            if (preserveGeometry) {
              image.dataset.smu1LiveMediaEmpty = 'true';
              image.style.opacity = '0';
            }
            image.removeAttribute('src');
            image.removeAttribute('srcset');
            image.closest('picture')?.querySelectorAll('source').forEach((source) => source.removeAttribute('srcset'));
          };

          const validRetargetedMediaBinding = (binding, bindingId) => (
            binding
            && binding.bindingId === bindingId
            && binding.scope === 'shared'
            && binding.tool === 'media'
            && binding.ownerCollection === 'projects'
            && binding.owner?.collection === 'projects'
            && binding.owner?.slug === binding.recordSlug
            && /^[a-z0-9][a-z0-9-]*$/u.test(String(binding.recordSlug || ''))
            && /^presentation\.(?:detailHeroMedia|archiveCoverMedia|publicGallery\[\d+\])$/u.test(String(binding.fieldPath || ''))
            && binding.renderer?.version === 'h6-v1'
          );

          const liveGalleries = new WeakMap();
          const projectLiveGallery = (element, value) => {
            const items = (Array.isArray(value.items) ? value.items : value.paths || [])
              .map((item) => typeof item === 'string' ? { src: item, alt: '', caption: '' } : item)
              .filter((item) => item && typeof item.src === 'string' && item.src);
            const product = element.matches('[data-v2-product-gallery]');
            const project = element.matches('[data-v2-project-gallery]');
            if (!product && !project) return false;
            const previousState = liveGalleries.get(element);
            const state = { items, current: Math.min(previousState?.current || 0, Math.max(0, items.length - 1)) };
            liveGalleries.set(element, state);
            const mainSelector = product ? '[data-v2-gallery-main]' : '[data-v2-project-gallery-main]';
            const thumbSelector = product ? '[data-v2-gallery-thumb]' : '[data-v2-project-gallery-thumb]';
            const statusSelector = product ? '[data-v2-gallery-status]' : '[data-v2-project-gallery-status]';
            const captionSelector = product ? '[data-v2-gallery-caption]' : '[data-v2-project-gallery-caption]';
            const lightboxSelector = product ? '[data-v2-lightbox-image]' : '[data-v2-project-lightbox-image]';
            const lightboxStatusSelector = product ? '[data-v2-lightbox-status]' : '[data-v2-project-lightbox-status]';
            const lightboxCaptionSelector = product ? '' : '[data-v2-project-lightbox-caption]';
            const current = items[state.current];
            const main = element.querySelector(mainSelector);
            if (main && current) writeLiveImage(main, current);
            if (main) main.hidden = !current;
            const empty = element.querySelector(product ? '[data-v2-gallery-empty]' : '[data-v2-project-gallery-fallback]');
            if (empty instanceof HTMLElement) empty.hidden = Boolean(current);
            const thumbs = Array.from(element.querySelectorAll(thumbSelector));
            thumbs.forEach((thumb, index) => {
              const item = items[index];
              thumb.hidden = !item;
              thumb.dataset.smu1LiveIndex = String(index);
              thumb.setAttribute('aria-pressed', String(index === state.current));
              thumb.classList.toggle('is-current', index === state.current);
              const image = thumb.querySelector('img');
              if (image && item) writeLiveImage(image, { ...item, alt: '' });
            });
            const status = element.querySelector(statusSelector);
            if (status instanceof HTMLElement) status.textContent = items.length ? `${state.current + 1} / ${items.length}` : '';
            const caption = element.querySelector(captionSelector);
            if (caption instanceof HTMLElement) {
              caption.textContent = current?.caption || '';
              caption.hidden = !current?.caption;
            }
            const lightboxImage = element.querySelector(lightboxSelector);
            if (lightboxImage && current) writeLiveImage(lightboxImage, current);
            const lightboxStatus = element.querySelector(lightboxStatusSelector);
            if (lightboxStatus instanceof HTMLElement) lightboxStatus.textContent = items.length ? `${state.current + 1} / ${items.length}` : '';
            const lightboxCaption = lightboxCaptionSelector ? element.querySelector(lightboxCaptionSelector) : null;
            if (lightboxCaption instanceof HTMLElement) {
              lightboxCaption.textContent = current?.caption || '';
              lightboxCaption.hidden = !current?.caption;
            }
            return true;
          };

          document.addEventListener('click', (event) => {
            if (mode !== 'preview' || !(event.target instanceof Element)) return;
            const gallery = event.target.closest('[data-v2-product-gallery],[data-v2-project-gallery]');
            const state = gallery ? liveGalleries.get(gallery) : null;
            if (!gallery || !state?.items?.length) return;
            const product = gallery.matches('[data-v2-product-gallery]');
            const thumb = event.target.closest(product ? '[data-v2-gallery-thumb]' : '[data-v2-project-gallery-thumb]');
            const previous = event.target.closest(product ? '[data-v2-gallery-prev],[data-v2-lightbox-prev]' : '[data-v2-project-gallery-prev],[data-v2-project-lightbox-prev]');
            const next = event.target.closest(product ? '[data-v2-gallery-next],[data-v2-lightbox-next]' : '[data-v2-project-gallery-next],[data-v2-project-lightbox-next]');
            if (!thumb && !previous && !next) return;
            event.preventDefault();
            event.stopImmediatePropagation();
            if (thumb) state.current = Number(thumb.dataset.smu1LiveIndex || thumb.dataset.v2GalleryIndex || thumb.dataset.v2ProjectGalleryIndex || 0);
            else state.current = (state.current + (previous ? -1 : 1) + state.items.length) % state.items.length;
            projectLiveGallery(gallery, { items: state.items });
          }, true);

          const projectValue = (element, binding, value) => {
            const target = binding?.projection?.target || 'text';
            if (value && typeof value === 'object' && value.__smu1ProjectDirectionProjection === true && element instanceof HTMLElement) {
              const items = (Array.isArray(value.items) ? value.items : [])
                .filter((item) => item && /^\/(?!\/)[a-z0-9а-яё/_-]*\/?$/iu.test(String(item.href || '')))
                .slice()
                .sort((left, right) => Number(left.order || 0) - Number(right.order || 0));
              const current = Array.from(element.querySelectorAll(':scope > a'));
              const rows = items.map((item, index) => {
                const row = current[index] instanceof HTMLAnchorElement
                  ? current[index]
                  : document.createElement('a');
                row.setAttribute('role', 'listitem');
                row.href = item.href;
                row.dataset.v2TransitionLabel = String(item.label || '');
                row.dataset.smu1LiveDirectionId = String(item.id || '');
                let context = row.querySelector(':scope > span');
                if (!(context instanceof HTMLElement)) {
                  context = document.createElement('span');
                  row.prepend(context);
                }
                let label = row.querySelector(':scope > strong');
                if (!(label instanceof HTMLElement)) {
                  label = document.createElement('strong');
                  row.append(label);
                }
                context.textContent = String(item.context || '');
                label.textContent = String(item.label || '');
                return row;
              });
              element.replaceChildren(...rows);
              return;
            }
            if (value && typeof value === 'object' && value.__smu1CropProjection === true && element instanceof HTMLElement) {
              const fit = value.fit === 'contain' ? 'contain' : 'cover';
              const positionX = Math.min(100, Math.max(0, Number(value.positionX ?? 50)));
              const positionY = Math.min(100, Math.max(0, Number(value.positionY ?? 50)));
              const scale = Math.min(3, Math.max(1, Number(value.scale ?? 1)));
              element.style.setProperty('--v2-image-source-x', `${positionX}%`);
              element.style.setProperty('--v2-image-source-y', `${positionY}%`);
              element.style.setProperty('--v2-image-source-scale', String(scale));
              element.style.objectFit = fit;
              element.style.objectPosition = `${positionX}% ${positionY}%`;
              element.style.transform = `scale(${scale})`;
              element.style.transformOrigin = 'center';
              return;
            }
            if (value && typeof value === 'object' && value.__smu1RelationMediaProjection === true) {
              const bindingId = String(value.mediaBindingId || '');
              const selectorValue = window.CSS?.escape
                ? CSS.escape(bindingId)
                : bindingId.replace(/["\\]/g, '\\$&');
              const mediaElement = element.querySelector(`[data-smu1-binding-id="${selectorValue}"]`);
              const image = mediaElement instanceof HTMLImageElement
                ? mediaElement
                : mediaElement?.querySelector('img');
              if (!(image instanceof HTMLImageElement) || !validRetargetedMediaBinding(value.mediaBinding, bindingId)) return;
              mediaElement.setAttribute('data-smu1-binding', JSON.stringify(value.mediaBinding));
              if (value.item?.src) writeLiveImage(image, value.item);
              else clearLiveImage(image, { preserveGeometry: true });
              for (const position of Array.isArray(value.positions) ? value.positions : []) {
                if (/^--[a-z][a-z0-9-]*$/u.test(String(position?.cssProperty || ''))) {
                  image.style.setProperty(position.cssProperty, String(position.value || '50% 50%'));
                }
              }
              if (/^(?:\d{1,3}%|left|center|right)\s+(?:\d{1,3}%|top|center|bottom)$/u.test(String(value.objectPosition || ''))) {
                image.style.objectPosition = value.objectPosition;
              }
              return;
            }
            if (value && typeof value === 'object' && value.__smu1VideoProjection === true && element instanceof HTMLVideoElement) {
              const desktop = typeof value.desktop === 'string' ? value.desktop : '';
              const mobile = typeof value.mobile === 'string' ? value.mobile : desktop;
              element.dataset.v2DesktopSrc = desktop;
              element.dataset.v2MobileSrc = mobile;
              element.dataset.hfDesktopSrc = desktop;
              element.dataset.hfMobileSrc = mobile;
              const next = window.matchMedia('(max-width: 760px)').matches ? mobile : desktop;
              if (next && element.currentSrc !== next && element.src !== next) {
                element.src = next;
                element.load();
              }
              return;
            }
            if (value && typeof value === 'object' && value.__smu1LinkProjection === true) {
              if (element instanceof HTMLAnchorElement && typeof value.href === 'string' && value.href) element.href = value.href;
              const text = value.text == null ? '' : String(value.text);
              if (element instanceof HTMLAnchorElement) {
                const strong = element.querySelector('strong');
                const label = strong || (element.children.length === 1 ? element.firstElementChild : null);
                if (label) label.textContent = text;
                else if (!element.children.length) element.textContent = binding.hrefPath === 'telegram' ? `${text} · Telegram` : text;
              }
              return;
            }
            if (value && typeof value === 'object' && value.__smu1ListProjection === true) {
              projectListValue(element, binding, value);
              return;
            }
            if (value && typeof value === 'object' && value.__smu1MediaProjection === true && Array.isArray(value.paths)) {
              if (projectLiveGallery(element, value)) return;
              const items = (Array.isArray(value.items) ? value.items : value.paths)
                .map((item) => typeof item === 'string' ? { src: item, alt: '', caption: '' } : item)
                .filter((item) => item && typeof item.src === 'string' && item.src);
              const images = element instanceof HTMLImageElement
                ? [element]
                : Array.from(element.querySelectorAll('img'));
              element.querySelectorAll('[data-smu1-live-media]').forEach((node) => node.remove());
              images.forEach((image, index) => {
                const next = items[index];
                if (!next) clearLiveImage(image);
                else writeLiveImage(image, next);
              });
              for (const next of items.slice(images.length)) {
                const image = document.createElement('img');
                image.src = next.src;
                image.alt = next.alt || '';
                image.dataset.smu1LiveMedia = 'true';
                image.style.cssText = 'display:block;width:100%;height:auto;object-fit:cover;';
                element.append(image);
              }
              return;
            }
            if (target === 'src' && element instanceof HTMLImageElement && typeof value === 'string') {
              writeLiveImage(element, { src: value, alt: element.alt });
              return;
            }
            if (target === 'href' && element instanceof HTMLAnchorElement && typeof value === 'string') {
              element.href = value;
              return;
            }
            if (target === 'style-image' && element instanceof HTMLElement && typeof value === 'string') {
              element.style.backgroundImage = `url("${value.replace(/["\\]/g, '\\$&')}")`;
              return;
            }
            if (target === 'attribute:aria-label' && element instanceof HTMLElement && typeof value === 'string') {
              element.setAttribute('aria-label', value);
              return;
            }
            if (target === 'paragraphs' && element instanceof HTMLElement && typeof value === 'string') {
              const paragraphs = value.split(/\n{2,}/u).map((item) => item.trim()).filter(Boolean);
              element.replaceChildren(...paragraphs.map((text) => {
                const paragraph = document.createElement('p');
                paragraph.textContent = text;
                return paragraph;
              }));
              return;
            }
            if (value === null || value === undefined || typeof value === 'object') return;
            element.textContent = String(value);
          };

          window.addEventListener('message', (event) => {
            if (event.origin !== parentOrigin || event.source !== window.parent) return;
            const message = event.data;
            if (!message || message.protocol !== PROTOCOL || message.version !== VERSION) return;
            if (message.nonce !== bridgeNonce || message.revision !== bridgeRevision) return;
            if (!Number.isSafeInteger(message.sequence) || message.sequence <= inboundSequence) return;
            inboundSequence = message.sequence;
            if (message.type === 'mode') {
              mode = message.mode === 'preview' ? 'preview' : 'edit';
              document.documentElement.dataset.smu1EditorMode = mode;
              return;
            }
            if (message.type === 'request-geometry') {
              queueGeometry();
              return;
            }
            if (message.type === 'projection' && Array.isArray(message.projections)) {
              for (const projection of message.projections) {
                const selectorValue = window.CSS?.escape
                  ? CSS.escape(String(projection.bindingId || ''))
                  : String(projection.bindingId || '').replace(/["\\]/g, '\\$&');
                document.querySelectorAll(`[data-smu1-binding-id="${selectorValue}"]`).forEach((element) => {
                  const binding = parseBinding(element);
                  if (binding) projectValue(element, binding, projection.value);
                });
              }
              queueGeometry();
              return;
            }
            if (message.type === 'reorder-projection' && Array.isArray(message.orderedSlugs)) {
              const zoneId = String(message.zoneId || '');
              const rows = bindingElements().flatMap((element) => {
                const binding = parseBinding(element);
                if (!binding || binding.tool !== 'reorder-item' || String(binding.zoneId || '') !== zoneId) return [];
                const style = window.getComputedStyle(element);
                const rect = element.getBoundingClientRect();
                if (style.display === 'none' || style.visibility === 'hidden' || rect.width < 1 || rect.height < 1) return [];
                const root = element.closest('[role="listitem"]') || element;
                return [{ slug: String(binding.stableItemId || binding.recordSlug || ''), root }];
              });
              const rowBySlug = new Map(rows.map((row) => [row.slug, row]));
              const roots = message.orderedSlugs.map((slug) => rowBySlug.get(String(slug))?.root).filter(Boolean);
              const parent = roots[0]?.parentElement;
              if (parent && roots.length === rows.length && roots.every((root) => root.parentElement === parent)) {
                roots.forEach((root) => parent.append(root));
              }
              queueGeometry();
            }
          });

          window.addEventListener('scroll', queueGeometry, { passive: true });
          window.addEventListener('resize', queueGeometry, { passive: true });
          if ('ResizeObserver' in window) new ResizeObserver(queueGeometry).observe(document.documentElement);
          if ('MutationObserver' in window) new MutationObserver(queueGeometry).observe(document.body, { childList: true, subtree: true });

          const ready = () => window.requestAnimationFrame(() => window.requestAnimationFrame(() => sendGeometry('ready')));
          if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', ready, { once: true });
          else ready();
        })();
      </script>
    )}
  </body>
</html>
