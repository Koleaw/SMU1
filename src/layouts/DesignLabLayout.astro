---
import '../styles/design-lab.css';
import { withBase } from '../utils/withBase';

interface Props {
  system: 'a' | 'b' | 'c';
  title: string;
  description: string;
}

const { system, title, description } = Astro.props as Props;
---

<!doctype html>
<html lang="ru" class={`dl-html dl-html--${system}`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={system === 'a' ? '#F3F5F1' : system === 'b' ? '#F2EFE9' : '#E9E8E3'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Raleway:wght@600&family=Manrope:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href={withBase('/assets/brand/favicon.svg?v=20260911')} />
    <link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href={withBase('/assets/brand/favicon.ico?v=20260911')} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase('/assets/brand/apple-touch-icon.png?v=20260911')} />
    <title>{title}</title>
  </head>
  <body class={`design-lab-body dl-system-${system}`}>
    <slot />
  </body>
</html>
