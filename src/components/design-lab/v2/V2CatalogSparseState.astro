---
import { withBase } from '../../../utils/withBase';
import {
  categoryGalleryImages,
  categoryHasMedia,
  type ProductCategoryData
} from './catalogV2Data';
import V2DirectContact from './V2DirectContact.astro';
import V2ProductGallery from './V2ProductGallery.astro';

interface Props {
  category: ProductCategoryData;
  sectionTitle: string;
  sectionHref: string;
}

const { category, sectionTitle, sectionHref } = Astro.props as Props;
const media = categoryGalleryImages(category);
const hasMedia = categoryHasMedia(category);
const stateMessage = hasMedia
  ? 'В записи категории опубликованы описание и примеры решений. Отдельные изделия для каталога пока не опубликованы.'
  : 'В записи категории опубликовано описание. Отдельные изделия и фотоматериалы для каталога пока не опубликованы.';
---

<section class="v2-sparse-state" aria-labelledby="v2-sparse-title">
  <div class="hv2-shell">
    <header class="v2-section-heading" data-v2-reveal>
      <div>
        <p class="hv2-eyebrow">Изготовление по задаче</p>
        <h2 id="v2-sparse-title">{category.heroTitle}</h2>
      </div>
      <p>{category.heroDescription}</p>
    </header>

    <div class="hv2-grid v2-sparse-state__grid">
      <div class="v2-sparse-state__media" data-v2-reveal>
        <V2ProductGallery
          images={media}
          title={category.title}
          imageView={category.imageView}
          entityLabel="категории"
        />
      </div>
      <div class="v2-sparse-state__content" data-v2-reveal>
        <p>{stateMessage}</p>
        <p>Для обсуждения пришлите размеры, фотографию, эскиз, чертёж или техническое задание.</p>
        <a class="hv2-text-link" href={withBase(sectionHref)}>
          Все направления: {sectionTitle}<span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
</section>

<V2DirectContact
  eyebrow="Прямая связь"
  title="Обсудим конструкцию по вашим вводным"
  description={category.heroDescription}
  primaryLabel="Обсудить задачу"
  secondaryLabel=""
/>
