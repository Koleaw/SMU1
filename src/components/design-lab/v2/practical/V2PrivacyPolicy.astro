---
import productionPolicySource from '../../../../pages/politika-konfidencialnosti/index.astro?raw';
import V2Breadcrumbs from '../V2Breadcrumbs.astro';

const normalizedSource = productionPolicySource.replace(/\r\n/g, '\n');
const startMarker = '<div class="container policy-page__container">';
const endMarker = '\n    </div>\n  </section>';
const contentStart = normalizedSource.indexOf(startMarker);
const contentEnd = normalizedSource.lastIndexOf(endMarker);

if (contentStart < 0 || contentEnd < 0 || contentEnd <= contentStart) {
  throw new Error('Не удалось извлечь исходный текст политики конфиденциальности.');
}

const policyMarkup = normalizedSource
  .slice(contentStart + startMarker.length, contentEnd)
  .trim();
---

<V2Breadcrumbs items={[
  { title: 'Главная', href: '/design-lab/home-v2/' },
  { title: 'Политика конфиденциальности и обработки персональных данных' }
]} />

<article class="practical-legal">
  <div class="hv2-shell practical-legal__layout">
    <aside class="practical-legal__aside" aria-label="О документе" data-v2-reveal>
      <p class="hv2-eyebrow">Юридический документ</p>
      <p>Политика конфиденциальности и обработки персональных данных ООО «СМУ 1».</p>
    </aside>
    <section class="practical-legal__document" set:html={policyMarkup} data-v2-reveal />
  </div>
</article>
