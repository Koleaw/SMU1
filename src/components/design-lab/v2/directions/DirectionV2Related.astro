---
import { withBase } from '../../../../utils/withBase';

interface RelatedItem {
  eyebrow?: string;
  title: string;
  description?: string;
  href: string;
}

interface Props {
  title?: string;
  items: RelatedItem[];
  variant?: 'default' | 'compact';
}

const { title = 'Связанные направления', items, variant = 'default' } = Astro.props as Props;
const href = (value: string) => /^(?:#|https?:|mailto:|tel:)/i.test(value) ? value : withBase(value);
---

{items.length > 0 && (
  <section class:list={['direction-related', `direction-related--${variant}`]} aria-labelledby="direction-related-title">
    <div class="hv2-shell">
      <header class="direction-section-heading direction-section-heading--compact" data-v2-reveal>
        <div>
          <p class="hv2-eyebrow">Дальше по задаче</p>
          <h2 id="direction-related-title">{title}</h2>
        </div>
      </header>
      <div class="direction-related__grid" role="list">
        {items.map((item) => (
          <a class="direction-related__card" href={href(item.href)} role="listitem" data-v2-reveal>
            <span>{item.eyebrow || 'Направление'}</span>
            <h3>{item.title}</h3>
            {item.description && <p>{item.description}</p>}
            <i aria-hidden="true">↗</i>
          </a>
        ))}
      </div>
    </div>
  </section>
)}
