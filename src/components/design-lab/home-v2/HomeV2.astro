---
import { withBase } from '../../../utils/withBase';
import settings from '../../../content/site-settings/global.json';
import HomeV2Header from './HomeV2Header.astro';
import HomeV2Projects from './HomeV2Projects.astro';
import HomeV2Footer from './HomeV2Footer.astro';

const path = (value: string) => withBase(value);
const regionLine = settings.regions.join(' · ');
---

<div class="home-v2" data-home-v2-root>
  <HomeV2Header currentPath="/design-lab/home-v2/" catalogV2 />

  <main>
    <section class="hv2-hero" aria-labelledby="home-v2-title" data-hv2-hero>
      <span class="hv2-hero__header-sentinel" aria-hidden="true" data-home-v2-header-sentinel></span>
      <div class="hv2-hero__media" aria-hidden="true">
        <picture class="hv2-hero__poster">
          <source media="(max-width: 700px)" srcset={path('/assets/images/hero-posters/home-hero-mobile-poster.jpg')} />
          <img
            src={path('/assets/images/hero-posters/home-hero-desktop-poster.jpg')}
            alt=""
            width="1920"
            height="1080"
            loading="eager"
            fetchpriority="high"
          />
        </picture>
        <video
          class="hv2-hero__video"
          muted
          loop
          playsinline
          preload="metadata"
          poster={path('/assets/images/hero-posters/home-hero-desktop-poster.jpg')}
          data-hv2-hero-video
          data-autoplay="true"
        >
          <source src={path('/uploads/hero-home-mobile.mp4')} type="video/mp4" media="(max-width: 700px)" />
          <source src={path('/uploads/media-1779034941013.mp4')} type="video/mp4" />
        </video>
        <div class="hv2-hero__veil"></div>
      </div>

      <div class="hv2-shell hv2-hero__content">
        <div class="hv2-hero__copy" data-reveal>
          <p class="hv2-eyebrow hv2-eyebrow--light">СМУ-1 · Курган</p>
          <h1 id="home-v2-title">Изделия, конструкции и комплексные работы на объекте</h1>
          <p class="hv2-hero__lead">
            Изготавливаем изделия и конструкции, выполняем металлоконструкции,
            строительно-монтажные работы и комплексное благоустройство.
          </p>
          <div class="hv2-actions">
            <a class="hv2-button hv2-button--primary" href="#contact">
              Получить расчёт <span aria-hidden="true">↗</span>
            </a>
            <a class="hv2-button hv2-button--ghost" href={path('/design-lab/v2/vypolnennye-obekty/')}>Смотреть объекты</a>
          </div>
        </div>

        <nav class="hv2-hero__quick" aria-label="Быстрые переходы">
          <a href={path('/design-lab/v2/metallokonstruktsii-dlya-biznesa/')}>Металлоконструкции <span aria-hidden="true">↗</span></a>
          <a href={path('/design-lab/v2/stroitelstvo-i-remonty/')}>Строительство <span aria-hidden="true">↗</span></a>
          <a href="#directions">Все направления <span aria-hidden="true">↓</span></a>
        </nav>
      </div>
    </section>

    <nav class="hv2-section-nav" aria-label="Навигация по главной" data-hv2-section-nav>
      <div class="hv2-shell hv2-section-nav__inner">
        <p><span aria-hidden="true"></span> По странице</p>
        <div>
          <a href="#directions" aria-current="location" data-hv2-section-link="directions">Направления</a>
          <a href="#projects" data-hv2-section-link="projects">Объекты</a>
          <a href="#brief" data-hv2-section-link="brief">Как начать</a>
          <a href="#contact" data-hv2-section-link="contact">Контакты</a>
        </div>
      </div>
    </nav>

    <section class="hv2-positioning" aria-labelledby="home-v2-positioning-title">
      <div class="hv2-shell hv2-grid">
        <p class="hv2-eyebrow">СМУ-1 в одной фразе</p>
        <h2 id="home-v2-positioning-title">Работаем с изделием, конструкцией и объектом целиком.</h2>
        <p>
          Доступны каталожные решения и работа по фото, размерам, эскизу, чертежу или ТЗ.
          Масштаб задач включает уличную мебель, металлоконструкции, благоустройство и строительство.
        </p>
      </div>
    </section>

    <section class="hv2-competencies" id="directions" aria-labelledby="home-v2-directions-title">
      <div class="hv2-shell">
        <header class="hv2-section-head hv2-grid" data-reveal>
          <div>
            <p class="hv2-eyebrow">Семь компетенций</p>
            <h2 id="home-v2-directions-title">От предметного решения до строительного объекта</h2>
          </div>
          <p>
            Каждое направление ведёт в существующий раздел с описанием работ,
            вариантами изделий или вводными для расчёта.
          </p>
        </header>

        <div class="hv2-competency-map hv2-grid">
          <a
            class="hv2-competency hv2-competency--construction hv2-competency--media"
            href={path('/design-lab/v2/stroitelstvo-i-remonty/')}
            data-reveal
          >
            <img
              src={path('/uploads/img-20250724-134235-1783272745917.jpg')}
              alt="Внешний вид собранного здания цеха"
              width="1920"
              height="1200"
              loading="lazy"
              decoding="async"
            />
            <span class="hv2-competency__veil"></span>
            <span class="hv2-competency__body">
              <span class="hv2-eyebrow hv2-eyebrow--light">Объектные работы</span>
              <strong>Строительство и ремонты</strong>
              <span>Основания, монтаж и работы по ТЗ — до подтверждённой сборки зданий и производственных цехов.</span>
              <span class="hv2-competency__link">Открыть направление <i aria-hidden="true">↗</i></span>
            </span>
          </a>

          <a
            class="hv2-competency hv2-competency--metals hv2-competency--media"
            href={path('/design-lab/v2/metallokonstruktsii-dlya-biznesa/')}
            data-reveal
          >
            <img
              src={path('/uploads/img-20250724-134010-1783272745899.jpg')}
              alt="Металлический каркас строящегося здания"
              width="1920"
              height="1200"
              loading="lazy"
              decoding="async"
            />
            <span class="hv2-competency__veil"></span>
            <span class="hv2-competency__body">
              <span class="hv2-eyebrow hv2-eyebrow--light">Конструкции под объект</span>
              <strong>Металлоконструкции</strong>
              <span>Каркасы, рамы, площадки, лестницы, опорные элементы и конструкции по чертежам.</span>
              <span class="hv2-competency__link">Открыть направление <i aria-hidden="true">↗</i></span>
            </span>
          </a>

          <a
            class="hv2-competency hv2-competency--furniture hv2-competency--media"
            href={path('/design-lab/v2/ulichnaya-mebel/')}
            data-reveal
          >
            <img
              src={path('/uploads/project-05e1cb18f1d596a46bdacc90.jpg')}
              alt="Городские качели из металла и дерева"
              width="1920"
              height="1200"
              loading="lazy"
              decoding="async"
            />
            <span class="hv2-competency__veil"></span>
            <span class="hv2-competency__body">
              <span class="hv2-eyebrow hv2-eyebrow--light">Каталог и адаптация</span>
              <strong>Уличная мебель</strong>
              <span>Серийные и адаптируемые решения для общественных и коммерческих территорий.</span>
              <span class="hv2-competency__link">Перейти в каталог <i aria-hidden="true">↗</i></span>
            </span>
          </a>

          <a
            class="hv2-competency hv2-competency--fences hv2-competency--media"
            href={path('/design-lab/v2/ograzhdeniya-i-zabory/')}
            data-reveal
          >
            <img
              src={path('/uploads/project-248f17177df30b29ab9b231a.jpg')}
              alt="Ограждение на набережной реки Тобол"
              width="1920"
              height="1200"
              loading="lazy"
              decoding="async"
            />
            <span class="hv2-competency__veil"></span>
            <span class="hv2-competency__body">
              <span class="hv2-eyebrow hv2-eyebrow--light">Под конкретный объект</span>
              <strong>Ограждения и заборы</strong>
              <span>Заборы, ворота, калитки, перила, поручни и входные группы.</span>
              <span class="hv2-competency__link">Открыть направление <i aria-hidden="true">↗</i></span>
            </span>
          </a>

          <div class="hv2-competency-stack">
            <a class="hv2-competency hv2-competency--graphic hv2-competency--canopies" href={path('/design-lab/v2/navesy-i-kozyrki/')} data-reveal>
              <span class="hv2-competency__drawing hv2-competency__drawing--canopy" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="hv2-competency__body">
                <span class="hv2-eyebrow">Конструкция под размеры</span>
                <strong>Навесы и козырьки</strong>
                <span>Для входных групп, зон ожидания, велопарковок и хозяйственных площадок.</span>
                <span class="hv2-competency__link">Открыть направление <i aria-hidden="true">↗</i></span>
              </span>
            </a>

            <a class="hv2-competency hv2-competency--graphic hv2-competency--topiary" href={path('/design-lab/v2/topiarii/')} data-reveal>
              <span class="hv2-competency__drawing hv2-competency__drawing--topiary" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="hv2-competency__body">
                <span class="hv2-eyebrow">Для территории</span>
                <strong>Топиарии</strong>
                <span>Декоративные фигуры, зелёные композиции и арт-объекты под задачу пространства.</span>
                <span class="hv2-competency__link">Открыть направление <i aria-hidden="true">↗</i></span>
              </span>
            </a>
          </div>

          <a
            class="hv2-competency hv2-competency--landscape hv2-competency--media"
            href={path('/design-lab/v2/blagoustroystvo-territoriy/')}
            data-reveal
          >
            <img
              src={path('/uploads/project-da0872c68d9a09f0a7d2f995.jpg')}
              alt="Благоустроенная набережная с лестницей, лавочками и ограждениями"
              width="1920"
              height="1200"
              loading="lazy"
              decoding="async"
            />
            <span class="hv2-competency__veil"></span>
            <span class="hv2-competency__body">
              <span class="hv2-eyebrow hv2-eyebrow--light">Территория целиком</span>
              <strong>Благоустройство территорий</strong>
              <span>Дворы, входные группы, зоны отдыха и хозяйственные площадки с подбором конструкций и монтажом.</span>
              <span class="hv2-competency__link">Открыть направление <i aria-hidden="true">↗</i></span>
            </span>
          </a>
        </div>
      </div>
    </section>

    <section class="hv2-projects" id="projects" aria-labelledby="home-v2-projects-title">
      <div class="hv2-shell">
        <header class="hv2-section-head hv2-section-head--projects hv2-grid" data-reveal>
          <div>
            <p class="hv2-eyebrow hv2-eyebrow--light">Выполненные объекты</p>
            <h2 id="home-v2-projects-title">Результаты разного масштаба — в реальных фотографиях</h2>
          </div>
          <div>
            <p>
              Городской объект, отдельная конструкция и подтверждённый строительный результат.
              В каждой карточке сохранён просмотр нескольких кадров.
            </p>
            <a class="hv2-text-link hv2-text-link--light" href={path('/design-lab/v2/vypolnennye-obekty/')}>
              Все выполненные объекты <span aria-hidden="true">↗</span>
            </a>
          </div>
        </header>

        <HomeV2Projects />
      </div>
    </section>

    <section class="hv2-brief" id="brief" aria-labelledby="home-v2-brief-title">
      <div class="hv2-shell hv2-brief__layout hv2-grid">
        <div class="hv2-brief__intro" data-reveal>
          <p class="hv2-eyebrow">Как начать работу</p>
          <h2 id="home-v2-brief-title">Пришлите то, что уже есть</h2>
          <p>
            Для первого разговора не нужен готовый комплект документов. Опишите задачу и приложите доступные вводные —
            по ним можно уточнить формат решения и расчёта.
          </p>
          <a class="hv2-text-link" href={path('/design-lab/v2/izgotovlenie-na-zakaz/')}>
            Изготовление на заказ <span aria-hidden="true">↗</span>
          </a>
        </div>

        <ul class="hv2-brief__inputs" aria-label="Что можно прислать" data-reveal>
          <li><span>Описание задачи</span><i aria-hidden="true">Текст</i></li>
          <li><span>Фотографию</span><i aria-hidden="true">JPG / PNG</i></li>
          <li><span>Размеры</span><i aria-hidden="true">Габариты</i></li>
          <li><span>Эскиз</span><i aria-hidden="true">Идея</i></li>
          <li><span>Чертёж</span><i aria-hidden="true">Документ</i></li>
          <li><span>Техническое задание</span><i aria-hidden="true">ТЗ</i></li>
        </ul>
      </div>
    </section>

    <section class="hv2-contact" id="contact" aria-labelledby="home-v2-contact-title">
      <div class="hv2-shell hv2-contact__grid hv2-grid">
        <div class="hv2-contact__intro" data-reveal>
          <p class="hv2-eyebrow hv2-eyebrow--light">Прямая связь</p>
          <h2 id="home-v2-contact-title">Обсудим ваш объект или конструкцию</h2>
          <p>Свяжемся, уточним задачу и подготовим расчёт.</p>
          <div class="hv2-actions">
            <a class="hv2-button hv2-button--light" href={settings.telegram} target="_blank" rel="noopener noreferrer">
              Написать в Telegram <span aria-hidden="true">↗</span>
            </a>
            <a class="hv2-button hv2-button--contrast" href={path('/design-lab/v2/kontakty/')}>Все контакты</a>
          </div>
        </div>

        <div class="hv2-contact__channels" data-reveal>
          <a href={`tel:${settings.phonePrimary.replace(/[^+\d]/g, '')}`}>
            <span>Основной телефон</span><strong>{settings.phonePrimary}</strong><i aria-hidden="true">↗</i>
          </a>
          <a href={`tel:${settings.phoneSecondary.replace(/[^+\d]/g, '')}`}>
            <span>Руководитель</span><strong>{settings.phoneSecondary}</strong><i aria-hidden="true">↗</i>
          </a>
          <a href={settings.telegram} target="_blank" rel="noopener noreferrer">
            <span>Telegram</span><strong>{settings.telegramLabel}</strong><i aria-hidden="true">↗</i>
          </a>
          <a href={`mailto:${settings.email}`}>
            <span>Электронная почта</span><strong>{settings.email}</strong><i aria-hidden="true">↗</i>
          </a>
          <div>
            <span>Адрес</span><strong>{settings.address}</strong>
          </div>
          <div>
            <span>География</span><strong>{regionLine}</strong>
          </div>
        </div>
      </div>
    </section>
  </main>

  <HomeV2Footer currentPath="/design-lab/home-v2/" catalogV2 />

  <aside class="hv2-palette-switch" aria-label="Переключатель цветовой схемы">
    <p>Цветовая схема</p>
    <div role="group" aria-label="Цветовой пресет">
      <button type="button" aria-pressed="true" data-hv2-palette="olive">Оливковая</button>
      <button type="button" aria-pressed="false" data-hv2-palette="steel">Стальная</button>
    </div>
  </aside>
</div>

<script>
  const initHomeV2Page = () => {
    const root = document.querySelector<HTMLElement>('[data-home-v2-root]');
    if (!root || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';

    const documentRoot = document.documentElement;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const hero = document.querySelector<HTMLElement>('[data-hv2-hero]');
    const video = document.querySelector<HTMLVideoElement>('[data-hv2-hero-video]');
    let playAttempted = false;
    let pausedForVisibility = false;

    const showPoster = () => hero?.classList.remove('is-video-playing');
    const playHeroVideo = () => {
      if (!video || reducedMotion.matches || playAttempted) return;
      playAttempted = true;
      video.muted = true;
      video.defaultMuted = true;
      video.playsInline = true;
      video.autoplay = true;
      const playPromise = video.play();
      if (playPromise && typeof playPromise.catch === 'function') {
        playPromise.catch(showPoster);
      }
    };

    if (video) {
      video.addEventListener('playing', () => hero?.classList.add('is-video-playing'));
      video.addEventListener('error', showPoster);
      video.addEventListener('stalled', () => {
        if (!video.currentSrc) showPoster();
      });

      if (reducedMotion.matches) {
        video.autoplay = false;
        video.pause();
        showPoster();
      } else {
        requestAnimationFrame(playHeroVideo);
      }

      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'hidden' && !video.paused) {
          pausedForVisibility = true;
          video.pause();
        } else if (
          document.visibilityState === 'visible' &&
          pausedForVisibility &&
          !reducedMotion.matches
        ) {
          pausedForVisibility = false;
          video.play().catch(showPoster);
        }
      });

      reducedMotion.addEventListener('change', () => {
        if (reducedMotion.matches) {
          video.autoplay = false;
          video.pause();
          showPoster();
        } else if (!playAttempted) {
          playHeroVideo();
        }
      });
    }

    const paletteButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-hv2-palette]'));
    const themeColor = document.querySelector<HTMLMetaElement>('[data-home-v2-theme-color]');
    const setPalette = (palette: 'olive' | 'steel') => {
      documentRoot.dataset.homeV2Theme = palette;
      paletteButtons.forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.hv2Palette === palette));
      });
      themeColor?.setAttribute('content', palette === 'steel' ? '#F2EFE9' : '#F3F5F1');
      try {
        window.localStorage.setItem('smu1-home-v2-palette', palette);
      } catch {
        // The comparison still works when storage is unavailable.
      }
    };

    const initialPalette = documentRoot.dataset.homeV2Theme === 'steel' ? 'steel' : 'olive';
    setPalette(initialPalette);
    paletteButtons.forEach((button) => {
      button.addEventListener('click', () => setPalette(button.dataset.hv2Palette === 'steel' ? 'steel' : 'olive'));
    });

    const sectionNav = document.querySelector<HTMLElement>('[data-hv2-section-nav]');
    const sectionLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-hv2-section-link]'));
    const sections = sectionLinks
      .map((link) => {
        const id = link.dataset.hv2SectionLink || '';
        const element = document.getElementById(id);
        return element ? { id, element } : null;
      })
      .filter((item): item is { id: string; element: HTMLElement } => Boolean(item));

    const syncSectionNavigation = () => {
      const headerHeight = document.querySelector<HTMLElement>('[data-home-v2-header]')?.offsetHeight || 0;
      const navHeight = sectionNav?.offsetHeight || 0;
      const threshold = headerHeight + navHeight + 40;
      let activeId = sections[0]?.id;
      sections.forEach((section) => {
        if (section.element.getBoundingClientRect().top <= threshold) activeId = section.id;
      });
      if (!activeId) return;
      sectionLinks.forEach((link) => {
        if (link.dataset.hv2SectionLink === activeId) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    };

    window.addEventListener('scroll', syncSectionNavigation, { passive: true });
    window.addEventListener('resize', syncSectionNavigation);
    syncSectionNavigation();

    const revealElements = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
    if (!reducedMotion.matches && 'IntersectionObserver' in window) {
      try {
        const revealObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.remove('hv2-reveal-pending');
            entry.target.classList.add('hv2-reveal-visible');
            revealObserver.unobserve(entry.target);
          });
        }, { rootMargin: '0px 0px -9% 0px', threshold: 0.08 });

        revealElements.forEach((element, index) => {
          const rect = element.getBoundingClientRect();
          if (rect.top < window.innerHeight * 0.94) {
            element.classList.add('hv2-reveal-visible');
            return;
          }
          element.style.setProperty('--hv2-reveal-delay', `${Math.min((index % 4) * 55, 165)}ms`);
          element.classList.add('hv2-reveal-pending');
          revealObserver.observe(element);
        });
      } catch {
        revealElements.forEach((element) => element.classList.remove('hv2-reveal-pending'));
      }
    }
  };

  initHomeV2Page();
  document.addEventListener('astro:page-load', initHomeV2Page);
</script>
