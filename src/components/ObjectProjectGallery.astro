---
import { withBase } from '../utils/withBase';
import type { ProjectImage } from '../utils/projectImages';

type Props = {
  title: string;
  images: ProjectImage[];
};

const { title, images } = Astro.props;
const initial = images[0];
const hasImages = Boolean(initial);
const hasMultipleImages = images.length > 1;
---

<div class="object-gallery" data-object-gallery aria-label={`Галерея объекта: ${title}`}>
  <div class="object-gallery__stage">
    {hasImages ? (
      <figure class="object-gallery__active" data-gallery-active>
        <img class="object-media-bg" data-gallery-bg src={withBase(initial.src)} alt="" loading="eager" decoding="async" aria-hidden="true" />
        <img class="object-media-fg" data-gallery-image src={withBase(initial.src)} alt={initial.alt || title} loading="eager" decoding="async" fetchpriority="high" />
        <figcaption data-gallery-caption hidden={!initial.caption}>{initial.caption || ''}</figcaption>
      </figure>
    ) : (
      <div class="object-placeholder object-placeholder--gallery">
        <span>Фото объекта будет добавлено позже</span>
      </div>
    )}

    {hasMultipleImages && (
      <>
        <button class="object-gallery-arrow object-gallery-arrow--prev" type="button" data-gallery-prev aria-label="Предыдущее фото"><span aria-hidden="true">‹</span></button>
        <button class="object-gallery-arrow object-gallery-arrow--next" type="button" data-gallery-next aria-label="Следующее фото"><span aria-hidden="true">›</span></button>
      </>
    )}
  </div>

  {hasMultipleImages && (
    <div class="object-gallery__thumbs" aria-label="Миниатюры галереи">
      {images.map((image, index) => (
        <button
          class={`object-gallery__thumb ${index === 0 ? 'is-active' : ''}`}
          type="button"
          data-gallery-thumb={index}
          data-gallery-src={withBase(image.src)}
          data-gallery-alt={image.alt || title}
          data-gallery-caption={image.caption || ''}
          aria-label={`Показать фото ${index + 1}`}
        >
          <img class="object-gallery__thumb-img" src={withBase(image.src)} alt="" loading="lazy" decoding="async" />
        </button>
      ))}
    </div>
  )}
</div>

<script>
  (() => {
    const initGallery = (gallery: Element) => {
      if (!(gallery instanceof HTMLElement) || gallery.dataset.objectGalleryReady === 'true') return;
      gallery.dataset.objectGalleryReady = 'true';

      const thumbs = Array.from(gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]'));
      const background = gallery.querySelector<HTMLImageElement>('[data-gallery-bg]');
      const image = gallery.querySelector<HTMLImageElement>('[data-gallery-image]');
      const caption = gallery.querySelector<HTMLElement>('[data-gallery-caption]');
      const prev = gallery.querySelector<HTMLButtonElement>('[data-gallery-prev]');
      const next = gallery.querySelector<HTMLButtonElement>('[data-gallery-next]');
      let index = 0;

      const show = (nextIndex: number) => {
        if (!thumbs.length || !background || !image) return;
        index = (nextIndex + thumbs.length) % thumbs.length;
        const thumb = thumbs[index];
        const src = thumb.dataset.gallerySrc || '';
        if (src && image.src !== new URL(src, window.location.href).href) {
          background.src = src;
          image.src = src;
        }
        image.alt = thumb.dataset.galleryAlt || '';
        if (caption) {
          caption.textContent = thumb.dataset.galleryCaption || '';
          caption.hidden = !caption.textContent;
        }
        thumbs.forEach((item, thumbIndex) => {
          item.classList.toggle('is-active', thumbIndex === index);
          item.setAttribute('aria-current', thumbIndex === index ? 'true' : 'false');
        });
      };

      prev?.addEventListener('click', () => show(index - 1));
      next?.addEventListener('click', () => show(index + 1));
      thumbs.forEach((thumb, thumbIndex) => thumb.addEventListener('click', () => show(thumbIndex)));
      show(0);
    };

    const initGalleries = () => document.querySelectorAll('[data-object-gallery]').forEach(initGallery);
    initGalleries();
    document.addEventListener('astro:page-load', initGalleries);
  })();
</script>
