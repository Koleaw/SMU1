---
import { v2Href as resolveV2Href } from '../../../utils/v2Routes';
import { imageViewStyle } from '../catalogV2Data';
import V2Breadcrumbs from '../V2Breadcrumbs.astro';
import V2ResponsiveImage from '../V2ResponsiveImage.astro';
import { resolveV2ResponsiveMedia } from '../../../utils/v2ResponsiveMedia';
import { adminBinding, adminDisposition } from '../../../admin/bindings/adminBinding';

interface BreadcrumbItem {
  title: string;
  href?: string;
}

interface Props {
  variant: 'metalworks' | 'landscaping' | 'construction' | 'canopies' | 'topiary';
  breadcrumbs: BreadcrumbItem[];
  eyebrow: string;
  title: string;
  description: string;
  image?: string;
  imageAlt: string;
  imageView?: { fit?: 'cover' | 'contain'; positionX?: number; positionY?: number; scale?: number };
  caption?: string;
  titleId?: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  productFinalHandoff?: boolean;
  bindingOwner?: { collection: string; slug: string };
  bindingFields?: { eyebrow?: string; title?: string; description?: string; image?: string; primaryLabel?: string; secondaryLabel?: string };
  bindingScope?: 'local' | 'shared' | 'global' | 'legal' | 'derived';
  affectedRoutes?: string[];
  editorSource?: string;
  mediaBinding?: {
    owner: { collection: string; slug: string };
    fieldPath: string;
    scope?: 'local' | 'shared' | 'global' | 'legal' | 'derived';
    affectedRoutes?: string[];
    projection?: { kind?: string; formula?: string; target?: string; fallback?: string };
  };
}

const {
  variant,
  breadcrumbs,
  eyebrow,
  title,
  description,
  image = '',
  imageAlt,
  imageView,
  caption = '',
  titleId = 'immersive-direction-title',
  primaryHref = '#contact',
  primaryLabel = 'Получить расчёт',
  secondaryHref = '#direction-brief',
  secondaryLabel = 'Обсудить задачу',
  productFinalHandoff = false
} = Astro.props as Props;

const withBase = (value: string) => resolveV2Href(value, Astro.url.pathname);
const href = (value: string) => /^(?:#|https?:|mailto:|tel:)/i.test(value) ? value : withBase(value);
const mediaFit = imageView?.fit || 'cover';
const mediaPositionX = imageView?.positionX ?? 50;
const mediaPositionY = imageView?.positionY ?? 50;
const mediaScale = imageView?.scale ?? 1;
const mediaStyle = [
  imageViewStyle(imageView),
  productFinalHandoff
    ? `--direction-hero-image-fit:${mediaFit};--direction-hero-image-x:${mediaPositionX}%;--direction-hero-image-y:${mediaPositionY}%;--direction-hero-image-scale:${mediaScale};`
    : ''
].join('');
const responsiveMedia = image ? resolveV2ResponsiveMedia(image, 'hero') : null;
const isolatedMedia = variant === 'canopies' || variant === 'topiary';
const transitionPlaceholder = isolatedMedia
  ? (responsiveMedia?.fallback.find((candidate) => candidate.width >= 768) ?? responsiveMedia?.fallback.at(-1))
  : (responsiveMedia?.fallback.find((candidate) => candidate.width >= 1440) ?? responsiveMedia?.fallback.at(-1));
const heroSizes = isolatedMedia ? '(max-width: 760px) 100vw, 52vw' : '100vw';
const transitionPlaceholderStyle = transitionPlaceholder
  ? [
      `--v2-transition-placeholder-fit:${isolatedMedia ? 'contain' : mediaFit}`,
      `--v2-transition-placeholder-x:${isolatedMedia ? 50 : mediaPositionX}%`,
      `--v2-transition-placeholder-y:${isolatedMedia ? 50 : mediaPositionY}%`,
      `--v2-transition-placeholder-scale:${mediaScale}`
    ].join(';')
  : undefined;
const bindingOwner = Astro.props.bindingOwner;
const bindingFields = Astro.props.bindingFields ?? {};
const affectedRoutes = Astro.props.affectedRoutes ?? [Astro.url.pathname];
const editorSource = Astro.props.editorSource ?? 'src/components/v2/directions/ImmersiveDirectionHero.astro#Astro.props';
const binding = (fieldPath: string | undefined, tool: string, options: Record<string, unknown> = {}) => fieldPath && bindingOwner
  ? adminBinding(Astro.url, {
      renderer: { family: 'direction-hero', variant }, owner: bindingOwner, fieldPath,
      stableItemId: `${bindingOwner.slug}-hero-${fieldPath}`, scope: Astro.props.bindingScope ?? 'local',
      tool, affectedRoutes, ...options
    })
  : {};
const editableOrDeclared = (
  fieldPath: string | undefined,
  tool: string,
  fragment: string,
  reason: string
) => fieldPath && bindingOwner
  ? binding(fieldPath, tool)
  : adminDisposition(Astro.url, {
      kind: 'contextual',
      reason,
      source: `${editorSource}#${fragment}`,
      tool: 'page-settings'
    });
const breadcrumbDisposition = adminDisposition(Astro.url, {
  kind: 'derived',
  reason: 'Хлебные крошки отражают каноническую иерархию route и название текущей записи; они не являются отдельной копией текста.',
  source: `${editorSource}#breadcrumbs`,
  tool: 'page-settings'
});
const mediaBinding = Astro.props.mediaBinding;
const mediaBindingAttributes = mediaBinding ? adminBinding(Astro.url, {
  renderer: { family: 'direction-hero', variant }, owner: mediaBinding.owner,
  fieldPath: mediaBinding.fieldPath, stableItemId: `${mediaBinding.owner.slug}-direction-hero-media`,
  role: 'hero-media', scope: mediaBinding.scope ?? 'shared', tool: 'media',
  affectedRoutes: mediaBinding.affectedRoutes ?? affectedRoutes,
  projection: mediaBinding.projection, multiple: false
}) : binding(bindingFields.image, 'media', { role: 'hero-media', multiple: false });
---

<section
  class:list={[
    'immersive-direction-hero',
    `immersive-direction-hero--${variant}`,
    `immersive-direction-hero--media-${mediaFit}`,
    {
      'immersive-direction-hero--no-media': !image,
      'immersive-direction-hero--product-final': productFinalHandoff
    }
  ]}
  aria-labelledby={titleId}
  data-immersive-direction-hero={productFinalHandoff ? undefined : ''}
  data-v2-hero-scroll={productFinalHandoff ? undefined : ''}
  data-product-final-hero={productFinalHandoff ? '' : undefined}
  data-product-final-track={productFinalHandoff ? '' : undefined}
>
  <span class="immersive-direction-hero__sentinel" aria-hidden="true" data-home-v2-header-sentinel></span>

  <div class="hv2-shell immersive-direction-hero__inner">
    <div class="immersive-direction-hero__breadcrumbs" data-v2-reveal data-v2-reveal-stage="breadcrumbs" data-v2-entrance-role="context" {...breadcrumbDisposition}>
      <V2Breadcrumbs items={breadcrumbs} />
    </div>

    <div class="immersive-direction-hero__composition">
      <div
        class="immersive-direction-hero__copy"
        data-v2-hero-scroll-copy={productFinalHandoff ? undefined : ''}
        data-v2-page-handoff="copy"
      >
        <p class="hv2-eyebrow hv2-eyebrow--light" data-v2-reveal data-v2-reveal-stage="eyebrow" data-v2-entrance-role="context" {...editableOrDeclared(bindingFields.eyebrow, 'short-text', 'eyebrow', 'Надзаголовок передан renderer-владельцем; прямое редактирование доступно, когда владелец указывает schema field.')}>{eyebrow}</p>
        <h1 id={titleId} data-v2-reveal data-v2-reveal-stage="title" data-v2-entrance-role="title-primary" {...editableOrDeclared(bindingFields.title, 'heading', 'title', 'Заголовок передан renderer-владельцем; прямое редактирование доступно, когда владелец указывает schema field.')}>{title}</h1>
        <p class="immersive-direction-hero__lead" data-v2-reveal data-v2-reveal-stage="description" data-v2-entrance-role="lead" {...editableOrDeclared(bindingFields.description, 'long-text', 'description', 'Описание передано renderer-владельцем; прямое редактирование доступно, когда владелец указывает schema field.')}>{description}</p>
        <div class="hv2-actions immersive-direction-hero__actions" data-v2-reveal data-v2-reveal-stage="actions" data-v2-entrance-role="actions-meta">
          <a class="hv2-button hv2-button--primary" href={href(primaryHref)} {...editableOrDeclared(
            bindingFields.primaryLabel,
            'link-label',
            'primaryLabel',
            'Подпись главного действия задана renderer-композицией; отдельного поля текущей записи для неё нет.'
          )}>
            {primaryLabel}
          </a>
          <a class="hv2-button hv2-button--ghost" href={href(secondaryHref)} {...editableOrDeclared(
            bindingFields.secondaryLabel,
            'link-label',
            'secondaryLabel',
            'Подпись перехода к proof-секции задана renderer-композицией и зависит от наличия этой секции.'
          )}>
            {secondaryLabel}
          </a>
        </div>
      </div>
    </div>
  </div>

  {image ? (
    <figure
      class="immersive-direction-hero__media"
      data-v2-media
      data-v2-hero-scroll-media={productFinalHandoff ? undefined : ''}
      data-v2-reveal
      data-v2-reveal-stage="media"
      data-v2-entrance-role="media"
      data-v2-transition-placeholder={transitionPlaceholder ? '' : undefined}
      data-v2-transition-placeholder-src={transitionPlaceholder ? withBase(transitionPlaceholder.path) : undefined}
      style={transitionPlaceholderStyle}
      {...mediaBindingAttributes}
    >
      <span class="v2-transition-media-placeholder" data-v2-transition-placeholder-layer aria-hidden="true"></span>
      <script is:inline>
        (() => {
          const script = document.currentScript;
          const host = script?.parentElement;
          if (document.documentElement.dataset.v2PageBootstrap === 'arrival'
            && document.documentElement.dataset.v2MotionProfile === 'normal'
            && host?.hasAttribute('data-v2-transition-placeholder')) {
            const layer = host.querySelector('[data-v2-transition-placeholder-layer]');
            const url = host.dataset.v2TransitionPlaceholderSrc;
            if (url && layer) {
              const preload = new Image();
              host.dataset.v2TransitionPlaceholderPreload = 'loading';
              preload.alt = '';
              preload.setAttribute('aria-hidden', 'true');
              preload.setAttribute('role', 'presentation');
              preload.dataset.v2TransitionPlaceholderImage = '';
              preload.dataset.v2ImageReadinessIgnore = '';
              preload.decoding = 'async';
              preload.addEventListener('load', () => {
                host.dataset.v2TransitionPlaceholderPreload = 'ready';
              }, { once: true });
              preload.addEventListener('error', () => {
                host.dataset.v2TransitionPlaceholderPreload = 'error';
                preload.remove();
              }, { once: true });
              layer.append(preload);
              preload.src = url;
            }
          }
          script?.remove();
        })();
      </script>
      <V2ResponsiveImage
        src={image}
        alt={imageAlt || title}
        role="hero"
        sizes={heroSizes}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        style={mediaStyle}
        data-v2-image
        data-v2-page-critical
      />
      <div class="immersive-direction-hero__fallback" aria-hidden="true"></div>
      {caption && <figcaption {...adminDisposition(Astro.url, {
        kind: 'contextual',
        reason: 'Подпись передана владельцем renderer вместе с media presentation; у текущей модели нет отдельного caption field.',
        source: `${editorSource}#caption`,
        tool: 'media'
      })}>{caption}</figcaption>}
    </figure>
  ) : (
    <div class="immersive-direction-hero__fallback immersive-direction-hero__fallback--standalone" aria-hidden="true"></div>
  )}

  <div class="immersive-direction-hero__veil" aria-hidden="true"></div>
</section>
