---
import { v2Href as resolveV2Href } from '../../../utils/v2Routes';
import { imageViewStyle } from '../catalogV2Data';
import type { DirectionCardItem } from './directionV2Data';

const withBase = (value: string) => resolveV2Href(value, Astro.url.pathname);

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  items: DirectionCardItem[];
  variant?: 'engineering' | 'visual';
  presentation?: 'cards' | 'open' | 'media-led-open';
  id?: string;
}

const {
  eyebrow = 'Виды решений',
  title,
  description = '',
  items,
  variant = 'engineering',
  presentation = 'cards',
  id = 'direction-types'
} = Astro.props as Props;

const featuredIndex = presentation === 'media-led-open'
  ? items.findIndex((item) => Boolean(item.image))
  : -1;
const indexLabel = (index: number) => String(index + 1).padStart(2, '0');
---

{items.length > 0 && (
  <section
    class:list={[
      'direction-types',
      `direction-types--${variant}`,
      {
        'direction-types--open': presentation === 'open',
        'direction-types--media-led-open': presentation === 'media-led-open'
      }
    ]}
    id={id}
    aria-labelledby={`${id}-title`}
    data-direction-type-count={presentation === 'cards' ? undefined : items.length}
  >
    <div class="hv2-shell">
      <header class="direction-section-heading" data-v2-reveal>
        <div>
          <p
            class:list={[
              'hv2-eyebrow',
              { 'hv2-eyebrow--light': variant === 'engineering' && presentation === 'cards' }
            ]}
          >
            {eyebrow}
          </p>
          <h2 id={`${id}-title`}>{title}</h2>
        </div>
        {description && <p>{description}</p>}
      </header>

      {presentation === 'cards' ? (
        <div class="direction-types__grid" role="list">
          {items.map((item, index) => (
            <article
              class:list={[
                'direction-type-card',
                { 'direction-type-card--accent': variant === 'visual' && index === items.length - 1 }
              ]}
              role="listitem"
              data-v2-reveal
            >
              {item.image ? (
                <figure class="direction-type-card__media" data-v2-media>
                  <img src={withBase(item.image)} alt="" width="720" height="540" loading="lazy" decoding="async" data-v2-image />
                </figure>
              ) : null}
              <div class="direction-type-card__body">
                <h3>{item.title}</h3>
                {item.text && <p>{item.text}</p>}
              </div>
            </article>
          ))}
        </div>
      ) : presentation === 'open' ? (
        <ol class="direction-types__open-list" data-v2-reveal>
          {items.map((item, index) => (
            <li class="direction-type-entry">
              <span class="direction-type-entry__index" aria-hidden="true">{indexLabel(index)}</span>
              <div class="direction-type-entry__body">
                <h3>{item.title}</h3>
                {item.text && <p>{item.text}</p>}
              </div>
            </li>
          ))}
        </ol>
      ) : (
        <ol class="direction-types__story-list" data-v2-reveal>
          {items.map((item, index) => index === featuredIndex ? (
            <li class="direction-type-story" data-direction-type-media-led>
              <figure class="direction-type-story__media" data-v2-media>
                <img
                  src={withBase(item.image || '')}
                  alt={item.title}
                  width="720"
                  height="540"
                  loading="lazy"
                  decoding="async"
                  style={imageViewStyle(item.imageView)}
                  data-v2-image
                />
              </figure>
              <div class="direction-type-story__body">
                <span class="direction-type-entry__index" aria-hidden="true">{indexLabel(index)}</span>
                <h3>{item.title}</h3>
                {item.text && <p>{item.text}</p>}
              </div>
            </li>
          ) : (
            <li class="direction-type-entry">
              <span class="direction-type-entry__index" aria-hidden="true">{indexLabel(index)}</span>
              <div class="direction-type-entry__body">
                <h3>{item.title}</h3>
                {item.text && <p>{item.text}</p>}
              </div>
            </li>
          ))}
        </ol>
      )}
    </div>
  </section>
)}
