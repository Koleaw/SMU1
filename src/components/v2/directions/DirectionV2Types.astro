---
import { imageViewStyle } from '../catalogV2Data';
import type { DirectionCardItem } from './directionV2Data';
import V2ResponsiveImage from '../V2ResponsiveImage.astro';

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  items: DirectionCardItem[];
  variant?: 'engineering' | 'visual';
  presentation?: 'cards' | 'open' | 'editorial-sequence';
  id?: string;
  titleBinding?: Record<string, string>;
  descriptionBinding?: Record<string, string>;
  itemsBinding?: Record<string, string>;
  eyebrowBinding?: Record<string, string>;
}

const {
  eyebrow = 'Виды решений',
  title,
  description = '',
  items,
  variant = 'engineering',
  presentation = 'cards',
  id = 'direction-types'
} = Astro.props as Props;

const editorialMediaIndexes = presentation === 'editorial-sequence'
  ? items.flatMap((item, index) => item.image ? [index] : [])
  : [];
const editorialMediaOrdinal = new Map(editorialMediaIndexes.map((itemIndex, mediaIndex) => [itemIndex, mediaIndex]));
const indexLabel = (index: number) => String(index + 1).padStart(2, '0');
const titleBinding = Astro.props.titleBinding ?? {};
const descriptionBinding = Astro.props.descriptionBinding ?? {};
const itemsBinding = Astro.props.itemsBinding ?? {};
const eyebrowBinding = Astro.props.eyebrowBinding ?? {};
---

{items.length > 0 && (
  <section
    class:list={[
      'direction-types',
      `direction-types--${variant}`,
      {
        'direction-types--open': presentation === 'open',
        'direction-types--editorial-sequence': presentation === 'editorial-sequence'
      }
    ]}
    id={id}
    aria-labelledby={`${id}-title`}
    data-direction-type-count={presentation === 'cards' ? undefined : items.length}
    data-direction-type-media-count={presentation === 'editorial-sequence' ? editorialMediaIndexes.length : undefined}
  >
    <div class="hv2-shell">
      <header class="direction-section-heading" data-v2-reveal>
        <div>
          <p
            class:list={[
              'hv2-eyebrow',
              { 'hv2-eyebrow--light': variant === 'engineering' && presentation === 'cards' }
            ]}
            {...eyebrowBinding}
          >
            {eyebrow}
          </p>
          <h2 id={`${id}-title`} {...titleBinding}>{title}</h2>
        </div>
        {description && <p {...descriptionBinding}>{description}</p>}
      </header>

      {presentation === 'cards' ? (
        <div class="direction-types__grid" role="list" {...itemsBinding}>
          {items.map((item, index) => (
            <article
              class:list={[
                'direction-type-card',
                { 'direction-type-card--accent': variant === 'visual' && index === items.length - 1 }
              ]}
              role="listitem"
              data-v2-reveal
            >
              {item.image ? (
                <figure class="direction-type-card__media" data-v2-media>
                  <V2ResponsiveImage
                    src={item.image}
                    alt=""
                    role="card"
                    sizes="(max-width: 760px) calc(100vw - 32px), 30vw"
                    loading="lazy"
                    decoding="async"
                    data-v2-image
                  />
                </figure>
              ) : null}
              <div class="direction-type-card__body">
                <h3>{item.title}</h3>
                {item.text && <p>{item.text}</p>}
              </div>
            </article>
          ))}
        </div>
      ) : presentation === 'open' ? (
        <ol class="direction-types__open-list" data-v2-reveal {...itemsBinding}>
          {items.map((item, index) => (
            <li class="direction-type-entry">
              <span class="direction-type-entry__index" aria-hidden="true">{indexLabel(index)}</span>
              <div class="direction-type-entry__body">
                <h3>{item.title}</h3>
                {item.text && <p>{item.text}</p>}
              </div>
            </li>
          ))}
        </ol>
      ) : (
        <ol class="direction-types__editorial-sequence" data-v2-reveal {...itemsBinding}>
          {items.map((item, index) => {
            const hasMedia = Boolean(item.image);
            const mediaOrdinal = editorialMediaOrdinal.get(index);
            const isFeatured = hasMedia && editorialMediaIndexes.length === 1;
            const mediaAtEnd = hasMedia && !isFeatured && mediaOrdinal !== undefined && mediaOrdinal % 2 === 1;

            return (
              <li
                class:list={[
                  'direction-type-editorial',
                  {
                    'direction-type-editorial--has-media': hasMedia,
                    'direction-type-editorial--no-media': !hasMedia,
                    'direction-type-editorial--featured': isFeatured,
                    'direction-type-editorial--media-end': mediaAtEnd
                  }
                ]}
                data-direction-type-index={indexLabel(index)}
                data-direction-type-state={hasMedia ? 'has-media' : 'no-media'}
                data-direction-type-featured={isFeatured ? 'true' : undefined}
                data-direction-type-media-order={mediaOrdinal === undefined ? undefined : mediaOrdinal + 1}
              >
                {item.image ? (
                  <figure class="direction-type-editorial__media" data-v2-media>
                    <V2ResponsiveImage
                      src={item.image}
                      alt={item.imageAlt || item.title}
                      role="card"
                      sizes="(max-width: 760px) calc(100vw - 32px), 48vw"
                      loading="lazy"
                      decoding="async"
                      style={imageViewStyle(item.imageView)}
                      data-direction-type-media-fit={item.imageView?.fit || 'cover'}
                      data-v2-image
                    />
                  </figure>
                ) : null}
                <div class="direction-type-editorial__body">
                  <span class="direction-type-entry__index" aria-hidden="true">{indexLabel(index)}</span>
                  <div class="direction-type-editorial__copy">
                    <h3>{item.title}</h3>
                    {item.text && <p>{item.text}</p>}
                  </div>
                </div>
              </li>
            );
          })}
        </ol>
      )}
    </div>
  </section>
)}
