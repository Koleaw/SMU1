---
import { adminListValue } from '../../../admin/bindings/adminBinding';

interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  items: string[];
  variant?: 'engineering' | 'visual';
  integrated?: boolean;
  titleBinding?: Record<string, string>;
  descriptionBinding?: Record<string, string>;
  itemsBinding?: Record<string, string>;
  eyebrowBinding?: Record<string, string>;
}

const {
  eyebrow = 'Для первого обсуждения',
  title,
  description,
  items,
  variant = 'engineering',
  integrated = false
} = Astro.props as Props;
const titleBinding = Astro.props.titleBinding ?? {};
const descriptionBinding = Astro.props.descriptionBinding ?? {};
const itemsBinding = Astro.props.itemsBinding ?? {};
const eyebrowBinding = Astro.props.eyebrowBinding ?? {};
---

{items.length > 0 && (
  <section
    class:list={[
      'direction-brief',
      `direction-brief--${variant}`,
      { 'direction-brief--integrated': integrated }
    ]}
    id="direction-brief"
    aria-labelledby="direction-brief-title"
    data-direction-brief-integrated={integrated ? '' : undefined}
  >
    <div class="hv2-shell hv2-grid direction-brief__grid">
      <header class="direction-brief__heading" data-v2-reveal>
        <p class="hv2-eyebrow" {...eyebrowBinding}>{eyebrow}</p>
        <h2 id="direction-brief-title" {...titleBinding}>{title}</h2>
        <p {...descriptionBinding}>{description}</p>
      </header>
      <ul class="direction-brief__items" data-v2-reveal {...itemsBinding}>
        {items.map((item) => (
          <li><strong {...adminListValue(Astro.url)}>{item}</strong></li>
        ))}
      </ul>
    </div>
    <slot />
  </section>
)}
