---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  items: string[];
  variant?: 'engineering' | 'visual';
  id?: string;
}

const {
  eyebrow = 'Применение',
  title,
  description = '',
  items,
  variant = 'engineering',
  id = 'direction-scope'
} = Astro.props as Props;
---

{items.length > 0 && (
  <section class:list={['direction-scope', `direction-scope--${variant}`]} id={id} aria-labelledby={`${id}-title`}>
    <div class="hv2-shell hv2-grid direction-scope__grid">
      <header class="direction-scope__heading" data-v2-reveal>
        <p class="hv2-eyebrow">{eyebrow}</p>
        <h2 id={`${id}-title`}>{title}</h2>
        {description && <p>{description}</p>}
      </header>
      <ul class="direction-scope__list" data-v2-reveal>
        {items.map((item) => (
          <li><p>{item}</p></li>
        ))}
      </ul>
    </div>
  </section>
)}
