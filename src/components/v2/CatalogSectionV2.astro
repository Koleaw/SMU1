---
import CatalogV2Layout from './CatalogV2Layout.astro';
import { v2Href as resolveV2Href } from '../../utils/v2Routes';
const withBase = (value: string) => resolveV2Href(value, Astro.url.pathname);
import V2Breadcrumbs from './V2Breadcrumbs.astro';
import V2CatalogHero from './V2CatalogHero.astro';
import V2HeroHandoff from './V2HeroHandoff.astro';
import V2CategoryCard from './V2CategoryCard.astro';
import V2DirectContact from './V2DirectContact.astro';
import settings from '../../content/site-settings/global.json';
import { adminBinding, adminDisposition } from '../../admin/bindings/adminBinding';
import {
  catalogMediaPresentation,
  catalogV2CategoryHref,
  publicCatalogCopy,
  type CatalogV2Links,
  type ProductCategoryData,
  type ProductSectionData
} from './catalogV2Data';

interface Props {
  section: ProductSectionData;
  categories: ProductCategoryData[];
  categoryProductCounts: Record<string, number>;
  links: CatalogV2Links;
  currentPath: string;
  productFinalPrototype?: 'hub';
}

const {
  section,
  categories,
  categoryProductCounts,
  links,
  currentPath,
  productFinalPrototype
} = Astro.props as Props;
const productFinalEnabled = productFinalPrototype === 'hub';
const catalogCopy = settings.catalogUi;
const globalBinding = (fieldPath: string, tool = 'short-text', options: Record<string, unknown> = {}) => adminBinding(Astro.url, {
  renderer: { family: 'catalog-ui', variant: 'hub' }, owner: { collection: 'site-settings', slug: 'global' },
  fieldPath: `catalogUi.${fieldPath}`, scope: 'global', tool, affectedRoutes: ['*'], ...options
});
const sectionBinding = (fieldPath: string, tool = 'short-text', options: Record<string, unknown> = {}) => adminBinding(Astro.url, {
  renderer: { family: 'catalog-hub', variant: section.slug }, owner: { collection: 'product-sections', slug: section.slug },
  fieldPath, scope: 'local', tool, affectedRoutes: [currentPath], ...options
});
const homeBreadcrumbEditor = globalBinding('shared.homeBreadcrumbLabel', 'short-text', { role: 'hub-home-breadcrumb' });
const sectionTitleEditor = sectionBinding('title', 'short-text', { role: 'hub-current-breadcrumb' });
const productFinalBreadcrumbs = [
  { title: catalogCopy.shared.homeBreadcrumbLabel, href: '/design-lab/home-v2/', editor: homeBreadcrumbEditor },
  { title: section.title, editor: sectionTitleEditor }
];
const categoryHref = (category: ProductCategoryData) =>
  links.categoryHrefs[category.slug] || catalogV2CategoryHref(section.slug, category.slug);
const blocks = Array.isArray(section.pageBlocks)
  ? section.pageBlocks as Array<{
      type?: string;
      title?: string;
      text?: string;
      isActive?: boolean;
      order?: number;
    }>
  : [];
const customBlockEntry = blocks
  .map((block, index) => ({ block, index }))
  .filter(({ block }) => block.isActive !== false && block.type === 'mediaText')
  .sort((a, b) => (a.block.order ?? 0) - (b.block.order ?? 0))[0];
const customBlock = customBlockEntry?.block;
const customTitleFromSection = publicCatalogCopy(customBlock?.title);
const customTextFromSection = publicCatalogCopy(customBlock?.text);
const customTitle = customTitleFromSection || catalogCopy.hub.customDefaultTitle;
const customText = publicCatalogCopy(customBlock?.text)
  || catalogCopy.hub.customDefaultDescription;
const customFieldBinding = (field: 'title' | 'text', tool: string) => {
  const hasValue = field === 'title' ? customTitleFromSection : customTextFromSection;
  return hasValue && customBlockEntry
    ? sectionBinding(`pageBlocks[${customBlockEntry.index}].${field}`, tool, {
        stableItemId: `${customBlock?.type || 'mediaText'}-${customBlock?.order ?? customBlockEntry.index}-${field}`
      })
    : globalBinding(`hub.${field === 'title' ? 'customDefaultTitle' : 'customDefaultDescription'}`, tool, {
        projection: { kind: 'fallback', fallback: `product-sections.${section.slug}.pageBlocks[mediaText].${field}` }
      });
};
const heroDescription = publicCatalogCopy(section.heroDescription);
const heroSupportingText = publicCatalogCopy(section.shortDescription);
const displayCategories = categories.map((category) => ({
  ...category,
  heroDescription: publicCatalogCopy(category.heroDescription),
  shortDescription: publicCatalogCopy(category.shortDescription)
}));
const contactTitleFromSection = publicCatalogCopy(section.contactTitle);
const contactDescriptionFromSection = publicCatalogCopy(section.contactDescription);
const contactTitle = contactTitleFromSection || catalogCopy.hub.contactDefaultTitle;
const contactDescription = publicCatalogCopy(section.contactDescription)
  || catalogCopy.hub.contactDefaultDescription;
const contactTitleBinding = contactTitleFromSection
  ? sectionBinding('contactTitle', 'heading')
  : globalBinding('hub.contactDefaultTitle', 'heading', { projection: { kind: 'fallback', fallback: `product-sections.${section.slug}.contactTitle` } });
const contactDescriptionBinding = contactDescriptionFromSection
  ? sectionBinding('contactDescription', 'long-text')
  : globalBinding('hub.contactDefaultDescription', 'long-text', { projection: { kind: 'fallback', fallback: `product-sections.${section.slug}.contactDescription` } });
const fenceHubEnabled = productFinalEnabled && section.slug === 'ograzhdeniya-i-zabory';
const heroMediaPresentation = fenceHubEnabled
  ? 'contextual'
  : section.mode === 'catalog-hub' && section.image?.trim()
  ? 'isolated'
  : catalogMediaPresentation(section.image || '', section.imageView);
const rootClass = fenceHubEnabled
  ? 'catalog-v2--fence-hub catalog-v2--fence-contextual'
  : '';
---

<CatalogV2Layout
  title={section.seoTitle}
  description={publicCatalogCopy(section.seoDescription) || heroDescription || heroSupportingText || section.title}
  canonicalPath={`/${section.slug}/`}
  currentPath={currentPath}
  ogImage={section.image}
  productFinalPrototype={productFinalPrototype}
  rootClass={rootClass}
>
  {!productFinalEnabled && <V2Breadcrumbs items={[
    { title: catalogCopy.shared.homeBreadcrumbLabel, href: '/design-lab/home-v2/', editor: homeBreadcrumbEditor },
    { title: section.title, editor: sectionTitleEditor }
  ]} />}

  <V2HeroHandoff enabled={productFinalEnabled}>
  <V2CatalogHero
    variant="section"
    productFinalHandoff={productFinalEnabled}
    kicker={catalogCopy.hub.heroKicker}
    title={section.heroTitle}
    description={heroDescription}
    supportingText={heroSupportingText}
    image={section.image}
    imageAlt={section.title}
    imageView={section.imageView}
    mediaPresentation={heroMediaPresentation}
    countLabel={`${categories.length} ${catalogCopy.hub.categoryCountSuffix}`}
    primaryHref="#catalog-grid"
    primaryLabel={catalogCopy.hub.heroPrimaryLabel}
    secondaryHref="#contact"
    secondaryLabel={catalogCopy.hub.heroSecondaryLabel}
    bindingOwner={{ collection: 'product-sections', slug: section.slug }}
    bindingFields={{ title: 'heroTitle', description: 'heroDescription', supportingText: 'shortDescription', image: 'image' }}
    kickerBinding={globalBinding('hub.heroKicker')}
    countLabelBinding={adminDisposition(Astro.url, {
      kind: 'derived',
      reason: 'Число вычисляется из опубликованных категорий, а подпись хранится в общих текстах каталога.',
      source: 'categories.length + site-settings.catalogUi.hub.categoryCountSuffix',
      tool: 'global-settings'
    })}
    primaryLabelBinding={globalBinding('hub.heroPrimaryLabel')}
    secondaryLabelBinding={globalBinding('hub.heroSecondaryLabel')}
    affectedRoutes={[currentPath, '/']}
  >
    {productFinalEnabled && <V2Breadcrumbs slot="breadcrumbs" items={productFinalBreadcrumbs} />}
  </V2CatalogHero>
  </V2HeroHandoff>

  <section class="v2-catalog-index" id="catalog-grid" aria-labelledby="v2-category-grid-title">
    <div class="hv2-shell">
      <header class="v2-section-heading" data-v2-reveal>
        <div>
          <p class="hv2-eyebrow" {...globalBinding('hub.gridEyebrow')}>{catalogCopy.hub.gridEyebrow}</p>
          <h2 id="v2-category-grid-title" {...globalBinding('hub.gridTitle', 'heading')}>{catalogCopy.hub.gridTitle}</h2>
        </div>
        <p {...globalBinding('hub.gridDescription', 'long-text')}>{catalogCopy.hub.gridDescription}</p>
      </header>
      {displayCategories.length > 0 ? (
        <div class="v2-category-grid" role="list">
          {displayCategories.map((category, index) => (
            <div role="listitem" class:list={['v2-category-grid__item', { 'v2-category-grid__item--featured': index === 0 }]}>
              <V2CategoryCard
                category={category}
                href={categoryHref(category)}
                productCount={categoryProductCounts[category.slug] || 0}
                featured={index === 0}
                loading="lazy"
              />
            </div>
          ))}
        </div>
      ) : (
        <div class="v2-empty-state" role="status">
          <h2 {...globalBinding('hub.emptyTitle', 'heading')}>{catalogCopy.hub.emptyTitle}</h2>
          <p {...globalBinding('hub.emptyDescription', 'long-text')}>{catalogCopy.hub.emptyDescription}</p>
        </div>
      )}
    </div>
  </section>

  <section class="v2-custom-cta" aria-labelledby="v2-section-custom-title">
    <div class="hv2-shell hv2-grid v2-custom-cta__grid" data-v2-reveal>
      <div>
        <p class="hv2-eyebrow" {...globalBinding('hub.customEyebrow')}>{catalogCopy.hub.customEyebrow}</p>
        <h2 id="v2-section-custom-title" {...customFieldBinding('title', 'heading')}>{customTitle}</h2>
      </div>
      <div>
        <p {...customFieldBinding('text', 'long-text')}>{customText}</p>
        <a class="hv2-text-link" href={withBase('/design-lab/v2/izgotovlenie-na-zakaz/')} {...globalBinding('hub.customLinkLabel')}>{catalogCopy.hub.customLinkLabel}</a>
      </div>
    </div>
  </section>

  <V2DirectContact
    eyebrow={catalogCopy.hub.contactEyebrow}
    title={contactTitle}
    description={contactDescription}
    primaryLabel={catalogCopy.hub.contactPrimaryLabel}
    secondaryLabel={catalogCopy.hub.contactSecondaryLabel}
    phoneChannelLabel={catalogCopy.shared.phoneChannelLabel}
    telegramChannelLabel={catalogCopy.shared.telegramChannelLabel}
    emailChannelLabel={catalogCopy.shared.emailChannelLabel}
    eyebrowBinding={globalBinding('hub.contactEyebrow')}
    titleBinding={contactTitleBinding}
    descriptionBinding={contactDescriptionBinding}
    primaryLabelBinding={globalBinding('hub.contactPrimaryLabel')}
    secondaryLabelBinding={globalBinding('hub.contactSecondaryLabel')}
    phoneChannelLabelBinding={globalBinding('shared.phoneChannelLabel')}
    telegramChannelLabelBinding={globalBinding('shared.telegramChannelLabel')}
    emailChannelLabelBinding={globalBinding('shared.emailChannelLabel')}
  />
</CatalogV2Layout>
