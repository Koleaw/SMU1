---
import { v2Href as resolveV2Href } from '../../utils/v2Routes';
import settings from '../../content/site-settings/global.json';
import CatalogV2Layout from './CatalogV2Layout.astro';
import V2Breadcrumbs from './V2Breadcrumbs.astro';
import V2ProductGallery from './V2ProductGallery.astro';
import V2ProductCard from './V2ProductCard.astro';
import V2ResponsiveImage from './V2ResponsiveImage.astro';
import V2DirectContact from './V2DirectContact.astro';
import V2HeroHandoff from './V2HeroHandoff.astro';
import V2SectionNav from './V2SectionNav.astro';
import { adminBinding, adminListField, adminListItem, isLocalAdminCanvas } from '../../admin/bindings/adminBinding';
import { resolveV2ResponsiveMedia } from '../../utils/v2ResponsiveMedia';
import {
  catalogV2CategoryHref,
  catalogV2ProductHref,
  cleanTextItems,
  formatProductPrice,
  imageViewStyle,
  productGalleryImages,
  publicCatalogCopy,
  type CatalogProductRoute,
  type CatalogV2Links
} from './catalogV2Data';

interface Props {
  route: CatalogProductRoute;
  relatedProducts: CatalogProductRoute[];
  links: CatalogV2Links;
  currentPath: string;
}

type PremiumProductFields = {
  solutionKicker?: string;
  applicationItems?: string[];
  executionVariants?: string[];
};

const withBase = (value: string) => resolveV2Href(value, Astro.url.pathname);
const { route, relatedProducts, links, currentPath } = Astro.props as Props;
const { section, category, product } = route;
const editorCanvas = isLocalAdminCanvas(Astro.url);
const standardTemplateProduct = { ...product, presentationType: 'standard' as const };
const premiumTemplateProduct = { ...product, presentationType: 'premium' as const };
const premium = product as typeof product & PremiumProductFields;
const images = productGalleryImages(product);
const primaryImage = images[0] || '';
const primaryImageMedia = primaryImage ? resolveV2ResponsiveMedia(primaryImage, 'hero') : null;
const primaryImageUrl = primaryImage ? withBase(primaryImageMedia?.src || primaryImage) : '';
const imageVariableStyle = [
  `--v2-image-source-x:${product.imageView?.positionX ?? 50}%`,
  `--v2-image-source-y:${product.imageView?.positionY ?? 50}%`,
  `--v2-image-source-scale:${product.imageView?.scale ?? 1}`,
  `--v2-premium-hero-image:url("${primaryImageUrl}")`
].join(';');
const imagePresentationStyle = [
  imageViewStyle(product.imageView),
  imageVariableStyle
].join(';');
const publicTextItems = (items: unknown) => cleanTextItems(items)
  .map((item) => publicCatalogCopy(item))
  .filter(Boolean);
const features = publicTextItems(product.features);
const materials = publicTextItems(product.materials);
const colors = publicTextItems(product.colors);
const customizationItems = publicTextItems(product.customizationItems);
const applicationItems = publicTextItems(premium.applicationItems);
const executionVariants = publicTextItems(premium.executionVariants);
const authoredSolutionKicker = publicCatalogCopy(premium.solutionKicker);
const solutionKicker = authoredSolutionKicker || settings.productUi.premiumDefaultSolutionKicker;
const productLead = publicCatalogCopy(product.leadText) || publicCatalogCopy(product.shortDescription);
const description = publicCatalogCopy(product.description) || productLead;
const descriptionParagraphs = description.split(/\n{2,}/).map((item) => item.trim()).filter(Boolean);
const deliveryParagraphs = publicCatalogCopy(product.deliveryText)
  .split(/\n{2,}/)
  .map((item) => item.trim())
  .filter(Boolean);
const dimensions = Array.isArray(product.dimensions)
  ? product.dimensions
      .map((item, sourceIndex) => ({ ...item, sourceIndex }))
      .filter((item) => item?.isActive !== false && (item?.label?.trim() || item?.value?.trim()))
      .slice()
      .sort((a, b) => (a.order ?? 0) - (b.order ?? 0))
  : [];
const genericSpecLabels = new Set(['размеры и характеристики', 'размеры', 'характеристики']);
const normalizedSpecs = dimensions.map((item) => {
  const label = item.label?.trim() || '';
  const values = (item.value || '').split(/\n+/).map((line) => line.trim()).filter(Boolean);
  const isPair = Boolean(label && values.length && !genericSpecLabels.has(label.toLocaleLowerCase('ru-RU')));
  return { id: item.id, label, values, isPair, sourceIndex: item.sourceIndex };
});
const pairedSpecs = normalizedSpecs.filter((item) => item.isPair);
const textualSpecs = normalizedSpecs.flatMap((item) => item.isPair
  ? []
  : item.values.length > 0
    ? item.values.map((text, lineIndex) => ({ id: item.id, text, lineIndex, sourceIndex: item.sourceIndex, field: 'value', contextField: 'label' }))
    : item.label && !genericSpecLabels.has(item.label.toLocaleLowerCase('ru-RU'))
      ? [{ id: item.id, text: item.label, lineIndex: 0, sourceIndex: item.sourceIndex, field: 'label', contextField: 'value' }]
      : []);
const hasSpecifications = pairedSpecs.length > 0 || textualSpecs.length > 0;
const hasTechnicalSystem = hasSpecifications || materials.length > 0 || colors.length > 0;
const relatedHref = links.categoryHrefs[category.slug] || catalogV2CategoryHref(section.slug, category.slug);
const relatedProductHref = (item: CatalogProductRoute) => links.productHrefs[item.product.slug]
  || catalogV2ProductHref(item.section.slug, item.category.slug, item.product.slug);
const displayRelatedProducts = relatedProducts.map((item) => ({
  ...item,
  product: {
    ...item.product,
    leadText: publicCatalogCopy(item.product.leadText),
    shortDescription: publicCatalogCopy(item.product.shortDescription)
  }
}));
const finalContactTitle = publicCatalogCopy(product.customProjectTitle) || settings.productUi.premiumDefaultTitle;
const finalContactDescription = publicCatalogCopy(product.customProjectText)
  || settings.productUi.premiumDefaultDescription;
const affectedRoutes = [route.href, relatedHref];
const binding = (fieldPath: string, tool = 'long-text', options: Record<string, unknown> = {}) => adminBinding(Astro.url, {
  renderer: { family: 'product-detail', variant: 'premium' }, owner: { collection: 'products', slug: product.slug },
  fieldPath, stableItemId: product.slug, scope: 'local', tool, affectedRoutes, ...options
});
const relatedProductsBinding = binding('relatedProductSlugs', 'relation-list', {
  itemKind: 'string',
  relationCollections: ['products'],
  label: 'Связанные товары и их порядок',
  permissions: { edit: true, reorder: true, delete: false },
  projection: { kind: product.relatedProductSlugs?.length ? 'relation' : 'fallback', fallback: 'category order' }
});
const relatedProductsEditorMetadata = editorCanvas ? {
  'data-smu1-product-relations-variant': 'premium',
  'data-smu1-product-relations-eyebrow': settings.productUi.premiumRelatedEyebrow,
  'data-smu1-product-relations-title': settings.productUi.premiumRelatedTitle,
  'data-smu1-product-relations-link-label': settings.productUi.premiumRelatedLinkLabel,
  'data-smu1-product-relations-link-href': withBase(relatedHref),
  'data-smu1-product-card-premium-label': settings.productUi.cardPremiumLabel,
  'data-smu1-product-card-materials-missing-label': settings.productUi.cardMaterialsMissingLabel,
  'data-smu1-product-card-cta-label': settings.productUi.cardCtaLabel
} : {};
const productUiBinding = (fieldPath: string, tool = 'short-text', occurrence = 'content', options: Record<string, unknown> = {}) => adminBinding(Astro.url, {
  renderer: { family: 'global-shell', variant: 'premium-product-ui' }, owner: { collection: 'site-settings', slug: 'global' },
  fieldPath: `productUi.${fieldPath}`, stableItemId: `premium-product-${fieldPath}-${occurrence}`, scope: 'global', tool, affectedRoutes: ['*'], ...options
});
const catalogUiBinding = (fieldPath: string, occurrence: string) => adminBinding(Astro.url, {
  renderer: { family: 'product-detail', variant: 'premium-breadcrumb' },
  owner: { collection: 'site-settings', slug: 'global' }, fieldPath: `catalogUi.${fieldPath}`,
  stableItemId: `${product.slug}-${occurrence}`, scope: 'global', tool: 'short-text', affectedRoutes: ['*']
});
const referenceBinding = (
  collection: string,
  slug: string,
  fieldPath: string,
  occurrence: string,
  routes: string[] = affectedRoutes
) => adminBinding(Astro.url, {
  renderer: { family: 'product-detail', variant: 'premium-reference' }, owner: { collection, slug }, fieldPath,
  stableItemId: `${product.slug}-${occurrence}`, scope: 'shared', tool: 'short-text', affectedRoutes: routes
});
const solutionKickerBinding = authoredSolutionKicker
  ? binding('solutionKicker', 'short-text', { stableItemId: `${product.slug}-solution-kicker` })
  : productUiBinding('premiumDefaultSolutionKicker', 'short-text', 'solution-kicker-fallback');
const premiumBreadcrumbs = [
  { title: settings.catalogUi.shared.homeBreadcrumbLabel, href: '/design-lab/home-v2/', editor: catalogUiBinding('shared.homeBreadcrumbLabel', 'breadcrumb-home') },
  { title: section.title, href: links.sectionHref, editor: referenceBinding('product-sections', section.slug, 'title', 'breadcrumb-section', [route.href, links.sectionHref, relatedHref]) },
  { title: category.title, href: relatedHref, editor: referenceBinding('product-categories', category.slug, 'title', 'breadcrumb-category') },
  { title: product.title, editor: binding('title', 'heading', { stableItemId: `${product.slug}-breadcrumb-product`, role: 'breadcrumb-product' }) }
];
const sectionNavItems = [
  { id: 'premium-solution', label: settings.productUi.premiumNavSolutionLabel, editor: productUiBinding('premiumNavSolutionLabel', 'short-text', 'nav-solution') },
  ...(applicationItems.length > 0 ? [{ id: 'premium-applications', label: settings.productUi.premiumNavApplicationsLabel, editor: productUiBinding('premiumNavApplicationsLabel', 'short-text', 'nav-applications') }] : []),
  ...(images.length > 1 ? [{ id: 'premium-gallery', label: settings.productUi.premiumNavGalleryLabel, editor: productUiBinding('premiumNavGalleryLabel', 'short-text', 'nav-gallery') }] : []),
  ...(customizationItems.length > 0 ? [{ id: 'premium-adaptation', label: settings.productUi.premiumNavAdaptationLabel, editor: productUiBinding('premiumNavAdaptationLabel', 'short-text', 'nav-adaptation') }] : []),
  ...(executionVariants.length > 0 ? [{ id: 'premium-variants', label: settings.productUi.premiumNavVariantsLabel, editor: productUiBinding('premiumNavVariantsLabel', 'short-text', 'nav-variants') }] : []),
  ...(hasTechnicalSystem ? [{ id: 'premium-technical', label: settings.productUi.premiumNavTechnicalLabel, editor: productUiBinding('premiumNavTechnicalLabel', 'short-text', 'nav-technical') }] : []),
  ...(product.showDeliveryBlock !== false && deliveryParagraphs.length > 0
    ? [{ id: 'premium-delivery', label: settings.productUi.premiumNavDeliveryLabel, editor: productUiBinding('premiumNavDeliveryLabel', 'short-text', 'nav-delivery') }]
    : []),
  ...(relatedProducts.length > 0 || editorCanvas ? [{
    id: 'premium-related',
    label: settings.productUi.premiumNavRelatedLabel,
    editor: {
      ...productUiBinding('premiumNavRelatedLabel', 'short-text', 'nav-related'),
      ...(editorCanvas && relatedProducts.length === 0
        ? { 'data-smu1-editor-affordance': 'empty-related-products-nav' }
        : {})
    }
  }] : []),
  { id: 'contact', label: settings.productUi.premiumNavContactLabel, editor: productUiBinding('premiumNavContactLabel', 'short-text', 'nav-contact') }
];
const headerCtaBinding = productUiBinding('premiumHeroPrimaryLabel', 'link-label', 'header-desktop');
const headerMobileCtaBinding = productUiBinding('premiumHeroPrimaryLabel', 'link-label', 'header-mobile');
const mobileCtaBinding = productUiBinding('premiumHeroPrimaryLabel', 'link-label', 'footer-mobile');
---

<CatalogV2Layout
  title={product.seoTitle}
  description={publicCatalogCopy(product.seoDescription) || productLead || product.title}
  canonicalPath={route.href}
  currentPath={currentPath}
  ogImage={primaryImage || product.image}
  pageKind="product"
  headerMode="overlay"
  headerCtaLabel={settings.productUi.premiumHeroPrimaryLabel}
  mobileCtaLabel={settings.productUi.premiumHeroPrimaryLabel}
  headerCtaBinding={headerCtaBinding}
  headerMobileCtaBinding={headerMobileCtaBinding}
  mobileCtaBinding={mobileCtaBinding}
  rootClass="catalog-product catalog-product--premium"
  productFinalPrototype="premium-product"
>
  <div data-product-presentation="premium">
    <V2HeroHandoff enabled>
    <section
      class:list={['v2-premium-product-hero', { 'v2-premium-product-hero--no-media': !primaryImage }]}
      id="product-overview"
      aria-labelledby="v2-premium-product-title"
      data-product-final-hero
    >
      <div class="v2-premium-product-hero__track" data-product-final-track>
        <div class="hv2-shell v2-premium-product-hero__inner">
          <div class="v2-premium-product-hero__breadcrumbs" data-v2-reveal="entry-meta" data-v2-entrance-role="context">
            <V2Breadcrumbs items={premiumBreadcrumbs} />
          </div>

          <div class="v2-premium-product-hero__copy" data-v2-page-handoff="copy">
            <p class="hv2-eyebrow hv2-eyebrow--light" data-v2-reveal="entry-meta" data-v2-entrance-role="context" {...solutionKickerBinding}>{solutionKicker}</p>
            <h1 id="v2-premium-product-title" data-v2-reveal="entry-title" data-v2-entrance-role="title-primary" {...binding('title', 'heading')}>{product.title}</h1>
            {productLead && <p class="v2-premium-product-hero__lead" data-v2-reveal="entry-copy" data-v2-entrance-role="lead" {...binding('leadText', 'long-text', { projection: { kind: 'fallback', fallback: 'shortDescription' } })}>{productLead}</p>}
            <dl class="v2-premium-product-hero__price" data-v2-reveal="entry-price" data-v2-entrance-role="actions-meta">
              <dt {...productUiBinding('premiumPriceLabel', 'short-text', 'hero-price-label')}>{settings.productUi.premiumPriceLabel}</dt>
              <dd {...binding('priceMode', 'price', { modePath: 'priceMode', valuePath: 'priceFrom', currencyPath: 'currency' })}>{formatProductPrice(product)}</dd>
            </dl>
            <div class="hv2-actions" data-v2-reveal="entry-actions" data-v2-entrance-role="actions-meta">
              <a class="hv2-button hv2-button--primary" href="#contact" {...productUiBinding('premiumHeroPrimaryLabel', 'link-label')}>{settings.productUi.premiumHeroPrimaryLabel}</a>
              <a class="hv2-button hv2-button--ghost" href={settings.telegram} target="_blank" rel="noopener noreferrer" {...productUiBinding('premiumHeroSecondaryLabel', 'link-label')}>
                {settings.productUi.premiumHeroSecondaryLabel}
              </a>
            </div>
          </div>
        </div>

        {(primaryImage || editorCanvas) && <div
          class="v2-premium-product-hero__media"
          data-v2-media
          data-v2-reveal="entry-media"
          data-v2-entrance-role="media"
          style={imageVariableStyle}
          {...binding('gallery', 'gallery', { role: primaryImage ? 'premium-hero-media' : 'missing-product-media', multiple: true, coverPath: 'image' })}
        >
          {primaryImage ? (
            <V2ResponsiveImage
              src={primaryImage}
              alt={`${product.title} — общий вид`}
              role="hero"
              sizes="(max-width: 980px) 100vw, 50vw"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              style={imagePresentationStyle}
              data-v2-image
              data-v2-page-critical
              {...binding('imageView', 'crop', {
                role: 'premium-hero-crop',
                stableItemId: `${product.slug}-premium-hero-crop`,
                label: 'Кадрирование первого экрана',
                validation: { fit: ['cover', 'contain'], positionX: [0, 100], positionY: [0, 100], scale: [1, 3] }
              })}
            />
          ) : (
            <div class="v2-media-empty" data-smu1-editor-affordance="missing-product-media"><p>Добавить фотографии</p></div>
          )}
        </div>}
      </div>
    </section>
    </V2HeroHandoff>

    <div class="v2-premium-content-front">
    <V2SectionNav
      items={sectionNavItems}
    label={settings.productUi.premiumSectionNavLabel}
    editor={productUiBinding('premiumSectionNavLabel', 'short-text', 'section-nav-label', { projection: { kind: 'direct', target: 'attribute:aria-label' } })}
    />

    <section
      class="v2-premium-solution"
      id="premium-solution"
      aria-labelledby="premium-solution-title"
      data-premium-product-section
    >
      <div class="hv2-shell hv2-grid">
        <header data-v2-reveal>
          <p class="hv2-eyebrow" {...productUiBinding('premiumSolutionEyebrow')}>{settings.productUi.premiumSolutionEyebrow}</p>
          <h2 id="premium-solution-title" {...binding('title', 'heading', { stableItemId: `${product.slug}-solution-title`, role: 'repeated-title' })}>{product.title}</h2>
        </header>
        <div class="v2-premium-solution__body" data-v2-reveal {...binding('description', 'long-text', { projection: { kind: 'fallback', target: 'paragraphs', fallback: 'leadText' } })}>
          {descriptionParagraphs.map((paragraph) => <p>{paragraph}</p>)}
          {features.length > 0 && <ul {...binding('features', 'list', { itemKind: 'string' })}>{features.map((feature) => <li>{feature}</li>)}</ul>}
        </div>
      </div>
    </section>

    {applicationItems.length > 0 && (
      <section
        class="v2-premium-applications"
        id="premium-applications"
        aria-labelledby="premium-applications-title"
        data-premium-product-section
      >
        <div class="hv2-shell">
          <header class="v2-section-heading" data-v2-reveal>
            <div><p class="hv2-eyebrow" {...productUiBinding('premiumApplicationsEyebrow')}>{settings.productUi.premiumApplicationsEyebrow}</p><h2 id="premium-applications-title" {...productUiBinding('premiumApplicationsTitle', 'heading')}>{settings.productUi.premiumApplicationsTitle}</h2></div>
          </header>
          <ul class="v2-premium-index-grid" role="list" data-premium-item-count={applicationItems.length} {...binding('applicationItems', 'list', { itemKind: 'string' })}>
            {applicationItems.map((item) => <li data-v2-reveal><p>{item}</p></li>)}
          </ul>
        </div>
      </section>
    )}

    {images.length > 1 && (
      <section
        class="v2-premium-gallery"
        id="premium-gallery"
        aria-labelledby="premium-gallery-title"
        data-premium-product-section
      >
        <div class="hv2-shell">
          <header class="v2-section-heading" data-v2-reveal>
            <div><p class="hv2-eyebrow" {...productUiBinding('premiumGalleryEyebrow')}>{settings.productUi.premiumGalleryEyebrow}</p><h2 id="premium-gallery-title" {...productUiBinding('premiumGalleryTitle', 'heading')}>{settings.productUi.premiumGalleryTitle}</h2></div>
          </header>
          <div class="v2-premium-gallery__viewer" data-v2-reveal="section-media" style={imageVariableStyle}>
            <V2ProductGallery
              images={images}
              imageMetadata={product.gallery}
              title={product.title}
              imageView={product.imageView}
              entityLabel="решения"
              mediaSizes="(max-width: 760px) calc(100vw - 32px), calc(100vw - 64px)"
              bindingOwner={{ collection: 'products', slug: product.slug }}
              bindingField="gallery"
              affectedRoutes={affectedRoutes}
            />
          </div>
        </div>
      </section>
    )}

    {customizationItems.length > 0 && (
      <section
        class="v2-premium-adaptation"
        id="premium-adaptation"
        aria-labelledby="premium-adaptation-title"
        data-premium-product-section
      >
        <div class="hv2-shell hv2-grid">
          <header data-v2-reveal>
            <p class="hv2-eyebrow" {...productUiBinding('premiumAdaptationEyebrow')}>{settings.productUi.premiumAdaptationEyebrow}</p>
            <h2 id="premium-adaptation-title" {...productUiBinding('premiumAdaptationTitle', 'heading')}>{settings.productUi.premiumAdaptationTitle}</h2>
          </header>
          <ul role="list" {...binding('customizationItems', 'list', { itemKind: 'string' })}>
            {customizationItems.map((item) => <li data-v2-reveal><p>{item}</p></li>)}
          </ul>
        </div>
      </section>
    )}

    {executionVariants.length > 0 && (
      <section
        class="v2-premium-variants"
        id="premium-variants"
        aria-labelledby="premium-variants-title"
        data-premium-product-section
      >
        <div class="hv2-shell">
          <header class="v2-section-heading" data-v2-reveal>
            <div><p class="hv2-eyebrow" {...productUiBinding('premiumVariantsEyebrow')}>{settings.productUi.premiumVariantsEyebrow}</p><h2 id="premium-variants-title" {...productUiBinding('premiumVariantsTitle', 'heading')}>{settings.productUi.premiumVariantsTitle}</h2></div>
          </header>
          <ul class="v2-premium-index-grid" role="list" data-premium-item-count={executionVariants.length} {...binding('executionVariants', 'list', { itemKind: 'string' })}>
            {executionVariants.map((item) => <li data-v2-reveal><p>{item}</p></li>)}
          </ul>
        </div>
      </section>
    )}

    {hasTechnicalSystem && (
      <section
        class="v2-premium-technical"
        id="premium-technical"
        aria-labelledby="premium-technical-title"
        data-premium-product-section
      >
        <div class="hv2-shell">
          <header class="v2-section-heading" data-v2-reveal>
            <div><p class="hv2-eyebrow" {...productUiBinding('premiumTechnicalEyebrow')}>{settings.productUi.premiumTechnicalEyebrow}</p><h2 id="premium-technical-title" {...productUiBinding('premiumTechnicalTitle', 'heading')}>{settings.productUi.premiumTechnicalTitle}</h2></div>
          </header>
          <div class="v2-premium-technical__grid" data-v2-scroll-section>
            {hasSpecifications && (
              <section data-v2-reveal data-v2-scroll-role="card" {...binding('dimensions', 'list', {
                itemKind: 'object',
                permissions: { edit: true, reorder: true, delete: false },
                projection: { kind: 'list', target: 'product-specifications' },
                itemFields: [
                  { fieldPath: 'id', tool: 'generated-id' },
                  { fieldPath: 'label', label: 'Характеристика', tool: 'short-text' },
                  { fieldPath: 'value', label: 'Значение', tool: 'long-text' },
                  { fieldPath: 'order', tool: 'generated-order' },
                  { fieldPath: 'isActive', label: 'Показывать характеристику', tool: 'visibility' }
                ]
              })}>
                <h3 {...productUiBinding('premiumSpecificationsTitle', 'heading')}>{settings.productUi.premiumSpecificationsTitle}</h3>
                {pairedSpecs.length > 0 && <dl>
                  {pairedSpecs.map((item) => <div {...adminListItem(Astro.url, item.id)}>
                    <dt {...adminListField(Astro.url, 'label')}>{item.label}</dt>
                    <dd {...adminListField(Astro.url, 'value')} data-smu1-list-transform={editorCanvas ? 'lines' : undefined}>{item.values.map((value) => <span>{value}</span>)}</dd>
                  </div>)}
                </dl>}
                {textualSpecs.length > 0 && <ul>{textualSpecs.map((item) => <li
                  {...adminListItem(Astro.url, item.id)}
                  {...adminListField(Astro.url, item.field)}
                  data-smu1-list-transform={editorCanvas ? 'line' : undefined}
                  data-smu1-list-line={editorCanvas ? String(item.lineIndex) : undefined}
                  data-smu1-list-context-field={editorCanvas ? item.contextField : undefined}
                >{item.text}</li>)}</ul>}
              </section>
            )}
            {materials.length > 0 && <section data-v2-reveal data-v2-scroll-role="card"><h3 {...productUiBinding('premiumMaterialsTitle', 'heading')}>{settings.productUi.premiumMaterialsTitle}</h3><ul {...binding('materials', 'list', { itemKind: 'string' })}>{materials.map((item) => <li>{item}</li>)}</ul></section>}
            {colors.length > 0 && <section data-v2-reveal data-v2-scroll-role="card"><h3 {...productUiBinding('premiumColorsTitle', 'heading')}>{settings.productUi.premiumColorsTitle}</h3><ul {...binding('colors', 'list', { itemKind: 'string' })}>{colors.map((item) => <li>{item}</li>)}</ul></section>}
          </div>
        </div>
      </section>
    )}

    {product.showDeliveryBlock !== false && deliveryParagraphs.length > 0 && (
      <section
        class="v2-premium-delivery"
        id="premium-delivery"
        aria-labelledby="premium-delivery-title"
        data-premium-product-section
      >
        <div class="hv2-shell hv2-grid">
          <header data-v2-reveal>
            <p class="hv2-eyebrow" {...productUiBinding('premiumDeliveryEyebrow')}>{settings.productUi.premiumDeliveryEyebrow}</p>
            <h2 id="premium-delivery-title" {...productUiBinding('premiumDeliveryTitle', 'heading')}>{settings.productUi.premiumDeliveryTitle}</h2>
          </header>
          <div data-v2-reveal {...binding('deliveryText', 'long-text')}>{deliveryParagraphs.map((paragraph) => <p>{paragraph}</p>)}</div>
        </div>
      </section>
    )}

    {editorCanvas && relatedProducts.length === 0 && (
      <button
        class="v2-editor-fixed-affordance"
        type="button"
        data-smu1-editor-affordance="empty-related-products"
        aria-label="Добавить связанные товары"
        {...relatedProductsBinding}
        {...relatedProductsEditorMetadata}
      >Добавить связанные товары</button>
    )}

    {editorCanvas && (
      <template data-smu1-product-relations-template="premium">
        <section
          class="v2-premium-related"
          id="premium-related"
          aria-labelledby="premium-related-title"
          data-premium-product-section
        >
          <div class="hv2-shell">
            <header class="v2-section-heading" data-v2-reveal>
              <div>
                <p class="hv2-eyebrow" {...productUiBinding('premiumRelatedEyebrow')}>{settings.productUi.premiumRelatedEyebrow}</p>
                <h2 id="premium-related-title" {...productUiBinding('premiumRelatedTitle', 'heading')}>{settings.productUi.premiumRelatedTitle}</h2>
              </div>
              <a class="hv2-text-link" href={withBase(relatedHref)} {...productUiBinding('premiumRelatedLinkLabel', 'link-label')}>{settings.productUi.premiumRelatedLinkLabel}</a>
            </header>
            <div
              class="v2-product-grid v2-product-grid--related"
              role="list"
              data-premium-related-count="1"
              {...relatedProductsBinding}
              {...relatedProductsEditorMetadata}
            >
              <div role="listitem" data-smu1-card-template-presentation="standard"><V2ProductCard product={standardTemplateProduct} href={currentPath} related /></div>
              <div role="listitem" data-smu1-card-template-presentation="premium"><V2ProductCard product={premiumTemplateProduct} href={currentPath} related /></div>
            </div>
          </div>
        </section>
      </template>
    )}

    {relatedProducts.length > 0 && (
      <section
        class="v2-premium-related"
        id="premium-related"
        aria-labelledby="premium-related-title"
        data-premium-product-section
      >
        <div class="hv2-shell">
          <header class="v2-section-heading" data-v2-reveal>
            <div>
              <p class="hv2-eyebrow" {...productUiBinding('premiumRelatedEyebrow')}>{settings.productUi.premiumRelatedEyebrow}</p>
              <h2 id="premium-related-title" {...productUiBinding('premiumRelatedTitle', 'heading')}>{settings.productUi.premiumRelatedTitle}</h2>
            </div>
            <a class="hv2-text-link" href={withBase(relatedHref)} {...productUiBinding('premiumRelatedLinkLabel', 'link-label')}>{settings.productUi.premiumRelatedLinkLabel}</a>
          </header>
          <div
            class="v2-product-grid v2-product-grid--related"
            role="list"
            data-premium-related-count={displayRelatedProducts.length}
            data-catalog-grid-count={displayRelatedProducts.length}
            {...relatedProductsBinding}
            {...relatedProductsEditorMetadata}
          >
            {displayRelatedProducts.map((item) => (
              <div role="listitem"><V2ProductCard product={item.product} href={relatedProductHref(item)} gridCount={displayRelatedProducts.length} related /></div>
            ))}
          </div>
        </div>
      </section>
    )}

    <V2DirectContact
      eyebrow={settings.productUi.premiumContactEyebrow}
      title={finalContactTitle}
      description={finalContactDescription}
      primaryLabel={settings.productUi.premiumContactPrimaryLabel}
      secondaryLabel={settings.productUi.premiumContactSecondaryLabel}
      variant="product"
      eyebrowBinding={productUiBinding('premiumContactEyebrow', 'short-text')}
      titleBinding={binding('customProjectTitle', 'heading', { projection: { kind: 'fallback', fallback: 'site-settings.productUi.premiumDefaultTitle' } })}
      descriptionBinding={binding('customProjectText', 'long-text', { projection: { kind: 'fallback', fallback: 'site-settings.productUi.premiumDefaultDescription' } })}
      primaryLabelBinding={productUiBinding('premiumContactPrimaryLabel', 'link-label')}
      secondaryLabelBinding={productUiBinding('premiumContactSecondaryLabel', 'link-label')}
    />
    </div>
  </div>
</CatalogV2Layout>
