---
import { v2Href } from '../../utils/v2Routes';
import { adminDisposition } from '../../admin/bindings/adminBinding';

interface Props {
  title: string;
  target: string;
}

const { title, target } = Astro.props as Props;
const href = v2Href(target, 'production');
const aliasSource = `compatibility-alias:${Astro.url.pathname}->${target}`;
const fixedCopy = (occurrence: string) => adminDisposition(Astro.url, {
  kind: 'template-fixed',
  reason: `Системный текст совместимого адреса; каноническая страница — ${target}`,
  source: `src/components/v2/LegacyV2Fallback.astro#${occurrence}`
});
const canonicalDisposition = adminDisposition(Astro.url, {
  kind: 'contextual',
  reason: `Это совместимый адрес без собственной записи. Изменения выполняются на канонической странице ${target} и затрагивают оба URL.`,
  source: aliasSource,
  tool: 'open-canonical-page'
});
---

<section class="v2-legacy-fallback" aria-labelledby="legacy-fallback-title">
  <div class="hv2-shell v2-legacy-fallback__inner">
    <p class="hv2-eyebrow" {...fixedCopy('eyebrow')}>Адрес страницы изменился</p>
    <h1 id="legacy-fallback-title" {...canonicalDisposition}>{title}</h1>
    <p {...fixedCopy('description')}>Содержимое доступно по основному адресу. Если переход не начался автоматически, используйте ссылку ниже.</p>
    <a class="hv2-button hv2-button--primary" href={href} {...canonicalDisposition}>Открыть основную страницу</a>
  </div>
</section>

<style>
  .v2-legacy-fallback { min-height: min(62svh, 680px); padding: clamp(7rem, 13vw, 11rem) 0 clamp(4rem, 9vw, 7rem); }
  .v2-legacy-fallback__inner { display: grid; max-width: 760px; gap: 1.25rem; }
  .v2-legacy-fallback h1 { max-width: 15ch; margin: 0; font-size: clamp(2.2rem, 5vw, 4.8rem); line-height: .96; }
  .v2-legacy-fallback p { max-width: 60ch; margin: 0; }
  .v2-legacy-fallback .hv2-button { width: fit-content; }
</style>
