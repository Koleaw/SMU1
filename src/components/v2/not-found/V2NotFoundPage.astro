---
import { v2Href as resolveV2Href } from '../../../utils/v2Routes';
import { getV2TelegramLabel } from '../../../utils/v2SiteSettings';
const withBase = (value: string) => resolveV2Href(value, Astro.url.pathname);
import settings from '../../../content/site-settings/global.json';
import '../../../styles/v2/not-found-v2.css';

const phoneHref = `tel:${settings.phonePrimary.replace(/[^+\d]/g, '')}`;
const telegramLabel = getV2TelegramLabel(settings);
---

<div class="not-found-v2">
  <section class="not-found-v2__main" aria-labelledby="not-found-v2-title" data-home-v2-header-sentinel>
    <div class="hv2-shell hv2-grid not-found-v2__grid">
      <div class="not-found-v2__copy" data-v2-reveal>
        <p class="hv2-eyebrow" data-v2-entrance-role="context">Навигация</p>
        <h1 id="not-found-v2-title" data-v2-entrance-role="title-primary">Страница не найдена</h1>
        <p data-v2-entrance-role="lead">Возможно, адрес изменился или в ссылке есть ошибка. Вернитесь на главную либо откройте список направлений.</p>
        <div class="not-found-v2__actions" data-v2-entrance-role="actions-meta">
          <a class="hv2-button hv2-button--primary" href={withBase('/design-lab/home-v2/')}>На главную</a>
          <a class="hv2-text-link" href={withBase('/design-lab/home-v2/#directions')}>Посмотреть направления</a>
        </div>
      </div>

      <aside class="not-found-v2__contacts" id="contact" aria-labelledby="not-found-v2-contacts-title" data-v2-reveal data-v2-entrance-role="support">
        <p class="hv2-eyebrow">Нужна помощь?</p>
        <h2 id="not-found-v2-contacts-title">Свяжитесь с СМУ-1</h2>
        <a href={phoneHref}><span>Телефон</span><strong>{settings.phonePrimary}</strong></a>
        <a href={settings.telegram} target="_blank" rel="noopener noreferrer"><span>Telegram</span><strong>{telegramLabel}</strong></a>
        <a href={`mailto:${settings.email}`}><span>Email</span><strong>{settings.email}</strong></a>
      </aside>
    </div>
  </section>
</div>
