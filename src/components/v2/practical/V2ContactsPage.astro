---
import settings from '../../../content/site-settings/global.json';
import yandex from '../../../data/yandex.json';
import { v2Href as resolveV2Href } from '../../../utils/v2Routes';
import { getV2Regions, getV2TelegramLabel } from '../../../utils/v2SiteSettings';
const withBase = (value: string) => resolveV2Href(value, Astro.url.pathname);
import V2Breadcrumbs from '../V2Breadcrumbs.astro';
import V2YandexMap from './V2YandexMap.astro';
import { adminBinding, adminDisposition, adminListField, adminListItem } from '../../../admin/bindings/adminBinding';

interface Props {
  taskInputs: Array<{ id: string; label: string }>;
}

const { taskInputs } = Astro.props as Props;
const tel = (value: string) => value.replace(/[^+\d]/g, '');
const regions = getV2Regions(settings);
const telegramLabel = getV2TelegramLabel(settings);
const constructorUrl = new URL(yandex.map.constructorSrc);
const mapWidgetUrl = new URL('https://yandex.ru/map-widget/v1/');
for (const key of ['lang', 'scroll', 'um']) {
  const value = constructorUrl.searchParams.get(key);
  if (value) mapWidgetUrl.searchParams.set(key, value);
}
mapWidgetUrl.searchParams.set('source', 'constructor-api');
const routeUrl = new URL('https://yandex.ru/maps/');
routeUrl.searchParams.set('mode', 'routes');
routeUrl.searchParams.set('rtext', `~${settings.address}`);
routeUrl.searchParams.set('rtt', 'auto');
const copy = settings.contactsPage;
const pageBinding = (fieldPath: string, tool = 'long-text') => adminBinding(Astro.url, {
  renderer: { family: 'practical', variant: 'contacts' }, owner: { collection: 'site-settings', slug: 'global' },
  fieldPath: `contactsPage.${fieldPath}`, stableItemId: `contacts-${fieldPath}`, scope: 'local', tool,
  affectedRoutes: ['/kontakty/']
});
const globalBinding = (fieldPath: string, tool = 'short-text', options: Record<string, unknown> = {}) => adminBinding(Astro.url, {
  renderer: { family: 'global-shell', variant: 'contacts' }, owner: { collection: 'site-settings', slug: 'global' },
  fieldPath, scope: 'global', tool, affectedRoutes: ['*'], ...options
});
const integrationDisposition = (fieldPath: string, reason: string) => adminDisposition(Astro.url, {
  kind: 'global', reason, source: `src/data/yandex.json#${fieldPath}`, tool: 'integration-settings'
});
const routeDisposition = (fragment: string, reason: string) => adminDisposition(Astro.url, {
  kind: 'derived', reason, source: `src/components/v2/practical/V2ContactsPage.astro#${fragment}`, tool: 'page-settings'
});
---

<V2Breadcrumbs items={[
  { title: copy.homeBreadcrumbLabel, href: '/design-lab/home-v2/', editor: pageBinding('homeBreadcrumbLabel', 'short-text') },
  { title: copy.breadcrumbLabel, editor: pageBinding('breadcrumbLabel', 'short-text') }
]} />

<article class="practical-contacts">
  <header class="practical-hero practical-contacts__hero">
    <div class="hv2-shell practical-contacts__hero-grid" data-v2-page-handoff="copy">
      <div data-v2-reveal>
        <p class="hv2-eyebrow" data-v2-entrance-role="context" {...pageBinding('eyebrow', 'short-text')}>{copy.eyebrow}</p>
        <h1 data-v2-entrance-role="title-primary" {...pageBinding('title', 'heading')}>{copy.title}</h1>
      </div>
      <p data-v2-reveal data-v2-entrance-role="lead" {...pageBinding('description', 'long-text')}>{copy.description}</p>
    </div>
  </header>

  <section class="practical-contacts__methods" id="contact-methods" aria-label="Способы связи">
    <div class="hv2-shell">
      <div class="practical-contacts__method-grid">
        <a
          class="practical-contact-card practical-contact-card--primary"
          href={`tel:${tel(settings.phonePrimary)}`}
          aria-label={`Позвонить по основному телефону ${settings.phonePrimary}`}
          data-v2-reveal
        >
          <span {...pageBinding('primaryPhoneLabel', 'short-text')}>{copy.primaryPhoneLabel}</span>
          <strong {...globalBinding('phonePrimary', 'link', { hrefPath: 'phonePrimary' })}>{settings.phonePrimary}</strong>
        </a>
        {settings.phoneSecondary && (
          <a
            class="practical-contact-card"
            href={`tel:${tel(settings.phoneSecondary)}`}
            aria-label={`Позвонить по дополнительному телефону ${settings.phoneSecondary}`}
            data-v2-reveal
          >
            <span {...pageBinding('secondaryPhoneLabel', 'short-text')}>{copy.secondaryPhoneLabel}</span>
            <strong {...globalBinding('phoneSecondary', 'link', { hrefPath: 'phoneSecondary' })}>{settings.phoneSecondary}</strong>
          </a>
        )}
        <a
          class="practical-contact-card"
          href={settings.telegram}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Написать в Telegram ${telegramLabel}`}
          data-v2-reveal
        >
          <span {...pageBinding('telegramCardLabel', 'short-text')}>{copy.telegramCardLabel}</span>
          <strong {...globalBinding('telegramLabel', 'link', { hrefPath: 'telegram' })}>{telegramLabel}</strong>
        </a>
        <a
          class="practical-contact-card practical-contact-card--email"
          href={`mailto:${settings.email}`}
          aria-label={`Написать на электронную почту ${settings.email}`}
          data-v2-reveal
        >
          <span {...pageBinding('emailCardLabel', 'short-text')}>{copy.emailCardLabel}</span>
          <strong {...globalBinding('email', 'link', { hrefPath: 'email' })}>{settings.email}</strong>
        </a>
      </div>
    </div>
  </section>

  <section class="practical-contacts__details" aria-labelledby="contacts-address-title">
    <div class="hv2-shell practical-contacts__details-grid">
      <article class="practical-contacts__address" data-v2-reveal>
        <p class="hv2-eyebrow" {...pageBinding('addressEyebrow', 'short-text')}>{copy.addressEyebrow}</p>
        <h2 id="contacts-address-title" {...globalBinding('address', 'long-text')}>{settings.address}</h2>
        <p {...pageBinding('addressDescription', 'long-text')}>{copy.addressDescription}</p>
        {regions.length > 0 && (
          <p class="practical-contacts__regions"><strong {...pageBinding('regionsLabel', 'short-text')}>{copy.regionsLabel}</strong> <span {...globalBinding('regions', 'list')}>{regions.join(' · ')}</span></p>
        )}
        <iframe
          class="practical-contacts__rating"
          src={yandex.ratingBadge.src}
          width={yandex.ratingBadge.width}
          height={yandex.ratingBadge.height}
          title={copy.ratingTitle}
          loading="lazy"
          {...integrationDisposition('ratingBadge', 'Виджет рейтинга и его адрес настраиваются в защищённых настройках интеграций; подпись доступна в настройках страницы контактов.')}
        ></iframe>
      </article>
      <div class="practical-contacts__map" data-v2-reveal>
        <V2YandexMap
          title={`Яндекс Карта: ${settings.address}`}
          editorAttributes={integrationDisposition('map', 'Провайдер и URL карты являются настройкой интеграции, а не редактируемым текстом страницы.')}
        />
        <div class="practical-contacts__map-actions">
        <a class="practical-contacts__route" href={routeUrl.toString()} target="_blank" rel="noopener noreferrer"
          {...routeDisposition('map-directions', 'Маршрут строится в Яндекс Картах по адресу из настроек компании.')}
        >Построить маршрут <span aria-hidden="true">↗</span></a>
        <a
          class="practical-contacts__map-link"
          href={mapWidgetUrl.toString()}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Открыть адрес ${settings.address} в Яндекс Картах`}
          {...integrationDisposition('map.constructorSrc', 'Адрес перехода вычисляется из проверенной конфигурации Яндекс Карт.')}
        >
          <span {...pageBinding('mapLinkLabel', 'link-label')}>{copy.mapLinkLabel}</span>
        </a>
        </div>
      </div>
    </div>
  </section>

  {taskInputs.length > 0 && (
    <section class="practical-contacts__brief" aria-labelledby="contacts-brief-title">
      <div class="hv2-shell practical-contacts__brief-grid">
        <header data-v2-reveal>
          <p class="hv2-eyebrow" {...pageBinding('briefEyebrow', 'short-text')}>{copy.briefEyebrow}</p>
          <h2 id="contacts-brief-title" {...pageBinding('briefTitle', 'heading')}>{copy.briefTitle}</h2>
          <p {...pageBinding('briefDescription', 'long-text')}>{copy.briefDescription}</p>
        </header>
        <ul data-v2-reveal {...adminBinding(Astro.url, {
          renderer: { family: 'practical', variant: 'contacts-brief' }, owner: { collection: 'static-pages', slug: 'custom-order' },
          fieldPath: 'customOrderSourceMaterials', stableItemId: 'contacts-task-inputs', scope: 'shared', tool: 'list',
          affectedRoutes: ['/kontakty/', '/izgotovlenie-na-zakaz/'], itemKind: 'object',
          permissions: { edit: true, reorder: true, delete: false },
          itemFields: [
            { fieldPath: 'id', tool: 'generated-id' },
            { fieldPath: 'label', label: 'Исходный материал', tool: 'short-text' },
            { fieldPath: 'order', tool: 'generated-order' },
            { fieldPath: 'isActive', label: 'Показывать пункт', tool: 'visibility' }
          ]
        })}>
          {taskInputs.map((item) => (
            <li {...adminListItem(Astro.url, item.id)}><strong {...adminListField(Astro.url, 'label')}>{item.label}</strong></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="practical-contacts__legal" aria-labelledby="contacts-legal-title">
    <div class="hv2-shell practical-contacts__legal-grid">
      <div data-v2-reveal>
        <p class="hv2-eyebrow" {...pageBinding('requisitesEyebrow', 'short-text')}>{copy.requisitesEyebrow}</p>
        <h2 id="contacts-legal-title" {...globalBinding('companyName')}>{settings.companyName}</h2>
        <p {...globalBinding('legalAddress', 'long-text')}>{settings.legalAddress}</p>
      </div>
      <dl data-v2-reveal>
        <div><dt {...pageBinding('innLabel', 'short-text')}>{copy.innLabel}</dt><dd {...globalBinding('inn')}>{settings.inn}</dd></div>
        <div><dt {...pageBinding('kppLabel', 'short-text')}>{copy.kppLabel}</dt><dd {...globalBinding('kpp')}>{settings.kpp}</dd></div>
        <div><dt {...pageBinding('ogrnLabel', 'short-text')}>{copy.ogrnLabel}</dt><dd {...globalBinding('ogrn')}>{settings.ogrn}</dd></div>
      </dl>
      <div class="practical-contacts__related" data-v2-reveal>
        <a href={withBase('/design-lab/v2/o-nas/')} {...routeDisposition('about-route', 'Адрес вычисляется из канонического route страницы компании.')}><span {...pageBinding('aboutLabel', 'link-label')}>{copy.aboutLabel}</span></a>
        <a href={withBase('/design-lab/v2/vakansii/')} {...routeDisposition('vacancies-route', 'Адрес вычисляется из канонического route архива вакансий.')}><span {...pageBinding('vacanciesLabel', 'link-label')}>{copy.vacanciesLabel}</span></a>
      </div>
    </div>
  </section>

  <section class="practical-contacts__cta" aria-labelledby="contacts-cta-title">
    <div class="hv2-shell practical-contacts__cta-grid">
      <div data-v2-reveal>
        <p class="hv2-eyebrow hv2-eyebrow--light" {...pageBinding('ctaEyebrow', 'short-text')}>{copy.ctaEyebrow}</p>
        <h2 id="contacts-cta-title" {...pageBinding('ctaTitle', 'heading')}>{copy.ctaTitle}</h2>
      </div>
      <div class="hv2-actions" data-v2-reveal>
        <a class="hv2-button hv2-button--light" href={settings.telegram} target="_blank" rel="noopener noreferrer">
          <span {...pageBinding('primaryLabel', 'button-label')}>{copy.primaryLabel}</span>
        </a>
        <a class="hv2-button hv2-button--contrast" href={`tel:${tel(settings.phonePrimary)}`}>
          <span {...pageBinding('secondaryLabel', 'button-label')}>{copy.secondaryLabel}</span>
        </a>
      </div>
    </div>
  </section>
</article>

<style>
  .practical-contacts__map { display: flex; flex-direction: column; }
  .practical-contacts__map > :global(.practical-yandex-map) { flex: 1 0 auto; }
  .practical-contacts__map-actions { display: flex; flex-wrap: wrap; align-items: stretch; background: #253b40; }
  .practical-contacts__map-actions a { display: flex; flex: 1 1 15rem; align-items: center; justify-content: space-between; gap: 1rem; min-height: 58px; padding: 16px 20px; border: 0; background: transparent; color: #faf8f1; font-weight: 600; text-decoration: none; }
  .practical-contacts__map-actions .practical-contacts__route { background: #d4b68a; color: #172c31; }
  .practical-contacts__map-actions a:hover { text-decoration: underline; text-underline-offset: .25em; }
  .practical-contacts__map-actions a:focus-visible { outline: 3px solid #fff; outline-offset: -5px; }
  .practical-contacts__map-actions .practical-contacts__route:focus-visible { outline-color: #172c31; }
</style>
