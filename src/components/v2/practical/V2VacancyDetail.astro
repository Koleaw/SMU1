---
import settings from '../../../content/site-settings/global.json';
import { v2Href as resolveV2Href } from '../../../utils/v2Routes';
import { getV2TelegramLabel } from '../../../utils/v2SiteSettings';
const withBase = (value: string) => resolveV2Href(value, Astro.url.pathname);
import V2Breadcrumbs from '../V2Breadcrumbs.astro';
import type { V2JobRecord } from './practicalV2Data';
import { nonEmptyItems } from './practicalV2Data';

interface Props {
  job: V2JobRecord;
}

const { job } = Astro.props as Props;
const tel = (value: string) => value.replace(/[^+\d]/g, '');
const telegramLabel = getV2TelegramLabel(settings);
const sections = [
  { id: 'vacancy-responsibilities', title: 'Обязанности', items: nonEmptyItems(job.responsibilities) },
  { id: 'vacancy-requirements', title: 'Требования', items: nonEmptyItems(job.requirements) },
  { id: 'vacancy-conditions', title: 'Условия', items: nonEmptyItems(job.conditions) }
].filter((section) => section.items.length > 0);
const facts = [
  job.city ? { label: 'Город', value: job.city } : null,
  job.employmentType ? { label: 'Занятость', value: job.employmentType } : null,
  job.salary ? { label: 'Оплата', value: job.salary } : null
].filter((item): item is { label: string; value: string } => Boolean(item));
---

<V2Breadcrumbs items={[
  { title: 'Главная', href: '/design-lab/home-v2/' },
  { title: 'Вакансии', href: '/design-lab/v2/vakansii/' },
  { title: job.title }
]} />

<article class="practical-vacancy">
  <header class="practical-vacancy__hero">
    <div class="hv2-shell practical-vacancy__hero-grid" data-v2-page-handoff="copy">
      <div data-v2-reveal>
        <p class="hv2-eyebrow">Вакансия</p>
        <h1>{job.title}</h1>
        {job.shortDescription && <p class="practical-hero__lead">{job.shortDescription}</p>}
        <a class="practical-vacancy__back" href={withBase('/design-lab/v2/vakansii/')}>
          Все вакансии
        </a>
      </div>
      {facts.length > 0 && (
        <dl data-v2-reveal>
          {facts.map((fact) => (
            <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>
          ))}
        </dl>
      )}
    </div>
  </header>

  {sections.length > 0 && (
    <div class="practical-vacancy__content hv2-shell">
      {sections.map((section) => (
        <section aria-labelledby={section.id} data-v2-reveal>
          <h2 id={section.id}>{section.title}</h2>
          <ul>{section.items.map((item) => <li>{item}</li>)}</ul>
        </section>
      ))}
    </div>
  )}

  <section class="practical-vacancy__contact" id="vacancy-contact" aria-labelledby="vacancy-contact-title">
    <div class="hv2-shell practical-vacancy__contact-grid">
      <div data-v2-reveal>
        <p class="hv2-eyebrow hv2-eyebrow--light">Откликнуться</p>
        <h2 id="vacancy-contact-title">Свяжитесь удобным способом</h2>
      </div>
      <div class="practical-vacancy__channels" data-v2-reveal>
        <a href={`mailto:${settings.email}`}><span>Email</span><strong>{settings.email}</strong></a>
        <a href={`tel:${tel(settings.phonePrimary)}`}><span>Телефон</span><strong>{settings.phonePrimary}</strong></a>
        <a href={settings.telegram} target="_blank" rel="noopener noreferrer"><span>Telegram</span><strong>{telegramLabel}</strong></a>
      </div>
    </div>
  </section>

  <nav class="practical-related-pages" aria-label="Связанные страницы">
    <div class="hv2-shell">
      <p>Узнать больше о СМУ-1</p>
      <a href={withBase('/design-lab/v2/o-nas/')}>О компании</a>
      <a href={withBase('/design-lab/v2/kontakty/')}>Контакты</a>
    </div>
  </nav>
</article>
