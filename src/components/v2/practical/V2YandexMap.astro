---
import yandex from '../../../data/yandex.json';

interface Props {
  title: string;
}

const { title } = Astro.props as Props;
---

<div
  class="practical-yandex-map"
  role="region"
  aria-label={title}
  data-v2-yandex-map
  data-v2-map-title={title}
  data-v2-map-constructor={yandex.map.constructorSrc}
>
  <div class="practical-yandex-map__placeholder" data-v2-map-placeholder hidden>
    <p>Интерактивная карта загружается по запросу.</p>
    <button type="button" data-v2-map-activate>Показать карту</button>
  </div>
  <span class="practical-yandex-map__status" role="status" aria-live="polite" data-v2-map-status></span>
  <noscript>Адрес и ссылка «Открыть в Яндекс Картах» доступны рядом с картой.</noscript>
</div>

<script is:inline>
  (() => {
    document.querySelectorAll('[data-v2-yandex-map]').forEach((map) => {
      if (map.dataset.v2MapReady === 'true') return;
      map.dataset.v2MapReady = 'true';
      const title = map.dataset.v2MapTitle || 'Яндекс Карта';
      const constructorSrc = map.dataset.v2MapConstructor || '';
      const activateButton = map.querySelector('[data-v2-map-activate]');
      const placeholder = map.querySelector('[data-v2-map-placeholder]');
      const status = map.querySelector('[data-v2-map-status]');
      placeholder?.removeAttribute('hidden');
      map.dataset.v2MapState = 'idle';
      let started = false;
      let observer;
      let timeoutId = 0;
      let script;
      const failOpen = (message) => {
        started = false;
        observer?.disconnect();
        window.clearTimeout(timeoutId);
        script?.remove();
        map.dataset.v2MapState = 'error';
        if (status) status.textContent = message;
        if (activateButton) {
          activateButton.disabled = false;
          activateButton.focus({ preventScroll: true });
        }
      };
      const labelFrames = () => {
        const frames = map.querySelectorAll('iframe');
        frames.forEach((frame) => {
          frame.setAttribute('title', title);
          frame.setAttribute('tabindex', '0');
        });
        if (frames.length > 0) {
          observer?.disconnect();
          window.clearTimeout(timeoutId);
          if (status) status.textContent = 'Карта загружена.';
          placeholder?.setAttribute('hidden', '');
          map.dataset.v2MapState = 'ready';
          window.requestAnimationFrame(() => frames[0]?.focus({ preventScroll: true }));
        }
        return frames.length > 0;
      };
      const activate = () => {
        if (started || !constructorSrc) return;
        started = true;
        map.dataset.v2MapState = 'loading';
        if (status) status.textContent = 'Загружаем карту…';
        if (activateButton) activateButton.disabled = true;
        script = document.createElement('script');
        script.async = true;
        script.setAttribute('charset', 'utf-8');
        script.src = constructorSrc;
        observer = new MutationObserver(() => {
          if (!labelFrames()) return;
          observer.disconnect();
        });
        observer.observe(map, { childList: true, subtree: true });
        timeoutId = window.setTimeout(() => {
          if (labelFrames()) return;
          failOpen('Карту не удалось загрузить. Используйте ссылку ниже.');
        }, 15000);
        script.addEventListener('error', () => {
          failOpen('Карту не удалось загрузить. Используйте ссылку ниже.');
        }, { once: true });
        map.append(script);
      };

      activateButton?.addEventListener('click', activate);
      if (!constructorSrc && activateButton) {
        activateButton.disabled = true;
        map.dataset.v2MapState = 'error';
        if (status) status.textContent = 'Интерактивная карта временно недоступна. Используйте ссылку ниже.';
      }
    });
  })();
</script>
