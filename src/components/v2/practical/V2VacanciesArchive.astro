---
import settings from '../../../content/site-settings/global.json';
import { v2Href as resolveV2Href } from '../../../utils/v2Routes';
const withBase = (value: string) => resolveV2Href(value, Astro.url.pathname);
import V2Breadcrumbs from '../V2Breadcrumbs.astro';
import type { V2JobRecord } from './practicalV2Data';
import { vacancyV2Route } from './practicalV2Data';

interface Props {
  jobs: V2JobRecord[];
}

const { jobs } = Astro.props as Props;
const jobFacts = (job: V2JobRecord) => [
  job.city ? { label: 'Город', value: job.city } : null,
  job.employmentType ? { label: 'Занятость', value: job.employmentType } : null,
  job.salary ? { label: 'Оплата', value: job.salary } : null
].filter((item): item is { label: string; value: string } => Boolean(item));
---

<V2Breadcrumbs items={[
  { title: 'Главная', href: '/design-lab/home-v2/' },
  { title: 'Вакансии' }
]} />

<article class="practical-vacancies">
  <header class="practical-hero practical-vacancies__hero">
    <div class="hv2-shell practical-vacancies__hero-grid" data-v2-page-handoff="copy">
      <div data-v2-reveal>
        <p class="hv2-eyebrow">Работа в СМУ-1</p>
        <h1>Вакансии</h1>
      </div>
      <p data-v2-reveal>Здесь размещаются актуальные вакансии СМУ-1. В списке показаны только открытые позиции.</p>
    </div>
  </header>

  <section class="practical-vacancies__list" aria-label="Открытые вакансии">
    <div class="hv2-shell">
      {jobs.length > 0 ? (
          <div class:list={['practical-vacancies__cards', { 'practical-vacancies__cards--single': jobs.length === 1 }]}>
            {jobs.map((job) => (
              <article class="practical-vacancy-card" data-v2-reveal>
                <div>
                  <p class="hv2-eyebrow">Открытая позиция</p>
                  <h2>{job.title}</h2>
                  {job.shortDescription && <p>{job.shortDescription}</p>}
                </div>
                {jobFacts(job).length > 0 && (
                  <dl>
                    {jobFacts(job).map((fact) => (
                      <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>
                    ))}
                  </dl>
                )}
                <a class="hv2-button hv2-button--primary" href={withBase(vacancyV2Route(job))}>
                  Подробнее
                </a>
              </article>
            ))}
          </div>
      ) : (
        <article class="practical-vacancies__empty" data-v2-reveal>
          <p class="hv2-eyebrow">Вакансии</p>
          <h2>{settings.vacanciesEmptyTitle}</h2>
          <p>{settings.vacanciesEmptyText}</p>
        </article>
      )}
    </div>
  </section>

  <nav class="practical-related-pages" aria-label="Связанные страницы">
    <div class="hv2-shell">
      <p>Узнать больше о СМУ-1</p>
      <a href={withBase('/design-lab/v2/o-nas/')}>О компании</a>
      <a href={withBase('/design-lab/v2/kontakty/')}>Контакты</a>
    </div>
  </nav>
</article>
