---
import type { CollectionEntry } from 'astro:content';
import settings from '../../../content/site-settings/global.json';
import { v2Href as resolveV2Href } from '../../../utils/v2Routes';
import { loadV2Directions } from '../../../utils/v2Directions';
import { getV2Regions } from '../../../utils/v2SiteSettings';
import type { V2ProjectPresentation } from '../mediaRoleAdapter';
import V2ProjectArchiveGateway from '../projects/V2ProjectArchiveGateway.astro';
import V2Breadcrumbs from '../V2Breadcrumbs.astro';
import V2DirectContact from '../V2DirectContact.astro';
import V2SectionNav from '../V2SectionNav.astro';
import V2ResponsiveImage from '../V2ResponsiveImage.astro';
  import { adminBinding, adminDisposition, adminListField, adminListItem, isLocalAdminCanvas } from '../../../admin/bindings/adminBinding';

interface Props {
  page: CollectionEntry<'static-pages'>['data'];
  projects: V2ProjectPresentation[];
}

type AboutCard = {
  id: string;
  title?: string;
  text?: string;
  order?: number;
  isActive?: boolean;
};

type AboutBlock = AboutCard & {
  type: string;
  intro?: string;
  buttonLabel?: string;
  secondaryButtonLabel?: string;
  items?: unknown[];
};

const { page, projects } = Astro.props as Props;
const withBase = (value: string) => resolveV2Href(value, Astro.url.pathname);
const contentValue = (value: string | undefined, fallback: string) => value?.trim() || fallback;

const heroKicker = contentValue(page.heroKicker, 'О компании');
const heroTitle = contentValue(
  page.heroTitle,
  'Соединяем производство, конструкции и работу на объекте'
);
const heroDescription = contentValue(
  page.heroDescription,
  'СМУ-1 изготавливает изделия и металлоконструкции, выполняет благоустройство, строительные и монтажные работы для коммерческих, общественных и производственных объектов.'
);
const heroPrimaryLabel = contentValue(page.heroPrimaryLabel, 'Смотреть выполненные объекты');
const heroSecondaryLabel = contentValue(page.heroSecondaryLabel, 'Обсудить задачу');
const contactTitle = contentValue(page.contactTitle, 'Обсудим задачу для вашего объекта');
const contactDescription = contentValue(
  page.contactDescription,
  'Пришлите фотографию, размеры, эскиз, чертёж, ТЗ или краткое описание задачи. Уточним исходные данные и состав работ.'
);
const contactEyebrow = contentValue(page.contactEyebrow, 'Прямая связь');

const pageBlocks = (page.pageBlocks ?? []) as AboutBlock[];
const whoBlock = pageBlocks.find((block) => block.type === 'whoWeAre' && block.isActive !== false);
const capabilitiesBlock = pageBlocks.find((block) => block.type === 'directionCards' && block.isActive !== false);
const proofBlock = pageBlocks.find((block) => block.type === 'companyProof' && block.isActive !== false);
const directionsBlock = pageBlocks.find((block) => block.type === 'companyDirections' && block.isActive !== false);
const detailsBlock = pageBlocks.find((block) => block.type === 'companyDetails' && block.isActive !== false);
const contactBlock = pageBlocks.find((block) => block.type === 'cta' && block.isActive !== false);
const capabilities = ((capabilitiesBlock?.items ?? []) as AboutCard[])
  .filter((item) => item.isActive !== false && item.title?.trim() && item.text?.trim())
  .sort((a, b) => (a.order ?? 0) - (b.order ?? 0));

const directions = await loadV2Directions();
const regions = getV2Regions(settings);
const coverageRegions = regions.filter((region) => region !== settings.city);

const productionProject = projects.find(
  (item) => item.project.slug === page.companyHeroProjectSlug
);
const heroMedia = productionProject?.detailHeroMedia;
const heroPosition = page.companyHeroPosition ?? productionProject?.detailHeroPosition ?? '50% 50%';
const isEditorCanvas = isLocalAdminCanvas(Astro.url);

const sectionNavItems = [
  { id: 'company-overview', label: 'О компании' },
  { id: 'company-projects', label: 'Выполненные объекты' },
  { id: 'company-directions', label: 'Направления' },
  { id: 'company-details', label: 'Реквизиты' },
  { id: 'contact', label: 'Контакты' }
];
const phoneHref = `tel:${settings.phonePrimary.replace(/[^+\d]/g, '')}`;
const projectsTitle = contentValue(proofBlock?.title, 'Работы на реальных объектах');
const projectsDescription = contentValue(
  proofBlock?.text,
  'Фотографии и состав выполненных работ собраны в отдельном разделе.'
);
const projectsArchiveLabel = contentValue(proofBlock?.buttonLabel, 'Перейти к объектам');
const directionsEyebrow = contentValue(directionsBlock?.intro, 'Направления');
const directionsTitle = contentValue(directionsBlock?.title, 'Выберите направление по задаче объекта');
const detailsEyebrow = contentValue(detailsBlock?.intro, 'География и доверие');
const detailsTitle = contentValue(detailsBlock?.title, 'География и реквизиты');
const contactPrimaryLabel = contentValue(contactBlock?.buttonLabel, 'Получить расчёт');
const contactSecondaryLabel = contentValue(contactBlock?.secondaryButtonLabel, 'Позвонить');
const pageRoute = '/o-nas/';
const companyCopy = settings.companyPage;
const pageBinding = (fieldPath: string, tool = 'long-text', options: Record<string, unknown> = {}) => adminBinding(Astro.url, {
  renderer: { family: 'practical', variant: 'company' }, owner: { collection: 'static-pages', slug: page.slug },
  fieldPath, scope: 'local', tool, affectedRoutes: [pageRoute], ...options
});
const globalBinding = (fieldPath: string, tool = 'short-text', options: Record<string, unknown> = {}) => adminBinding(Astro.url, {
  renderer: { family: 'global-shell', variant: 'company' }, owner: { collection: 'site-settings', slug: 'global' },
  fieldPath, scope: 'global', tool, affectedRoutes: ['*'], ...options
});
const companyPageBinding = (fieldPath: string, tool = 'short-text', occurrence = fieldPath) => adminBinding(Astro.url, {
  renderer: { family: 'practical', variant: 'company-copy' }, owner: { collection: 'site-settings', slug: 'global' },
  fieldPath: `companyPage.${fieldPath}`, stableItemId: `company-${occurrence}`, scope: 'local', tool,
  affectedRoutes: [pageRoute]
});
const fixedPrefix = (source: string, reason: string) => adminDisposition(Astro.url, {
  kind: 'template-fixed', reason, source: `src/components/v2/practical/V2CompanyPage.astro#${source}`
});
const blockPath = (block: AboutBlock | undefined, suffix: string) => {
  const index = block ? pageBlocks.indexOf(block) : -1;
  return index >= 0 ? `pageBlocks[${index}].${suffix}` : suffix;
};
const companyHeroMediaBinding = productionProject ? adminBinding(Astro.url, {
  renderer: { family: 'practical', variant: 'company-hero-media' },
  owner: { collection: 'projects', slug: productionProject.project.slug },
  fieldPath: 'presentation.detailHeroMedia', stableItemId: 'company-hero-project-media',
  scope: 'shared', tool: 'media', label: `Фотография объекта «${productionProject.project.title}»`,
  affectedRoutes: [pageRoute, productionProject.productionRoute], role: 'detail-hero', multiple: false,
  projection: { kind: 'shared-media', formula: 'project.presentation.detailHeroMedia → company hero' }
}) : {};
const companyHeroRelationBinding = pageBinding('companyHeroProjectSlug', 'relation-select', {
  stableItemId: 'company-hero-source', role: 'company-hero-source',
  label: 'Объект-источник фотографии',
  relationCollection: 'projects', validation: { required: true },
  projection: { kind: 'relation', formula: 'companyHeroProjectSlug → project.presentation.detailHeroMedia' },
  relationProjection: {
    mediaBindingId: companyHeroMediaBinding['data-smu1-binding-id'] || '',
    mediaFieldPaths: ['presentation.detailHeroMedia', 'presentation.archiveCoverMedia', 'presentation.publicGallery'],
    positionFields: [{ fieldPath: 'companyHeroPosition', cssProperty: '--company-hero-position' }]
  }
});
---

<article class="practical-company">
  <header
    class="practical-company__hero"
    data-hv2-hero
    style={`--company-hero-position: ${heroPosition};`}
  >
    {heroMedia && (
      <div
        class="practical-company__hero-image"
        data-v2-media
        data-v2-entrance-role="media"
        data-smu1-borrowed-media-root={isEditorCanvas ? 'true' : undefined}
        {...companyHeroRelationBinding}
      >
        <V2ResponsiveImage
          src={heroMedia.src}
          alt={heroMedia.alt}
          role="hero"
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          data-v2-image
          data-v2-page-critical
          data-smu1-borrowed-media={isEditorCanvas ? 'true' : undefined}
          {...companyHeroMediaBinding}
        />
        <div class="v2-media-empty" aria-hidden="true"><p>Изображение компании недоступно</p></div>
      </div>
    )}
    <div class="practical-company__hero-edge" aria-hidden="true"></div>

    <div class="hv2-shell practical-company__hero-inner">
      <div class="practical-company__breadcrumbs" data-v2-entrance-role="context">
        <V2Breadcrumbs
          variant="overlay"
          items={[
            { title: companyCopy.homeBreadcrumbLabel, href: '/design-lab/home-v2/', editor: companyPageBinding('homeBreadcrumbLabel', 'short-text', 'home-breadcrumb') },
            { title: companyCopy.breadcrumbLabel, editor: companyPageBinding('breadcrumbLabel', 'short-text', 'current-breadcrumb') }
          ]}
        />
      </div>

      <div class="practical-company__hero-copy" data-v2-page-handoff="copy">
        <p class="hv2-eyebrow hv2-eyebrow--light" data-v2-entrance-role="context" {...pageBinding('heroKicker', 'short-text')}>{heroKicker}</p>
        <h1 data-v2-entrance-role="title-primary" {...pageBinding('heroTitle', 'heading')}>{heroTitle}</h1>
        <p class="practical-company__hero-lead" data-v2-entrance-role="lead" {...pageBinding('heroDescription', 'long-text')}>{heroDescription}</p>
        <div class="hv2-actions practical-company__hero-actions" data-v2-entrance-role="actions-meta">
          <a class="hv2-button hv2-button--light" href="#company-projects" {...pageBinding('heroPrimaryLabel', 'button-label')}>
            {heroPrimaryLabel}
          </a>
          <a class="hv2-button hv2-button--ghost" href="#contact" {...pageBinding('heroSecondaryLabel', 'button-label')}>
            {heroSecondaryLabel}
          </a>
        </div>
      </div>
    </div>
  </header>

  <V2SectionNav
    items={sectionNavItems}
    label="Навигация по странице о компании"
    editorSource="src/components/v2/practical/V2CompanyPage.astro#sectionNavItems"
  />

  <section class="practical-company__overview" id="company-overview" aria-labelledby="company-overview-title">
    <div class="hv2-shell">
      <div class="practical-company__overview-intro">
        <h2 id="company-overview-title" {...pageBinding(blockPath(whoBlock, 'title'), 'heading')}>
          {contentValue(whoBlock?.title, 'Работаем на стыке цеха и площадки')}
        </h2>
        <p {...pageBinding(blockPath(whoBlock, 'text'), 'long-text')}>{contentValue(
          whoBlock?.text,
          'СМУ-1 работает на стыке производства, металлоконструкций, благоустройства и прикладных работ на объектах. Мы не ограничиваемся одной товарной линейкой: подбираем решение под назначение площадки, размеры, основание, внешний вид и условия эксплуатации.'
        )}</p>
      </div>

      <dl class="practical-company__fact-rail" aria-label="Проверенные сведения о компании">
        <div>
          <dt {...companyPageBinding('companyLabel', 'short-text', 'fact-company')}>{companyCopy.companyLabel}</dt>
          <dd {...globalBinding('companyName', 'short-text', { stableItemId: 'company-fact-name' })}>{settings.companyName}</dd>
        </div>
        <div>
          <dt {...companyPageBinding('cityLabel', 'short-text', 'fact-city')}>{companyCopy.cityLabel}</dt>
          <dd {...globalBinding('city', 'short-text', { stableItemId: 'company-fact-city' })}>{settings.city}</dd>
        </div>
        <div>
          <dt {...companyPageBinding('registrationLabel', 'short-text', 'fact-registration')}>{companyCopy.registrationLabel}</dt>
          <dd><span {...fixedPrefix('registered-prefix', 'Грамматический префикс даты регистрации фиксирован шаблоном; редактируется только значение даты.')}>Зарегистрировано </span><span {...globalBinding('registrationDate', 'short-text', { stableItemId: 'company-fact-registration-date' })}>{settings.registrationDate}</span></dd>
        </div>
        <div>
          <dt {...companyPageBinding('regionsLabel', 'short-text', 'fact-regions')}>{companyCopy.regionsLabel}</dt>
          <dd {...globalBinding('regions', 'list', { stableItemId: 'company-fact-regions' })}>{coverageRegions.join(' · ')}</dd>
        </div>
      </dl>

      {capabilities.length > 0 && (
        <div class="practical-company__capabilities" aria-label="Основные возможности компании" {...pageBinding(blockPath(capabilitiesBlock, 'items'), 'list', {
          stableItemId: 'company-capabilities',
          itemKind: 'object',
          permissions: { edit: true, reorder: true, delete: false },
          itemFields: [
            { fieldPath: 'id', tool: 'generated-id' },
            { fieldPath: 'title', label: 'Название возможности', tool: 'short-text' },
            { fieldPath: 'text', label: 'Описание', tool: 'long-text' },
            { fieldPath: 'order', tool: 'generated-order' },
            { fieldPath: 'isActive', label: 'Показывать возможность', tool: 'visibility' }
          ]
        })}>
          {capabilities.map((item) => (
            <article {...adminListItem(Astro.url, item.id)}>
              <h3 {...adminListField(Astro.url, 'title')}>{item.title}</h3>
              <p {...adminListField(Astro.url, 'text')}>{item.text}</p>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

  <V2ProjectArchiveGateway
    variant="company"
    sectionId="company-projects"
    title={projectsTitle}
    description={projectsDescription}
    ctaLabel={projectsArchiveLabel}
    projectSlugs={page.gatewayProjectSlugs ?? []}
    projectSelectionField="gatewayProjectSlugs"
    excludeSources={heroMedia ? [heroMedia.src] : []}
    bindingOwner={{ collection: 'static-pages', slug: page.slug }}
    bindingFields={{ title: blockPath(proofBlock, 'title'), description: blockPath(proofBlock, 'text'), ctaLabel: blockPath(proofBlock, 'buttonLabel') }}
  />

  <section class="practical-company__directions" id="company-directions" aria-labelledby="company-directions-title">
    <div class="hv2-shell">
      <header class="practical-company__section-heading">
        <p class="hv2-eyebrow" {...pageBinding(blockPath(directionsBlock, 'intro'), 'short-text')}>{directionsEyebrow}</p>
        <h2 id="company-directions-title" {...pageBinding(blockPath(directionsBlock, 'title'), 'heading')}>{directionsTitle}</h2>
      </header>
      <nav class="practical-company__direction-index" aria-label="Направления работы СМУ-1">
        <ul role="list">
          {directions.map((item, index) => (
            <li class:list={{ 'practical-company__direction-break': index === 5 }}>
              <a href={withBase(item.href)}>
                <strong {...adminBinding(Astro.url, {
                  renderer: { family: 'practical', variant: 'company-direction' }, owner: { collection: item.ownerCollection, slug: item.slug },
                  fieldPath: 'title', stableItemId: item.slug, scope: 'shared', tool: 'heading', affectedRoutes: [pageRoute, item.href]
                })}>{item.title}</strong>
                <span {...adminBinding(Astro.url, {
                  renderer: { family: 'practical', variant: 'company-direction' }, owner: { collection: item.ownerCollection, slug: item.slug },
                  fieldPath: 'shortDescription', stableItemId: item.slug, scope: 'shared', tool: 'long-text', affectedRoutes: [pageRoute, item.href]
                })}>{item.description}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </section>

  <section class="practical-company__details" id="company-details" aria-labelledby="company-details-title">
    <div class="hv2-shell practical-company__details-grid">
      <div class="practical-company__details-intro">
        <p class="hv2-eyebrow" {...pageBinding(blockPath(detailsBlock, 'intro'), 'short-text')}>{detailsEyebrow}</p>
        <h2 id="company-details-title" {...pageBinding(blockPath(detailsBlock, 'title'), 'heading')}>{detailsTitle}</h2>
        <p class="practical-company__details-company" {...globalBinding('companyName', 'short-text', { stableItemId: 'company-details-name' })}>{settings.companyName}</p>
        <p {...globalBinding('city', 'short-text', { stableItemId: 'company-details-city' })}>{settings.city}</p>
        <address {...globalBinding('address', 'long-text', { stableItemId: 'company-details-address' })}>{settings.address}</address>
        <ul aria-label="Регионы работы" {...globalBinding('regions', 'list', { stableItemId: 'company-details-regions' })}>
          {coverageRegions.map((region) => <li>{region}</li>)}
        </ul>
        <div class="practical-company__details-links">
          <a class="hv2-text-link" href={withBase('/kontakty/')} {...companyPageBinding('contactsLabel', 'link-label', 'details-contacts')}>{companyCopy.contactsLabel}</a>
          <a class="hv2-text-link" href={withBase('/politika-konfidencialnosti/')} {...companyPageBinding('privacyLabel', 'link-label', 'details-privacy')}>{companyCopy.privacyLabel}</a>
        </div>
      </div>

      <dl class="practical-company__requisites">
        <div><dt {...companyPageBinding('companyLabel', 'short-text', 'requisite-company')}>{companyCopy.companyLabel}</dt><dd {...globalBinding('companyName', 'short-text', { stableItemId: 'company-requisite-name' })}>{settings.companyName}</dd></div>
        <div><dt {...companyPageBinding('innLabel', 'short-text', 'requisite-inn')}>{companyCopy.innLabel}</dt><dd {...globalBinding('inn')}>{settings.inn}</dd></div>
        <div><dt {...companyPageBinding('kppLabel', 'short-text', 'requisite-kpp')}>{companyCopy.kppLabel}</dt><dd {...globalBinding('kpp')}>{settings.kpp}</dd></div>
        <div><dt {...companyPageBinding('ogrnLabel', 'short-text', 'requisite-ogrn')}>{companyCopy.ogrnLabel}</dt><dd {...globalBinding('ogrn')}>{settings.ogrn}</dd></div>
        <div><dt {...companyPageBinding('registrationDateLabel', 'short-text', 'requisite-registration-date')}>{companyCopy.registrationDateLabel}</dt><dd {...globalBinding('registrationDate', 'short-text', { stableItemId: 'company-requisite-registration-date' })}>{settings.registrationDate}</dd></div>
        <div><dt {...companyPageBinding('legalAddressLabel', 'short-text', 'requisite-legal-address')}>{companyCopy.legalAddressLabel}</dt><dd {...globalBinding('legalAddress', 'long-text')}>{settings.legalAddress}</dd></div>
        <div><dt {...companyPageBinding('contactAddressLabel', 'short-text', 'requisite-contact-address')}>{companyCopy.contactAddressLabel}</dt><dd {...globalBinding('address', 'long-text', { stableItemId: 'company-requisite-contact-address' })}>{settings.address}</dd></div>
      </dl>
    </div>
  </section>

  <V2DirectContact
    eyebrow={contactEyebrow}
    title={contactTitle}
    description={contactDescription}
    primaryLabel={contactPrimaryLabel}
    secondaryLabel={contactSecondaryLabel}
    secondaryHref={phoneHref}
    eyebrowBinding={pageBinding('contactEyebrow', 'short-text')}
    titleBinding={pageBinding('contactTitle', 'heading')}
    descriptionBinding={pageBinding('contactDescription', 'long-text')}
    primaryLabelBinding={pageBinding(blockPath(contactBlock, 'buttonLabel'), 'button-label')}
    secondaryLabelBinding={pageBinding(blockPath(contactBlock, 'secondaryButtonLabel'), 'button-label')}
    editorSource="src/components/v2/practical/V2CompanyPage.astro#contact"
  />
</article>
