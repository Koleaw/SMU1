---
import DirectionV2Layout from '../directions/DirectionV2Layout.astro';
import '../../../styles/v2/engineering-direction-v2.css';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  currentPath: string;
  ogImage?: string;
  variant?: 'metalworks';
}

const {
  title,
  description,
  canonicalPath,
  currentPath,
  ogImage = '',
  variant
} = Astro.props as Props;
---

<DirectionV2Layout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  currentPath={currentPath}
  ogImage={ogImage}
  variant="engineering-commercial"
>
  <div
    class:list={[
      'engineering-direction-v2',
      { 'engineering-direction-v2--metalworks': variant === 'metalworks' }
    ]}
    data-engineering-direction-v2
  >
    <slot />
  </div>
</DirectionV2Layout>
