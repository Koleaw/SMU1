---
import DirectionV2Layout from '../directions/DirectionV2Layout.astro';
import '../../../styles/v2/engineering-direction-v2.css';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  currentPath: string;
  ogImage?: string;
}

const { title, description, canonicalPath, currentPath, ogImage = '' } = Astro.props as Props;
---

<DirectionV2Layout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  currentPath={currentPath}
  ogImage={ogImage}
  variant="engineering-commercial"
>
  <div class="engineering-direction-v2" data-engineering-direction-v2>
    <slot />
  </div>
</DirectionV2Layout>
