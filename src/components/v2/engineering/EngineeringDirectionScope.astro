---
interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  items: string[];
}

const { eyebrow = 'Контекст задачи', title, description, items } = Astro.props as Props;
---

{items.length > 0 && (
  <section class="engineering-scope" aria-labelledby="engineering-scope-title">
    <div class="hv2-shell hv2-grid engineering-scope__grid">
      <header class="engineering-scope__heading" data-v2-reveal>
        <p class="hv2-eyebrow">{eyebrow}</p>
        <h2 id="engineering-scope-title">{title}</h2>
        <p>{description}</p>
      </header>
      <ul class="engineering-scope__list" data-v2-reveal>
        {items.map((item) => (
          <li><p>{item}</p></li>
        ))}
      </ul>
    </div>
  </section>
)}
