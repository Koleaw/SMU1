---
import { v2Href as resolveV2Href } from '../../utils/v2Routes';
const withBase = (value: string) => resolveV2Href(value, Astro.url.pathname);

interface BreadcrumbItem {
  title: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
  variant?: 'default' | 'overlay';
}

const { items, variant = 'default' } = Astro.props as Props;
const publicItems = items.map((item) => ({
  ...item,
  title: item.title === 'Главная V2' ? 'Главная' : item.title
}));
const toAbsoluteUrl = (href?: string) => new URL(withBase(href || Astro.url.pathname), Astro.site).toString();
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: publicItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.title,
    item: toAbsoluteUrl(item.href)
  }))
};
---

<div class:list={['v2-breadcrumbs-bar', { 'v2-breadcrumbs-bar--overlay': variant === 'overlay' }]}>
  <div class={variant === 'default' ? 'hv2-shell' : undefined}>
    <nav class="v2-breadcrumbs" aria-label="Хлебные крошки">
      <ol>
        {publicItems.map((item, index) => (
          <li>
            {item.href ? <a href={withBase(item.href)} data-v2-transition-label={item.title}>{item.title}</a> : <span aria-current="page">{item.title}</span>}
            {index < publicItems.length - 1 && <i aria-hidden="true">/</i>}
          </li>
        ))}
      </ol>
    </nav>
  </div>
</div>
<script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
