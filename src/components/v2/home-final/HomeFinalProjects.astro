---
import { getCollection } from 'astro:content';
import { v2Href } from '../../../utils/v2Routes';
import { getV2ProjectPresentation } from '../mediaRoleAdapter';

const path = (value: string) => v2Href(value, Astro.url.pathname);
const projectBySlug = new Map(
  (await getCollection('projects', ({ data }) => data.isActive))
    .map(({ data }) => getV2ProjectPresentation(data))
    .map((presentation) => [presentation.project.slug, presentation])
);

const featured = projectBySlug.get('kompleks-rabot-na-proizvodstvennoy-territorii');
const featuredImages = featured?.publicGallery.slice(0, 3) ?? [];
const supporting = [
  projectBySlug.get('blagoustroystvo-naberezhnoy-reki-tobol'),
  projectBySlug.get('gorodskie-kacheli-dlya-obshchestvennyh-territoriy')
].filter((project): project is NonNullable<typeof project> => Boolean(project?.archiveCoverMedia));
---

<div class="hf-projects__layout">
  {featured && featuredImages.length > 0 && <article class="hf-project-featured" data-reveal>
    <div
      class="hf-project-featured__gallery"
      role="region"
      aria-roledescription="галерея"
      aria-label={`Фотографии объекта «${featured.project.title}»`}
      tabindex="0"
      data-hf-project-gallery
    >
      <div class="hf-project-featured__slides">
        {featuredImages.map((image, index) => <figure
          class:list={['hf-project-featured__slide', { 'is-current': index === 0 }]}
          aria-hidden={index === 0 ? 'false' : 'true'}
          data-hf-project-slide
        >
          <img
            src={path(image.src)}
            alt={image.alt}
            width="1920"
            height="1200"
            loading="lazy"
            decoding="async"
          />
        </figure>)}
      </div>

      <p class="hf-project-featured__meta">
        <span>{featured.category || 'Выполненный объект'}</span>
        <span>{featured.location} · {featured.project.year}</span>
      </p>

      {featuredImages.length > 1 && <div class="hf-project-featured__controls">
        <button type="button" aria-label="Предыдущее фото" data-hf-project-prev>
          <svg viewBox="0 0 24 24" width="22" height="22" focusable="false" aria-hidden="true">
            <path d="M19 12H6M11 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="square" stroke-linejoin="miter"></path>
          </svg>
        </button>
        <p aria-live="polite" aria-atomic="true" data-hf-project-status>1 / {featuredImages.length}</p>
        <button type="button" aria-label="Следующее фото" data-hf-project-next>
          <svg viewBox="0 0 24 24" width="22" height="22" focusable="false" aria-hidden="true">
            <path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="square" stroke-linejoin="miter"></path>
          </svg>
        </button>
      </div>}
    </div>

    <div class="hf-project-featured__body">
      <p class="hf-eyebrow">Главный объект</p>
      <h3>{featured.project.title}</h3>
      <p class="hf-project-featured__lead">{featured.project.shortDescription}</p>
      <p class="hf-project-featured__facts">{featured.project.whatWasDone}</p>
      <a class="hf-project-link" href={path(featured.productionRoute)}>
        <span>Открыть объект</span>
        <svg viewBox="0 0 24 24" width="24" height="24" focusable="false" aria-hidden="true">
          <path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="square" stroke-linejoin="miter"></path>
        </svg>
      </a>
    </div>
  </article>}

  <div class="hf-project-supporting">
    {supporting.map((project, index) => <a
      class={`hf-project-support hf-project-support--${index + 1}`}
      href={path(project.productionRoute)}
      data-reveal
    >
      <span class="hf-project-support__media">
        <img
          src={path(project.archiveCoverMedia!.src)}
          alt={project.archiveCoverMedia!.alt}
          width="1920"
          height="1200"
          loading="lazy"
          decoding="async"
          style={`object-position:${project.archiveCoverPosition};`}
        />
        <span class="hf-project-support__meta">
          <span>{project.category || 'Выполненный объект'}</span>
          <span>{project.location} · {project.project.year}</span>
        </span>
      </span>
      <span class="hf-project-support__body">
        <strong>{project.project.title}</strong>
        <span class="hf-project-support__description">{project.project.shortDescription}</span>
        <span class="hf-project-support__link">
          <span>Открыть объект</span>
          <svg viewBox="0 0 24 24" width="24" height="24" focusable="false" aria-hidden="true">
            <path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="square" stroke-linejoin="miter"></path>
          </svg>
        </span>
      </span>
    </a>)}
  </div>
</div>

<script>
  const initializeHomeFinalProjectGallery = (gallery: HTMLElement) => {
    if (gallery.dataset.ready === 'true') return;
    gallery.dataset.ready = 'true';
    const slides = Array.from(gallery.querySelectorAll<HTMLElement>('[data-hf-project-slide]'));
    const previous = gallery.querySelector<HTMLButtonElement>('[data-hf-project-prev]');
    const next = gallery.querySelector<HTMLButtonElement>('[data-hf-project-next]');
    const status = gallery.querySelector<HTMLElement>('[data-hf-project-status]');
    if (slides.length < 2 || !previous || !next || !status) return;

    let index = 0;
    const show = (requestedIndex: number) => {
      index = (requestedIndex + slides.length) % slides.length;
      slides.forEach((slide, slideIndex) => {
        const current = slideIndex === index;
        slide.classList.toggle('is-current', current);
        slide.setAttribute('aria-hidden', String(!current));
      });
      status.textContent = `${index + 1} / ${slides.length}`;
    };

    previous.addEventListener('click', () => show(index - 1));
    next.addEventListener('click', () => show(index + 1));
    gallery.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        show(index - 1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        show(index + 1);
      }
    });
  };

  document.querySelectorAll<HTMLElement>('[data-hf-project-gallery]').forEach(initializeHomeFinalProjectGallery);
</script>
