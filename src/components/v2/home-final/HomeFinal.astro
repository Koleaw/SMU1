---
import settings from '../../../content/site-settings/global.json';
import home from '../../../content/static-pages/home.json';
import { v2Href } from '../../../utils/v2Routes';
import { loadV2Directions } from '../../../utils/v2Directions';
import { getV2Regions, getV2TelegramLabel } from '../../../utils/v2SiteSettings';
import { adminBinding, adminDisposition } from '../../../admin/bindings/adminBinding';
import HomeV2Footer from '../home-v2/HomeV2Footer.astro';
import HomeV2Header from '../home-v2/HomeV2Header.astro';
import { getHomeV2Presentation } from '../home-v2/homeV2Presentation';
import V2ProjectArchiveGateway from '../projects/V2ProjectArchiveGateway.astro';
import V2ResponsiveImage from '../V2ResponsiveImage.astro';
import '../../../styles/v2/home-final.css';

const path = (value: string) => v2Href(value, Astro.url.pathname);
const copy = getHomeV2Presentation(home);
const regionLine = getV2Regions(settings).join(' · ');
const telegramLabel = getV2TelegramLabel(settings);
const directionBySlug = new Map(
  (await loadV2Directions()).filter((item) => item.showOnHome).map((item) => [item.slug, item])
);
const homeDirectionCards = (home.homeDirectionCards ?? [])
  .filter((item) => item.isActive !== false)
  .slice()
  .sort((a, b) => a.order - b.order)
  .map((item) => ({ ...item, direction: directionBySlug.get(item.directionSlug as Parameters<typeof directionBySlug.get>[0]) }));
const directionCards = homeDirectionCards.filter((item) => item.group === 'feature');
const railDirections = homeDirectionCards.filter((item) => item.group === 'rail');
const landscapingCard = homeDirectionCards.find((item) => item.group === 'wide');
const intakeItems = (home.intakeItems ?? []).filter((item) => item.isActive !== false).slice().sort((a, b) => a.order - b.order);
const homeRoute = ['/'];
const homeBinding = (fieldPath: string, tool = 'long-text', options: Record<string, unknown> = {}) => adminBinding(Astro.url, {
  renderer: { family: 'home', variant: 'final' }, owner: { collection: 'static-pages', slug: 'home' },
  fieldPath, scope: 'local', tool, affectedRoutes: homeRoute, ...options
});
const directionBinding = (
  direction: NonNullable<(typeof homeDirectionCards)[number]['direction']>,
  fieldPath: string,
  tool = 'long-text',
  options: Record<string, unknown> = {}
) => adminBinding(Astro.url, {
  renderer: { family: 'home', variant: 'direction-card' },
  owner: { collection: direction.ownerCollection, slug: direction.slug }, fieldPath,
  stableItemId: direction.slug, scope: 'shared', tool,
  affectedRoutes: ['/', direction.href], permissions: { edit: true, reorder: false, delete: false },
  ...options
});
const homeDirectionCardBinding = (id: string, field: string, tool = 'short-text') => {
  const index = (home.homeDirectionCards ?? []).findIndex((item) => item.id === id);
  return index < 0 ? {} : homeBinding(`homeDirectionCards[${index}].${field}`, tool, {
    stableItemId: id,
    role: `home-direction-${field}`
  });
};
const globalBinding = (fieldPath: string, tool = 'short-text', options: Record<string, unknown> = {}) => adminBinding(Astro.url, {
  renderer: { family: 'global-shell', variant: 'contact' }, owner: { collection: 'site-settings', slug: 'global' },
  fieldPath, scope: 'global', tool, affectedRoutes: ['*'], ...options
});
const globalHrefDisposition = (fieldPath: string, reason: string) => adminDisposition(Astro.url, {
  kind: 'global', reason, source: `src/content/site-settings/global.json#${fieldPath}`, tool: 'global-settings'
});
---

<div class="home-v2 home-final" data-home-v2-root data-home-final-root>
  <HomeV2Header currentPath={Astro.url.pathname} catalogV2 />

  <main id="main-content" tabindex="-1">
    <section class="hf-hero" aria-labelledby="home-final-title" data-hf-hero data-v2-hero-scroll>
      <span class="hf-hero__header-sentinel" aria-hidden="true" data-home-v2-header-sentinel></span>

      <div
        class="hf-hero__media"
        aria-hidden="true"
        data-reveal
        data-v2-entry="media"
        data-v2-entrance-role="media"
        data-v2-hero-scroll-media
        style="--hv2-reveal-delay: 220ms"
      >
        <picture class="hf-hero__poster">
          <source
            media="(max-width: 760px)"
            srcset={path(home.heroMediaPosterMobile)}
            {...homeBinding('heroMediaPosterMobile', 'media', {
              role: 'home-hero-poster-mobile', stableItemId: 'home-hero-poster-mobile', multiple: false,
              projection: { kind: 'responsive-role', target: 'source.srcset' }
            })}
          />
          <img
            src={path(home.heroMediaPoster)}
            alt=""
            width="1920"
            height="1080"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            data-v2-critical-media
            data-v2-page-critical
            {...homeBinding('heroMediaPoster', 'media', {
              role: 'home-hero-poster-desktop', stableItemId: 'home-hero-poster-desktop', multiple: false,
              projection: { kind: 'responsive-role', target: 'img.src', fallback: 'heroMediaPosterMobile at max-width 760px' }
            })}
          />
        </picture>
        <video
          class="hf-hero__video"
          muted
          loop
          playsinline
          preload="none"
          data-hf-hero-video
          data-v2-deferred-video
          data-hf-desktop-src={path(home.heroMediaVideo)}
          data-hf-mobile-src={path(home.heroMediaVideoMobile)}
          data-v2-desktop-src={path(home.heroMediaVideo)}
          data-v2-mobile-src={path(home.heroMediaVideoMobile)}
          {...homeBinding('heroMediaVideo', 'video', { role: 'home-hero-video', multiple: false })}
        ></video>
        <div class="hf-hero__veil"></div>
      </div>

      <button
        class="hf-hero__video-toggle"
        type="button"
        aria-label="Приостановить фоновое видео"
        data-hf-video-toggle
        data-v2-entry="control"
        data-v2-entrance-role="support"
        hidden
      >
        <span data-hf-video-toggle-label>Пауза видео</span>
      </button>

      <div class="hf-shell hf-shell--editorial hf-hero__content">
        <div class="hf-hero__copy" data-hf-hero-copy data-v2-hero-scroll-copy data-v2-page-handoff="copy">
          <p class="hf-eyebrow hf-eyebrow--light" data-reveal data-v2-entry="meta" data-v2-entrance-role="context" style="--hv2-reveal-delay: 0ms" {...homeBinding('heroKicker', 'short-text')}>{copy.heroKicker}</p>
          <h1 id="home-final-title" data-reveal data-v2-entry="title" data-v2-entrance-role="title-primary" style="--hv2-reveal-delay: 60ms" {...homeBinding('heroTitle', 'heading')}>{copy.heroTitle}</h1>
          <p class="hf-hero__lead" data-reveal data-v2-entry="lead" data-v2-entrance-role="lead" style="--hv2-reveal-delay: 120ms" {...homeBinding('heroDescription', 'long-text')}>{copy.heroDescription}</p>
          <div class="hf-actions" data-reveal data-v2-entry="actions" data-v2-entrance-role="actions-meta" style="--hv2-reveal-delay: 180ms">
            <a class="hf-button hf-button--primary" href={path(home.heroPrimaryHref)} {...homeBinding('heroPrimaryLabel', 'link', { hrefPath: 'heroPrimaryHref' })}>{copy.heroPrimaryLabel}</a>
            <a class="hf-button hf-button--ghost" href={path(home.heroSecondaryHref)} data-v2-transition-label="Выполненные объекты" {...homeBinding('heroSecondaryLabel', 'link', { hrefPath: 'heroSecondaryHref' })}>
              {copy.heroSecondaryLabel}
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="hf-directions" id="directions" aria-labelledby="home-final-directions-title">
      <div class="hf-shell hf-shell--editorial">
        <header class="hf-section-head" data-reveal data-v2-reveal="title">
          <div>
            <p class="hf-eyebrow" {...homeBinding('directionsEyebrow', 'short-text')}>{copy.directionsEyebrow}</p>
            <h2 id="home-final-directions-title" {...homeBinding('directionsTitle', 'heading')}>{home.directionsTitle}</h2>
          </div>
          <div class="hf-section-head__summary">
            <p><strong {...homeBinding('pathwaysTitle', 'heading')}>{copy.positioningTitle}</strong> <span {...homeBinding('positioningSummary', 'long-text')}>{copy.positioningSummary}</span></p>
            <p {...homeBinding('directionsDescription', 'long-text')}>{copy.directionsDescription}</p>
          </div>
        </header>

        <div class="hf-directions__layout">
          {directionCards.map(({ id, direction, className, kicker }) => direction && (
            <a class={`hf-direction hf-direction--${className}`} href={path(direction.href)} data-v2-transition-label={direction.title} data-reveal data-v2-reveal="media" {...homeBinding('homeDirectionCards', 'reorder-item', { stableItemId: id, zoneId: 'home-directions', permissions: { edit: true, reorder: true, delete: false } })}>
              {direction.image && <V2ResponsiveImage
                src={direction.image}
                alt=""
                role="card"
                sizes="(max-width: 760px) calc(100vw - 32px), (max-width: 1180px) 50vw, 42vw"
                loading="lazy"
                decoding="async"
                style={`object-fit:${direction.imageFit};object-position:${direction.imagePosition};`}
                {...directionBinding(direction, 'homeImage', 'media', {
                  role: 'home-direction-image', multiple: false, affectedRoutes: ['/']
                })}
              />}
              <span class="hf-direction__veil" aria-hidden="true"></span>
              <span class="hf-direction__body">
                <span class="hf-direction__meta" {...homeDirectionCardBinding(id, 'kicker')}>{kicker}</span>
                <strong {...directionBinding(direction, 'title', 'heading')}>{direction.title}</strong>
                <span class="hf-direction__description" {...directionBinding(direction, 'shortDescription', 'long-text')}>{direction.description}</span>
              </span>
            </a>
          ))}

          <div class="hf-direction-rail" aria-label="Специализированные направления">
            {railDirections.map(({ id, direction, kicker }) => direction && (
              <a class="hf-direction-rail__item" href={path(direction.href)} data-v2-transition-label={direction.title} data-reveal data-v2-reveal="group" {...homeBinding('homeDirectionCards', 'reorder-item', { stableItemId: id, zoneId: 'home-directions', permissions: { edit: true, reorder: true, delete: false } })}>
                <span class="hf-direction-rail__copy">
                  <span class="hf-direction__meta" {...homeDirectionCardBinding(id, 'kicker')}>{kicker}</span>
                  <strong {...directionBinding(direction, 'title', 'heading')}>{direction.title}</strong>
                  <span class="hf-direction__description" {...directionBinding(direction, 'shortDescription', 'long-text')}>{direction.description}</span>
                </span>
              </a>
            ))}
          </div>

          {landscapingCard?.direction && <a
            class="hf-direction hf-direction--landscaping"
            href={path(landscapingCard.direction.href)}
            data-v2-transition-label={landscapingCard.direction.title}
            data-reveal
            data-v2-reveal="media"
            {...homeBinding('homeDirectionCards', 'reorder-item', { stableItemId: landscapingCard.id, zoneId: 'home-directions', permissions: { edit: true, reorder: true, delete: false } })}
          >
            {landscapingCard.direction.image && <V2ResponsiveImage
              src={landscapingCard.direction.image}
              alt=""
              role="card"
              sizes="(max-width: 760px) calc(100vw - 32px), 86vw"
              loading="lazy"
              decoding="async"
              style={`object-fit:${landscapingCard.direction.imageFit};object-position:${landscapingCard.direction.imagePosition};`}
              {...directionBinding(landscapingCard.direction, 'homeImage', 'media', {
                role: 'home-direction-image', multiple: false, affectedRoutes: ['/']
              })}
            />}
            <span class="hf-direction__veil" aria-hidden="true"></span>
            <span class="hf-direction__body">
              <span class="hf-direction__meta" {...homeDirectionCardBinding(landscapingCard.id, 'kicker')}>{landscapingCard.kicker}</span>
              <strong {...directionBinding(landscapingCard.direction, 'title', 'heading')}>{landscapingCard.direction.title}</strong>
              <span class="hf-direction__description" {...directionBinding(landscapingCard.direction, 'shortDescription', 'long-text')}>{landscapingCard.direction.description}</span>
            </span>
          </a>}
        </div>
      </div>
    </section>

    <V2ProjectArchiveGateway
      variant="home"
      sectionId="projects"
      title={copy.projectsEyebrow}
      description={copy.projectsDescription}
      ctaLabel={home.projectsCtaLabel}
      projectSlugs={home.gatewayProjectSlugs ?? []}
      projectSelectionField="gatewayProjectSlugs"
      bindingOwner={{ collection: 'static-pages', slug: 'home' }}
      bindingFields={{ title: 'trustTitle', description: 'trustText', ctaLabel: 'projectsCtaLabel' }}
    />

    <section class="hf-intake" id="brief" aria-labelledby="home-final-intake-title">
      <div class="hf-shell hf-shell--editorial hf-intake__layout">
        <div class="hf-intake__intro" data-reveal data-v2-reveal="copy">
          <p class="hf-eyebrow hf-eyebrow--light" {...homeBinding('intakeEyebrow', 'short-text')}>{home.intakeEyebrow}</p>
          <h2 id="home-final-intake-title" {...homeBinding('intakeTitle', 'heading')}>{home.intakeTitle}</h2>
          <p {...homeBinding('intakeDescription', 'long-text')}>{home.intakeDescription}</p>
          <a class="hf-intake__link" href={path(home.intakeLinkHref)} data-v2-transition-label="Изготовление на заказ" {...homeBinding('intakeLinkLabel', 'link', { hrefPath: 'intakeLinkHref' })}>
            <span>{home.intakeLinkLabel}</span>
          </a>
        </div>

        <ol class="hf-intake__sequence" aria-label="Что можно прислать" data-reveal data-v2-reveal="group">
          {intakeItems.map((item) => <li {...homeBinding('intakeItems', 'list', { stableItemId: item.id, itemKind: 'object' })}><strong>{item.label}</strong><span class="hf-intake__format">{item.format}</span></li>)}
        </ol>
      </div>
    </section>

    <section class="hv2-contact" id="contact" aria-labelledby="home-final-contact-title">
      <div class="hv2-shell hv2-contact__grid hv2-grid">
        <div class="hv2-contact__intro" data-reveal data-v2-reveal="title">
          <p class="hv2-eyebrow hv2-eyebrow--light" {...homeBinding('contactEyebrow', 'short-text')}>{home.contactEyebrow}</p>
          <h2 id="home-final-contact-title" {...homeBinding('contactTitle', 'heading')}>{copy.contactTitle}</h2>
          <p {...homeBinding('contactDescription', 'long-text')}>{copy.contactDescription}</p>
          <div class="hv2-actions">
            <a class="hv2-button hv2-button--light" href={settings.telegram} target="_blank" rel="noopener noreferrer" {...globalHrefDisposition('telegram', 'Адрес основной контактной кнопки берётся из общей ссылки Telegram и изменяется в настройках компании.')}>
              <span {...homeBinding('contactPrimaryLabel', 'button-label')}>{home.contactPrimaryLabel}</span>
            </a>
            <a class="hv2-button hv2-button--contrast" href={path(home.contactSecondaryHref)} data-v2-transition-label="Контакты" {...homeBinding('contactSecondaryLabel', 'link', { hrefPath: 'contactSecondaryHref' })}>{home.contactSecondaryLabel}</a>
          </div>
        </div>

        <div class="hv2-contact__channels" data-reveal data-v2-reveal="group">
          <a href={`tel:${settings.phonePrimary.replace(/[^+\d]/g, '')}`} {...globalHrefDisposition('phonePrimary', 'Телефонная ссылка вычисляется из общего основного телефона компании.')}>
            <span {...homeBinding('contactPhonePrimaryLabel', 'short-text')}>{home.contactPhonePrimaryLabel}</span><strong {...globalBinding('phonePrimary')}>{settings.phonePrimary}</strong>
          </a>
          <a href={`tel:${settings.phoneSecondary.replace(/[^+\d]/g, '')}`} {...globalHrefDisposition('phoneSecondary', 'Телефонная ссылка вычисляется из общего дополнительного телефона компании.')}>
            <span {...homeBinding('contactPhoneSecondaryLabel', 'short-text')}>{home.contactPhoneSecondaryLabel}</span><strong {...globalBinding('phoneSecondary')}>{settings.phoneSecondary}</strong>
          </a>
          <a href={settings.telegram} target="_blank" rel="noopener noreferrer" {...globalHrefDisposition('telegram', 'Адрес канала берётся из общей ссылки Telegram компании.')}>
            <span {...homeBinding('contactTelegramLabel', 'short-text')}>{home.contactTelegramLabel}</span><strong {...globalBinding('telegramLabel', 'short-text', { projection: { kind: 'fallback', fallback: 'telegram URL label' } })}>{telegramLabel}</strong>
          </a>
          <a href={`mailto:${settings.email}`} {...globalHrefDisposition('email', 'Почтовая ссылка вычисляется из общего адреса электронной почты компании.')}>
            <span {...homeBinding('contactEmailLabel', 'short-text')}>{home.contactEmailLabel}</span><strong {...globalBinding('email')}>{settings.email}</strong>
          </a>
          <div>
            <span {...homeBinding('contactAddressLabel', 'short-text')}>{home.contactAddressLabel}</span><strong {...globalBinding('address', 'long-text')}>{settings.address}</strong>
          </div>
          {regionLine && <div>
            <span {...homeBinding('contactRegionsLabel', 'short-text')}>{home.contactRegionsLabel}</span><strong {...globalBinding('regions', 'list')}>{regionLine}</strong>
          </div>}
        </div>
      </div>
    </section>
  </main>

  <HomeV2Footer currentPath={Astro.url.pathname} catalogV2 />
</div>

<script>
  import { waitForRevealMedia } from '../../../utils/v2ImageReady';

  const initializeHomeFinalHero = (root: HTMLElement) => {
    const hero = root.querySelector<HTMLElement>('[data-hf-hero]');
    const video = root.querySelector<HTMLVideoElement>('[data-hf-hero-video]');
    const toggle = root.querySelector<HTMLButtonElement>('[data-hf-video-toggle]');
    const toggleLabel = root.querySelector<HTMLElement>('[data-hf-video-toggle-label]');
    const copy = root.querySelector<HTMLElement>('[data-hf-hero-copy]');
    if (!hero || !video || !toggle || !toggleLabel || !copy) return;
    if (root.dataset.hfHeroReady === 'true') return;
    root.dataset.hfHeroReady = 'true';

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const initialMobile = window.matchMedia('(max-width: 760px)').matches;
    const initialNarrow = window.matchMedia('(max-width: 359px)').matches;
    const connection = (navigator as Navigator & {
      connection?: { saveData?: boolean; effectiveType?: string };
    }).connection;
    const motionRoot = root.closest<HTMLElement>('[data-v2-motion-root][data-v2-entry-mode]');
    const entryManaged = Boolean(motionRoot && document.documentElement.classList.contains('v2-entry-js'));
    const pageArrivalManaged = document.documentElement.dataset.v2PageBootstrap === 'arrival'
      && document.documentElement.dataset.v2PageState !== 'done';
    const constrainedConnection = ['slow-2g', '2g'].includes(connection?.effectiveType ?? '');
    const videoAllowed = !reducedMotion.matches
      && !connection?.saveData
      && !constrainedConnection
      && !initialNarrow;
    const selectedSource = initialMobile ? video.dataset.hfMobileSrc : video.dataset.hfDesktopSrc;

    const setPlayingState = (playing: boolean) => {
      hero.classList.toggle('is-video-playing', playing);
      toggleLabel.textContent = playing ? 'Пауза видео' : 'Включить видео';
      toggle.setAttribute('aria-label', playing ? 'Приостановить фоновое видео' : 'Включить фоновое видео');
    };

    const stopAndUnloadVideo = () => {
      video.pause();
      video.removeAttribute('src');
      video.load();
      toggle.hidden = true;
      toggle.disabled = true;
      toggle.setAttribute('aria-hidden', 'true');
      setPlayingState(false);
    };

    const primeVideoControl = () => {
      if (!videoAllowed || !selectedSource) return;
      toggle.hidden = false;
      toggle.disabled = true;
      toggle.setAttribute('aria-hidden', 'true');
    };

    let videoStarted = false;
    const startVideo = () => {
      if (videoStarted || !videoAllowed || !selectedSource) return;
      videoStarted = true;
      video.src = selectedSource;
      video.defaultMuted = true;
      video.muted = true;
      setPlayingState(false);
      toggle.hidden = false;
      toggle.disabled = false;
      toggle.removeAttribute('aria-hidden');
      video.addEventListener('playing', () => setPlayingState(true));
      video.addEventListener('pause', () => setPlayingState(false));
      video.addEventListener('error', stopAndUnloadVideo);
      video.load();
      requestAnimationFrame(() => {
        video.play().catch(() => setPlayingState(false));
      });

      toggle.addEventListener('click', () => {
        if (video.paused) video.play().catch(() => setPlayingState(false));
        else video.pause();
      });
    };

    if (pageArrivalManaged) {
      primeVideoControl();
      document.addEventListener('v2:page-revealing', startVideo, { once: true });
      document.addEventListener('v2:page-done', startVideo, { once: true });
    } else if (entryManaged && motionRoot) {
      primeVideoControl();
      const state = motionRoot.dataset.v2MotionState;
      const entryStillBlocking = state === 'armed' || state === 'logo' || state === 'waiting';
      if (!entryStillBlocking) startVideo();
      else {
        motionRoot.addEventListener('v2:entry-opening', startVideo, { once: true });
        motionRoot.addEventListener('v2:entry-done', startVideo, { once: true });
      }
    } else {
      startVideo();
    }

    reducedMotion.addEventListener('change', (event) => {
      if (event.matches) stopAndUnloadVideo();
    });

    const initialMode = initialMobile ? 'mobile' : 'desktop';
    let modeInvalidated = false;
    window.addEventListener('resize', () => {
      if (modeInvalidated) return;
      const currentMode = window.matchMedia('(max-width: 760px)').matches ? 'mobile' : 'desktop';
      if (currentMode === initialMode) return;
      modeInvalidated = true;
      stopAndUnloadVideo();
    }, { passive: true });

    if (!initialMobile) return;
    let ticking = false;
    const updateMobileHandoff = () => {
      ticking = false;
      const header = root.querySelector<HTMLElement>('.hv2-header');
      const headerBottom = header?.getBoundingClientRect().bottom ?? 72;
      const copyTop = copy.getBoundingClientRect().top;
      const start = headerBottom + 96;
      const end = headerBottom + 24;
      const progress = Math.min(1, Math.max(0, (start - copyTop) / (start - end)));
      const opacity = reducedMotion.matches ? (copyTop <= end ? 0 : 1) : 1 - progress;
      copy.style.setProperty('--hf-mobile-copy-opacity', String(opacity));
      copy.style.setProperty('--hf-mobile-copy-shift', `${Math.round(progress * -18)}px`);
    };
    const requestMobileHandoff = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(updateMobileHandoff);
    };
    updateMobileHandoff();
    window.addEventListener('scroll', requestMobileHandoff, { passive: true });
    window.addEventListener('resize', requestMobileHandoff, { passive: true });
  };

  const initializeHomeFinalMotion = (root: HTMLElement) => {
    if (root.closest('[data-v2-motion-root][data-v2-entry-mode]')) {
      root.querySelectorAll<HTMLElement>('[data-reveal]').forEach((element) => {
        element.classList.remove('hv2-reveal-pending', 'hv2-reveal-visible');
        delete element.dataset.v2RevealQueued;
      });
      root.dataset.hfMotionReady = 'managed';
      return;
    }
    if (root.dataset.hfMotionReady === 'true') return;
    root.dataset.hfMotionReady = 'true';

    const revealElements = Array.from(root.querySelectorAll<HTMLElement>('[data-reveal]'));
    if (revealElements.length === 0) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let revealObserver: IntersectionObserver | undefined;
    let revealScanQueued = false;

    const makeVisible = (element: HTMLElement) => {
      element.classList.remove('hv2-reveal-pending');
      element.classList.add('hv2-reveal-visible');
    };
    const revealElement = (element: HTMLElement) => {
      if (element.dataset.v2RevealQueued === 'true') return;
      element.dataset.v2RevealQueued = 'true';
      revealObserver?.unobserve(element);
      try {
        void waitForRevealMedia(element, 3500).then(
          () => makeVisible(element),
          () => makeVisible(element)
        );
      } catch {
        makeVisible(element);
      }
    };
    const revealReached = (viewportFactor = 0.94) => {
      revealScanQueued = false;
      revealElements.forEach((element) => {
        if (!element.classList.contains('hv2-reveal-pending')) return;
        if (element.getBoundingClientRect().top < window.innerHeight * viewportFactor) revealElement(element);
      });
    };
    const queueRevealScan = () => {
      if (revealScanQueued) return;
      revealScanQueued = true;
      requestAnimationFrame(() => revealReached());
    };

    if (reducedMotion.matches) {
      revealElements.forEach(revealElement);
    } else if ('IntersectionObserver' in window) {
      try {
        revealObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            revealElement(entry.target as HTMLElement);
          });
        }, { rootMargin: '0px 0px -9% 0px', threshold: 0.08 });

        revealElements.forEach((element, index) => {
          if (!element.style.getPropertyValue('--hv2-reveal-delay')) {
            element.style.setProperty('--hv2-reveal-delay', `${Math.min((index % 4) * 55, 165)}ms`);
          }
          element.classList.add('hv2-reveal-pending');
          revealObserver?.observe(element);
        });

        window.addEventListener('scroll', queueRevealScan, { passive: true });
        window.addEventListener('resize', queueRevealScan);
        requestAnimationFrame(() => requestAnimationFrame(() => revealReached()));
        window.setTimeout(() => revealReached(1), 1600);
      } catch {
        revealElements.forEach(makeVisible);
      }
    } else {
      revealElements.forEach(makeVisible);
    }
  };

  const initializeHomeFinalPage = () => {
    document.querySelectorAll<HTMLElement>('[data-home-final-root]').forEach((root) => {
      initializeHomeFinalHero(root);
      initializeHomeFinalMotion(root);
    });
  };

  initializeHomeFinalPage();
  document.addEventListener('astro:page-load', initializeHomeFinalPage);
</script>
