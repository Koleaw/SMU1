---
import DirectionV2Layout from '../directions/DirectionV2Layout.astro';
import '../../../styles/v2/project-direction-v2.css';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  currentPath: string;
  ogImage?: string;
  variant?: 'construction';
}

const { title, description, canonicalPath, currentPath, ogImage = '', variant } = Astro.props as Props;
---

<DirectionV2Layout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  currentPath={currentPath}
  ogImage={ogImage}
  variant="project-commercial"
>
  <div
    class:list={['project-direction-v2', variant && `project-direction-v2--${variant}`]}
    data-project-direction-v2
  >
    <slot />
  </div>
</DirectionV2Layout>
