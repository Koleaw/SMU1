---
interface WorkItem {
  title: string;
  text?: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  items: WorkItem[];
  featuredFirst?: boolean;
  titleBinding?: Record<string, string>;
  descriptionBinding?: Record<string, string>;
  itemsBinding?: Record<string, string>;
  eyebrowBinding?: Record<string, string>;
}

const { eyebrow = 'Виды работ', title, description = '', items, featuredFirst = false } = Astro.props as Props;
const titleBinding = Astro.props.titleBinding ?? {};
const descriptionBinding = Astro.props.descriptionBinding ?? {};
const itemsBinding = Astro.props.itemsBinding ?? {};
const eyebrowBinding = Astro.props.eyebrowBinding ?? {};
---

{items.length > 0 && (
  <section class="project-scope" id="construction-scope" aria-labelledby="project-scope-title">
    <div class="hv2-shell">
      <header class="project-scope__heading hv2-grid" data-v2-reveal>
        <div>
          <p class="hv2-eyebrow" {...eyebrowBinding}>{eyebrow}</p>
          <h2 id="project-scope-title" {...titleBinding}>{title}</h2>
        </div>
        {description && <p {...descriptionBinding}>{description}</p>}
      </header>
      <ul class:list={['project-scope__list', { 'project-scope__list--featured-first': featuredFirst }]} role="list" {...itemsBinding}>
        {items.map((item, index) => (
          <li class:list={{ 'project-scope__item--featured': featuredFirst && index === 0 }} data-v2-reveal>
            <h3>{item.title}</h3>
            {item.text && <p>{item.text}</p>}
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
