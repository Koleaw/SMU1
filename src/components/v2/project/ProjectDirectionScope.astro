---
interface WorkItem {
  title: string;
  text?: string;
}

interface Props {
  title: string;
  description?: string;
  items: WorkItem[];
  featuredFirst?: boolean;
}

const { title, description = '', items, featuredFirst = false } = Astro.props as Props;
---

{items.length > 0 && (
  <section class="project-scope" id="construction-scope" aria-labelledby="project-scope-title">
    <div class="hv2-shell">
      <header class="project-scope__heading hv2-grid" data-v2-reveal>
        <div>
          <p class="hv2-eyebrow">Виды работ</p>
          <h2 id="project-scope-title">{title}</h2>
        </div>
        {description && <p>{description}</p>}
      </header>
      <ul class:list={['project-scope__list', { 'project-scope__list--featured-first': featuredFirst }]} role="list">
        {items.map((item, index) => (
          <li class:list={{ 'project-scope__item--featured': featuredFirst && index === 0 }} data-v2-reveal>
            <h3>{item.title}</h3>
            {item.text && <p>{item.text}</p>}
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
