---
import { v2Href as resolveV2Href } from '../../../utils/v2Routes';
const withBase = (value: string) => resolveV2Href(value, Astro.url.pathname);
import { imageViewStyle } from '../catalogV2Data';

interface MediaItem {
  src: string;
  alt: string;
  caption?: string;
  view?: { fit?: 'cover' | 'contain'; positionX?: number; positionY?: number; scale?: number };
}

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  media?: MediaItem[];
  primaryHref?: string;
  secondaryHref?: string;
}

const {
  eyebrow,
  title,
  description,
  media = [],
  primaryHref = '#contact',
  secondaryHref = '#construction-brief'
} = Astro.props as Props;
const visibleMedia = media.filter((item) => item.src?.trim()).slice(0, 2);
const href = (value: string) => /^(?:#|https?:|mailto:|tel:)/i.test(value) ? value : withBase(value);
---

<section class:list={['project-hero', { 'project-hero--no-media': visibleMedia.length === 0 }]} aria-labelledby="project-direction-title">
  <div class="hv2-shell hv2-grid project-hero__grid">
    <div class="project-hero__copy" data-v2-reveal>
      <p class="hv2-eyebrow">{eyebrow}</p>
      <h1 id="project-direction-title">{title}</h1>
      <p class="project-hero__lead">{description}</p>
      <div class="hv2-actions project-hero__actions">
        <a class="hv2-button hv2-button--primary" href={href(primaryHref)}>
          Получить расчёт <span aria-hidden="true">↓</span>
        </a>
        <a class="hv2-button project-hero__secondary" href={href(secondaryHref)}>
          Обсудить объект <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>

    {visibleMedia.length > 0 && (
      <div class:list={['project-hero__media', { 'project-hero__media--single': visibleMedia.length === 1 }]} data-v2-reveal>
        {visibleMedia.map((item, index) => (
          <figure class:list={['project-hero__figure', `project-hero__figure--${index + 1}`]} data-v2-media>
            <img
              src={withBase(item.src)}
              alt={item.alt}
              width="1600"
              height="1100"
              loading={index === 0 ? 'eager' : 'lazy'}
              fetchpriority={index === 0 ? 'high' : undefined}
              decoding="async"
              style={imageViewStyle(item.view)}
              data-v2-image
            />
            <div class="project-hero__fallback" aria-hidden="true">Изображение объекта недоступно</div>
            {item.caption && <figcaption>{item.caption}</figcaption>}
          </figure>
        ))}
      </div>
    )}
  </div>
</section>
