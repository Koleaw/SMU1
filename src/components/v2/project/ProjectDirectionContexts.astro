---
interface Props {
  eyebrow?: string;
  title: string;
  items: string[];
  titleBinding?: Record<string, string>;
  itemsBinding?: Record<string, string>;
  eyebrowBinding?: Record<string, string>;
}

const { eyebrow = 'Контекст работ', title, items } = Astro.props as Props;
const titleBinding = Astro.props.titleBinding ?? {};
const itemsBinding = Astro.props.itemsBinding ?? {};
const eyebrowBinding = Astro.props.eyebrowBinding ?? {};
---

{items.length > 0 && (
  <section class="project-contexts" id="construction-contexts" aria-labelledby="project-contexts-title">
    <div class="hv2-shell hv2-grid project-contexts__grid">
      <header class="project-contexts__heading" data-v2-reveal>
        <p class="hv2-eyebrow hv2-eyebrow--light" {...eyebrowBinding}>{eyebrow}</p>
        <h2 id="project-contexts-title" {...titleBinding}>{title}</h2>
      </header>
      <ul class="project-contexts__list" role="list" data-v2-reveal {...itemsBinding}>
        {items.map((item) => <li><span aria-hidden="true"></span>{item}</li>)}
      </ul>
    </div>
  </section>
)}
