---
import { v2Href as resolveV2Href } from '../../utils/v2Routes';
const withBase = (value: string) => resolveV2Href(value, Astro.url.pathname);
import {
  imageViewStyle,
  isPlaceholderCatalogMedia,
  type ProductCategoryData
} from './catalogV2Data';
import V2ResponsiveImage from './V2ResponsiveImage.astro';
import { adminBinding, isLocalAdminCanvas } from '../../admin/bindings/adminBinding';
import settings from '../../content/site-settings/global.json';

interface Props {
  category: ProductCategoryData;
  href: string;
  productCount?: number;
  featured?: boolean;
  loading?: 'eager' | 'lazy';
}

const { category, href, productCount = 0, featured = false, loading = 'lazy' } = Astro.props as Props;
const rawCategoryImage = category.image?.trim() || '';
const cardImageUsesPrimary = Boolean(rawCategoryImage && !isPlaceholderCatalogMedia(rawCategoryImage));
const categoryGallery = Array.isArray(category.gallery) ? category.gallery : [];
const galleryFallbackIndex = categoryGallery.findIndex((item) => {
  const source = typeof item === 'string' ? item.trim() : item?.src?.trim() || '';
  return Boolean(source) && !isPlaceholderCatalogMedia(source);
});
const galleryFallback = galleryFallbackIndex >= 0 ? categoryGallery[galleryFallbackIndex] : undefined;
const galleryFallbackSource = typeof galleryFallback === 'string'
  ? galleryFallback.trim()
  : galleryFallback?.src?.trim() || '';
const cardImage = cardImageUsesPrimary ? rawCategoryImage : galleryFallbackSource;
const editorCanvas = isLocalAdminCanvas(Astro.url);
const hasMedia = Boolean(cardImage);
const cardCopy = settings.catalogUi.card;
const productNoun = productCount % 10 === 1 && productCount % 100 !== 11
  ? cardCopy.productCountOne
  : [2, 3, 4].includes(productCount % 10) && ![12, 13, 14].includes(productCount % 100)
    ? cardCopy.productCountFew
    : cardCopy.productCountMany;
const state = productCount > 0 ? 'products' : hasMedia ? 'sparse' : 'minimal';
const mediaSizes = featured
  ? '(max-width: 560px) calc(100vw - 32px), (max-width: 768px) calc(100vw - 40px), (max-width: 1240px) 66vw, 50vw'
  : '(max-width: 560px) calc(100vw - 32px), (max-width: 768px) calc(50vw - 29px), (max-width: 1240px) 33vw, 25vw';
const stateLabel = productCount > 0
  ? `${productCount} ${productNoun}`
  : hasMedia
    ? cardCopy.sparseLabel
    : cardCopy.minimalLabel;
const affectedRoutes = [Astro.url.pathname, href];
const binding = (fieldPath: string, tool: string, options: Record<string, unknown> = {}) => adminBinding(Astro.url, {
  renderer: { family: 'catalog-card', variant: 'category' },
  owner: { collection: 'product-categories', slug: category.slug }, fieldPath,
  stableItemId: category.slug, scope: 'shared', tool, affectedRoutes, ...options
});
const catalogUiBinding = (fieldPath: string, tool = 'short-text', options: Record<string, unknown> = {}) => adminBinding(Astro.url, {
  renderer: { family: 'catalog-card', variant: 'category-ui' },
  owner: { collection: 'site-settings', slug: 'global' }, fieldPath: `catalogUi.card.${fieldPath}`,
  stableItemId: `${category.slug}-category-card-${fieldPath}`, scope: 'global', tool,
  affectedRoutes: ['*'], ...options
});
const productCountField = productCount % 10 === 1 && productCount % 100 !== 11
  ? 'productCountOne'
  : [2, 3, 4].includes(productCount % 10) && ![12, 13, 14].includes(productCount % 100)
    ? 'productCountFew'
    : 'productCountMany';
const stateLabelBinding = productCount > 0
  ? catalogUiBinding(productCountField, 'short-text', {
      projection: { kind: 'derived', formula: `productCount (${productCount}) + catalogUi.card.${productCountField}` }
    })
  : catalogUiBinding(hasMedia ? 'sparseLabel' : 'minimalLabel');
const mediaBinding = cardImageUsesPrimary
  ? binding('image', 'media', { role: 'category-card-media', multiple: false })
  : galleryFallbackIndex >= 0
    ? binding(`gallery[${galleryFallbackIndex}]`, 'media', {
        role: 'category-card-media', multiple: false,
        projection: {
          kind: 'fallback',
          formula: 'category.image when non-placeholder, otherwise first non-placeholder category.gallery item',
          fallback: 'image'
        }
      })
    : binding('image', 'media', { role: 'missing-category-card-media', multiple: false });
---

<a
  class:list={['v2-category-card', { 'v2-category-card--featured': featured }]}
  href={withBase(href)}
  data-v2-transition-label={category.title}
  data-v2-category-state={state}
  data-v2-reveal
  {...binding('order', 'reorder-item', {
    role: 'category-order',
    zoneId: category.parentSectionSlug,
    parentSlug: category.parentSectionSlug,
    permissions: { edit: true, reorder: true, delete: false }
  })}
>
  {(hasMedia || editorCanvas) && <div class="v2-category-card__media" data-v2-media {...mediaBinding}>
    {cardImage ? (
      <V2ResponsiveImage
        src={cardImage}
        alt={category.title}
        role="card"
        sizes={mediaSizes}
        loading={loading}
        decoding="async"
        style={imageViewStyle(category.imageView)}
        data-v2-image
      />
    ) : null}
    <div class="v2-media-empty" aria-hidden={hasMedia}>
      <p {...catalogUiBinding('emptyMediaLabel')}>{cardCopy.emptyMediaLabel}</p>
    </div>
  </div>}
  <div class="v2-category-card__body">
    <p {...stateLabelBinding}>{stateLabel}</p>
    <h3 {...binding('title', 'heading')}>{category.title}</h3>
    <span class="v2-category-card__description" {...binding('shortDescription', 'long-text')}>{category.shortDescription}</span>
    <span class="v2-card-link" {...catalogUiBinding('ctaLabel', 'link-label')}>{cardCopy.ctaLabel}</span>
  </div>
</a>
