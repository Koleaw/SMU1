---
import { v2Href as resolveV2Href } from '../../utils/v2Routes';
const withBase = (value: string) => resolveV2Href(value, Astro.url.pathname);
import {
  categoryGalleryImages,
  imageViewStyle,
  isPlaceholderCatalogMedia,
  type ProductCategoryData
} from './catalogV2Data';

interface Props {
  category: ProductCategoryData;
  href: string;
  productCount?: number;
  featured?: boolean;
  loading?: 'eager' | 'lazy';
}

const { category, href, productCount = 0, featured = false, loading = 'lazy' } = Astro.props as Props;
const rawCategoryImage = category.image?.trim() || '';
const cardImage = rawCategoryImage && !isPlaceholderCatalogMedia(rawCategoryImage)
  ? rawCategoryImage
  : categoryGalleryImages(category)[0] || '';
const hasMedia = Boolean(cardImage);
const productNoun = productCount % 10 === 1 && productCount % 100 !== 11
  ? 'опубликованное изделие'
  : [2, 3, 4].includes(productCount % 10) && ![12, 13, 14].includes(productCount % 100)
    ? 'опубликованных изделия'
    : 'опубликованных изделий';
const state = productCount > 0 ? 'products' : hasMedia ? 'sparse' : 'minimal';
const stateLabel = productCount > 0
  ? `${productCount} ${productNoun}`
  : hasMedia
    ? 'Изготовление по задаче'
    : 'Описание без фотоматериалов';
---

<a
  class:list={['v2-category-card', { 'v2-category-card--featured': featured }]}
  href={withBase(href)}
  data-v2-transition-label={category.title}
  data-v2-category-state={state}
  data-v2-reveal
>
  <div class="v2-category-card__media" data-v2-media>
    {cardImage ? (
      <img
        src={withBase(cardImage)}
        alt={category.title}
        width="900"
        height="680"
        loading={loading}
        decoding="async"
        style={imageViewStyle(category.imageView)}
        data-v2-image
      />
    ) : null}
    <div class="v2-media-empty" aria-hidden={hasMedia}>
      <p>Фотоматериалы не указаны</p>
    </div>
  </div>
  <div class="v2-category-card__body">
    <p>{stateLabel}</p>
    <h3>{category.title}</h3>
    <span class="v2-category-card__description">{category.shortDescription}</span>
    <span class="v2-card-link">Открыть категорию</span>
  </div>
</a>
