---
import { v2Href as resolveV2Href } from '../../utils/v2Routes';
const withBase = (value: string) => resolveV2Href(value, Astro.url.pathname);
import { formatProductPrice, imageViewStyle, productGalleryImages, type ProductData } from './catalogV2Data';

interface Props {
  product: ProductData;
  href: string;
  loading?: 'eager' | 'lazy';
  related?: boolean;
}

const { product, href, loading = 'lazy', related = false } = Astro.props as Props;
const primaryMaterial = Array.isArray(product.materials)
  ? product.materials.find((item) => typeof item === 'string' && item.trim())?.trim()
  : '';
const cardImage = productGalleryImages(product)[0] || '';
const isPremium = product.presentationType === 'premium';
---

<a
  class:list={['v2-product-card', { 'v2-product-card--related': related, 'v2-product-card--premium': isPremium }]}
  href={withBase(href)}
  data-v2-transition-label={product.title}
  data-product-card-presentation={isPremium ? 'premium' : 'standard'}
  data-v2-reveal
>
  <div class="v2-product-card__media" data-v2-media>
    {cardImage ? (
      <img
        src={withBase(cardImage)}
        alt={product.title}
        width="800"
        height="640"
        loading={loading}
        decoding="async"
        style={imageViewStyle(product.imageView)}
        data-v2-image
      />
    ) : null}
    <div class="v2-media-empty" aria-hidden={Boolean(cardImage)}>
      <p>Фото не указано</p>
    </div>
  </div>
  <div class="v2-product-card__body">
    {isPremium ? (
      <p class="v2-product-card__presentation" data-product-presentation-indicator="premium">Решение для объекта</p>
    ) : null}
    <p class="v2-product-card__type">{primaryMaterial || 'Материалы не указаны'}</p>
    <h3>{product.title}</h3>
    <p class="v2-product-card__description">{product.shortDescription}</p>
    <div class="v2-product-card__footer">
      <strong>{formatProductPrice(product)}</strong>
      <span class="v2-card-link">Подробнее</span>
    </div>
  </div>
</a>
