---
import { v2Href as resolveV2Href } from '../../utils/v2Routes';
const withBase = (value: string) => resolveV2Href(value, Astro.url.pathname);
import { formatProductPrice, imageViewStyle, productGalleryImages, type ProductData } from './catalogV2Data';
import V2ResponsiveImage from './V2ResponsiveImage.astro';
import { adminBinding, isLocalAdminCanvas } from '../../admin/bindings/adminBinding';
import settings from '../../content/site-settings/global.json';

interface Props {
  product: ProductData;
  href: string;
  loading?: 'eager' | 'lazy';
  related?: boolean;
  gridCount?: number;
}

const { product, href, loading = 'lazy', related = false, gridCount = 4 } = Astro.props as Props;
const mediaSizes = gridCount <= 3 ? `(max-width: 760px) calc(100vw - 32px), (max-width: 980px) 48vw, ${gridCount === 3 ? '32vw' : '48vw'}` : '(max-width: 760px) calc(100vw - 32px), (max-width: 1180px) 48vw, 24vw';
const primaryMaterial = Array.isArray(product.materials)
  ? product.materials.find((item) => typeof item === 'string' && item.trim())?.trim()
  : '';
const cardImage = productGalleryImages(product)[0] || '';
const editorCanvas = isLocalAdminCanvas(Astro.url);
const isPremium = product.presentationType === 'premium';
const affectedRoutes = [Astro.url.pathname, href];
const binding = (fieldPath: string, tool: string, options: Record<string, unknown> = {}) => adminBinding(Astro.url, {
  renderer: { family: 'catalog-card', variant: isPremium ? 'premium-product' : 'standard-product' },
  owner: { collection: 'products', slug: product.slug }, fieldPath,
  stableItemId: product.slug, scope: 'shared', tool, affectedRoutes, ...options
});
const productUiBinding = (fieldPath: string, tool = 'short-text') => adminBinding(Astro.url, {
  renderer: { family: 'global-shell', variant: 'catalog-card-ui' },
  owner: { collection: 'site-settings', slug: 'global' },
  fieldPath: `productUi.${fieldPath}`,
  stableItemId: `catalog-card-${product.slug}-${fieldPath}`,
  scope: 'global',
  tool,
  affectedRoutes: ['*']
});
---

<a
  class:list={['v2-product-card', {
    'v2-product-card--related': related,
    'v2-product-card--no-media': !cardImage,
    'v2-product-card--isolated': /\.(png|svg)$/i.test(cardImage),
    'v2-product-card--premium': isPremium,
    'v2-product-card--editor-missing-media': !cardImage && editorCanvas
  }]}
  href={withBase(href)}
  data-v2-transition-label={product.title}
  data-catalog-product-slug={product.slug}
  data-product-card-presentation={isPremium ? 'premium' : 'standard'}
  data-smu1-live-product-slug={editorCanvas ? product.slug : undefined}
  data-smu1-live-product-category={editorCanvas ? product.productCategorySlug : undefined}
  data-v2-reveal
  {...(!related ? binding('order', 'reorder-item', { zoneId: product.productCategorySlug, parentSlug: product.productCategorySlug, permissions: { edit: true, reorder: true, delete: false } }) : {})}
>
  {(cardImage || editorCanvas) && (
    <div
      class:list={['v2-product-card__media', { 'v2-product-card__media--editor-affordance': !cardImage }]}
      data-v2-media
      data-smu1-editor-affordance={!cardImage ? 'missing-product-media' : undefined}
      {...binding('gallery', 'gallery', { role: cardImage ? 'product-card-media' : 'missing-product-media', multiple: true, coverPath: 'image' })}
    >
      {cardImage ? (
      <V2ResponsiveImage
        src={cardImage}
        alt={product.title}
        role="card"
        sizes={mediaSizes}
        loading={loading}
        decoding="async"
        style={imageViewStyle(product.imageView)}
        data-v2-image
        data-smu1-canonical-media={editorCanvas ? cardImage : undefined}
      />
      ) : (
        <span class="v2-media-empty v2-media-empty--editor-affordance" data-smu1-editor-affordance="missing-product-media">
          <span>Добавить фотографии</span>
        </span>
      )}
    </div>
  )}
  <div class="v2-product-card__body">
    {isPremium ? (
      <p class="v2-product-card__presentation" data-product-presentation-indicator="premium" {...productUiBinding('cardPremiumLabel')}>
        {settings.productUi.cardPremiumLabel}
      </p>
    ) : null}
    <p class="v2-product-card__type" {...binding('materials', 'list', {
      itemKind: 'string',
      label: 'Материалы товара',
      projection: {
        kind: 'derived',
        formula: 'first non-empty materials item || site-settings.global.productUi.cardMaterialsMissingLabel'
      }
    })}>
      {primaryMaterial || settings.productUi.cardMaterialsMissingLabel}
    </p>
    <h3 {...binding('title', 'heading')}>{product.title}</h3>
    <p class="v2-product-card__description" {...binding('shortDescription', 'long-text')}>{product.shortDescription}</p>
    <div class="v2-product-card__footer">
      <strong {...binding('priceMode', 'price', { modePath: 'priceMode', valuePath: 'priceFrom', currencyPath: 'currency' })}>{formatProductPrice(product)}</strong>
      <span class="v2-card-link" {...productUiBinding('cardCtaLabel', 'link-label')}>{settings.productUi.cardCtaLabel}</span>
    </div>
  </div>
</a>
