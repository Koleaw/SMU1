---
import DirectionV2Layout from '../directions/DirectionV2Layout.astro';
import placeStylesheetUrl from '../../../styles/v2/place-direction-v2.css?url';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  currentPath: string;
  ogImage?: string;
  variant?: 'landscaping';
}

const { title, description, canonicalPath, currentPath, ogImage = '', variant } = Astro.props as Props;
---

<DirectionV2Layout
  blockingStylesheetUrls={[placeStylesheetUrl]}
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  currentPath={currentPath}
  ogImage={ogImage}
  variant="place-commercial"
>
  <div
    class:list={['place-direction-v2', variant && `place-direction-v2--${variant}`]}
    data-place-direction-v2
  >
    <slot />
  </div>
</DirectionV2Layout>
