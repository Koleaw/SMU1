---
interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  items: string[];
  titleBinding?: Record<string, string>;
  descriptionBinding?: Record<string, string>;
  itemsBinding?: Record<string, string>;
  eyebrowBinding?: Record<string, string>;
}

const { eyebrow = 'Для первого обсуждения', title, description, items } = Astro.props as Props;
const titleBinding = Astro.props.titleBinding ?? {};
const descriptionBinding = Astro.props.descriptionBinding ?? {};
const itemsBinding = Astro.props.itemsBinding ?? {};
const eyebrowBinding = Astro.props.eyebrowBinding ?? {};
---

{items.length > 0 && (
  <section class="place-brief" id="landscaping-brief" aria-labelledby="place-brief-title">
    <div class="hv2-shell hv2-grid place-brief__grid">
      <header class="place-brief__heading" data-v2-reveal>
        <p class="hv2-eyebrow" {...eyebrowBinding}>{eyebrow}</p>
        <h2 id="place-brief-title" {...titleBinding}>{title}</h2>
        <p {...descriptionBinding}>{description}</p>
      </header>
      <ul class="place-brief__items" role="list" data-v2-reveal {...itemsBinding}>
        {items.map((item) => (
          <li><strong>{item}</strong></li>
        ))}
      </ul>
    </div>
  </section>
)}
