---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  items: string[];
  titleBinding?: Record<string, string>;
  descriptionBinding?: Record<string, string>;
  itemsBinding?: Record<string, string>;
  eyebrowBinding?: Record<string, string>;
}

const { eyebrow = 'Территории и объекты', title, description = '', items } = Astro.props as Props;
const titleBinding = Astro.props.titleBinding ?? {};
const descriptionBinding = Astro.props.descriptionBinding ?? {};
const itemsBinding = Astro.props.itemsBinding ?? {};
const eyebrowBinding = Astro.props.eyebrowBinding ?? {};
---

{items.length > 0 && (
  <section class="place-contexts" id="landscaping-contexts" aria-labelledby="place-contexts-title">
    <div class="hv2-shell hv2-grid place-contexts__grid">
      <header class="place-contexts__heading" data-v2-reveal>
        <p class="hv2-eyebrow hv2-eyebrow--light" {...eyebrowBinding}>{eyebrow}</p>
        <h2 id="place-contexts-title" {...titleBinding}>{title}</h2>
        {description && <p {...descriptionBinding}>{description}</p>}
      </header>
      <ul class="place-contexts__list" role="list" data-v2-reveal {...itemsBinding}>
        {items.map((item) => (
          <li><strong>{item}</strong></li>
        ))}
      </ul>
    </div>
  </section>
)}
