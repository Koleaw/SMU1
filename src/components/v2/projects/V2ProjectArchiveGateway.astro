---
import { v2Href } from '../../../utils/v2Routes';
import type { V2ProjectMedia, V2ProjectPresentation } from '../mediaRoleAdapter';
import { loadPublishedV2ProjectPresentations } from './projectV2Data';
import '../../../styles/v2/project-archive-gateway.css';

interface Props {
  variant: 'home' | 'company';
  sectionId: string;
  title: string;
  description: string;
  ctaLabel: string;
  excludeSources?: readonly string[];
}

type GatewayFrame = {
  src: string;
  position: string;
  webpSrcset?: string;
};

const FRAME_INTERVAL_MS = 3000;
const CROSSFADE_MS = 700;
const GATEWAY_IMAGE_WIDTHS = [768, 1360, 1600, 2080, 3200] as const;
const GATEWAY_MEDIA_STEMS: Readonly<Record<string, string>> = {
  '/uploads/project-da0872c68d9a09f0a7d2f995.jpg': 'project-da0872c68d9a09f0a7d2f995',
  '/uploads/img-20250724-134235-1783272745917.jpg': 'img-20250724-134235-1783272745917',
  '/uploads/project-05c77513c1a391e5a71a7dee.jpg': 'project-05c77513c1a391e5a71a7dee',
  '/uploads/project-248f17177df30b29ab9b231a.jpg': 'project-248f17177df30b29ab9b231a',
  '/uploads/img-20231102-142552-1783272745634.jpg': 'img-20231102-142552-1783272745634',
  '/uploads/img-20231223-222338-1783272745821.jpg': 'img-20231223-222338-1783272745821',
  '/uploads/img-20250724-133811-1783272616313.jpg': 'img-20250724-133811-1783272616313'
};

const {
  variant,
  sectionId,
  title,
  description,
  ctaLabel,
  excludeSources = []
} = Astro.props as Props;

const MAX_FRAMES = 6;
const excluded = new Set(excludeSources.map((source) => source.trim()).filter(Boolean));
const presentations = await loadPublishedV2ProjectPresentations();
const isPlaceholder = (source: string) => /\/assets\/images\/placeholders\//iu.test(source);
const isSafeMedia = (media: V2ProjectMedia) => (
  (media.roles.includes('finished-result') || media.roles.includes('proof'))
  && !media.roles.includes('process')
  && !media.roles.includes('excluded')
  && !isPlaceholder(media.src)
  && !excluded.has(media.src)
);
const frameFromMedia = (
  presentation: V2ProjectPresentation,
  media: V2ProjectMedia
): GatewayFrame => ({
  src: media.src,
  position: media.src === presentation.archiveCoverMedia?.src
    ? presentation.archiveCoverPosition
    : media.src === presentation.detailHeroMedia?.src
      ? presentation.detailHeroPosition
      : '50% 50%'
});
const candidatesByPresentation = presentations.map((presentation) => {
  const seen = new Set<string>();
  return [presentation.archiveCoverMedia, ...presentation.publicGallery]
    .filter((media): media is V2ProjectMedia => Boolean(media))
    .filter((media) => {
      if (seen.has(media.src) || !isSafeMedia(media)) return false;
      seen.add(media.src);
      return true;
    })
    .map((media) => frameFromMedia(presentation, media));
});

const selectedFrames: GatewayFrame[] = [];
const selectedSources = new Set<string>();
let addedFrame = true;
while (selectedFrames.length < MAX_FRAMES && addedFrame) {
  addedFrame = false;
  for (const candidates of candidatesByPresentation) {
    const candidate = candidates.find((frame) => !selectedSources.has(frame.src));
    if (!candidate) continue;
    selectedFrames.push(candidate);
    selectedSources.add(candidate.src);
    addedFrame = true;
    if (selectedFrames.length >= MAX_FRAMES) break;
  }
}

const orderedFrames = variant === 'company' && selectedFrames.length > 1
  ? [...selectedFrames.slice(1), selectedFrames[0]]
  : selectedFrames;
const responsiveSizes = variant === 'home'
  ? [
      '(min-width: 2200px) min(2080px, calc(100vw - 160px))',
      '(min-width: 1600px) min(1600px, calc(100vw - 96px))',
      '(min-width: 761px) min(1360px, calc(100vw - 64px))',
      '(min-width: 360px) calc(100vw - 32px)',
      'calc(100vw - 24px)'
    ].join(', ')
  : [
      '(min-width: 2200px) min(2080px, calc(100vw - 160px))',
      '(min-width: 1600px) min(1600px, calc(100vw - 96px))',
      '(min-width: 1101px) min(1360px, calc(100vw - 64px))',
      '(min-width: 701px) min(980px, calc(100vw - 40px))',
      '(min-width: 361px) calc(100vw - 32px)',
      'calc(100vw - 24px)'
    ].join(', ');
const frames = orderedFrames.map((frame): GatewayFrame => {
  const derivativeStem = GATEWAY_MEDIA_STEMS[frame.src];
  return {
    ...frame,
    src: v2Href(frame.src, Astro.url.pathname),
    webpSrcset: derivativeStem
      ? GATEWAY_IMAGE_WIDTHS
          .map((width) => `${v2Href(`/assets/images/gateway/${derivativeStem}-w${width}.webp`, Astro.url.pathname)} ${width}w`)
          .join(', ')
      : undefined
  };
});
const firstFrame = frames[0];
const archiveHref = v2Href('/vypolnennye-obekty/', Astro.url.pathname);
const titleId = `${sectionId}-gateway-title`;
const descriptionId = `${sectionId}-gateway-description`;
const hasMedia = Boolean(firstFrame);
const canRotate = frames.length > 1;
---

<section
  class:list={[
    'v2-project-archive-gateway',
    `v2-project-archive-gateway--${variant}`,
    { 'v2-project-archive-gateway--text-only': !hasMedia }
  ]}
  id={sectionId}
  aria-labelledby={titleId}
  data-v2-project-archive-gateway
  data-gateway-frames={JSON.stringify(frames)}
  data-gateway-frame-interval-ms={FRAME_INTERVAL_MS}
  data-gateway-crossfade-ms={CROSSFADE_MS}
  data-gateway-sizes={responsiveSizes}
  style={`--gateway-crossfade-duration: ${CROSSFADE_MS}ms;`}
>
  <div class:list={[
    'v2-project-archive-gateway__shell',
    variant === 'home' ? 'hf-shell hf-shell--editorial' : 'hv2-shell'
  ]}>
    <div class="v2-project-archive-gateway__stage">
      <a
        class="v2-project-archive-gateway__link"
        href={archiveHref}
        aria-labelledby={titleId}
        aria-describedby={descriptionId}
        data-gateway-link
      >
        {firstFrame && (
          <span class="v2-project-archive-gateway__media" aria-hidden="true" data-gateway-media>
            <picture class="v2-project-archive-gateway__picture" data-gateway-current-picture>
              {firstFrame.webpSrcset && (
                <source
                  type="image/webp"
                  srcset={firstFrame.webpSrcset}
                  sizes={responsiveSizes}
                  data-gateway-current-source
                />
              )}
              <img
                class="v2-project-archive-gateway__image is-current"
                src={firstFrame.src}
                alt=""
                width="1920"
                height="1200"
                loading="lazy"
                decoding="async"
                style={`object-position: ${firstFrame.position};`}
                data-gateway-current-image
              />
            </picture>
          </span>
        )}
        {hasMedia && <span class="v2-project-archive-gateway__gradient" aria-hidden="true"></span>}
        <span class="v2-project-archive-gateway__copy">
          <h2 id={titleId}>{title}</h2>
          <span class="v2-project-archive-gateway__description" id={descriptionId}>{description}</span>
          <span class="v2-project-archive-gateway__cta">
            <span>{ctaLabel}</span>
            <svg viewBox="0 0 24 24" width="24" height="24" focusable="false" aria-hidden="true">
              <path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="square" stroke-linejoin="miter"></path>
            </svg>
          </span>
        </span>
      </a>

      {canRotate && (
        <button
          class="v2-project-archive-gateway__toggle"
          type="button"
          aria-label="Остановить смену фотографий"
          aria-pressed="false"
          data-gateway-toggle
          hidden
        >
          <svg data-gateway-pause-icon viewBox="0 0 24 24" width="20" height="20" focusable="false" aria-hidden="true">
            <path d="M8 6v12M16 6v12" fill="none" stroke="currentColor" stroke-width="2"></path>
          </svg>
          <svg class="is-hidden" data-gateway-play-icon viewBox="0 0 24 24" width="20" height="20" focusable="false" aria-hidden="true">
            <path d="m9 6 9 6-9 6Z" fill="currentColor"></path>
          </svg>
        </button>
      )}
    </div>
  </div>
</section>

<script>
  type GatewayFrame = { src: string; position: string; webpSrcset?: string };
  type GatewaySlot = {
    picture: HTMLPictureElement;
    source: HTMLSourceElement | null;
    image: HTMLImageElement;
  };

  const DEFAULT_FRAME_INTERVAL_MS = 3000;
  const DEFAULT_CROSSFADE_MS = 700;

  const initializeProjectArchiveGateway = (root: HTMLElement) => {
    if (root.dataset.gatewayReady === 'true') return;
    root.dataset.gatewayReady = 'true';

    const link = root.querySelector<HTMLAnchorElement>('[data-gateway-link]');
    const media = root.querySelector<HTMLElement>('[data-gateway-media]');
    const initialPicture = root.querySelector<HTMLPictureElement>('[data-gateway-current-picture]');
    const initialSource = root.querySelector<HTMLSourceElement>('[data-gateway-current-source]');
    const initialImage = root.querySelector<HTMLImageElement>('[data-gateway-current-image]');
    const toggle = root.querySelector<HTMLButtonElement>('[data-gateway-toggle]');
    const pauseIcon = root.querySelector<SVGElement>('[data-gateway-pause-icon]');
    const playIcon = root.querySelector<SVGElement>('[data-gateway-play-icon]');
    if (!link || !media || !initialPicture || !initialImage || !toggle || !pauseIcon || !playIcon) return;
    const mediaElement = media;

    let frames: GatewayFrame[] = [];
    try {
      const parsed = JSON.parse(root.dataset.gatewayFrames || '[]') as unknown;
      if (Array.isArray(parsed)) {
        frames = parsed.filter((frame): frame is GatewayFrame => (
          typeof frame === 'object'
          && frame !== null
          && typeof (frame as GatewayFrame).src === 'string'
          && typeof (frame as GatewayFrame).position === 'string'
          && (
            (frame as GatewayFrame).webpSrcset === undefined
            || typeof (frame as GatewayFrame).webpSrcset === 'string'
          )
        ));
      }
    } catch {
      frames = [];
    }
    if (frames.length < 2) return;

    const parsedFrameInterval = Number(root.dataset.gatewayFrameIntervalMs);
    const parsedCrossfade = Number(root.dataset.gatewayCrossfadeMs);
    const frameIntervalMs = Number.isFinite(parsedFrameInterval) && parsedFrameInterval > 0
      ? parsedFrameInterval
      : DEFAULT_FRAME_INTERVAL_MS;
    const crossfadeMs = Number.isFinite(parsedCrossfade) && parsedCrossfade >= 0
      ? parsedCrossfade
      : DEFAULT_CROSSFADE_MS;
    const responsiveSizes = root.dataset.gatewaySizes || '100vw';
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const connection = (navigator as Navigator & {
      connection?: EventTarget & { saveData?: boolean };
    }).connection;

    const standbyPicture = document.createElement('picture');
    standbyPicture.className = 'v2-project-archive-gateway__picture';
    standbyPicture.setAttribute('aria-hidden', 'true');
    const standbySource = document.createElement('source');
    standbySource.type = 'image/webp';
    standbySource.setAttribute('sizes', responsiveSizes);
    const standbyImage = document.createElement('img');
    standbyImage.className = 'v2-project-archive-gateway__image';
    standbyImage.alt = '';
    standbyImage.width = 1920;
    standbyImage.height = 1200;
    standbyImage.loading = 'eager';
    standbyImage.decoding = 'async';
    standbyImage.setAttribute('aria-hidden', 'true');
    standbyPicture.append(standbySource, standbyImage);

    let currentSlot: GatewaySlot = {
      picture: initialPicture,
      source: initialSource,
      image: initialImage
    };
    let standbySlot: GatewaySlot = {
      picture: standbyPicture,
      source: standbySource,
      image: standbyImage
    };
    let currentIndex = 0;
    let timer = 0;
    let transitionTimer = 0;
    let transitionToken = 0;
    let preparationToken = 0;
    let preparingIndex = -1;
    let preparedIndex = -1;
    let nextDeadline = 0;
    let advanceDue = false;
    let advanceDueUntil = 0;
    let isNearViewport = false;
    let isVisible = false;
    let isLinkFocused = false;
    let isTransitioning = false;
    let userPaused = false;
    let rotationUnavailable = false;
    const failedFrames = new Set<number>();

    root.dataset.gatewayFrameIndex = '0';

    const clearSchedule = () => {
      if (!timer) return;
      window.clearTimeout(timer);
      timer = 0;
    };

    const isSaveDataEnabled = () => Boolean(connection?.saveData);
    const canRotate = () => (
      isVisible
      && !document.hidden
      && !isLinkFocused
      && !userPaused
      && !reducedMotion.matches
      && !isSaveDataEnabled()
      && !rotationUnavailable
    );
    const canPrepare = () => (
      isNearViewport
      && !document.hidden
      && !reducedMotion.matches
      && !isSaveDataEnabled()
      && !rotationUnavailable
    );

    const updateToggle = () => {
      const label = userPaused
        ? 'Возобновить смену фотографий'
        : 'Остановить смену фотографий';
      toggle.setAttribute('aria-label', label);
      toggle.setAttribute('aria-pressed', String(userPaused));
      pauseIcon.classList.toggle('is-hidden', userPaused);
      playIcon.classList.toggle('is-hidden', !userPaused);
      root.dataset.gatewayUserPaused = String(userPaused);
    };

    const cancelTransition = () => {
      if (!isTransitioning && !transitionTimer) return;
      transitionToken += 1;
      if (transitionTimer) {
        window.clearTimeout(transitionTimer);
        transitionTimer = 0;
      }
      standbySlot.image.classList.remove('is-incoming');
      isTransitioning = false;
    };

    const nextFrameIndex = () => {
      for (let offset = 1; offset !== frames.length; offset += 1) {
        const index = (currentIndex + offset) % frames.length;
        if (!failedFrames.has(index)) return index;
      }
      return -1;
    };

    const ensureSource = (slot: GatewaySlot) => {
      if (slot.source) return slot.source;
      const source = document.createElement('source');
      source.type = 'image/webp';
      slot.picture.insertBefore(source, slot.image);
      slot.source = source;
      return source;
    };

    const applyFrame = (slot: GatewaySlot, frame: GatewayFrame) => {
      const source = ensureSource(slot);
      source.setAttribute('sizes', responsiveSizes);
      if (frame.webpSrcset) {
        source.setAttribute('srcset', frame.webpSrcset);
      } else {
        source.removeAttribute('srcset');
      }
      slot.image.src = frame.src;
      slot.image.style.objectPosition = frame.position;
    };

    const stopClock = () => {
      clearSchedule();
      nextDeadline = 0;
      advanceDue = false;
      advanceDueUntil = 0;
    };

    const setRotationUnavailable = () => {
      rotationUnavailable = true;
      stopClock();
      cancelTransition();
      toggle.hidden = true;
      root.dataset.gatewayRotation = 'static';
    };

    function prepareAhead() {
      if (!canPrepare() || isTransitioning || preparedIndex >= 0 || preparingIndex >= 0) return;
      const requestedIndex = nextFrameIndex();
      if (requestedIndex < 0) {
        setRotationUnavailable();
        return;
      }

      if (!standbySlot.picture.isConnected) mediaElement.append(standbySlot.picture);
      const frame = frames[requestedIndex];
      const requestToken = ++preparationToken;
      preparingIndex = requestedIndex;
      applyFrame(standbySlot, frame);

      void Promise.resolve()
        .then(() => standbySlot.image.decode())
        .then(() => {
          if (requestToken !== preparationToken) return;
          if (!standbySlot.image.complete || standbySlot.image.naturalWidth === 0) {
            throw new Error('Gateway image decode failed.');
          }
          preparingIndex = -1;
          preparedIndex = requestedIndex;
          flushPreparedFrame();
        })
        .catch(() => {
          if (requestToken !== preparationToken) return;
          preparingIndex = -1;
          preparedIndex = -1;
          failedFrames.add(requestedIndex);
          if (nextFrameIndex() < 0) setRotationUnavailable();
          else prepareAhead();
        });
    }

    function beginCrossfade(requestedIndex: number) {
      if (!canRotate() || isTransitioning || preparedIndex !== requestedIndex) return;
      advanceDue = false;
      advanceDueUntil = 0;
      isTransitioning = true;
      const requestToken = ++transitionToken;
      mediaElement.append(standbySlot.picture);
      standbySlot.image.classList.add('is-incoming');
      transitionTimer = window.setTimeout(() => {
        if (requestToken !== transitionToken) return;
        currentSlot.image.classList.remove('is-current');
        standbySlot.image.classList.remove('is-incoming');
        standbySlot.image.classList.add('is-current');
        const previousSlot = currentSlot;
        currentSlot = standbySlot;
        standbySlot = previousSlot;
        currentIndex = requestedIndex;
        preparedIndex = -1;
        transitionTimer = 0;
        isTransitioning = false;
        root.dataset.gatewayFrameIndex = String(currentIndex);
        prepareAhead();
        flushPreparedFrame();
      }, crossfadeMs);
    }

    function flushPreparedFrame() {
      if (!advanceDue || !canRotate() || isTransitioning || preparedIndex < 0) return;
      if (performance.now() > advanceDueUntil) {
        advanceDue = false;
        advanceDueUntil = 0;
        return;
      }
      beginCrossfade(preparedIndex);
    }

    const armDeadline = () => {
      clearSchedule();
      if (!canRotate() || nextDeadline <= 0) return;
      timer = window.setTimeout(handleDeadline, Math.max(0, nextDeadline - performance.now()));
    };

    function handleDeadline() {
      timer = 0;
      if (!canRotate()) {
        stopClock();
        return;
      }
      const dueDeadline = nextDeadline;
      const now = performance.now();
      do nextDeadline += frameIntervalMs;
      while (nextDeadline <= now);
      armDeadline();
      if (preparedIndex >= 0 && !isTransitioning) {
        beginCrossfade(preparedIndex);
        return;
      }
      advanceDue = true;
      advanceDueUntil = dueDeadline + 250;
      flushPreparedFrame();
    }

    const startClock = () => {
      if (!canRotate()) return;
      if (nextDeadline <= 0) nextDeadline = performance.now() + frameIntervalMs;
      armDeadline();
    };

    const syncState = () => {
      if (reducedMotion.matches || isSaveDataEnabled()) {
        stopClock();
        cancelTransition();
        toggle.hidden = true;
        root.dataset.gatewayRotation = 'static';
        return;
      }
      if (rotationUnavailable) {
        stopClock();
        cancelTransition();
        toggle.hidden = true;
        root.dataset.gatewayRotation = 'static';
        return;
      }
      toggle.hidden = false;
      root.dataset.gatewayRotation = 'available';
      prepareAhead();
      if (!canRotate()) {
        stopClock();
        cancelTransition();
        return;
      }
      startClock();
    };

    link.addEventListener('focusin', () => {
      isLinkFocused = true;
      syncState();
    });
    link.addEventListener('focusout', () => {
      window.requestAnimationFrame(() => {
        isLinkFocused = link.contains(document.activeElement);
        syncState();
      });
    });
    document.addEventListener('visibilitychange', syncState);
    reducedMotion.addEventListener('change', syncState);
    connection?.addEventListener?.('change', syncState);
    toggle.addEventListener('click', () => {
      userPaused = !userPaused;
      updateToggle();
      syncState();
    });

    if ('IntersectionObserver' in window) {
      const preloadObserver = new IntersectionObserver((entries) => {
        isNearViewport = entries.some((entry) => entry.isIntersecting);
        syncState();
      }, { rootMargin: '600px 0px', threshold: 0 });
      const visibilityObserver = new IntersectionObserver((entries) => {
        isVisible = entries.some((entry) => entry.isIntersecting);
        syncState();
      }, { rootMargin: '0px', threshold: 0.01 });
      preloadObserver.observe(root);
      visibilityObserver.observe(root);
    } else {
      isNearViewport = true;
      isVisible = true;
    }

    updateToggle();
    syncState();
  };

  const initializeProjectArchiveGateways = () => {
    document.querySelectorAll<HTMLElement>('[data-v2-project-archive-gateway]')
      .forEach(initializeProjectArchiveGateway);
  };

  initializeProjectArchiveGateways();
  document.addEventListener('astro:page-load', initializeProjectArchiveGateways);
</script>
