---
import { getCollection } from 'astro:content';
import settings from '../../../content/site-settings/global.json';
import V2Breadcrumbs from '../V2Breadcrumbs.astro';
import V2DirectContact from '../V2DirectContact.astro';
import V2ProjectArchive from './V2ProjectArchive.astro';
import V2ProjectsLayout from './V2ProjectsLayout.astro';
import { loadPublishedV2ProjectPresentations } from './projectV2Data';
import { adminBinding } from '../../../admin/bindings/adminBinding';

const [projects, staticPages] = await Promise.all([
  loadPublishedV2ProjectPresentations(),
  getCollection('static-pages')
]);
const page = staticPages.find(({ data }) => data.slug === 'vypolnennye-obekty')?.data;
if (!page) throw new Error('Published projects V2 requires the existing vypolnennye-obekty static-page record.');

const nonEmpty = (value: string | undefined, fallback: string) => value?.trim() || fallback;
const heroKicker = nonEmpty(page.heroKicker, '');
const heroTitle = nonEmpty(page.heroTitle, page.title);
const heroDescription = nonEmpty(page.heroDescription, '');
const archiveTitle = nonEmpty(page.trustTitle, page.title);
const archiveDescription = nonEmpty(page.trustText, '');
const contactTitle = nonEmpty(page.contactTitle, page.title);
const contactDescription = nonEmpty(page.contactDescription, '');
const contactEyebrow = nonEmpty(page.contactEyebrow, settings.shellLabels.directContactGroup);
const contactPrimaryLabel = nonEmpty(page.contactPrimaryLabel, settings.projectUi.detailContactPrimaryLabel);
const contactSecondaryLabel = nonEmpty(page.contactSecondaryLabel, '');
const showKicker = page.showBadge !== false && Boolean(heroKicker);
const ogImage = projects.find((project) => project.archiveCoverMedia)?.archiveCoverMedia?.src;
const phoneHref = `tel:${settings.phonePrimary.replace(/[^+\d]/g, '')}`;
const pageBinding = (fieldPath: string, tool = 'long-text') => adminBinding(Astro.url, {
  renderer: { family: 'project-archive', variant: 'index' }, owner: { collection: 'static-pages', slug: page.slug },
  fieldPath, stableItemId: page.slug, scope: 'local', tool, affectedRoutes: ['/vypolnennye-obekty/']
});
const projectUiBinding = (fieldPath: string, tool = 'short-text') => adminBinding(Astro.url, {
  renderer: { family: 'project-archive', variant: 'index' }, owner: { collection: 'site-settings', slug: 'global' },
  fieldPath: `projectUi.${fieldPath}`, stableItemId: `project-archive-${fieldPath}`, scope: 'shared', tool,
  affectedRoutes: ['/vypolnennye-obekty/', '/vypolnennye-obekty/*']
});
---

<V2ProjectsLayout
  title={page.seoTitle}
  description={page.seoDescription}
  canonicalPath="/vypolnennye-obekty/"
  currentPath={Astro.url.pathname}
  ogImage={ogImage}
  variant="archive"
>
  <V2Breadcrumbs items={[
    { title: settings.projectUi.homeBreadcrumbLabel, href: '/', editor: projectUiBinding('homeBreadcrumbLabel') },
    { title: page.title, editor: pageBinding('title', 'short-text') }
  ]} />

  <header class="v2-project-archive-hero">
    <div class="hv2-shell v2-project-archive-hero__grid" data-v2-page-handoff="copy">
      <div data-v2-reveal>
        {showKicker && <p class="hv2-eyebrow" data-v2-entrance-role="context" {...pageBinding('heroKicker', 'short-text')}>{heroKicker}</p>}
        <h1 data-v2-entrance-role="title-primary" {...pageBinding('heroTitle', 'heading')}>{heroTitle}</h1>
      </div>
      <p data-v2-reveal data-v2-entrance-role="lead" {...pageBinding('heroDescription', 'long-text')}>{heroDescription}</p>
    </div>
  </header>

  <V2ProjectArchive projects={projects} title={archiveTitle} description={archiveDescription} bindingOwner={{ collection: 'static-pages', slug: page.slug }} />

  <V2DirectContact
    eyebrow={contactEyebrow}
    title={contactTitle}
    description={contactDescription}
    primaryLabel={contactPrimaryLabel}
    primaryHref={settings.telegram}
    secondaryLabel={contactSecondaryLabel}
    secondaryHref={phoneHref}
    eyebrowBinding={pageBinding('contactEyebrow', 'short-text')}
    titleBinding={pageBinding('contactTitle', 'heading')}
    descriptionBinding={pageBinding('contactDescription', 'long-text')}
    primaryLabelBinding={pageBinding('contactPrimaryLabel', 'button-label')}
    secondaryLabelBinding={pageBinding('contactSecondaryLabel', 'button-label')}
    editorSource="src/components/v2/projects/V2ProjectArchivePage.astro#contact"
  />
</V2ProjectsLayout>
