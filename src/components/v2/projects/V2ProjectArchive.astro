---
import type { V2ProjectPresentation } from '../mediaRoleAdapter';
import V2ProjectCard from './V2ProjectCard.astro';
import '../../../styles/v2/projects-v2.css';

interface Props {
  projects: V2ProjectPresentation[];
}

const { projects } = Astro.props as Props;
const visualProjects = projects.filter((item) => !item.isTextOnly && item.archiveCoverMedia);
const textProjects = projects.filter((item) => item.isTextOnly);
const firstMediaSlug = visualProjects[0]?.project.slug;
---

<section class="v2-project-archive" aria-label="Список выполненных объектов">
  <div class="hv2-shell">
    {visualProjects.length > 0 && (
      <div class="v2-project-archive__visual-grid" role="list">
        {visualProjects.map((presentation) => (
          <div class="v2-project-archive__item" role="listitem">
            <V2ProjectCard
              presentation={presentation}
              variant="visual"
              headingLevel="h2"
              eager={presentation.project.slug === firstMediaSlug}
            />
          </div>
        ))}
      </div>
    )}

    {textProjects.length > 0 && (
      <div class="v2-project-archive__text-grid" role="list" aria-label="Другие выполненные объекты">
        {textProjects.map((presentation) => (
          <div class="v2-project-archive__item" role="listitem">
          <V2ProjectCard
            presentation={presentation}
            variant="text"
            headingLevel="h2"
          />
          </div>
        ))}
      </div>
    )}
  </div>
</section>
