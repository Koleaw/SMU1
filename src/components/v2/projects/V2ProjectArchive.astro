---
import type { V2ProjectPresentation } from '../mediaRoleAdapter';
import V2ProjectCard from './V2ProjectCard.astro';
import '../../../styles/v2/projects-v2.css';

interface Props {
  projects: V2ProjectPresentation[];
}

const { projects } = Astro.props as Props;
const visualProjects = projects.filter((item) => !item.isTextOnly && item.archiveCoverMedia);
const textProjects = projects.filter((item) => item.isTextOnly);
const featuredProject = visualProjects[0];
const remainingVisualProjects = visualProjects.slice(1);
---

<section class="v2-project-archive" aria-labelledby="v2-project-archive-title">
  <div class="hv2-shell">
    <header class="v2-project-archive__heading" data-v2-reveal>
      <div>
        <p class="hv2-eyebrow">Объект в фокусе</p>
        <h2 id="v2-project-archive-title">От задачи к выполненному результату</h2>
      </div>
      <p>В карточках собраны фактические объекты: место, год, состав работ и фотографии результата.</p>
    </header>

    {featuredProject && (
      <div class="v2-project-archive__featured" role="list" aria-label="Выбранный выполненный объект">
        <div class="v2-project-archive__item" role="listitem">
          <V2ProjectCard
            presentation={featuredProject}
            variant="visual"
            headingLevel="h3"
            eager
          />
        </div>
      </div>
    )}

    {remainingVisualProjects.length > 0 && (
      <div class="v2-project-archive__visual-grid" role="list">
        {remainingVisualProjects.map((presentation) => (
          <div class="v2-project-archive__item" role="listitem">
            <V2ProjectCard
              presentation={presentation}
              variant="visual"
              headingLevel="h2"
            />
          </div>
        ))}
      </div>
    )}

    {textProjects.length > 0 && (
      <div class="v2-project-archive__text-grid" role="list" aria-label="Другие выполненные объекты">
        {textProjects.map((presentation) => (
          <div class="v2-project-archive__item" role="listitem">
          <V2ProjectCard
            presentation={presentation}
            variant="text"
            headingLevel="h2"
          />
          </div>
        ))}
      </div>
    )}
  </div>
</section>
