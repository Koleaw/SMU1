---
import CatalogV2Layout from '../CatalogV2Layout.astro';
import '../../../styles/v2/projects-v2.css';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  currentPath: string;
  ogImage?: string;
  variant?: 'default' | 'archive';
}

const {
  title,
  description,
  canonicalPath,
  currentPath,
  ogImage = '',
  variant = 'default'
} = Astro.props as Props;
---

<CatalogV2Layout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  currentPath={currentPath}
  ogImage={ogImage}
  pageKind="section"
>
  <div
    class:list={['projects-v2', { 'projects-v2--archive': variant === 'archive' }]}
    data-projects-v2-root
  >
    <slot />
  </div>
</CatalogV2Layout>
