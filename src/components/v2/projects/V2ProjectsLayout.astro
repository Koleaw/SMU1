---
import CatalogV2Layout from '../CatalogV2Layout.astro';
import '../../../styles/v2/projects-v2.css';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  currentPath: string;
  ogImage?: string;
  variant?: 'default' | 'archive';
  contactHref?: string;
  ctaLabel?: string;
  headerCtaBinding?: Record<string, string>;
  headerMobileCtaBinding?: Record<string, string>;
  mobileCtaBinding?: Record<string, string>;
}

const {
  title,
  description,
  canonicalPath,
  currentPath,
  ogImage = '',
  variant = 'default',
  contactHref = '#contact',
  ctaLabel
} = Astro.props as Props;
---

<CatalogV2Layout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  currentPath={currentPath}
  ogImage={ogImage}
  pageKind="section"
  contactHref={contactHref}
  headerCtaLabel={ctaLabel}
  mobileCtaLabel={ctaLabel}
  headerCtaBinding={Astro.props.headerCtaBinding}
  headerMobileCtaBinding={Astro.props.headerMobileCtaBinding}
  mobileCtaBinding={Astro.props.mobileCtaBinding}
>
  <div
    class:list={['projects-v2', { 'projects-v2--archive': variant === 'archive' }]}
    data-projects-v2-root
  >
    <slot />
  </div>
</CatalogV2Layout>
