---
import { v2Href as resolveV2Href } from '../../../utils/v2Routes';
const withBase = (value: string) => resolveV2Href(value, Astro.url.pathname);
import type { V2ProjectMedia, V2ProjectPresentation } from '../mediaRoleAdapter';
import V2ProjectMeta from './V2ProjectMeta.astro';
import V2ResponsiveImage from '../V2ResponsiveImage.astro';
import { adminBinding } from '../../../admin/bindings/adminBinding';
import settings from '../../../content/site-settings/global.json';
import '../../../styles/v2/projects-v2.css';

interface Props {
  presentation: V2ProjectPresentation;
  variant?: 'visual' | 'text';
  headingLevel?: 'h2' | 'h3';
  media?: V2ProjectMedia;
  mediaPosition?: string;
  eager?: boolean;
}

const {
  presentation,
  variant = 'visual',
  headingLevel = 'h2',
  media = presentation.archiveCoverMedia,
  mediaPosition = presentation.archiveCoverPosition,
  eager = false
} = Astro.props as Props;
const { project, location, v2Route } = presentation;
const Heading = headingLevel;
const showMedia = variant === 'visual' && Boolean(media);
const affectedRoutes = ['/vypolnennye-obekty/', presentation.productionRoute];
const binding = (fieldPath: string, tool = 'long-text', options: Record<string, unknown> = {}) => adminBinding(Astro.url, {
  renderer: { family: 'project-card', variant }, owner: { collection: 'projects', slug: project.slug },
  fieldPath, stableItemId: project.slug, scope: 'shared', tool, affectedRoutes, ...options
});
const projectUiBinding = (fieldPath: string, tool = 'short-text') => adminBinding(Astro.url, {
  renderer: { family: 'global-shell', variant: 'project-archive-card' },
  owner: { collection: 'site-settings', slug: 'global' },
  fieldPath: `projectUi.${fieldPath}`,
  stableItemId: `project-archive-card-${project.slug}-${fieldPath}`,
  scope: 'shared',
  tool,
  affectedRoutes: ['/vypolnennye-obekty/']
});
---

<article
  class:list={[
    'v2-project-card',
    `v2-project-card--${variant}`,
    { 'v2-project-card--media-rich': showMedia, 'v2-project-card--media-sparse': !showMedia }
  ]}
  data-v2-reveal
  data-v2-project-card
  {...binding('order', 'reorder-item', { zoneId: 'project-archive', permissions: { edit: true, reorder: true, delete: false } })}
>
  <a
    class="v2-project-card__card-link"
    href={withBase(v2Route)}
    aria-label={`Открыть объект «${project.title}»`}
    data-v2-transition-label={project.title}
  >
    {showMedia && media && (
      <figure
        class="v2-project-card__media"
        style={`--v2-project-card-position: ${mediaPosition};`}
        data-v2-media
        {...binding('gallery', 'gallery', { role: 'archive-cover', multiple: true, archivePath: 'presentation.archiveCoverMedia', coverPath: 'presentation.archiveCoverMedia', heroPath: 'presentation.detailHeroMedia' })}
      >
        <V2ResponsiveImage
          src={media.src}
          alt={media.alt}
          role="project"
          sizes="(max-width: 760px) calc(100vw - 32px), 42vw"
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : 'auto'}
          decoding="async"
          data-v2-image
          data-v2-page-critical={eager ? '' : undefined}
        />
      </figure>
    )}
    <div class="v2-project-card__body">
      <V2ProjectMeta location={location} year={project.year} bindingOwner={{ collection: 'projects', slug: project.slug }} affectedRoutes={affectedRoutes} />
      <Heading {...binding('title', 'heading')}>{project.title}</Heading>
      <p class="v2-project-card__description" {...binding('shortDescription', 'long-text')}>{project.shortDescription}</p>
      <span class="v2-project-card__link" aria-hidden="true" {...projectUiBinding('archiveCardCtaLabel', 'link-label')}>
        {settings.projectUi.archiveCardCtaLabel}
      </span>
    </div>
  </a>
</article>
