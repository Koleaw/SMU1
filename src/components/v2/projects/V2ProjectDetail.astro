---
import { v2Href as resolveV2Href } from '../../../utils/v2Routes';
const withBase = (value: string) => resolveV2Href(value, Astro.url.pathname);
import type { V2ProjectPresentation } from '../mediaRoleAdapter';
import V2Breadcrumbs from '../V2Breadcrumbs.astro';
import V2DirectContact from '../V2DirectContact.astro';
import { projectTextItems } from './projectV2Data';
import V2ProjectGallery from './V2ProjectGallery.astro';
import V2ProjectMeta from './V2ProjectMeta.astro';
import V2SectionNav from '../V2SectionNav.astro';
import V2ResponsiveImage from '../V2ResponsiveImage.astro';
import '../../../styles/v2/projects-v2.css';

interface Props {
  presentation: V2ProjectPresentation;
  previous?: V2ProjectPresentation;
  next?: V2ProjectPresentation;
}

const { presentation, previous, next } = Astro.props as Props;
const {
  project,
  detailHeroMedia: heroMedia,
  detailHeroPosition,
  publicGallery,
  location,
  relatedDirections,
  isTextOnly
} = presentation;
const eyebrow = presentation.category || 'Выполненный объект';
const heroLead = project.result?.trim() || project.shortDescription;
const additionalFacts = [
  project.summary && project.summary !== project.shortDescription ? { title: 'Об объекте', text: project.summary } : null,
  project.task ? { title: 'Задача', text: project.task } : null,
  project.workTypes?.length
    ? { title: 'Виды работ', text: project.workTypes.join(', ') }
    : project.workType ? { title: 'Виды работ', text: project.workType } : null,
  project.scope ? { title: 'Объём работ', text: project.scope } : null,
  projectTextItems(project.materials).length
    ? { title: 'Материалы', text: projectTextItems(project.materials).join(', ') }
    : null,
  projectTextItems(project.features).length
    ? { title: 'Особенности объекта', text: projectTextItems(project.features).join(', ') }
    : null
].filter((item): item is { title: string; text: string } => Boolean(item?.text));
const sectionNavItems = [
  { id: 'project-overview', label: 'Обзор' },
  { id: 'project-work', label: 'Что выполнено' },
  ...(additionalFacts.length > 0 ? [{ id: 'project-facts', label: 'Сведения' }] : []),
  ...(publicGallery.length > 0 ? [{ id: 'project-gallery', label: 'Фотографии' }] : []),
  ...(relatedDirections.length > 0 ? [{ id: 'project-directions', label: 'Направления' }] : []),
  { id: 'contact', label: 'Обсудить задачу' }
];
---

<V2Breadcrumbs items={[
  { title: 'Главная', href: '/design-lab/home-v2/' },
  { title: 'Выполненные объекты', href: '/design-lab/v2/vypolnennye-obekty/' },
  { title: project.title }
]} />

<article class:list={['v2-project-detail', { 'v2-project-detail--media-sparse': isTextOnly }]}>
  <header class="v2-project-detail__hero" id="project-overview">
    <div class="hv2-shell v2-project-detail__hero-grid">
      <div class="v2-project-detail__hero-copy" data-v2-reveal data-v2-page-handoff="copy">
        <p class="hv2-eyebrow" data-v2-entrance-role="context">{eyebrow}</p>
        <h1 data-v2-entrance-role="title-primary">{project.title}</h1>
        <V2ProjectMeta location={location} year={project.year} />
        <p class="v2-project-detail__lead" data-v2-entrance-role="lead">{heroLead}</p>
        <a class="v2-project-detail__back" href={withBase('/design-lab/v2/vypolnennye-obekty/')} data-v2-entrance-role="actions-meta">
          Все объекты
        </a>
      </div>
      {heroMedia && (
        <figure
          class="v2-project-detail__hero-media"
          style={`--v2-project-hero-position: ${detailHeroPosition};`}
          data-v2-media
          data-v2-reveal
          data-v2-entrance-role="media"
        >
          <V2ResponsiveImage
            src={heroMedia.src}
            alt={heroMedia.alt}
            role="hero"
            sizes="(max-width: 760px) calc(100vw - 32px), 56vw"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            data-v2-image
            data-v2-page-critical
          />
          {heroMedia.caption && <figcaption>{heroMedia.caption}</figcaption>}
        </figure>
      )}
    </div>
  </header>

  <V2SectionNav items={sectionNavItems} label="Разделы объекта" />

  <section class="v2-project-detail__work" id="project-work" aria-labelledby="v2-project-work-title">
    <div class="hv2-shell v2-project-detail__work-grid">
      <div data-v2-reveal>
        <h2 id="v2-project-work-title">Что было выполнено</h2>
      </div>
      <p data-v2-reveal>{project.whatWasDone}</p>
    </div>
  </section>

  {additionalFacts.length > 0 && (
    <section class="v2-project-detail__facts" id="project-facts" aria-labelledby="v2-project-facts-title">
      <div class="hv2-shell">
        <header data-v2-reveal>
          <p class="hv2-eyebrow">Сведения об объекте</p>
          <h2 id="v2-project-facts-title">По опубликованным данным</h2>
        </header>
        <div class="v2-project-detail__facts-grid" data-v2-scroll-section>
          {additionalFacts.map((fact) => (
            <section data-v2-reveal data-v2-scroll-role="card">
              <h3>{fact.title}</h3>
              <p>{fact.text}</p>
            </section>
          ))}
        </div>
      </div>
    </section>
  )}

  {publicGallery.length > 0 && (
    <section class="v2-project-detail__gallery" id="project-gallery" aria-labelledby="v2-project-gallery-title">
      <div class="hv2-shell">
        <header class="v2-project-detail__section-heading" data-v2-reveal>
          <p class="hv2-eyebrow">Фотографии объекта</p>
          <h2 id="v2-project-gallery-title">Объект в кадрах</h2>
        </header>
        <div data-v2-reveal>
          <V2ProjectGallery
            images={publicGallery}
            title={project.title}
            galleryKey={`detail-${project.slug}`}
            variant="detail"
          />
        </div>
      </div>
    </section>
  )}

  {relatedDirections.length > 0 && (
    <section class="v2-project-detail__directions" id="project-directions" aria-labelledby="v2-project-directions-title">
      <div class="hv2-shell">
        <header class="v2-project-detail__section-heading" data-v2-reveal>
          <p class="hv2-eyebrow">Связанные направления</p>
          <h2 id="v2-project-directions-title">Продолжить по задаче</h2>
        </header>
        <div class="v2-project-detail__direction-grid" role="list">
          {relatedDirections.map((direction) => (
            <a href={withBase(direction.href)} role="listitem" data-v2-transition-label={direction.label} data-v2-reveal>
              <span>{direction.context}</span>
              <strong>{direction.label}</strong>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {(previous || next) && (
    <nav class="v2-project-detail__navigation" aria-label="Переходы между выполненными объектами">
      <div class="hv2-shell">
        {previous && (
          <a href={withBase(previous.v2Route)} rel="prev" data-v2-transition-label={previous.project.title}>
            <span>Предыдущий объект</span>
            <strong>{previous.project.title}</strong>
          </a>
        )}
        {next && (
          <a href={withBase(next.v2Route)} rel="next" data-v2-transition-label={next.project.title}>
            <span>Следующий объект</span>
            <strong>{next.project.title}</strong>
          </a>
        )}
      </div>
    </nav>
  )}

  <V2DirectContact
    eyebrow="Прямая связь"
    title="Обсудим похожую задачу"
    description="Кратко опишите объект и имеющиеся исходные материалы — обсудим задачу и подготовим расчёт."
    primaryLabel="Написать в Telegram"
    secondaryLabel="Все выполненные объекты"
    secondaryHref="/design-lab/v2/vypolnennye-obekty/"
  />
</article>
