---
import { v2Href as resolveV2Href } from '../../utils/v2Routes';
const withBase = (value: string) => resolveV2Href(value, Astro.url.pathname);
import V2Breadcrumbs from './V2Breadcrumbs.astro';
import {
  catalogMediaPresentation,
  imageViewStyle,
  type CatalogMediaPresentation
} from './catalogV2Data';

interface Props {
  kicker: string;
  title: string;
  description?: string;
  supportingText?: string;
  image?: string;
  imageAlt?: string;
  imageView?: { fit?: 'cover' | 'contain'; positionX?: number; positionY?: number; scale?: number };
  variant?: 'section' | 'category';
  mediaPresentation?: CatalogMediaPresentation;
  countLabel?: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  productFinalHandoff?: boolean;
  breadcrumbs?: Array<{ title: string; href?: string }>;
}

const {
  kicker,
  title,
  description = '',
  supportingText = '',
  image = '',
  imageAlt = '',
  imageView,
  variant = 'section',
  mediaPresentation = catalogMediaPresentation(image, imageView),
  countLabel = '',
  primaryHref = '#catalog-grid',
  primaryLabel = 'Смотреть каталог',
  secondaryHref = '/design-lab/v2/izgotovlenie-na-zakaz/',
  secondaryLabel = 'Изготовление по задаче'
} = Astro.props as Props;

const href = (value: string) => value.startsWith('#') ? value : withBase(value);
const hasMedia = Boolean(image);
const productFinalHandoff = Astro.props.productFinalHandoff ?? false;
const breadcrumbs = Astro.props.breadcrumbs ?? [];
const hasBreadcrumbs = breadcrumbs.length > 0 || Astro.slots.has('breadcrumbs');
---

<section
  class:list={[
    'v2-catalog-hero',
    `v2-catalog-hero--${variant}`,
    `v2-catalog-hero--${mediaPresentation}`,
    { 'v2-catalog-hero--no-media': !hasMedia }
  ]}
  aria-labelledby="v2-catalog-title"
  data-v2-hero-scroll={!productFinalHandoff ? '' : undefined}
  data-product-final-hero={productFinalHandoff ? '' : undefined}
>
  <div
    class="hv2-shell hv2-grid v2-catalog-hero__grid"
    data-product-final-track={productFinalHandoff ? '' : undefined}
  >
    <div
      class="v2-catalog-hero__copy"
      data-v2-hero-scroll-copy={!productFinalHandoff ? '' : undefined}
    >
      <div class="v2-catalog-hero__meta">
      {hasBreadcrumbs && (
        <div class="v2-catalog-hero__breadcrumbs">
          {breadcrumbs.length > 0
            ? <V2Breadcrumbs items={breadcrumbs} />
            : <slot name="breadcrumbs" />
          }
        </div>
      )}
      <div class="v2-catalog-hero__topline" data-v2-reveal="entry-meta">
        <p class="hv2-eyebrow">{kicker}</p>
        {countLabel && <span>{countLabel}</span>}
      </div>
      </div>
      <h1 id="v2-catalog-title" data-v2-reveal="entry-title">{title}</h1>
      {description && <p class="v2-catalog-hero__lead" data-v2-reveal="entry-copy">{description}</p>}
      {supportingText && <p class="v2-catalog-hero__support" data-v2-reveal="entry-support">{supportingText}</p>}
      <div class="hv2-actions v2-catalog-hero__actions" data-v2-reveal="entry-actions">
        <a class="hv2-button hv2-button--primary" href={href(primaryHref)}>{primaryLabel}</a>
        {secondaryLabel && <a class="hv2-text-link" href={href(secondaryHref)}>{secondaryLabel}</a>}
      </div>
    </div>

    {hasMedia && (
      <figure
        class="v2-catalog-hero__media"
        data-v2-media
        data-v2-hero-scroll-media={!productFinalHandoff ? '' : undefined}
        data-v2-reveal="entry-media"
      >
        <img
          src={withBase(image)}
          alt={imageAlt || title}
          width="1200"
          height="900"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          style={imageViewStyle(imageView)}
          data-v2-image
        />
      </figure>
    )}
  </div>
</section>
