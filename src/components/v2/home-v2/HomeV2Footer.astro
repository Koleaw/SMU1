---
import settings from '../../../content/site-settings/global.json';
import { getV2Scope, v2CurrentState, v2Href } from '../../../utils/v2Routes';
import { getV2Navigation } from '../../../utils/v2Navigation';
import { getV2TelegramLabel } from '../../../utils/v2SiteSettings';
import { v2TransitionLabelForRoute } from '../../../utils/v2TransitionLabel';
import navigationItems from '../../../data/navigation.json';
import { adminBinding, adminDisposition } from '../../../admin/bindings/adminBinding';

interface Props {
  currentPath?: string;
  catalogV2?: boolean;
  mobileCtaLabel?: string;
  mobileCtaBinding?: Record<string, string>;
  contactHref?: string;
}

const {
  currentPath = Astro.url.pathname,
  catalogV2 = false,
  mobileCtaLabel = settings.shellLabels.defaultCtaLabel,
  contactHref = '#contact'
} = Astro.props as Props;
const path = (value: string) => v2Href(value, Astro.url.pathname);
const resolveHref = (value: string) => /^(?:#|https?:|mailto:|tel:)/i.test(value) ? value : path(value);
const directionV2Roots = [
  '/ulichnaya-mebel/',
  '/ograzhdeniya-i-zabory/',
  '/navesy-i-kozyrki/',
  '/topiarii/',
  '/metallokonstruktsii-dlya-biznesa/',
  '/stroitelstvo-i-remonty/',
  '/blagoustroystvo-territoriy/',
  '/vypolnennye-obekty/'
];
const aboutV2Root = '/o-nas/';
const contactsV2Root = '/kontakty/';
const vacanciesV2Root = '/vakansii/';
const legalV2Root = '/politika-konfidencialnosti/';
const customOrderV2Root = '/izgotovlenie-na-zakaz/';
const { directions, workAndCompanyLinks, additions } = await getV2Navigation();
const telegramLabel = getV2TelegramLabel(settings);
const shellLabels = settings.shellLabels;
const transitionLabel = (href: string, fallback: string) => v2TransitionLabelForRoute(href, fallback);
const contactTransitionLabel = contactHref.startsWith('#')
  ? undefined
  : transitionLabel(contactHref, 'Контакты');
const v2Roots = [...directionV2Roots, aboutV2Root, contactsV2Root, vacanciesV2Root, legalV2Root, customOrderV2Root];
const currentState = (href: string) => v2CurrentState(currentPath, href, v2Roots);
const isDesignLab = getV2Scope(Astro.url.pathname) === 'design-lab';
const globalBinding = (fieldPath: string, tool = 'short-text', options: Record<string, unknown> = {}) => adminBinding(Astro.url, {
  renderer: { family: 'global-shell', variant: 'footer' }, owner: { collection: 'site-settings', slug: 'global' },
  fieldPath, scope: 'global', tool, affectedRoutes: ['*'], ...options
});
const mobileCtaBinding = Astro.props.mobileCtaBinding
  ?? (Astro.props.mobileCtaLabel === undefined
    ? globalBinding('shellLabels.defaultCtaLabel', 'button-label', { stableItemId: 'home-footer-mobile-cta', role: 'shell-cta-label' })
    : {});
const declared = (
  kind: 'derived' | 'global' | 'legal' | 'template-fixed',
  fragment: string,
  reason: string,
  tool = 'global-settings'
) => adminDisposition(Astro.url, {
  kind,
  reason,
  source: `src/components/v2/home-v2/HomeV2Footer.astro#${fragment}`,
  tool
});
const navigationIndex = new Map((navigationItems as Array<{ href?: string }>).map((item, index) => [item.href, index]));
const navigationAttributes = (item: { href: string }, occurrence: string) => {
  const index = navigationIndex.get(item.href);
  return index !== undefined
    ? adminBinding(Astro.url, {
        renderer: { family: 'global-shell', variant: 'footer-navigation' },
        owner: { collection: 'navigation', slug: 'navigation' },
        fieldPath: `items[${index}].title`,
        hrefPath: `items[${index}].href`,
        stableItemId: `${occurrence}-${item.href}`,
        scope: 'global',
        tool: 'link',
        affectedRoutes: ['*']
      })
    : declared(
        'derived',
        `getV2Navigation.${item.href}`,
        'Пункт получен из общей route/navigation композиции; если записи нет в navigation.json, подпись меняется в глобальной структуре навигации.'
      );
};
const globalHref = (fieldPath: string) => adminDisposition(Astro.url, {
  kind: 'global',
  reason: 'Адрес канала вычисляется из глобального контактного значения; редактируйте его в настройках компании.',
  source: `src/content/site-settings/global.json#${fieldPath}`,
  tool: 'global-settings'
});
---

<footer class="hv2-footer">
  <div class="hv2-shell hv2-footer__grid">
    <section class="hv2-footer__brand" aria-label="Реквизиты СМУ-1">
      <a href={path('/')} aria-label="СМУ-1 — на главную" data-v2-transition-label="Главная">
        <img src={path(settings.brandLogo)} alt="СМУ-1" width="355" height="211" {...globalBinding('brandLogo', 'media', { role: 'brand-logo-footer' })} />
      </a>
      <p {...globalBinding('companyName')}>{settings.companyName}</p>
      <p><span {...declared('template-fixed', 'legal-prefix-inn', 'Юридическая аббревиатура фиксирует тип реквизита; само значение редактируется отдельно.')}>ИНН </span><span {...globalBinding('inn')}>{settings.inn}</span><span {...declared('template-fixed', 'legal-separator-kpp', 'Разделитель и юридическая аббревиатура фиксируют структуру реквизитов; само значение редактируется отдельно.')}> · КПП </span><span {...globalBinding('kpp')}>{settings.kpp}</span></p>
      <p><span {...declared('template-fixed', 'legal-prefix-ogrn', 'Юридическая аббревиатура фиксирует тип реквизита; само значение редактируется отдельно.')}>ОГРН </span><span {...globalBinding('ogrn')}>{settings.ogrn}</span></p>
      <p><span {...declared('template-fixed', 'registration-date-label', 'Системная подпись поясняет юридическую дату; само значение редактируется отдельно.')}>Дата регистрации: </span><span {...globalBinding('registrationDate')}>{settings.registrationDate}</span></p>
    </section>

    <section class="hv2-footer__nav-group hv2-footer__nav-group--directions" aria-label="Навигация по направлениям">
      <nav class="hv2-footer__directions hv2-footer__desktop-nav" aria-label="Направления СМУ-1">
        <p {...globalBinding('shellLabels.directionsGroup', 'short-text', { stableItemId: 'footer-desktop-directions-group' })}>{shellLabels.directionsGroup}</p>
        {directions.map((item) => <a href={path(item.href)} aria-current={currentState(item.href)} data-v2-transition-label={transitionLabel(item.href, item.label)} {...navigationAttributes(item, 'desktop-direction')}>{item.label}</a>)}
      </nav>
      <details class="hv2-footer__accordion">
        <summary><span {...globalBinding('shellLabels.directionsGroup', 'short-text', { stableItemId: 'footer-mobile-directions-group' })}>{shellLabels.directionsGroup}</span> <span aria-hidden="true"></span></summary>
        <nav class="hv2-footer__directions hv2-footer__accordion-content" aria-label="Направления СМУ-1">
          {directions.map((item) => <a href={path(item.href)} aria-current={currentState(item.href)} data-v2-transition-label={transitionLabel(item.href, item.label)} {...navigationAttributes(item, 'mobile-direction')}>{item.label}</a>)}
        </nav>
      </details>
    </section>

    <section class="hv2-footer__nav-group hv2-footer__nav-group--company" aria-label="Навигация по компании">
      <nav class="hv2-footer__company hv2-footer__desktop-nav" aria-label="Работа и компания">
        <p {...globalBinding('shellLabels.workAndCompanyGroup', 'short-text', { stableItemId: 'footer-desktop-company-group' })}>{shellLabels.workAndCompanyGroup}</p>
        {workAndCompanyLinks.map((item) => <a href={path(item.href)} aria-current={currentState(item.href)} data-v2-transition-label={transitionLabel(item.href, item.label)} {...navigationAttributes(item, 'desktop-company')}>{item.label}</a>)}
      </nav>
      <details class="hv2-footer__accordion">
        <summary><span {...globalBinding('shellLabels.workAndCompanyGroup', 'short-text', { stableItemId: 'footer-mobile-company-group' })}>{shellLabels.workAndCompanyGroup}</span> <span aria-hidden="true"></span></summary>
        <nav class="hv2-footer__company hv2-footer__accordion-content" aria-label="Работа и компания">
          {workAndCompanyLinks.map((item) => <a href={path(item.href)} aria-current={currentState(item.href)} data-v2-transition-label={transitionLabel(item.href, item.label)} {...navigationAttributes(item, 'mobile-company')}>{item.label}</a>)}
        </nav>
      </details>
    </section>

    <section class="hv2-footer__contacts" aria-labelledby="hv2-footer-contacts-title">
      <p id="hv2-footer-contacts-title" {...globalBinding('shellLabels.directContactGroup')}>{shellLabels.directContactGroup}</p>
      {catalogV2 && (
        <a
          class="hv2-footer__mobile-cta hv2-button hv2-button--contrast"
          href={resolveHref(contactHref)}
          data-v2-transition-label={contactTransitionLabel}
          {...(Object.keys(mobileCtaBinding).length > 0
            ? mobileCtaBinding
            : declared('derived', 'Astro.props.mobileCtaLabel', 'Подпись мобильного CTA задаётся layout-владельцем и зависит от типа текущей страницы.', 'page-settings'))}
        >{mobileCtaLabel}</a>
      )}
      <a href={`tel:${settings.phonePrimary.replace(/[^+\d]/g, '')}`} {...globalBinding('phonePrimary', 'link', { hrefPath: 'phonePrimary' })}>{settings.phonePrimary}</a>
      <a href={`tel:${settings.phoneSecondary.replace(/[^+\d]/g, '')}`} {...globalBinding('phoneSecondary', 'link', { hrefPath: 'phoneSecondary' })}>{settings.phoneSecondary}</a>
      <a href={settings.telegram} target="_blank" rel="noopener noreferrer" {...globalHref('telegram')}><span {...globalBinding('telegramLabel')}>{telegramLabel}</span>{' · '}<span {...globalBinding('shellLabels.telegramSuffix')}>{shellLabels.telegramSuffix}</span></a>
      <a href={`mailto:${settings.email}`} {...globalBinding('email', 'link', { hrefPath: 'email' })}>{settings.email}</a>
      <address {...globalBinding('address', 'long-text')}>{settings.address}</address>
    </section>
  </div>

  <div class="hv2-shell hv2-footer__legal" role="group" aria-label="Юридическая информация">
    <small {...globalBinding('copyrightLabel', 'short-text')}>{settings.copyrightLabel}</small>
    <small {...globalBinding('footerDisclaimer', 'long-text')}>{settings.footerDisclaimer}</small>
    <a href={path(additions.privacy.href)} aria-current={currentState(additions.privacy.href)} data-v2-transition-label={additions.privacy.label} {...declared('legal', 'privacy-link', 'Название юридического документа синхронизировано с каноническим legal route и редактируется в legal editor.', 'legal-editor')}>{additions.privacy.label}</a>
    {isDesignLab
      ? <button type="button" data-hv2-cookie-open {...globalBinding('cookieNotice.settingsLabel', 'short-text')}>{settings.cookieNotice.settingsLabel}</button>
      : <button type="button" data-open-cookie-settings {...globalBinding('cookieNotice.settingsLabel', 'short-text')}>{settings.cookieNotice.settingsLabel}</button>}
  </div>
</footer>

{isDesignLab && (
  <dialog class="hv2-cookie-dialog" aria-labelledby="hv2-cookie-title" data-hv2-cookie-dialog>
    <div class="hv2-cookie-dialog__inner">
      <p class="hv2-eyebrow" {...declared('template-fixed', 'cookie-dialog-eyebrow', 'Системная метка обозначает диалог настроек конфиденциальности.')}>Конфиденциальность</p>
      <h2 id="hv2-cookie-title" {...globalBinding('cookieNotice.dialogTitle', 'heading')}>{settings.cookieNotice.dialogTitle}</h2>
      <p {...globalBinding('cookieNotice.dialogDescription', 'long-text')}>{settings.cookieNotice.dialogDescription}</p>
      <button class="hv2-button hv2-button--primary" type="button" data-hv2-cookie-close {...globalBinding('cookieNotice.closeLabel', 'short-text')}>{settings.cookieNotice.closeLabel}</button>
    </div>
  </dialog>
)}

<script>
  const initHomeV2CookieDialog = () => {
    const dialog = document.querySelector<HTMLDialogElement>('[data-hv2-cookie-dialog]');
    const openButton = document.querySelector<HTMLButtonElement>('[data-hv2-cookie-open]');
    const closeButton = document.querySelector<HTMLButtonElement>('[data-hv2-cookie-close]');
    if (!dialog || !openButton || !closeButton || dialog.dataset.ready === 'true') return;
    dialog.dataset.ready = 'true';

    openButton.addEventListener('click', () => {
      dialog.showModal();
      closeButton.focus();
    });
    closeButton.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => openButton.focus());
  };

  initHomeV2CookieDialog();
  document.addEventListener('astro:page-load', initHomeV2CookieDialog);
</script>
