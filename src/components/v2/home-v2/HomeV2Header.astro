---
import settings from '../../../content/site-settings/global.json';
import navigationItems from '../../../data/navigation.json';
import { v2CurrentState, v2Href } from '../../../utils/v2Routes';
import { getV2Navigation } from '../../../utils/v2Navigation';
import { getV2TelegramLabel } from '../../../utils/v2SiteSettings';
import { v2TransitionLabelForRoute } from '../../../utils/v2TransitionLabel';
import { adminBinding, adminDisposition } from '../../../admin/bindings/adminBinding';

interface Props {
  mode?: 'overlay' | 'light';
  currentPath?: string;
  catalogV2?: boolean;
  contactHref?: string;
  ctaLabel?: string;
  desktopCtaBinding?: Record<string, string>;
  mobileCtaBinding?: Record<string, string>;
}

const {
  mode = 'overlay',
  currentPath = Astro.url.pathname,
  catalogV2 = true,
  contactHref = '#contact',
  ctaLabel = settings.shellLabels.defaultCtaLabel
} = Astro.props as Props;
const directOrDeclared = (attributes: Record<string, string>, fragment: string) => Object.keys(attributes).length > 0
  ? attributes
  : adminDisposition(Astro.url, {
      kind: 'contextual',
      reason: 'Подпись CTA задаётся владельцем layout и зависит от типа текущей страницы.',
      source: `src/components/v2/home-v2/HomeV2Header.astro#${fragment}`,
      tool: 'page-settings'
    });
const path = (value: string) => v2Href(value, Astro.url.pathname);
const resolveHref = (value: string) => value.startsWith('#') ? value : path(value);
const productV2Roots = [
  '/ulichnaya-mebel/',
  '/ograzhdeniya-i-zabory/',
  '/navesy-i-kozyrki/',
  '/topiarii/'
];
const metalworksV2Root = '/metallokonstruktsii-dlya-biznesa/';
const constructionV2Root = '/stroitelstvo-i-remonty/';
const landscapingV2Root = '/blagoustroystvo-territoriy/';
const objectsV2Root = '/vypolnennye-obekty/';
const aboutV2Root = '/o-nas/';
const contactsV2Root = '/kontakty/';
const vacanciesV2Root = '/vakansii/';
const legalV2Root = '/politika-konfidencialnosti/';
const customOrderV2Root = '/izgotovlenie-na-zakaz/';
const { productLinks, primaryLinks, companyLinks, workAndCompanyLinks } = await getV2Navigation();
const splitLeftPrimaryLinks = primaryLinks.filter(
  (item) => item.href === metalworksV2Root || item.href === landscapingV2Root
);
const splitRightPrimaryLinks = primaryLinks.filter(
  (item) => item.href !== metalworksV2Root && item.href !== landscapingV2Root
);
const telegramLabel = getV2TelegramLabel(settings);
const shellLabels = settings.shellLabels;
const transitionLabel = (href: string, fallback: string) => v2TransitionLabelForRoute(href, fallback);
const contactTransitionLabel = contactHref.startsWith('#')
  ? undefined
  : transitionLabel(contactHref, 'Контакты');
const companyV2Roots = [aboutV2Root, contactsV2Root, vacanciesV2Root, legalV2Root];
const v2Roots = [
  ...productV2Roots,
  metalworksV2Root,
  constructionV2Root,
  landscapingV2Root,
  objectsV2Root,
  customOrderV2Root,
  ...companyV2Roots
];
const currentState = (href: string) => v2CurrentState(currentPath, href, v2Roots);
const isCatalogV2Location = productV2Roots.some((href) => v2CurrentState(currentPath, href, productV2Roots))
  || Boolean(v2CurrentState(currentPath, customOrderV2Root, [customOrderV2Root]));
const isCompanyV2Location = companyV2Roots.some((href) => v2CurrentState(currentPath, href, companyV2Roots));
const productsMenuId = 'home-v2-products-menu';
const companyMenuId = 'home-v2-company-menu';
const mobileMenuId = 'home-v2-mobile-menu';
const globalBinding = (fieldPath: string, tool = 'short-text', options: Record<string, unknown> = {}) => adminBinding(Astro.url, {
  renderer: { family: 'global-shell', variant: 'header' }, owner: { collection: 'site-settings', slug: 'global' },
  fieldPath, scope: 'global', tool, affectedRoutes: ['*'], ...options
});
const desktopCtaBinding = Astro.props.desktopCtaBinding
  ?? (Astro.props.ctaLabel === undefined
    ? globalBinding('shellLabels.defaultCtaLabel', 'button-label', { stableItemId: 'home-header-desktop-cta', role: 'shell-cta-label' })
    : {});
const mobileCtaBinding = Astro.props.mobileCtaBinding
  ?? (Astro.props.ctaLabel === undefined
    ? globalBinding('shellLabels.defaultCtaLabel', 'button-label', { stableItemId: 'home-header-mobile-cta', role: 'shell-cta-label' })
    : {});
const navigationIndex = new Map((navigationItems as Array<{ href?: string }>).map((item, index) => [item.href, index]));
const navigationBinding = (item: { href: string }, occurrence: string) => {
  const index = navigationIndex.get(item.href);
  return index === undefined ? {} : adminBinding(Astro.url, {
    renderer: { family: 'global-shell', variant: 'navigation' }, owner: { collection: 'navigation', slug: 'navigation' },
    fieldPath: `items[${index}].title`, hrefPath: `items[${index}].href`, stableItemId: `${occurrence}-${item.href}`,
    scope: 'global', tool: 'link', affectedRoutes: ['*']
  });
};
const declared = (
  kind: 'contextual' | 'derived' | 'global' | 'template-fixed',
  fragment: string,
  reason: string,
  tool = 'global-settings'
) => adminDisposition(Astro.url, {
  kind,
  reason,
  source: `src/components/v2/home-v2/HomeV2Header.astro#${fragment}`,
  tool
});
const navigationAttributes = (item: { href: string }, occurrence: string) => {
  const binding = navigationBinding(item, occurrence);
  return Object.keys(binding).length > 0
    ? binding
    : declared(
        'derived',
        `getV2Navigation.${item.href}`,
        'Пункт получен из общей route/navigation композиции; если записи нет в navigation.json, подпись меняется в глобальной структуре навигации.'
      );
};
const globalHref = (fieldPath: string) => adminDisposition(Astro.url, {
  kind: 'global',
  reason: 'Адрес канала вычисляется из глобального контактного значения; редактируйте его в настройках компании.',
  source: `src/content/site-settings/global.json#${fieldPath}`,
  tool: 'global-settings'
});

---

<header
  class:list={['hv2-header', { 'is-scrolled': mode === 'light' }]}
  data-home-v2-header
  data-hv2-header-mode={mode}
  data-v2-entry="header"
>
  <div class="hv2-shell hv2-header__inner">
    <a
      class="hv2-header__brand"
      href={path('/')}
      aria-label="СМУ-1 — на главную"
      data-v2-transition-label="Главная"
      aria-current={currentState('/')}
      data-hv2-header-side="left"
      data-v2-entrance-role="header-logo"
    >
      <img src={path(settings.brandLogo)} alt="СМУ-1" width="355" height="211" {...globalBinding('brandLogo', 'media', { role: 'brand-logo' })} />
    </a>

    <nav class="hv2-header__nav" aria-label="Основная навигация" data-v2-entrance-role="header-nav">
      <div
        class="hv2-header__nav-group hv2-header__nav-group--left"
        data-hv2-header-side="left"
      >
      <div class="hv2-dropdown" data-hv2-dropdown>
        <button
          class="hv2-header__nav-button"
          type="button"
          aria-expanded="false"
          aria-controls={productsMenuId}
          aria-current={catalogV2 && isCatalogV2Location ? 'location' : undefined}
          data-hv2-dropdown-trigger
          {...globalBinding('shellLabels.productsGroup', 'short-text', { stableItemId: 'header-desktop-products-group' })}
        >
          <span>{shellLabels.productsGroup}</span>
          <span class="hv2-header__dropdown-indicator" aria-hidden="true">
            <span class="hv2-header__dropdown-indicator-open">+</span>
            <span class="hv2-header__dropdown-indicator-close">−</span>
          </span>
        </button>
        <div class="hv2-dropdown__panel" id={productsMenuId} data-hv2-dropdown-panel>
          <p class="hv2-dropdown__eyebrow" {...globalBinding('shellLabels.productsMenuEyebrow')}>{shellLabels.productsMenuEyebrow}</p>
          <div class="hv2-dropdown__links">
            {productLinks.map((item) => (
              <a href={path(item.href)} aria-current={currentState(item.href)} data-v2-transition-label={transitionLabel(item.href, item.label)} data-hv2-dropdown-link {...navigationAttributes(item, 'desktop-product')}>
                <span>{item.label}</span>
              </a>
            ))}
          </div>
        </div>
      </div>

      {splitLeftPrimaryLinks.map((item) => <a class="hv2-header__nav-link" href={path(item.href)} aria-current={currentState(item.href)} data-v2-transition-label={transitionLabel(item.href, item.label)} {...navigationAttributes(item, 'desktop-primary-left')}>{item.label}</a>)}
      </div>

      <div
        class="hv2-header__nav-group hv2-header__nav-group--right"
        data-hv2-header-side="right"
      >
      {splitRightPrimaryLinks.map((item) => <a class="hv2-header__nav-link" href={path(item.href)} aria-current={currentState(item.href)} data-v2-transition-label={transitionLabel(item.href, item.label)} {...navigationAttributes(item, 'desktop-primary-right')}>{item.label}</a>)}

      <div class="hv2-dropdown" data-hv2-dropdown>
        <button
          class="hv2-header__nav-button"
          type="button"
          aria-expanded="false"
          aria-controls={companyMenuId}
          aria-current={isCompanyV2Location ? 'location' : undefined}
          data-hv2-dropdown-trigger
          {...globalBinding('shellLabels.companyMenu')}
        >
          <span>{shellLabels.companyMenu}</span>
          <span class="hv2-header__dropdown-indicator" aria-hidden="true">
            <span class="hv2-header__dropdown-indicator-open">+</span>
            <span class="hv2-header__dropdown-indicator-close">−</span>
          </span>
        </button>
        <div class="hv2-dropdown__panel hv2-dropdown__panel--right" id={companyMenuId} data-hv2-dropdown-panel>
          <p class="hv2-dropdown__eyebrow" {...globalBinding('companyShortName')}>{settings.companyShortName}</p>
          <div class="hv2-dropdown__links">
            {companyLinks.map((item) => (
              <a href={path(item.href)} aria-current={currentState(item.href)} data-v2-transition-label={transitionLabel(item.href, item.label)} data-hv2-dropdown-link {...navigationAttributes(item, 'desktop-company')}>
                <span>{item.label}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
      </div>
    </nav>

    <div class="hv2-header__actions" aria-label="Быстрые действия" data-hv2-header-side="right" data-v2-entrance-role="header-actions">
      <a class="hv2-header__phone" href={`tel:${settings.phonePrimary.replace(/[^+\d]/g, '')}`} {...globalBinding('phonePrimary', 'link', { hrefPath: 'phonePrimary' })}>
        {settings.phonePrimary}
      </a>
      <a
        class="hv2-header__telegram"
        href={settings.telegram}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Telegram"
        {...globalHref('telegram')}
      >
        <span class="hv2-header__telegram-label" {...declared('template-fixed', 'telegram-channel-label', 'Системная подпись обозначает тип канала; username и URL редактируются глобально.')}>Telegram</span>
      </a>
      <a
        class="hv2-button hv2-button--header"
        href={resolveHref(contactHref)}
        data-v2-transition-label={contactTransitionLabel}
        {...directOrDeclared(desktopCtaBinding, 'Astro.props.ctaLabel')}
      >{ctaLabel}</a>
    </div>

    <button
      class="hv2-header__menu-button"
      type="button"
      aria-expanded="false"
      aria-controls={mobileMenuId}
      aria-label="Открыть меню"
      data-hv2-mobile-open
      data-v2-entrance-role="header-actions"
      {...declared('template-fixed', 'mobile-menu-open-label', 'Системная кнопка открывает мобильную навигацию.')}
    >
      <span>Меню</span>
      <span class="hv2-header__menu-lines" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>
</header>

<div
  class="hv2-mobile-menu"
  id={mobileMenuId}
  role="dialog"
  aria-modal="true"
  aria-labelledby="home-v2-mobile-menu-title"
  aria-hidden="true"
  hidden
  data-hv2-mobile-menu
>
  <div class="hv2-mobile-menu__top">
    <a class="hv2-mobile-menu__brand" href={path('/')} aria-current={currentState('/')} data-v2-transition-label="Главная" data-hv2-mobile-link>
      <img src={path(settings.brandLogo)} alt="СМУ-1" width="355" height="211" {...globalBinding('brandLogo', 'media', { role: 'brand-logo-mobile' })} />
    </a>
    <p id="home-v2-mobile-menu-title" {...declared('template-fixed', 'mobile-menu-title', 'Системный заголовок идентифицирует диалог навигации.')}>Навигация</p>
    <button class="hv2-mobile-menu__close" type="button" aria-label="Закрыть меню" data-hv2-mobile-close>
      <span aria-hidden="true"></span>
    </button>
  </div>

  <div class="hv2-mobile-menu__scroll">
    <a
      class="hv2-button hv2-button--primary hv2-mobile-menu__cta"
      href={resolveHref(contactHref)}
      data-v2-transition-label={contactTransitionLabel}
      data-hv2-mobile-link
      {...directOrDeclared(mobileCtaBinding, 'Astro.props.ctaLabel.mobile')}
    >
      {ctaLabel}
    </a>

    <nav class="hv2-mobile-menu__nav" aria-label="Мобильная навигация">
      <div class="hv2-mobile-menu__group">
        <p {...globalBinding('shellLabels.productsGroup', 'short-text', { stableItemId: 'header-mobile-products-group' })}>{shellLabels.productsGroup}</p>
        {productLinks.filter((item) => item.href !== customOrderV2Root).map((item) => <a href={path(item.href)} aria-current={currentState(item.href)} data-v2-transition-label={transitionLabel(item.href, item.label)} data-hv2-mobile-link {...navigationAttributes(item, 'mobile-product')}>{item.label}</a>)}
      </div>

      <div class="hv2-mobile-menu__group hv2-mobile-menu__group--primary">
        {primaryLinks.filter((item) => item.href !== objectsV2Root).map((item) => <a href={path(item.href)} aria-current={currentState(item.href)} data-v2-transition-label={transitionLabel(item.href, item.label)} data-hv2-mobile-link {...navigationAttributes(item, 'mobile-primary')}>{item.label}</a>)}
      </div>

      <div class="hv2-mobile-menu__group">
        <p {...globalBinding('shellLabels.workAndCompanyGroup')}>{shellLabels.workAndCompanyGroup}</p>
        {workAndCompanyLinks.map((item) => <a href={path(item.href)} aria-current={currentState(item.href)} data-v2-transition-label={transitionLabel(item.href, item.label)} data-hv2-mobile-link {...navigationAttributes(item, 'mobile-company')}>{item.label}</a>)}
      </div>
    </nav>

    <section class="hv2-mobile-menu__contacts" aria-labelledby="home-v2-mobile-contacts-title">
      <p id="home-v2-mobile-contacts-title" {...globalBinding('shellLabels.directContactGroup')}>{shellLabels.directContactGroup}</p>
      <a href={`tel:${settings.phonePrimary.replace(/[^+\d]/g, '')}`} {...globalBinding('phonePrimary', 'link', { hrefPath: 'phonePrimary', role: 'mobile-header-phone' })}>{settings.phonePrimary}</a>
      <a href={`tel:${settings.phoneSecondary.replace(/[^+\d]/g, '')}`} {...globalHref('phoneSecondary')}>
        <span {...globalBinding('phoneSecondary', 'short-text')}>{settings.phoneSecondary}</span> · <span {...globalBinding('shellLabels.secondaryPhoneSuffix')}>{shellLabels.secondaryPhoneSuffix}</span>
      </a>
      <a href={settings.telegram} target="_blank" rel="noopener noreferrer" {...globalHref('telegram')}><span {...globalBinding('telegramLabel', 'short-text', { role: 'mobile-header-telegram' })}>{telegramLabel}</span> · <span {...globalBinding('shellLabels.telegramSuffix')}>{shellLabels.telegramSuffix}</span></a>
      <a href={`mailto:${settings.email}`} {...globalBinding('email', 'link', { hrefPath: 'email' })}>{settings.email}</a>
      <address {...globalBinding('address', 'long-text')}>{settings.address}</address>
    </section>
  </div>
</div>

<style>
  .hv2-header__nav-group {
    display: contents;
  }
</style>

<script>
  const initHomeV2Header = () => {
    const header = document.querySelector<HTMLElement>('[data-home-v2-header]');
    const menu = document.querySelector<HTMLElement>('[data-hv2-mobile-menu]');
    const menuOpen = document.querySelector<HTMLButtonElement>('[data-hv2-mobile-open]');
    const menuClose = document.querySelector<HTMLButtonElement>('[data-hv2-mobile-close]');

    if (!header || !menu || !menuOpen || !menuClose || header.dataset.ready === 'true') return;
    header.dataset.ready = 'true';

    const compactMenuBreakpoint = header.closest(
      '[data-catalog-v2-root][data-product-final-prototype]'
    ) ? 1320 : 1180;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const dropdowns = Array.from(header.querySelectorAll<HTMLElement>('[data-hv2-dropdown]'));
    let closeTimer = 0;
    const revealHeader = () => header.classList.remove('is-hidden');
    header.addEventListener('focusin', revealHeader);

    const closeDropdown = (group: HTMLElement, restoreFocus = false) => {
      const trigger = group.querySelector<HTMLButtonElement>('[data-hv2-dropdown-trigger]');
      group.classList.remove('is-open');
      trigger?.setAttribute('aria-expanded', 'false');
      if (restoreFocus) trigger?.focus();
    };

    const closeAllDropdowns = (except?: HTMLElement) => {
      dropdowns.forEach((group) => {
        if (group !== except) closeDropdown(group);
      });
    };

    const openDropdown = (group: HTMLElement, focusFirst = false) => {
      window.clearTimeout(closeTimer);
      revealHeader();
      closeAllDropdowns(group);
      const trigger = group.querySelector<HTMLButtonElement>('[data-hv2-dropdown-trigger]');
      group.classList.add('is-open');
      trigger?.setAttribute('aria-expanded', 'true');
      if (focusFirst) group.querySelector<HTMLAnchorElement>('[data-hv2-dropdown-link]')?.focus();
    };

    dropdowns.forEach((group) => {
      const trigger = group.querySelector<HTMLButtonElement>('[data-hv2-dropdown-trigger]');
      const panel = group.querySelector<HTMLElement>('[data-hv2-dropdown-panel]');
      const links = Array.from(group.querySelectorAll<HTMLAnchorElement>('[data-hv2-dropdown-link]'));
      if (!trigger || !panel) return;

      group.addEventListener('pointerenter', (event) => {
        if (event.pointerType === 'mouse') openDropdown(group);
      });
      group.addEventListener('pointerleave', (event) => {
        if (event.pointerType !== 'mouse') return;
        closeTimer = window.setTimeout(() => closeDropdown(group), 180);
      });
      group.addEventListener('focusin', () => openDropdown(group));
      group.addEventListener('focusout', (event) => {
        const next = event.relatedTarget;
        if (!(next instanceof Node) || !group.contains(next)) {
          closeTimer = window.setTimeout(() => closeDropdown(group), 0);
        }
      });

      trigger.addEventListener('click', () => {
        if (group.classList.contains('is-open')) closeDropdown(group);
        else openDropdown(group);
      });

      trigger.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowDown') {
          event.preventDefault();
          openDropdown(group, true);
        } else if (event.key === 'Escape') {
          event.preventDefault();
          closeDropdown(group, true);
        }
      });

      panel.addEventListener('keydown', (event) => {
        const currentIndex = links.indexOf(document.activeElement as HTMLAnchorElement);
        if (event.key === 'Escape') {
          event.preventDefault();
          closeDropdown(group, true);
        } else if (event.key === 'ArrowDown' && links.length) {
          event.preventDefault();
          links[(currentIndex + 1 + links.length) % links.length]?.focus();
        } else if (event.key === 'ArrowUp' && links.length) {
          event.preventDefault();
          links[(currentIndex - 1 + links.length) % links.length]?.focus();
        }
      });
    });

    document.addEventListener('pointerdown', (event) => {
      if (!(event.target instanceof Node) || !header.contains(event.target)) closeAllDropdowns();
    });

    const heroBoundary = document.querySelector<HTMLElement>(
      '[data-hv2-hero], [data-immersive-direction-hero], [data-v2-hero-scroll]'
    );
    let lastScrollY = Math.max(0, window.scrollY);
    let scrollIntent = 0;
    let scrollDirection = 0;
    let headerFrame = 0;

    const syncHeaderState = () => {
      headerFrame = 0;
      const currentScrollY = Math.max(0, window.scrollY);
      const solid = header.dataset.hv2HeaderMode === 'light'
        || !heroBoundary
        || heroBoundary.getBoundingClientRect().bottom <= header.offsetHeight;
      header.classList.toggle('is-scrolled', solid);

      const delta = currentScrollY - lastScrollY;
      const nextDirection = Math.sign(delta);
      if (nextDirection && nextDirection !== scrollDirection) {
        scrollDirection = nextDirection;
        scrollIntent = 0;
      }
      scrollIntent += delta;

      const interactionIsOpen = header.matches(':focus-within')
        || !menu.hidden
        || dropdowns.some((group) => group.classList.contains('is-open'));
      const canHide = solid && currentScrollY > header.offsetHeight * 2 && !interactionIsOpen;

      if (!canHide) {
        revealHeader();
        header.dataset.scrollDirection = 'idle';
        scrollIntent = 0;
      } else if (scrollIntent >= 14) {
        header.classList.add('is-hidden');
        header.dataset.scrollDirection = 'down';
        scrollIntent = 0;
      } else if (scrollIntent <= -8) {
        revealHeader();
        header.dataset.scrollDirection = 'up';
        scrollIntent = 0;
      }

      lastScrollY = currentScrollY;
    };

    const queueHeaderSync = () => {
      if (headerFrame) return;
      headerFrame = window.requestAnimationFrame(syncHeaderState);
    };

    window.addEventListener('scroll', queueHeaderSync, { passive: true });
    window.addEventListener('resize', () => {
      revealHeader();
      queueHeaderSync();
    });
    if (heroBoundary && 'ResizeObserver' in window) {
      new ResizeObserver(queueHeaderSync).observe(heroBoundary);
    }
    syncHeaderState();
    const legacyPreviewManaged = Boolean(
      header.closest('[data-v2-motion-root][data-v2-entry-mode="preview"]')
      && document.documentElement.classList.contains('v2-entry-js')
    );
    // Production H4 stages the inner semantic groups independently. The
    // Design Lab preview retains its accepted first-entry Header handoff.
    if (!legacyPreviewManaged) header.classList.add('is-ready');

    let lastFocus: HTMLElement | null = null;
    let lockedScrollY = 0;
    let pageLocked = false;
    let hideTimer = 0;

    const focusableItems = () => Array.from(menu.querySelectorAll<HTMLElement>(
      'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
    )).filter((element) => !element.hasAttribute('hidden'));

    const lockPage = () => {
      if (pageLocked) return;
      lockedScrollY = window.scrollY;
      pageLocked = true;
      document.body.style.position = 'fixed';
      document.body.style.top = `-${lockedScrollY}px`;
      document.body.style.width = '100%';
      document.body.style.overflow = 'hidden';
      document.documentElement.classList.add('hv2-menu-open');
      document.querySelector('main')?.setAttribute('inert', '');
      header.setAttribute('inert', '');
    };

    const unlockPage = (restoreScroll = true) => {
      const scrollYToRestore = pageLocked ? lockedScrollY : null;
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.width = '';
      document.body.style.overflow = '';
      document.documentElement.classList.remove('hv2-menu-open');
      document.querySelector('main')?.removeAttribute('inert');
      header.removeAttribute('inert');
      pageLocked = false;
      if (restoreScroll && scrollYToRestore !== null) {
        const html = document.documentElement;
        const previousScrollBehavior = html.style.scrollBehavior;
        html.style.scrollBehavior = 'auto';
        window.scrollTo(0, scrollYToRestore);
        html.style.scrollBehavior = previousScrollBehavior;
      }
    };

    const openMobileMenu = () => {
      window.clearTimeout(hideTimer);
      revealHeader();
      const activeElement = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      lastFocus = activeElement && activeElement !== document.body ? activeElement : menuOpen;
      menu.hidden = false;
      menu.setAttribute('aria-hidden', 'false');
      menuOpen.setAttribute('aria-expanded', 'true');
      lockPage();
      requestAnimationFrame(() => {
        menu.classList.add('is-open');
        menuClose.focus();
      });
    };

    const closeMobileMenu = (restoreFocus = true) => {
      if (menu.hidden) return;
      menu.classList.remove('is-open');
      menu.setAttribute('aria-hidden', 'true');
      menuOpen.setAttribute('aria-expanded', 'false');
      unlockPage();
      const finish = () => {
        menu.hidden = true;
        if (restoreFocus) lastFocus?.focus();
      };
      if (reducedMotion.matches) finish();
      else hideTimer = window.setTimeout(finish, 300);
    };

    menuOpen.addEventListener('click', openMobileMenu);
    menuClose.addEventListener('click', () => closeMobileMenu());
    menu.querySelectorAll('[data-hv2-mobile-link]').forEach((link) => {
      link.addEventListener('click', () => closeMobileMenu(false));
    });

    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        event.preventDefault();
        closeMobileMenu();
        return;
      }
      if (event.key !== 'Tab') return;
      const items = focusableItems();
      const first = items[0];
      const last = items.at(-1);
      if (!first || !last) return;
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeAllDropdowns();
    });
    window.addEventListener('resize', () => {
      if (window.innerWidth > compactMenuBreakpoint && !menu.hidden) closeMobileMenu(false);
    });

    const settleHeaderForSnapshot = () => {
      window.clearTimeout(closeTimer);
      window.clearTimeout(hideTimer);
      if (headerFrame) window.cancelAnimationFrame(headerFrame);
      headerFrame = 0;
      closeAllDropdowns();
      revealHeader();
      menu.classList.remove('is-open');
      menu.setAttribute('aria-hidden', 'true');
      menu.hidden = true;
      menuOpen.setAttribute('aria-expanded', 'false');
      unlockPage(true);
    };

    window.addEventListener('pagehide', settleHeaderForSnapshot);
    document.addEventListener('v2:prepare-bfcache', settleHeaderForSnapshot);
  };

  initHomeV2Header();
  document.addEventListener('astro:page-load', initHomeV2Header);
</script>
