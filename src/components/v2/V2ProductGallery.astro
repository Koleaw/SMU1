---
import { v2Href as resolveV2Href } from '../../utils/v2Routes';
const withBase = (value: string) => resolveV2Href(value, Astro.url.pathname);
import { imageViewStyle } from './catalogV2Data';

interface Props {
  images: string[];
  title: string;
  imageView?: { fit?: 'cover' | 'contain'; positionX?: number; positionY?: number; scale?: number };
  caption?: string;
  entityLabel?: string;
}

const { images, title, imageView, caption = '', entityLabel = 'товара' } = Astro.props as Props;
const galleryImages = Array.from(new Set(images.map((item) => item.trim()).filter(Boolean)));
const hasImages = galleryImages.length > 0;
const hasMultipleImages = galleryImages.length > 1;
const galleryId = 'v2-product-gallery';
const lightboxTitleId = 'v2-product-lightbox-title';
const firstImageAlt = hasMultipleImages ? `${title} — фото 1 из ${galleryImages.length}` : `${title} — фото`;
---

<section
  class:list={['v2-product-gallery', { 'v2-product-gallery--empty': !hasImages, 'v2-product-gallery--single': hasImages && !hasMultipleImages }]}
  id={galleryId}
  aria-label={`Галерея: ${title}`}
  data-v2-product-gallery
>
  <div class="v2-product-gallery__stage" data-v2-gallery-context>
    <div class="v2-product-gallery__media" data-v2-media>
      {hasImages ? (
        <button class="v2-product-gallery__open" type="button" aria-label="Открыть текущее изображение на весь экран" data-v2-gallery-open>
          <img
            src={withBase(galleryImages[0])}
            alt={firstImageAlt}
            width="1400"
            height="1100"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            style={imageViewStyle(imageView)}
            data-v2-gallery-main
          />
          <span class="v2-product-gallery__zoom" aria-hidden="true">Развернуть</span>
        </button>
      ) : null}
      <div class="v2-media-empty v2-product-gallery__empty" aria-hidden={hasImages} data-v2-gallery-empty>
        <p>Фотоматериалы {entityLabel} не указаны</p>
      </div>
    </div>

    {hasMultipleImages && (
      <div class="v2-product-gallery__arrows" aria-label="Переключение изображений">
        <button type="button" aria-label="Назад" data-v2-gallery-prev>Назад</button>
        <button type="button" aria-label="Далее" data-v2-gallery-next>Далее</button>
      </div>
    )}

    {hasMultipleImages && (
      <p class="v2-product-gallery__status" aria-live="polite" aria-atomic="true" data-v2-gallery-status>
        1 / {galleryImages.length}
      </p>
    )}
  </div>

  {hasMultipleImages && (
    <div class="v2-product-gallery__thumbs" aria-label={`Все изображения ${entityLabel}`} data-v2-gallery-context>
      {galleryImages.map((image, index) => (
        <button
          class:list={['v2-product-gallery__thumb', { 'is-current': index === 0 }]}
          type="button"
          aria-label={`Показать изображение ${index + 1} из ${galleryImages.length}`}
          aria-pressed={index === 0 ? 'true' : 'false'}
          data-v2-gallery-thumb
          data-v2-gallery-index={index}
          data-v2-gallery-src={withBase(image)}
        >
          <img src={withBase(image)} alt="" width="180" height="140" loading="lazy" decoding="async" />
        </button>
      ))}
    </div>
  )}

  {caption && <p class="v2-product-gallery__caption">{caption}</p>}

  {hasImages && (
    <dialog class="v2-product-lightbox" aria-labelledby={lightboxTitleId} data-v2-product-lightbox>
      <div class="v2-product-lightbox__inner">
        <header class="v2-product-lightbox__header">
          <div>
            <p id={lightboxTitleId}>{title}</p>
            {hasMultipleImages && <span aria-live="polite" data-v2-lightbox-status>1 / {galleryImages.length}</span>}
          </div>
          <div class="v2-product-lightbox__toolbar">
            {hasMultipleImages && (
              <div class="v2-product-lightbox__arrows" aria-label="Переключение полноэкранных изображений">
                <button type="button" aria-label="Назад" data-v2-lightbox-prev>Назад</button>
                <button type="button" aria-label="Далее" data-v2-lightbox-next>Далее</button>
              </div>
            )}
            <button class="v2-product-lightbox__close" type="button" aria-label="Закрыть полноэкранную галерею" data-v2-lightbox-close>
              <span aria-hidden="true"></span>
            </button>
          </div>
        </header>
        <div class="v2-product-lightbox__media" data-v2-lightbox-media>
          <img alt="" data-v2-lightbox-image />
          <div class="v2-product-lightbox__fallback" hidden>Изображение не удалось загрузить</div>
        </div>
      </div>
    </dialog>
  )}
  <script
    type="application/json"
    data-v2-gallery-data
    set:html={JSON.stringify({ images: galleryImages.map(withBase), title })}
    is:inline
  />
</section>

<script>
  const initV2ProductGalleries = () => {
    document.querySelectorAll<HTMLElement>('[data-v2-product-gallery]').forEach((gallery) => {
      if (gallery.dataset.ready === 'true') return;
      gallery.dataset.ready = 'true';
      const dataElement = gallery.querySelector<HTMLScriptElement>('[data-v2-gallery-data]');
      let data: { images?: string[]; title?: string } = {};
      try {
        data = JSON.parse(dataElement?.textContent || '{}');
      } catch {
        data = {};
      }
      const sources = Array.isArray(data.images) ? data.images.filter(Boolean) : [];
      const galleryTitle = data.title || 'Изображение товара';
      const mainImage = gallery.querySelector<HTMLImageElement>('[data-v2-gallery-main]');
      const media = gallery.querySelector<HTMLElement>('[data-v2-media]');
      const emptyState = gallery.querySelector<HTMLElement>('[data-v2-gallery-empty]');
      const status = gallery.querySelector<HTMLElement>('[data-v2-gallery-status]');
      const thumbsTrack = gallery.querySelector<HTMLElement>('.v2-product-gallery__thumbs');
      const thumbs = Array.from(gallery.querySelectorAll<HTMLButtonElement>('[data-v2-gallery-thumb]'));
      const stage = gallery.querySelector<HTMLElement>('.v2-product-gallery__stage');
      const openButton = gallery.querySelector<HTMLButtonElement>('[data-v2-gallery-open]');
      const lightbox = gallery.querySelector<HTMLDialogElement>('[data-v2-product-lightbox]');
      const lightboxImage = gallery.querySelector<HTMLImageElement>('[data-v2-lightbox-image]');
      const lightboxStatus = gallery.querySelector<HTMLElement>('[data-v2-lightbox-status]');
      const lightboxFallback = gallery.querySelector<HTMLElement>('.v2-product-lightbox__fallback');
      if (!mainImage || !media || !stage || sources.length === 0) return;

      let current = 0;
      let lastFocus: HTMLElement | null = null;
      let pointerStartX = 0;
      let pointerStartY = 0;
      let pointerId = -1;
      let suppressOpen = false;

      const normalizedIndex = (index: number) => (index + sources.length) % sources.length;
      const altFor = (index: number) => sources.length > 1
        ? `${galleryTitle} — фото ${index + 1} из ${sources.length}`
        : `${galleryTitle} — фото`;
      const setImageState = (image: HTMLImageElement, container: HTMLElement, src: string, alt: string) => {
        container.classList.remove('is-broken');
        emptyState?.setAttribute('aria-hidden', 'true');
        image.hidden = false;
        image.alt = alt;
        image.onload = () => {
          container.classList.remove('is-broken');
          emptyState?.setAttribute('aria-hidden', 'true');
        };
        image.onerror = () => {
          image.hidden = true;
          container.classList.add('is-broken');
          emptyState?.setAttribute('aria-hidden', 'false');
        };
        image.src = src;
      };

      const syncLightbox = () => {
        if (!lightbox?.open || !lightboxImage) return;
        if (lightboxFallback) lightboxFallback.hidden = true;
        lightboxImage.hidden = false;
        lightboxImage.alt = altFor(current);
        lightboxImage.onload = () => {
          lightboxImage.hidden = false;
          if (lightboxFallback) lightboxFallback.hidden = true;
        };
        lightboxImage.onerror = () => {
          lightboxImage.hidden = true;
          if (lightboxFallback) lightboxFallback.hidden = false;
        };
        lightboxImage.src = sources[current];
        if (lightboxStatus) lightboxStatus.textContent = `${current + 1} / ${sources.length}`;
      };

      const revealCurrentThumb = () => {
        const thumb = thumbs[current];
        if (!thumbsTrack || !thumb) return;

        const trackRect = thumbsTrack.getBoundingClientRect();
        const thumbRect = thumb.getBoundingClientRect();
        const startDelta = thumbRect.left - trackRect.left;
        const endDelta = thumbRect.right - trackRect.right;
        const delta = startDelta < 0 ? startDelta : endDelta > 0 ? endDelta : 0;
        if (delta === 0) return;

        thumbsTrack.scrollTo({
          left: Math.max(0, thumbsTrack.scrollLeft + delta),
          top: thumbsTrack.scrollTop,
          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth'
        });
      };

      const setCurrent = (index: number, revealThumb = true) => {
        current = normalizedIndex(index);
        setImageState(mainImage, media, sources[current], altFor(current));
        thumbs.forEach((thumb, thumbIndex) => {
          const isCurrent = thumbIndex === current;
          thumb.classList.toggle('is-current', isCurrent);
          thumb.setAttribute('aria-pressed', String(isCurrent));
        });
        if (revealThumb) revealCurrentThumb();
        if (status) status.textContent = `${current + 1} / ${sources.length}`;
        syncLightbox();
      };

      const previous = () => setCurrent(current - 1);
      const next = () => setCurrent(current + 1);
      gallery.querySelector<HTMLButtonElement>('[data-v2-gallery-prev]')?.addEventListener('click', previous);
      gallery.querySelector<HTMLButtonElement>('[data-v2-gallery-next]')?.addEventListener('click', next);
      gallery.querySelector<HTMLButtonElement>('[data-v2-lightbox-prev]')?.addEventListener('click', previous);
      gallery.querySelector<HTMLButtonElement>('[data-v2-lightbox-next]')?.addEventListener('click', next);
      thumbs.forEach((thumb, index) => thumb.addEventListener('click', () => setCurrent(index)));

      gallery.addEventListener('keydown', (event) => {
        if (sources.length < 2) return;
        const target = event.target;
        if (!(target instanceof Element) || !target.closest('[data-v2-gallery-context]')) return;
        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          previous();
        } else if (event.key === 'ArrowRight') {
          event.preventDefault();
          next();
        }
      });

      stage.addEventListener('pointerdown', (event) => {
        if (event.pointerType !== 'touch' || sources.length < 2) return;
        pointerId = event.pointerId;
        pointerStartX = event.clientX;
        pointerStartY = event.clientY;
      });
      stage.addEventListener('pointerup', (event) => {
        if (event.pointerId !== pointerId) return;
        const deltaX = event.clientX - pointerStartX;
        const deltaY = event.clientY - pointerStartY;
        pointerId = -1;
        if (Math.abs(deltaX) < 42 || Math.abs(deltaX) <= Math.abs(deltaY)) return;
        suppressOpen = true;
        window.setTimeout(() => { suppressOpen = false; }, 0);
        if (deltaX > 0) previous();
        else next();
      });
      stage.addEventListener('pointercancel', () => { pointerId = -1; });

      const focusableLightboxItems = () => lightbox
        ? Array.from(lightbox.querySelectorAll<HTMLElement>('button:not([disabled]), a[href], [tabindex]:not([tabindex="-1"])'))
          .filter((item) => !item.hasAttribute('hidden'))
        : [];
      const openLightbox = () => {
        if (!lightbox || !lightboxImage) return;
        lastFocus = document.activeElement instanceof HTMLElement ? document.activeElement : openButton;
        lightbox.showModal();
        document.documentElement.classList.add('v2-lightbox-open');
        syncLightbox();
        gallery.querySelector<HTMLButtonElement>('[data-v2-lightbox-close]')?.focus();
      };
      const closeLightbox = () => {
        if (!lightbox?.open) return;
        lightbox.close();
      };

      openButton?.addEventListener('click', (event) => {
        if (suppressOpen) {
          event.preventDefault();
          return;
        }
        openLightbox();
      });
      gallery.querySelector<HTMLButtonElement>('[data-v2-lightbox-close]')?.addEventListener('click', closeLightbox);
      lightbox?.addEventListener('cancel', (event) => {
        event.preventDefault();
        closeLightbox();
      });
      lightbox?.addEventListener('close', () => {
        document.documentElement.classList.remove('v2-lightbox-open');
        lastFocus?.focus();
      });
      lightbox?.addEventListener('click', (event) => {
        if (event.target === lightbox) closeLightbox();
      });
      lightbox?.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          previous();
          return;
        }
        if (event.key === 'ArrowRight') {
          event.preventDefault();
          next();
          return;
        }
        if (event.key !== 'Tab') return;
        const items = focusableLightboxItems();
        const first = items[0];
        const last = items.at(-1);
        if (!first || !last) return;
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      });

      thumbs.forEach((thumb) => {
        const image = thumb.querySelector('img');
        if (!image) return;
        image.addEventListener('error', () => thumb.classList.add('is-broken'), { once: true });
      });

      setCurrent(0, false);
    });
  };

  initV2ProductGalleries();
  document.addEventListener('astro:page-load', initV2ProductGalleries);
</script>
