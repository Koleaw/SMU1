---
import { v2Href as resolveV2Href } from '../../utils/v2Routes';
const withBase = (value: string) => resolveV2Href(value, Astro.url.pathname);
import {
  categoryGalleryImages,
  publicCatalogCopy,
  type ProductCategoryData
} from './catalogV2Data';
import V2DirectContact from './V2DirectContact.astro';
import V2ProductGallery from './V2ProductGallery.astro';
import settings from '../../content/site-settings/global.json';
import { adminBinding } from '../../admin/bindings/adminBinding';

interface Props {
  category: ProductCategoryData;
  sectionTitle: string;
  sectionHref: string;
}

const { category, sectionTitle, sectionHref } = Astro.props as Props;
const catalogCopy = settings.catalogUi;
const globalBinding = (fieldPath: string, tool = 'short-text', options: Record<string, unknown> = {}) => adminBinding(Astro.url, {
  renderer: { family: 'catalog-ui', variant: 'sparse-category' }, owner: { collection: 'site-settings', slug: 'global' },
  fieldPath: `catalogUi.${fieldPath}`, scope: 'global', tool, affectedRoutes: ['*'], ...options
});
const categoryBinding = (fieldPath: string, tool = 'short-text', options: Record<string, unknown> = {}) => adminBinding(Astro.url, {
  renderer: { family: 'catalog-category', variant: 'sparse' }, owner: { collection: 'product-categories', slug: category.slug },
  fieldPath, scope: 'local', tool, affectedRoutes: [Astro.url.pathname, sectionHref], ...options
});
const sectionBinding = (fieldPath: string, tool = 'short-text', options: Record<string, unknown> = {}) => adminBinding(Astro.url, {
  renderer: { family: 'catalog-category', variant: 'parent-reference' },
  owner: { collection: 'product-sections', slug: category.parentSectionSlug }, fieldPath,
  scope: 'shared', tool, affectedRoutes: [Astro.url.pathname, sectionHref], ...options
});
const media = categoryGalleryImages(category);
const showGallery = media.length > 0;
const heroDescription = publicCatalogCopy(category.heroDescription);
const shortDescription = publicCatalogCopy(category.shortDescription);
const categoryDescription = heroDescription || shortDescription;
const categoryDescriptionBinding = heroDescription
  ? categoryBinding('heroDescription', 'long-text')
  : categoryBinding('shortDescription', 'long-text', { projection: { kind: 'fallback', fallback: 'heroDescription' } });
const contactDescription = categoryDescription
  || catalogCopy.sparse.contactDefaultDescription;
const contactDescriptionBinding = categoryDescription
  ? categoryDescriptionBinding
  : globalBinding('sparse.contactDefaultDescription', 'long-text', {
      projection: { kind: 'fallback', fallback: `product-categories.${category.slug}.heroDescription || shortDescription` }
    });
const materials = catalogCopy.sparse.materials
  .map((item, sourceIndex) => ({ ...item, sourceIndex }))
  .filter((item) => item.isActive !== false)
  .sort((a, b) => a.order - b.order);
---

{showGallery && (
  <section
    class="v2-category-examples v2-category-examples--sparse"
    id="category-examples"
    aria-labelledby="v2-sparse-examples-title"
  >
    <div class="hv2-shell">
      <header class="v2-section-heading" data-v2-reveal>
        <div>
          <h2 id="v2-sparse-examples-title" {...globalBinding('sparse.galleryTitle', 'heading')}>{catalogCopy.sparse.galleryTitle}</h2>
        </div>
        {categoryDescription && <p {...categoryDescriptionBinding}>{categoryDescription}</p>}
      </header>
      <div class="v2-category-examples__gallery" data-v2-reveal>
        <V2ProductGallery
          images={media}
          imageMetadata={category.gallery}
          title={category.title}
          imageView={category.imageView}
          entityLabel="категории"
          mediaSizes="(max-width: 760px) calc(100vw - 32px), min(1120px, calc(100vw - 64px))"
          bindingOwner={{ collection: 'product-categories', slug: category.slug }}
          bindingField="gallery"
          affectedRoutes={[Astro.url.pathname, sectionHref]}
        />
      </div>
    </div>
  </section>
)}

<section
  class="v2-sparse-state v2-sparse-state--text-only"
  aria-labelledby="v2-sparse-title"
>
  <div class="hv2-shell">
    <header class="v2-section-heading" data-v2-reveal>
      <div>
        <p class="hv2-eyebrow" {...globalBinding('sparse.eyebrow')}>{catalogCopy.sparse.eyebrow}</p>
        <h2 id="v2-sparse-title" {...globalBinding('sparse.title', 'heading')}>{catalogCopy.sparse.title}</h2>
      </div>
      {!showGallery && categoryDescription && <p {...categoryDescriptionBinding}>{categoryDescription}</p>}
    </header>

    <div class="hv2-grid v2-sparse-state__grid">
      <div class="v2-sparse-state__content" data-v2-reveal>
        <p class="v2-sparse-state__summary" {...globalBinding('sparse.summary', 'long-text')}>{catalogCopy.sparse.summary}</p>
        <ul
          aria-label={catalogCopy.sparse.materialsLabel}
          {...globalBinding('sparse.materials', 'list', {
            role: 'sparse-calculation-materials', stableItemId: 'sparse-calculation-materials', itemKind: 'object',
            zoneId: 'catalog-sparse-materials', permissions: { edit: true, reorder: true, delete: false }
          })}
        >
          {materials.map((item) => (
            <li {...globalBinding(`sparse.materials[${item.sourceIndex}].label`, 'short-text', { stableItemId: item.id })}>{item.label}</li>
          ))}
        </ul>
        <a class="hv2-text-link" href={withBase(sectionHref)}>
          <span {...globalBinding('sparse.sectionLinkPrefix')}>{catalogCopy.sparse.sectionLinkPrefix}</span>{' '}
          <span {...sectionBinding('title')}>{sectionTitle}</span>
        </a>
      </div>
    </div>
  </div>
</section>

<V2DirectContact
  eyebrow={catalogCopy.sparse.contactEyebrow}
  title={catalogCopy.sparse.contactTitle}
  description={contactDescription}
  primaryLabel={catalogCopy.sparse.contactPrimaryLabel}
  secondaryLabel={catalogCopy.sparse.contactSecondaryLabel}
  phoneChannelLabel={catalogCopy.shared.phoneChannelLabel}
  telegramChannelLabel={catalogCopy.shared.telegramChannelLabel}
  emailChannelLabel={catalogCopy.shared.emailChannelLabel}
  eyebrowBinding={globalBinding('sparse.contactEyebrow')}
  titleBinding={globalBinding('sparse.contactTitle', 'heading')}
  descriptionBinding={contactDescriptionBinding}
  primaryLabelBinding={globalBinding('sparse.contactPrimaryLabel')}
  secondaryLabelBinding={globalBinding('sparse.contactSecondaryLabel')}
  phoneChannelLabelBinding={globalBinding('shared.phoneChannelLabel')}
  telegramChannelLabelBinding={globalBinding('shared.telegramChannelLabel')}
  emailChannelLabelBinding={globalBinding('shared.emailChannelLabel')}
/>
