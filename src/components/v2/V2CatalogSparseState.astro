---
import { v2Href as resolveV2Href } from '../../utils/v2Routes';
const withBase = (value: string) => resolveV2Href(value, Astro.url.pathname);
import {
  categoryGalleryImages,
  publicCatalogCopy,
  type ProductCategoryData
} from './catalogV2Data';
import V2DirectContact from './V2DirectContact.astro';
import V2ProductGallery from './V2ProductGallery.astro';

interface Props {
  category: ProductCategoryData;
  sectionTitle: string;
  sectionHref: string;
}

const { category, sectionTitle, sectionHref } = Astro.props as Props;
const media = categoryGalleryImages(category);
const showGallery = media.length > 1;
const categoryDescription = publicCatalogCopy(category.heroDescription)
  || publicCatalogCopy(category.shortDescription);
const contactDescription = categoryDescription
  || 'Пришлите размеры, количество, фотографию места установки, эскиз или техническое задание.';
---

<section
  class:list={['v2-sparse-state', { 'v2-sparse-state--with-media': showGallery, 'v2-sparse-state--text-only': !showGallery }]}
  aria-labelledby="v2-sparse-title"
>
  <div class="hv2-shell">
    <header class="v2-section-heading" data-v2-reveal>
      <div>
        <p class="hv2-eyebrow">Изготовление по задаче</p>
        <h2 id="v2-sparse-title">Что можно прислать для расчёта</h2>
      </div>
      {categoryDescription && <p>{categoryDescription}</p>}
    </header>

    <div class="hv2-grid v2-sparse-state__grid">
      {showGallery && (
        <div class="v2-sparse-state__media" data-v2-reveal="section-media">
          <V2ProductGallery
            images={media}
            title={category.title}
            imageView={category.imageView}
            entityLabel="категории"
          />
        </div>
      )}
      <div class="v2-sparse-state__content" data-v2-reveal>
        <p class="v2-sparse-state__summary">Готовые модели этой категории пока не опубликованы. Конструкцию можно рассчитать по вашим вводным.</p>
        <ul aria-label="Материалы для расчёта">
          <li>размеры и необходимое количество;</li>
          <li>фотографию места установки;</li>
          <li>эскиз, чертёж или техническое задание.</li>
        </ul>
        <a class="hv2-text-link" href={withBase(sectionHref)}>
          Все направления: {sectionTitle}<span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
</section>

<V2DirectContact
  eyebrow="Прямая связь"
  title="Обсудим конструкцию по вашим вводным"
  description={contactDescription}
  primaryLabel="Обсудить задачу"
  secondaryLabel=""
/>
