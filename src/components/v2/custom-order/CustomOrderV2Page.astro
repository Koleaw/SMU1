---
import { v2Href as resolveV2Href } from '../../../utils/v2Routes';
import { getV2TelegramLabel } from '../../../utils/v2SiteSettings';
import settings from '../../../content/site-settings/global.json';
import V2Breadcrumbs from '../V2Breadcrumbs.astro';
import V2HeroHandoff from '../V2HeroHandoff.astro';
import V2ResponsiveImage from '../V2ResponsiveImage.astro';
import type { CustomOrderV2Data } from './customOrderV2Data';
import '../../../styles/v2/custom-order-v2.css';
  import { adminBinding, adminDisposition, adminListField, adminListItem, isLocalAdminCanvas } from '../../../admin/bindings/adminBinding';

interface Props {
  data: CustomOrderV2Data;
}

const { data } = Astro.props as Props;
const withBase = (value: string) => resolveV2Href(value, Astro.url.pathname);
const phoneHref = `tel:${settings.phonePrimary.replace(/[^+\d]/g, '')}`;
const emailHref = `mailto:${settings.email}`;
const telegramLabel = getV2TelegramLabel(settings);
const heroMedia = data.heroMedia[0];
const isEditorCanvas = isLocalAdminCanvas(Astro.url);
const pageBinding = (fieldPath: string, tool = 'long-text', options: Record<string, unknown> = {}) => adminBinding(Astro.url, {
  renderer: { family: 'custom-order', variant: 'production' }, owner: { collection: 'static-pages', slug: 'custom-order' },
  fieldPath, scope: 'local', tool, affectedRoutes: ['/izgotovlenie-na-zakaz/'], ...options
});
const globalBinding = (
  fieldPath: string,
  tool = 'short-text',
  occurrence = fieldPath,
  options: Record<string, unknown> = {}
) => adminBinding(Astro.url, {
  renderer: { family: 'global-shell', variant: 'contact' }, owner: { collection: 'site-settings', slug: 'global' },
  fieldPath, stableItemId: `custom-order-${occurrence}`, scope: 'global', tool, affectedRoutes: ['*'], ...options
});
const contactHrefDisposition = (fieldPath: 'phonePrimary' | 'email' | 'telegram', occurrence: string) => adminDisposition(Astro.url, {
  kind: 'derived',
  reason: fieldPath === 'phonePrimary'
    ? 'Адрес звонка вычисляется из основного телефона без пробелов и служебных символов.'
    : fieldPath === 'email'
      ? 'Адрес письма вычисляется из электронной почты компании.'
      : 'Ссылка ведёт на общий Telegram компании.',
  source: `site-settings/global.${fieldPath} → ${fieldPath === 'phonePrimary' ? 'tel:' : fieldPath === 'email' ? 'mailto:' : 'https:'} (${occurrence})`,
  tool: 'global-settings'
});
const breadcrumbItems = [
  {
    title: settings.catalogUi.shared.homeBreadcrumbLabel,
    href: '/design-lab/home-v2/',
    editor: globalBinding('catalogUi.shared.homeBreadcrumbLabel', 'short-text', 'breadcrumb-home')
  },
  {
    title: data.sourcePage.title,
    editor: pageBinding('title', 'heading', { stableItemId: 'custom-order-breadcrumb-current', role: 'breadcrumb-current' })
  }
];
const customOrderHeroMediaBinding = adminBinding(Astro.url, {
  renderer: { family: 'custom-order', variant: 'borrowed-project-hero' },
  owner: { collection: 'projects', slug: heroMedia.ownerSlug }, fieldPath: heroMedia.fieldPath,
  stableItemId: 'custom-order-hero-project-media', role: 'detail-hero', scope: 'shared', tool: 'media',
  label: `Фотография объекта «${heroMedia.ownerSlug}»`, multiple: false,
  affectedRoutes: ['/izgotovlenie-na-zakaz/', `/vypolnennye-obekty/${heroMedia.ownerSlug}/`],
  projection: { kind: 'shared-media', formula: 'project.presentation.detailHeroMedia → custom order hero' }
});
const customOrderHeroRelationBinding = pageBinding('customOrderHeroProjectSlug', 'relation-select', {
  stableItemId: 'custom-order-hero-source', role: 'custom-order-hero-source',
  label: 'Объект-источник первого экрана',
  relationCollection: 'projects', validation: { required: true },
  projection: { kind: 'relation', formula: 'customOrderHeroProjectSlug → project.presentation.detailHeroMedia' },
  relationProjection: {
    mediaBindingId: customOrderHeroMediaBinding['data-smu1-binding-id'] || '',
    mediaFieldPaths: ['presentation.detailHeroMedia', 'presentation.archiveCoverMedia', 'presentation.publicGallery'],
    positionFields: [
      { fieldPath: 'customOrderHeroPosition', cssProperty: '--custom-order-hero-position' },
      { fieldPath: 'customOrderHeroMobilePosition', cssProperty: '--custom-order-hero-position-mobile' }
    ]
  }
});
---

<div class="custom-order-v2">
  <V2HeroHandoff enabled>
    <section
      class="custom-order-hero"
      aria-labelledby="custom-order-title"
      data-product-final-hero
    >
      <div class="custom-order-hero__track" data-product-final-track>
        <div class="hv2-shell custom-order-hero__grid">
          <div class="custom-order-hero__copy" data-v2-page-handoff="copy">
            <div class="custom-order-hero__breadcrumbs" data-v2-entrance-role="context">
              <V2Breadcrumbs items={breadcrumbItems} />
            </div>
            <p class="hv2-eyebrow" data-v2-entrance-role="context" {...pageBinding('heroKicker', 'short-text')}>{data.copy.heroKicker}</p>
            <h1 id="custom-order-title" data-v2-entrance-role="title-primary" {...pageBinding('heroTitle', 'heading')}>{data.copy.heroTitle}</h1>
            <p class="custom-order-hero__lead" data-v2-entrance-role="lead" {...pageBinding('heroDescription', 'long-text')}>{data.copy.heroDescription}</p>
            <div class="custom-order-hero__actions" data-v2-entrance-role="actions-meta">
              <a
                class="hv2-button hv2-button--primary custom-order-hero__phone"
                href={phoneHref}
                aria-label={`${data.copy.heroPrimaryLabel} ${settings.phonePrimary}`}
                {...contactHrefDisposition('phonePrimary', 'hero-primary')}
              >
                <span {...pageBinding('heroPrimaryLabel', 'button-label')}>{data.copy.heroPrimaryLabel}</span>
                <strong {...globalBinding('phonePrimary', 'short-text', 'hero-phone-value')}>{settings.phonePrimary}</strong>
              </a>
              <a class="hv2-button custom-order-hero__email" href={emailHref} {...pageBinding('heroSecondaryLabel', 'button-label')} {...contactHrefDisposition('email', 'hero-secondary')}>
                {data.copy.heroSecondaryLabel}
              </a>
            </div>
          </div>

          <div
            class="custom-order-hero__media"
            data-v2-media
            data-v2-entrance-role="media"
            data-smu1-borrowed-media-root={isEditorCanvas ? 'true' : undefined}
            {...customOrderHeroRelationBinding}
          >
            <V2ResponsiveImage
              src={heroMedia.src}
              alt={heroMedia.alt}
              role="hero"
              sizes="(max-width: 760px) 100vw, 50vw"
              loading="eager"
              decoding="async"
              fetchpriority="high"
              style={`--custom-order-hero-position:${heroMedia.position};--custom-order-hero-position-mobile:${heroMedia.mobilePosition};`}
              data-v2-image
              data-v2-page-critical
              data-smu1-borrowed-media={isEditorCanvas ? 'true' : undefined}
              {...customOrderHeroMediaBinding}
            />
          </div>
        </div>
      </div>
    </section>
  </V2HeroHandoff>

  <section class="custom-order-brief" aria-labelledby="custom-order-brief-title">
    <div class="hv2-shell">
      <header class="custom-order-brief__heading">
        <h2 id="custom-order-brief-title" {...pageBinding('customOrderBriefTitle', 'heading')}>{data.sourcePage.customOrderBriefTitle}</h2>
      </header>

      <div class="custom-order-brief__content">
        <div class="custom-order-brief__column custom-order-brief__column--sources">
          <div class="custom-order-brief__intro">
            <h3 {...pageBinding('customOrderSourceHeading', 'heading')}>{data.sourcePage.customOrderSourceHeading}</h3>
            <p {...pageBinding('customOrderSourceDescription', 'long-text')}>{data.sourcePage.customOrderSourceDescription}</p>
          </div>
          <ol class="custom-order-sources" {...pageBinding('customOrderSourceMaterials', 'list', {
                stableItemId: 'custom-order-source-materials',
                itemKind: 'object',
                permissions: { edit: true, reorder: true, delete: false },
                itemFields: [
                  { fieldPath: 'id', tool: 'generated-id' },
                  { fieldPath: 'label', label: 'Материал', tool: 'short-text' },
                  { fieldPath: 'order', tool: 'generated-order' },
                  { fieldPath: 'isActive', label: 'Показывать пункт', tool: 'visibility' }
                ]
              })}>
            {data.sourceMaterials.map((item) => (
              <li {...adminListItem(Astro.url, item.id)}><span {...adminListField(Astro.url, 'label')}>{item.label}</span></li>
            ))}
          </ol>
        </div>

        <div class="custom-order-brief__column custom-order-brief__column--changes">
          <div class="custom-order-brief__intro">
            <h3 {...pageBinding('customOrderChangeHeading', 'heading')}>{data.sourcePage.customOrderChangeHeading}</h3>
            <p {...pageBinding('customOrderChangeDescription', 'long-text')}>{data.sourcePage.customOrderChangeDescription}</p>
          </div>
          <ul class="custom-order-themes" {...pageBinding('customOrderChangeThemes', 'list', {
                stableItemId: 'custom-order-change-themes',
                itemKind: 'object',
                permissions: { edit: true, reorder: true, delete: false },
                itemFields: [
                  { fieldPath: 'id', tool: 'generated-id' },
                  { fieldPath: 'title', label: 'Тема изменений', tool: 'short-text' },
                  { fieldPath: 'order', tool: 'generated-order' },
                  { fieldPath: 'isActive', label: 'Показывать тему', tool: 'visibility' },
                  {
                    fieldPath: 'items', label: 'Что можно изменить', tool: 'list', itemKind: 'object',
                    itemFields: [
                      { fieldPath: 'id', tool: 'generated-id' },
                      { fieldPath: 'label', label: 'Параметр', tool: 'short-text' },
                      { fieldPath: 'order', tool: 'generated-order' },
                      { fieldPath: 'isActive', label: 'Показывать параметр', tool: 'visibility' }
                    ]
                  }
                ]
              })}>
            {data.changeThemes.map((theme) => (
              <li {...adminListItem(Astro.url, theme.id)}>
                <h4 {...adminListField(Astro.url, 'title')}>{theme.title}</h4>
                <ul {...adminListField(Astro.url, 'items')}>
                  {theme.items.map((item) => <li {...adminListItem(Astro.url, item.id)}><span {...adminListField(Astro.url, 'label')}>{item.label}</span></li>)}
                </ul>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="custom-order-directions" aria-labelledby="custom-order-directions-title">
    <div class="hv2-shell custom-order-directions__inner">
      <h2 id="custom-order-directions-title" {...pageBinding('customOrderDirectionsTitle', 'heading')}>{data.sourcePage.customOrderDirectionsTitle}</h2>
      <ul class="custom-order-directions__links" {...pageBinding('relatedDirectionSlugs', 'relation-list', {
        stableItemId: 'custom-order-related-directions', permissions: { edit: true, reorder: true, delete: false },
        label: 'Связанные направления и их порядок',
        relationCollections: ['product-sections', 'services'],
        projection: { kind: 'relation', formula: 'ordered relatedDirectionSlugs → direction links' }
      })}>
        {data.directions.map((direction) => (
          <li>
            <a href={withBase(direction.href)} {...adminBinding(Astro.url, {
              renderer: { family: 'custom-order', variant: 'related-direction' },
              owner: { collection: direction.ownerCollection, slug: direction.slug }, fieldPath: 'title',
              stableItemId: direction.slug, scope: 'shared', tool: 'heading',
              affectedRoutes: ['/izgotovlenie-na-zakaz/', direction.href]
            })}>{direction.title}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="custom-order-contact" id="contact" aria-labelledby="custom-order-contact-title">
    <div class="hv2-shell custom-order-contact__grid">
      <div class="custom-order-contact__intro">
        <p class="hv2-eyebrow hv2-eyebrow--light" {...pageBinding('contactEyebrow', 'short-text')}>{data.copy.contactEyebrow}</p>
        <h2 id="custom-order-contact-title" {...pageBinding('contactTitle', 'heading')}>{data.copy.contactTitle}</h2>
        <p {...pageBinding('contactDescription', 'long-text')}>{data.copy.contactDescription}</p>
      </div>
      <div class="custom-order-contact__channels">
        <a class="custom-order-contact__channel custom-order-contact__channel--primary" href={phoneHref} {...contactHrefDisposition('phonePrimary', 'contact-primary')}>
          <span {...pageBinding('contactPrimaryLabel', 'short-text')}>{data.copy.contactPrimaryLabel}</span>
          <strong {...globalBinding('phonePrimary', 'short-text', 'contact-phone-value')}>{settings.phonePrimary}</strong>
        </a>
        <a class="custom-order-contact__channel custom-order-contact__channel--primary" href={emailHref} {...contactHrefDisposition('email', 'contact-secondary')}>
          <span {...pageBinding('contactSecondaryLabel', 'short-text')}>{data.copy.contactSecondaryLabel}</span>
          <strong {...globalBinding('email', 'short-text', 'contact-email-value')}>{settings.email}</strong>
        </a>
        <a
          class="custom-order-contact__channel custom-order-contact__channel--secondary"
          href={settings.telegram}
          target="_blank"
          rel="noopener noreferrer"
          {...contactHrefDisposition('telegram', 'contact-telegram')}
        >
          <span {...globalBinding('contactsPage.telegramCardLabel', 'short-text', 'contact-telegram-label')}>{settings.contactsPage.telegramCardLabel}</span>
          <strong {...globalBinding('telegram', 'link', 'contact-telegram-value')}>{telegramLabel}</strong>
        </a>
      </div>
    </div>
  </section>
</div>
