---
import { v2Href as resolveV2Href } from '../../../utils/v2Routes';
import { getV2TelegramLabel } from '../../../utils/v2SiteSettings';
import settings from '../../../content/site-settings/global.json';
import V2Breadcrumbs from '../V2Breadcrumbs.astro';
import V2HeroHandoff from '../V2HeroHandoff.astro';
import type { CustomOrderV2Data } from './customOrderV2Data';
import '../../../styles/v2/custom-order-v2.css';

interface Props {
  data: CustomOrderV2Data;
}

const { data } = Astro.props as Props;
const withBase = (value: string) => resolveV2Href(value, Astro.url.pathname);
const phoneHref = `tel:${settings.phonePrimary.replace(/[^+\d]/g, '')}`;
const emailHref = `mailto:${settings.email}`;
const telegramLabel = getV2TelegramLabel(settings);
const heroMedia = data.heroMedia[0];
---

<div class="custom-order-v2">
  <V2HeroHandoff enabled>
    <section
      class="custom-order-hero"
      aria-labelledby="custom-order-title"
      data-product-final-hero
    >
      <div class="custom-order-hero__track" data-product-final-track>
        <div class="hv2-shell custom-order-hero__grid">
          <div class="custom-order-hero__copy" data-v2-page-handoff="copy">
            <div class="custom-order-hero__breadcrumbs">
              <V2Breadcrumbs items={[
                { title: 'Главная', href: '/design-lab/home-v2/' },
                { title: data.sourcePage.title }
              ]} />
            </div>
            <p class="hv2-eyebrow">{data.copy.heroKicker}</p>
            <h1 id="custom-order-title">{data.copy.heroTitle}</h1>
            <p class="custom-order-hero__lead">{data.copy.heroDescription}</p>
            <div class="custom-order-hero__actions">
              <a
                class="hv2-button hv2-button--primary custom-order-hero__phone"
                href={phoneHref}
                aria-label={`Позвонить ${settings.phonePrimary}`}
              >
                <span>Позвонить</span>
                <strong>{settings.phonePrimary}</strong>
              </a>
              <a class="hv2-button custom-order-hero__email" href={emailHref}>
                Отправить исходные данные
              </a>
            </div>
          </div>

          <div class="custom-order-hero__media" data-v2-media>
            <img
              src={withBase(heroMedia.src)}
              alt={heroMedia.alt}
              width="3072"
              height="4096"
              loading="eager"
              decoding="async"
              fetchpriority="high"
              style={`--custom-order-hero-position:${heroMedia.position};--custom-order-hero-position-mobile:${heroMedia.mobilePosition};`}
              data-v2-image
              data-v2-page-critical
            />
          </div>
        </div>
      </div>
    </section>
  </V2HeroHandoff>

  <section class="custom-order-brief" aria-labelledby="custom-order-brief-title">
    <div class="hv2-shell">
      <header class="custom-order-brief__heading">
        <h2 id="custom-order-brief-title">Что можно прислать / Что можно изменить</h2>
      </header>

      <div class="custom-order-brief__content">
        <div class="custom-order-brief__column custom-order-brief__column--sources">
          <div class="custom-order-brief__intro">
            <h3>Что можно прислать</h3>
            <p>Не нужно готовить полный комплект документов. Пришлите один или несколько материалов — остальное уточним вместе.</p>
          </div>
          <ol class="custom-order-sources">
            {data.sourceMaterials.map((item) => (
              <li><span>{item}</span></li>
            ))}
          </ol>
        </div>

        <div class="custom-order-brief__column custom-order-brief__column--changes">
          <div class="custom-order-brief__intro">
            <h3>Что можно изменить</h3>
            <p>Набор параметров зависит от изделия и условий объекта. На старте фиксируем только то, что действительно влияет на исполнение.</p>
          </div>
          <ul class="custom-order-themes">
            {data.changeThemes.map((theme) => (
              <li>
                <h4>{theme.title}</h4>
                <ul>
                  {theme.items.map((item) => <li>{item}</li>)}
                </ul>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="custom-order-directions" aria-labelledby="custom-order-directions-title">
    <div class="hv2-shell custom-order-directions__inner">
      <h2 id="custom-order-directions-title">Выберите близкое направление</h2>
      <ul class="custom-order-directions__links">
        {data.directions.map((direction) => (
          <li>
            <a href={withBase(direction.href)}>{direction.title}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="custom-order-contact" id="contact" aria-labelledby="custom-order-contact-title">
    <div class="hv2-shell custom-order-contact__grid">
      <div class="custom-order-contact__intro">
        <p class="hv2-eyebrow hv2-eyebrow--light">Прямая связь</p>
        <h2 id="custom-order-contact-title">{data.copy.contactTitle}</h2>
        <p>{data.copy.contactDescription}</p>
      </div>
      <div class="custom-order-contact__channels">
        <a class="custom-order-contact__channel custom-order-contact__channel--primary" href={phoneHref}>
          <span>Основной телефон</span>
          <strong>{settings.phonePrimary}</strong>
        </a>
        <a class="custom-order-contact__channel custom-order-contact__channel--primary" href={emailHref}>
          <span>Email</span>
          <strong>{settings.email}</strong>
        </a>
        <a
          class="custom-order-contact__channel custom-order-contact__channel--secondary"
          href={settings.telegram}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>Telegram</span>
          <strong>{telegramLabel}</strong>
        </a>
      </div>
    </div>
  </section>
</div>
