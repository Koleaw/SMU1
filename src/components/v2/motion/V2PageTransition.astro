---
import '../../../styles/v2/page-transition-v2.css';

interface Props {
  part?: 'head' | 'overlay';
  allowDesignLab?: boolean;
}

const {
  part = 'overlay',
  allowDesignLab = false
} = Astro.props as Props;

const basePath = import.meta.env.BASE_URL || '/';
---

{part === 'head' ? (
  <>
    <!--
      This deliberately small rule is duplicated from the bundled stylesheet.
      It is needed before first paint: a valid MPA handoff arrives with the
      navigation drawing already covering the new document.
    -->
    <style is:inline>
      .v2-page-transition{position:fixed;z-index:1200;inset:0;overflow:hidden;visibility:hidden;pointer-events:none;contain:strict;isolation:isolate}.v2-page-transition__sheet,.v2-page-transition-bootstrap{position:absolute;inset:0;display:flex;align-items:center;overflow:hidden;background-color:#0b1d36;background-image:linear-gradient(rgb(255 255 255/.035) 1px,transparent 1px),linear-gradient(90deg,rgb(255 255 255/.035) 1px,transparent 1px);background-size:64px 64px}.v2-page-transition__sheet{transform:translate3d(100%,0,0)}.v2-page-transition-bootstrap{position:fixed;z-index:1201;pointer-events:auto}.v2-page-transition-bootstrap:before{position:absolute;z-index:3;inset-block:0;left:0;width:2px;background:#1759b7;content:""}.v2-page-transition-bootstrap:after{position:absolute;z-index:3;inset-block:0;left:2px;width:10px;background:linear-gradient(90deg,rgb(23 89 183/.1),transparent);content:""}.v2-page-transition__shell,.v2-page-transition-bootstrap__shell{position:relative;z-index:2;width:min(calc(100% - 64px),1360px);margin-inline:auto}.v2-page-transition__label,.v2-page-transition-bootstrap__label{display:-webkit-box;max-width:18ch;margin:0;overflow:hidden;color:#fff;font-family:Manrope,Arial,sans-serif;font-size:clamp(32px,4.2vw,64px);font-weight:600;line-height:1.08;letter-spacing:-.025em;text-transform:none;-webkit-box-orient:vertical;-webkit-line-clamp:2}html[data-v2-page-bootstrap=arrival]{overflow:hidden;background:#0b1d36;scrollbar-gutter:stable;scrollbar-color:transparent #0b1d36}html[data-v2-page-bootstrap=arrival] .v2-page-transition{visibility:visible;pointer-events:auto}html[data-v2-page-bootstrap=arrival] .v2-page-transition__sheet{transform:translate3d(0,0,0)}@media(max-width:760px){.v2-page-transition__shell,.v2-page-transition-bootstrap__shell{width:calc(100% - 32px)}.v2-page-transition__label,.v2-page-transition-bootstrap__label{font-size:clamp(27px,8vw,38px)}}
    </style>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const key = 'smu1:page-transition:v1';
        const entryKey = 'smu1:entry-intro:v2';
        const tabKey = 'smu1:browser-tab:v1';
        const tabNameMarker = '__smu1_browser_tab_v1__:';
        const ttl = 20000;
        const labelLimit = 80;
        const exactTarget = `${window.location.pathname}${window.location.search}${window.location.hash}`;
        let state = 'static';
        let reason = 'no-token';
        const sanitizeLabel = (value) => Array.from(
          String(value ?? '')
            .replace(/[\u0000-\u001f\u007f]/g, ' ')
            .replace(/\s+/g, ' ')
            .trim()
        ).slice(0, labelLimit).join('');

        try {
          // sessionStorage can be cloned into a newly opened tab. window.name
          // is browsing-context-local, so their matching IDs distinguish a
          // same-tab MPA/reload from a cloned session. Preserve an unrelated
          // name as a prefix instead of replacing it.
          const markerPattern = /(?:^|\|)__smu1_browser_tab_v1__:([a-z\d-]+)$/i;
          const currentName = String(window.name || '');
          const nameMatch = currentName.match(markerPattern);
          const nameId = nameMatch ? nameMatch[1] : '';
          const storedId = window.sessionStorage.getItem(tabKey) || '';
          if (!nameId || nameId !== storedId) {
            let tabId = '';
            try {
              tabId = typeof crypto.randomUUID === 'function'
                ? crypto.randomUUID()
                : `${Date.now().toString(36)}-${Math.random().toString(36).slice(2)}`;
            } catch {
              tabId = `${Date.now().toString(36)}-${Math.random().toString(36).slice(2)}`;
            }
            const preservedName = currentName.replace(markerPattern, '');
            window.name = `${preservedName}${preservedName ? '|' : ''}${tabNameMarker}${tabId}`;
            window.sessionStorage.setItem(tabKey, tabId);
            window.sessionStorage.removeItem(entryKey);
            window.sessionStorage.removeItem(key);
          }

          const raw = window.sessionStorage.getItem(key);
          if (raw) {
            // Invalid and mismatched records are one-shot as well. Removing
            // them prevents an unrelated later navigation from accepting a
            // token which was not created for that navigation.
            window.sessionStorage.removeItem(key);
            try {
              const token = JSON.parse(raw);
              const age = Date.now() - Number(token && token.timestamp);
              const validShape = token
                && token.version === 1
                && typeof token.nonce === 'string'
                && token.nonce.length > 0
                && typeof token.target === 'string'
                && Number.isFinite(age);

              if (!validShape) {
                state = 'skipped';
                reason = 'invalid-token';
              } else if (age < -1000 || age > ttl) {
                state = 'skipped';
                reason = 'stale-token';
              } else if (token.target !== exactTarget) {
                state = 'skipped';
                reason = 'target-mismatch';
              } else if (typeof token.label !== 'string' || !sanitizeLabel(token.label)) {
                state = 'skipped';
                reason = 'invalid-label';
              } else {
                state = 'arrival';
                reason = 'valid-token';
                root.dataset.v2PageTransitionLabel = sanitizeLabel(token.label);
              }
            } catch {
              state = 'skipped';
              reason = 'invalid-token';
            }
          }
        } catch {
          state = 'fail-open';
          reason = 'storage-error';
        }

        root.dataset.v2PageBootstrap = state;
        root.dataset.v2PageBootstrapReason = reason;
        root.dataset.v2PageState = state;

        if (state === 'arrival') {
          // The body overlay has not been parsed yet. Create the same drawing
          // now so even a progressive first paint contains the target label.
          // The body handoff replaces it atomically, and both labels are set
          // exclusively through textContent.
          const bootstrapOverlay = document.createElement('div');
          const bootstrapShell = document.createElement('div');
          const bootstrapLabel = document.createElement('p');
          bootstrapOverlay.className = 'v2-page-transition-bootstrap';
          bootstrapOverlay.dataset.v2PageBootstrapOverlay = '';
          bootstrapOverlay.setAttribute('aria-hidden', 'true');
          bootstrapOverlay.inert = true;
          bootstrapShell.className = 'v2-page-transition-bootstrap__shell';
          bootstrapLabel.className = 'v2-page-transition-bootstrap__label';
          bootstrapLabel.textContent = root.dataset.v2PageTransitionLabel || '';
          bootstrapShell.append(bootstrapLabel);
          bootstrapOverlay.append(bootstrapShell);
          root.append(bootstrapOverlay);

          window.__smu1PageTransitionFailSafe = window.setTimeout(() => {
            const current = root.dataset.v2PageState;
            if (root.dataset.v2PageBootstrap !== 'arrival'
              || (current !== 'arrival' && current !== 'waiting')) return;

            root.dataset.v2PageBootstrap = 'fail-open';
            root.dataset.v2PageBootstrapReason = 'controller-timeout';
            root.dataset.v2PageState = 'fail-open';
            root.classList.remove('v2-page-transition-locked');
            delete root.dataset.v2PageLock;
            document.querySelector('[data-v2-page-bootstrap-overlay]')?.remove();
            const overlay = document.querySelector('[data-v2-page-transition]');
            if (overlay instanceof HTMLElement) {
              overlay.dataset.v2PageState = 'fail-open';
              overlay.dataset.v2PageFailure = 'controller-timeout';
              overlay.dataset.v2PageSettled = 'true';
              delete overlay.dataset.v2PageLock;
            }
            document.dispatchEvent(new CustomEvent('v2:page-revealing', {
              detail: { state: 'fail-open', reason: 'controller-timeout' }
            }));
            document.dispatchEvent(new CustomEvent('v2:page-done', {
              detail: { state: 'fail-open', reason: 'controller-timeout' }
            }));
          }, 1600);
        }
      })();
    </script>
  </>
) : (
  <div
    class="v2-page-transition"
    data-v2-page-transition
    data-v2-page-state="idle"
    data-v2-page-base={basePath}
    data-v2-page-allow-design-lab={allowDesignLab ? 'true' : undefined}
    aria-hidden="true"
    inert
  >
    <div class="v2-page-transition__sheet" data-v2-page-sheet>
      <div class="v2-page-transition__shell">
        <p class="v2-page-transition__label" data-v2-page-label>
          <script is:inline>
            (() => {
              const current = document.currentScript;
              const label = current instanceof HTMLScriptElement ? current.parentElement : null;
              if (!(label instanceof HTMLElement)) return;
              const value = Array.from(
                String(document.documentElement.dataset.v2PageTransitionLabel || '')
                  .replace(/[\u0000-\u001f\u007f]/g, ' ')
                  .replace(/\s+/g, ' ')
                  .trim()
              ).slice(0, 80).join('');
              label.textContent = value;
              const bootstrapOverlay = document.querySelector('[data-v2-page-bootstrap-overlay]');
              if (value) document.documentElement.dataset.v2PageOverlayReady = 'true';
              bootstrapOverlay?.remove();
            })();
          </script>
        </p>
      </div>
      <span
        class="v2-page-transition__trail v2-page-transition__trail--cover"
        data-v2-page-trail="cover"
      ></span>
      <span
        class="v2-page-transition__edge v2-page-transition__edge--cover"
        data-v2-page-edge="cover"
      ></span>
      <span
        class="v2-page-transition__trail v2-page-transition__trail--reveal"
        data-v2-page-trail="reveal"
      ></span>
      <span
        class="v2-page-transition__edge v2-page-transition__edge--reveal"
        data-v2-page-edge="reveal"
      ></span>
    </div>
  </div>
)}
