---
import DirectionV2Brief from '../directions/DirectionV2Brief.astro';
import DirectionV2FinalCTA from '../directions/DirectionV2FinalCTA.astro';
import DirectionV2Gallery from '../directions/DirectionV2Gallery.astro';
import ImmersiveDirectionHero from '../directions/ImmersiveDirectionHero.astro';
import DirectionV2Layout from '../directions/DirectionV2Layout.astro';
import DirectionV2Related from '../directions/DirectionV2Related.astro';
import DirectionV2Scope from '../directions/DirectionV2Scope.astro';
import DirectionV2Types from '../directions/DirectionV2Types.astro';
import {
  getDirectionBlock,
  getDirectionCardItems,
  getDirectionGalleryImages,
  getDirectionListItems,
  loadDirectionV2Snapshot
} from '../directions/directionV2Data';
import {
  approvedMediaUntilEdited
} from '../directions/directionV2Presentation';
import {
  directionPresentationBinding,
  directionRelatedRelationsBinding,
  directionRelatedItems,
  directionSectionNavItems,
  requireDirectionPresentation
} from '../directions/directionPresentation';
import V2HeroHandoff from '../V2HeroHandoff.astro';
import V2SectionNav from '../V2SectionNav.astro';
import { adminBinding } from '../../../admin/bindings/adminBinding';

const currentPath = Astro.url.pathname;
const data = await loadDirectionV2Snapshot({
  sectionSlug: 'navesy-i-kozyrki',
  catalogCategorySlug: 'navesy'
});
const { section, catalogCategory, catalogProducts, catalog, services } = data;
const presentation = requireDirectionPresentation(section);
const owner = { collection: 'product-sections' as const, slug: section.slug };
const route = `/${section.slug}/`;
const presentationBinding = (fieldPath: string, tool = 'short-text') =>
  directionPresentationBinding(Astro.url, owner, route, fieldPath, tool);
const typesBlock = getDirectionBlock(section, 'cardGrid');
const scopeBlock = getDirectionBlock(section, 'listPanel');
const types = getDirectionCardItems(typesBlock);
const scope = getDirectionListItems(scopeBlock);
const galleryImages = getDirectionGalleryImages(catalogProducts);
const galleryMediaSources = catalogProducts
  .filter((product) => Array.isArray(product.gallery) && product.gallery.length > 0)
  .map((product) => ({ owner: { collection: 'products', slug: product.slug }, fieldPath: 'gallery' }));
const briefInputs = (presentation.brief.items ?? [])
  .filter((item) => item.isActive !== false)
  .slice()
  .sort((left, right) => left.order - right.order)
  .map((item) => item.label);
const approvedHeroImage = catalogCategory?.image?.trim() || galleryImages[0] || '';
const heroMedia = approvedMediaUntilEdited(
  section.image,
  '/uploads/2026-03-08-221112-1777541397642.png',
  approvedHeroImage
);
const heroImage = heroMedia.src;
const heroImageView = heroMedia.usesApprovedBaseline
  ? (catalogCategory?.imageView
    ? { ...catalogCategory.imageView, fit: 'contain' as const }
    : { fit: 'contain' as const, positionX: 50, positionY: 50, scale: 1 })
  : (section.imageView || { fit: 'cover' as const, positionX: 50, positionY: 50, scale: 1 });
const directionTitle = section.title;
const heroKicker = section.heroKicker || section.title;
const heroTitle = section.heroTitle;
const heroDescription = section.heroDescription;
const contactTitle = section.contactTitle || '';
const contactDescription = section.contactDescription || '';
const telegramLabel = section.contactTelegramLabel || '';
const phoneLabel = section.contactPhoneLabel || '';
const emailLabel = section.contactEmailLabel || '';
const related = directionRelatedItems(Astro.url, owner, route, presentation, catalog, services);
const availableSectionIds = [
  ...(galleryImages.length > 0 ? ['direction-gallery'] : []),
  ...(types.length > 0 ? ['direction-types'] : []),
  ...(scope.length > 0 ? ['direction-scope'] : []),
  ...(briefInputs.length > 0 ? ['direction-brief'] : []),
  'contact'
];
const sectionNavItems = directionSectionNavItems(Astro.url, owner, route, presentation, availableSectionIds);
const blockBinding = (block: unknown, field: 'title' | 'intro' | 'items', tool: string, itemKind?: 'string' | 'object') => {
  const index = section.pageBlocks?.indexOf(block as never) ?? -1;
  if (index < 0) return {};
  const source = block as { sectionId?: string; type?: string; order?: number };
  return adminBinding(Astro.url, {
      renderer: { family: 'direction-block', variant: source.type }, owner: { collection: 'product-sections', slug: section.slug },
      fieldPath: `pageBlocks[${index}].${field}`, stableItemId: `${source.sectionId || `${source.type}-${source.order}`}-${field}`,
      scope: 'local', tool, affectedRoutes: [`/${section.slug}/`], itemKind,
      permissions: itemKind === 'object' ? { edit: true, reorder: true, delete: false } : undefined,
      itemFields: itemKind === 'object' ? [
        { fieldPath: 'id', tool: 'generated-id' },
        { fieldPath: 'ordinal', tool: 'computed', formula: 'Позиция элемента в списке' },
        { fieldPath: 'title', label: 'Название', tool: 'short-text' },
        { fieldPath: 'text', label: 'Описание', tool: 'long-text' },
        { fieldPath: 'order', tool: 'generated-order' },
        { fieldPath: 'isActive', label: 'Показывать карточку', tool: 'visibility' }
      ] : undefined
    });
};
---

<DirectionV2Layout
  title={section.seoTitle}
  description={section.seoDescription}
  canonicalPath={`/${section.slug}/`}
  currentPath={currentPath}
  ogImage={heroImage}
  variant="engineering-visual"
  productFinalHandoff
>
  <V2HeroHandoff enabled>
    <ImmersiveDirectionHero
      variant="canopies"
      breadcrumbs={[
        { title: 'Главная', href: '/design-lab/home-v2/' },
        { title: directionTitle }
      ]}
      eyebrow={heroKicker}
      title={heroTitle}
      description={heroDescription}
      image={heroImage}
      imageAlt={presentation.hero.imageAlt}
      imageView={heroImageView}
      titleId="direction-v2-title"
      primaryLabel={presentation.hero.primaryLabel}
      secondaryHref="#direction-brief"
      secondaryLabel={presentation.hero.secondaryLabel}
      productFinalHandoff
      bindingOwner={{ collection: 'product-sections', slug: section.slug }}
      bindingFields={{ eyebrow: 'heroKicker', title: 'heroTitle', description: 'heroDescription', image: 'image', primaryLabel: 'directionPresentation.hero.primaryLabel', secondaryLabel: 'directionPresentation.hero.secondaryLabel' }}
      affectedRoutes={[`/${section.slug}/`, '/']}
      mediaBinding={heroMedia.usesApprovedBaseline && catalogCategory
        ? { owner: { collection: 'product-categories', slug: catalogCategory.slug }, fieldPath: 'image', scope: 'shared', affectedRoutes: [`/${section.slug}/`, `/ulichnaya-mebel/${catalogCategory.slug}/`] }
        : undefined}
    />
  </V2HeroHandoff>

  <V2SectionNav items={sectionNavItems} label={presentation.sectionNav.label} />

  <DirectionV2Gallery
    eyebrow={presentation.gallery?.eyebrow}
    title={presentation.gallery?.title || ''}
    description={presentation.gallery?.description || ''}
    images={galleryImages}
    galleryTitle={presentation.gallery?.galleryTitle || ''}
    caption={presentation.gallery?.caption || ''}
    presentation="media-led"
    mediaSources={galleryMediaSources}
    editorSource="src/components/v2/pages/CanopiesV2Page.astro#direction-gallery"
    eyebrowBinding={presentationBinding('gallery.eyebrow')}
    titleBinding={presentationBinding('gallery.title', 'heading')}
    descriptionBinding={presentationBinding('gallery.description', 'long-text')}
    galleryTitleBinding={presentationBinding('gallery.galleryTitle')}
    captionBinding={presentationBinding('gallery.caption', 'long-text')}
  />

  <DirectionV2Types
    eyebrow={presentation.types.eyebrow}
    title={presentation.types.title || typesBlock?.title || ''}
    items={types}
    variant="engineering"
    presentation="open"
    eyebrowBinding={presentationBinding('types.eyebrow')}
    titleBinding={presentation.types.title ? presentationBinding('types.title', 'heading') : blockBinding(typesBlock, 'title', 'heading')}
    itemsBinding={blockBinding(typesBlock, 'items', 'list', 'object')}
  />

  <DirectionV2Scope
    eyebrow={presentation.scope.eyebrow}
    title={scopeBlock?.title || 'Для каких объектов'}
    items={scope}
    variant="engineering"
    presentation="open"
    titleBinding={blockBinding(scopeBlock, 'title', 'heading')}
    eyebrowBinding={presentationBinding('scope.eyebrow')}
    itemsBinding={blockBinding(scopeBlock, 'items', 'list', 'string')}
  />

  <DirectionV2Related
    eyebrow={presentation.related.eyebrow}
    title={presentation.related.title}
    items={related}
    relationsBinding={directionRelatedRelationsBinding(Astro.url, owner, route)}
    presentation="links"
    eyebrowBinding={presentationBinding('related.eyebrow')}
    titleBinding={presentationBinding('related.title', 'heading')}
  />

  <DirectionV2Brief
    eyebrow={presentation.brief.eyebrow}
    title={presentation.brief.title || ''}
    description={presentation.brief.description || ''}
    items={briefInputs}
    variant="engineering"
    integrated
    eyebrowBinding={presentationBinding('brief.eyebrow')}
    titleBinding={presentationBinding('brief.title', 'heading')}
    descriptionBinding={presentationBinding('brief.description', 'long-text')}
    itemsBinding={presentationBinding('brief.items', 'ordered-label-list')}
  >
    <DirectionV2FinalCTA
      title={contactTitle}
      description={contactDescription}
      primaryLabel={telegramLabel}
      secondaryLabel={phoneLabel}
      telegramChannelLabel="Telegram"
      eyebrow={presentation.contactEyebrow}
      phoneChannelLabel={presentation.contactPhoneChannelLabel}
      emailChannelLabel={emailLabel}
      bindingOwner={{ collection: 'product-sections', slug: section.slug }}
      bindingFields={{ eyebrow: 'directionPresentation.contactEyebrow', title: 'contactTitle', description: 'contactDescription', primaryLabel: 'contactTelegramLabel', secondaryLabel: 'contactPhoneLabel', phoneChannelLabel: 'directionPresentation.contactPhoneChannelLabel' }}
      affectedRoutes={[`/${section.slug}/`]}
    />
  </DirectionV2Brief>
</DirectionV2Layout>
