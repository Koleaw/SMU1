---
import DirectionV2FinalCTA from '../directions/DirectionV2FinalCTA.astro';
import ImmersiveDirectionHero from '../directions/ImmersiveDirectionHero.astro';
import DirectionV2Related from '../directions/DirectionV2Related.astro';
import {
  getDirectionCardItems,
  getDirectionListItems
} from '../directions/directionV2Data';
import {
  approvedMediaUntilEdited
} from '../directions/directionV2Presentation';
import {
  directionPresentationBinding,
  directionRelatedItems,
  directionSectionNavItems,
  requireDirectionPresentation
} from '../directions/directionPresentation';
import ProjectDirectionBrief from '../project/ProjectDirectionBrief.astro';
import ProjectDirectionContexts from '../project/ProjectDirectionContexts.astro';
import ProjectDirectionProof from '../project/ProjectDirectionProof.astro';
import ProjectDirectionScope from '../project/ProjectDirectionScope.astro';
import ProjectDirectionV2Layout from '../project/ProjectDirectionV2Layout.astro';
import {
  getProjectDirectionBlock,
  getProjectDirectionBlocks,
  loadProjectDirectionV2Snapshot,
  selectProject
} from '../project/projectDirectionV2Data';
import {
  selectV2ProjectMedia,
  selectV2ProjectMediaItems
} from '../mediaRoleAdapter';
import V2SectionNav from '../V2SectionNav.astro';
import { adminBinding } from '../../../admin/bindings/adminBinding';

const currentPath = Astro.url.pathname;
const data = await loadProjectDirectionV2Snapshot('stroitelstvo-i-remonty');
const { service, projects, catalog, services } = data;
const presentation = requireDirectionPresentation(service);
const owner = { collection: 'services' as const, slug: service.slug };
const route = `/${service.slug}/`;
const presentationBinding = (fieldPath: string, tool = 'short-text') =>
  directionPresentationBinding(Astro.url, owner, route, fieldPath, tool);
const pageBlocks = getProjectDirectionBlocks(service);
const blockSectionId = (block: unknown) => (block as { sectionId?: string } | undefined)?.sectionId;
const blockIntro = (block: unknown) => (block as { intro?: string } | undefined)?.intro?.trim() || '';
const worksBlock = pageBlocks.find((block) => blockSectionId(block) === 'construction-scope')
  || getProjectDirectionBlock(service, 'cardGrid');
const contextsBlock = pageBlocks.find((block) => blockSectionId(block) === 'construction-contexts')
  || getProjectDirectionBlock(service, 'listPanel');
const briefBlock = pageBlocks.find((block) => blockSectionId(block) === 'construction-brief');
const works = getDirectionCardItems(worksBlock).map(({ title, text }) => ({ title, text }));
const contexts = getDirectionListItems(contextsBlock);
const briefInputs = getDirectionListItems(briefBlock);

const industrial = selectProject(projects, 'kompleks-rabot-na-proizvodstvennoy-territorii');
const squareRepair = selectProject(projects, 'remont-skvera-na-ulitse-gogolya');
const approvedIndustrialHero = selectV2ProjectMedia(industrial, {
  allOf: ['construction-building', 'finished-result', 'hero']
})[0] || '';
const industrialProofMedia = selectV2ProjectMediaItems(industrial, {
  allOf: ['construction-building', 'finished-result', 'proof']
});
const resolvedHeroMedia = approvedMediaUntilEdited(
  service.image,
  '/assets/images/placeholders/construction.svg',
  approvedIndustrialHero
);
const industrialHero = resolvedHeroMedia.src;
const directionTitle = service.title;
const heroKicker = service.heroKicker || service.title;
const heroTitle = service.heroTitle;
const heroDescription = service.heroDescription;
const contactTitle = service.contactTitle || '';
const contactDescription = service.contactDescription || '';
const telegramLabel = service.contactTelegramLabel || '';
const phoneLabel = service.contactPhoneLabel || '';
const emailLabel = service.contactEmailLabel || '';
const telegramChannelLabel = ['Написать в Telegram', 'Получить расчёт'].includes(service.contactTelegramLabel || '')
  ? 'Telegram'
  : (service.contactTelegramLabel || 'Telegram');
const supportingProjects = [
  squareRepair ? {
    title: squareRepair.title,
    city: squareRepair.city,
    year: squareRepair.year,
    description: squareRepair.whatWasDone?.trim() || squareRepair.shortDescription,
    href: `/design-lab/v2/vypolnennye-obekty/${squareRepair.slug}/`,
    editor: {
      owner: { collection: 'projects', slug: squareRepair.slug },
      descriptionField: squareRepair.whatWasDone?.trim() ? 'whatWasDone' as const : 'shortDescription' as const,
      affectedRoutes: [
        `/${service.slug}/`,
        `/vypolnennye-obekty/${squareRepair.slug}/`,
        '/vypolnennye-obekty/'
      ]
    }
  } : null
].filter((item): item is NonNullable<typeof item> => Boolean(item));

const related = directionRelatedItems(Astro.url, owner, route, presentation, catalog, services);
const constructionFeatureIndex = industrialProofMedia.findIndex((item) => item.src === approvedIndustrialHero);
const sectionNavItems = directionSectionNavItems(Astro.url, owner, route, presentation, [
  ...(industrial && industrialProofMedia.length > 0 ? ['construction-proof'] : []),
  ...(works.length > 0 ? ['construction-scope'] : []),
  ...(contexts.length > 0 ? ['construction-contexts'] : []),
  ...(briefInputs.length > 0 ? ['construction-brief'] : []),
  'contact'
]);
const blockBinding = (block: unknown, field: 'title' | 'intro' | 'items', tool: string, itemKind?: 'string' | 'object') => {
  const index = service.pageBlocks?.indexOf(block as never) ?? -1;
  if (index < 0) return {};
  const source = block as { sectionId?: string; type?: string; order?: number };
  return adminBinding(Astro.url, {
    renderer: { family: 'direction-block', variant: source.type }, owner: { collection: 'services', slug: service.slug },
    fieldPath: `pageBlocks[${index}].${field}`, stableItemId: `${source.sectionId || `${source.type}-${source.order}`}-${field}`,
    scope: 'local', tool, affectedRoutes: [`/${service.slug}/`], itemKind
  });
};
---

<ProjectDirectionV2Layout
  title={service.seoTitle}
  description={service.seoDescription}
  canonicalPath={`/${service.slug}/`}
  currentPath={currentPath}
  ogImage={industrialHero}
  variant="construction"
>
  <ImmersiveDirectionHero
    variant="construction"
    breadcrumbs={[
      { title: 'Главная', href: '/design-lab/home-v2/' },
      { title: directionTitle }
    ]}
    eyebrow={heroKicker}
    title={heroTitle}
    description={heroDescription}
    image={industrialHero}
    imageAlt={resolvedHeroMedia.usesApprovedBaseline ? presentation.hero.imageAlt : directionTitle}
    imageView={resolvedHeroMedia.usesApprovedBaseline
      ? { fit: 'cover', positionX: 50, positionY: 48, scale: 1 }
      : service.imageView}
    titleId="project-direction-title"
    primaryLabel={presentation.hero.primaryLabel}
    secondaryHref="#construction-proof"
    secondaryLabel={presentation.hero.secondaryLabel}
    bindingOwner={{ collection: 'services', slug: service.slug }}
    bindingFields={{ eyebrow: 'heroKicker', title: 'heroTitle', description: 'heroDescription', image: 'image', primaryLabel: 'directionPresentation.hero.primaryLabel', secondaryLabel: 'directionPresentation.hero.secondaryLabel' }}
    affectedRoutes={[`/${service.slug}/`, '/']}
    mediaBinding={resolvedHeroMedia.usesApprovedBaseline && industrial
      ? { owner: { collection: 'projects', slug: industrial.slug }, fieldPath: 'presentation.detailHeroMedia', scope: 'shared', affectedRoutes: [`/${service.slug}/`, `/vypolnennye-obekty/${industrial.slug}/`, '/vypolnennye-obekty/'], projection: { kind: 'derived', formula: 'project presentation media roles: construction-building + finished-result + hero' } }
      : undefined}
  />

  <V2SectionNav items={sectionNavItems} label={presentation.sectionNav.label} />

  {industrial && industrialProofMedia.length > 0 && (
    <ProjectDirectionProof
      eyebrow={presentation.proof?.eyebrow}
      title={presentation.proof?.title || ''}
      proofDescription={presentation.proof?.description}
      linkLabel={presentation.proof?.linkLabel}
      supportingLinkLabel={presentation.proof?.supportingLinkLabel}
      featured={{
        title: industrial.title,
        city: industrial.city,
        year: industrial.year,
        description: industrial.whatWasDone?.trim() || industrial.shortDescription,
        href: `/design-lab/v2/vypolnennye-obekty/${industrial.slug}/`,
        images: industrialProofMedia,
        featureIndex: constructionFeatureIndex >= 0 ? constructionFeatureIndex : 0,
        editor: {
          owner: { collection: 'projects', slug: industrial.slug },
          descriptionField: industrial.whatWasDone?.trim() ? 'whatWasDone' : 'shortDescription',
          mediaField: 'presentation.mediaRoles',
          mediaFormula: 'project media whose presentation.mediaRoles contain construction-building + finished-result + proof',
          affectedRoutes: [
            `/${service.slug}/`,
            `/vypolnennye-obekty/${industrial.slug}/`,
            '/vypolnennye-obekty/'
          ]
        }
      }}
      supporting={supportingProjects}
      eyebrowBinding={presentationBinding('proof.eyebrow')}
      titleBinding={presentationBinding('proof.title', 'heading')}
      proofDescriptionBinding={presentationBinding('proof.description', 'long-text')}
      linkLabelBinding={presentationBinding('proof.linkLabel', 'link-label')}
      supportingLinkLabelBinding={presentationBinding('proof.supportingLinkLabel', 'link-label')}
      editorSource="src/components/v2/pages/ConstructionV2Page.astro#construction-proof"
    />
  )}

  <ProjectDirectionScope
    eyebrow={presentation.types.eyebrow}
    title={worksBlock?.title || presentation.types.title || ''}
    description={blockIntro(worksBlock) || presentation.types.description || ''}
    items={works}
    featuredFirst
    titleBinding={blockBinding(worksBlock, 'title', 'heading')}
    eyebrowBinding={presentationBinding('types.eyebrow')}
    descriptionBinding={blockBinding(worksBlock, 'intro', 'long-text')}
    itemsBinding={blockBinding(worksBlock, 'items', 'list', 'object')}
  />

  <ProjectDirectionContexts
    eyebrow={presentation.scope.eyebrow}
    title={contextsBlock?.title || presentation.scope.title || ''}
    items={contexts}
    titleBinding={blockBinding(contextsBlock, 'title', 'heading')}
    eyebrowBinding={presentationBinding('scope.eyebrow')}
    itemsBinding={blockBinding(contextsBlock, 'items', 'list', 'string')}
  />

  <ProjectDirectionBrief
    eyebrow={presentation.brief.eyebrow}
    title={briefBlock?.title || presentation.brief.title || ''}
    description={blockIntro(briefBlock) || presentation.brief.description || ''}
    items={briefInputs}
    titleBinding={blockBinding(briefBlock, 'title', 'heading')}
    eyebrowBinding={presentationBinding('brief.eyebrow')}
    descriptionBinding={blockBinding(briefBlock, 'intro', 'long-text')}
    itemsBinding={blockBinding(briefBlock, 'items', 'list', 'string')}
  />

  <DirectionV2Related
    eyebrow={presentation.related.eyebrow}
    title={presentation.related.title}
    items={related}
    variant="compact"
    presentation="links"
    eyebrowBinding={presentationBinding('related.eyebrow')}
    titleBinding={presentationBinding('related.title', 'heading')}
  />

  <DirectionV2FinalCTA
    title={contactTitle}
    description={contactDescription}
    primaryLabel={telegramLabel}
    secondaryLabel={phoneLabel}
    telegramChannelLabel={telegramChannelLabel}
    eyebrow={presentation.contactEyebrow}
    phoneChannelLabel={presentation.contactPhoneChannelLabel}
    emailChannelLabel={emailLabel}
    bindingOwner={{ collection: 'services', slug: service.slug }}
    bindingFields={{ eyebrow: 'directionPresentation.contactEyebrow', title: 'contactTitle', description: 'contactDescription', primaryLabel: 'contactTelegramLabel', secondaryLabel: 'contactPhoneLabel', phoneChannelLabel: 'directionPresentation.contactPhoneChannelLabel' }}
    affectedRoutes={[`/${service.slug}/`]}
  />
</ProjectDirectionV2Layout>
