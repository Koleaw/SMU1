---
import DirectionV2FinalCTA from '../directions/DirectionV2FinalCTA.astro';
import ImmersiveDirectionHero from '../directions/ImmersiveDirectionHero.astro';
import DirectionV2Related from '../directions/DirectionV2Related.astro';
import {
  getDirectionBlock,
  getDirectionCardItems,
  getDirectionListItems,
  getDirectionStepItems
} from '../directions/directionV2Data';
import {
  approvedMediaUntilEdited
} from '../directions/directionV2Presentation';
import {
  directionPresentationBinding,
  directionRelatedRelationsBinding,
  directionRelatedItems,
  directionSectionNavItems,
  requireDirectionPresentation
} from '../directions/directionPresentation';
import EngineeringDirectionBrief from '../engineering/EngineeringDirectionBrief.astro';
import EngineeringDirectionProof from '../engineering/EngineeringDirectionProof.astro';
import EngineeringDirectionScope from '../engineering/EngineeringDirectionScope.astro';
import EngineeringDirectionTasks from '../engineering/EngineeringDirectionTasks.astro';
import EngineeringDirectionV2Layout from '../engineering/EngineeringDirectionV2Layout.astro';
import { loadEngineeringDirectionV2Snapshot } from '../engineering/engineeringDirectionV2Data';
import { selectV2ProjectMedia } from '../mediaRoleAdapter';
import V2SectionNav from '../V2SectionNav.astro';
import { adminBinding } from '../../../admin/bindings/adminBinding';

const currentPath = Astro.url.pathname;
const proofProjectSlug = 'kompleks-rabot-na-proizvodstvennoy-territorii';
const data = await loadEngineeringDirectionV2Snapshot({
  sectionSlug: 'metallokonstruktsii-dlya-biznesa',
  proofProjectSlug
});
const { section, catalog, services, proofProject } = data;
const presentation = requireDirectionPresentation(section);
const owner = { collection: 'product-sections' as const, slug: section.slug };
const route = `/${section.slug}/`;
const presentationBinding = (fieldPath: string, tool = 'short-text') =>
  directionPresentationBinding(Astro.url, owner, route, fieldPath, tool);
const typesBlock = getDirectionBlock(section, 'cardGrid');
const scopeBlock = getDirectionBlock(section, 'listPanel');
const inputBlock = getDirectionBlock(section, 'process');
const getBlockIntro = (block: { intro?: unknown; text?: string } | undefined) => {
  const intro = typeof block?.intro === 'string' ? block.intro.trim() : '';
  return intro || block?.text?.trim() || '';
};
const tasks = getDirectionCardItems(typesBlock).map(({ id, title, text }) => ({ id, title, text }));
const scope = getDirectionListItems(scopeBlock);
const briefInputs = getDirectionStepItems(inputBlock);
const approvedHeroImage = selectV2ProjectMedia(proofProject, {
  allOf: ['metalworks', 'hero']
})[0] || '';
const proofImages = selectV2ProjectMedia(proofProject, {
  allOf: ['metalworks', 'proof']
});
const heroMedia = approvedMediaUntilEdited(
  section.image,
  '/uploads/chatgpt-image-5-2026-22-01-29-1783278108067.png',
  approvedHeroImage
);
const heroImage = heroMedia.src;
const heroImageView = heroMedia.usesApprovedBaseline
  ? { fit: 'cover' as const, positionX: 50, positionY: 48, scale: 1 }
  : (section.imageView || { fit: 'cover' as const, positionX: 50, positionY: 50, scale: 1 });
const directionTitle = section.title;
const heroKicker = section.heroKicker || section.title;
const heroTitle = section.heroTitle;
const heroDescription = section.heroDescription;
const tasksDescription = getBlockIntro(typesBlock) || presentation.types.description || '';
const scopeDescription = getBlockIntro(scopeBlock) || presentation.scope.description || '';
const briefDescription = getBlockIntro(inputBlock) || presentation.brief.description || '';
const contactTitle = section.contactTitle || '';
const contactDescription = section.contactDescription || '';
const telegramLabel = section.contactTelegramLabel || '';
const phoneLabel = section.contactPhoneLabel || '';
const emailLabel = section.contactEmailLabel || '';
const proofDescriptionField = proofProject?.whatWasDone?.trim() ? 'whatWasDone' : 'shortDescription';
const telegramChannelLabel = ['Написать в Telegram', 'Получить расчёт'].includes(section.contactTelegramLabel || '')
  ? 'Telegram'
  : (section.contactTelegramLabel || 'Telegram');
const related = directionRelatedItems(Astro.url, owner, route, presentation, catalog, services);
const sectionNavItems = directionSectionNavItems(Astro.url, owner, route, presentation, [
  ...(proofProject && proofImages.length > 0 ? ['engineering-proof'] : []),
  ...(tasks.length > 0 ? ['engineering-tasks'] : []),
  ...(scope.length > 0 ? ['engineering-scope'] : []),
  ...(briefInputs.length > 0 ? ['engineering-brief'] : []),
  'contact'
]);
const blockBinding = (block: unknown, field: 'title' | 'intro' | 'items' | 'steps', tool: string, itemKind?: 'string' | 'object') => {
  const index = section.pageBlocks?.indexOf(block as never) ?? -1;
  if (index < 0) return {};
  const source = block as { sectionId?: string; type?: string; order?: number };
  return adminBinding(Astro.url, {
      renderer: { family: 'direction-block', variant: source.type }, owner: { collection: 'product-sections', slug: section.slug },
      fieldPath: `pageBlocks[${index}].${field}`, stableItemId: `${source.sectionId || `${source.type}-${source.order}`}-${field}`,
      scope: 'local', tool, affectedRoutes: [`/${section.slug}/`], itemKind,
      permissions: itemKind === 'object' ? { edit: true, reorder: true, delete: false } : undefined,
      itemFields: itemKind === 'object' ? [
        { fieldPath: 'id', tool: 'generated-id' },
        { fieldPath: 'title', label: 'Название', tool: 'short-text' },
        ...(field === 'items' ? [{ fieldPath: 'text', label: 'Описание', tool: 'long-text' as const }] : []),
        { fieldPath: 'order', tool: 'generated-order' },
        { fieldPath: 'isActive', label: 'Показывать карточку', tool: 'visibility' }
      ] : undefined
    });
};
---

<EngineeringDirectionV2Layout
  title={section.seoTitle}
  description={section.seoDescription}
  canonicalPath={`/${section.slug}/`}
  currentPath={currentPath}
  ogImage={heroImage}
  variant="metalworks"
>
  <ImmersiveDirectionHero
    variant="metalworks"
    breadcrumbs={[
      { title: 'Главная', href: '/design-lab/home-v2/' },
      { title: directionTitle }
    ]}
    eyebrow={heroKicker}
    title={heroTitle}
    description={heroDescription}
    image={heroImage}
    imageAlt={heroMedia.usesApprovedBaseline ? presentation.hero.imageAlt : directionTitle}
    imageView={heroImageView}
    titleId="engineering-direction-title"
    primaryLabel={presentation.hero.primaryLabel}
    secondaryHref="#engineering-proof"
    secondaryLabel={presentation.hero.secondaryLabel}
    bindingOwner={{ collection: 'product-sections', slug: section.slug }}
    bindingFields={{ eyebrow: 'heroKicker', title: 'heroTitle', description: 'heroDescription', image: 'image', primaryLabel: 'directionPresentation.hero.primaryLabel', secondaryLabel: 'directionPresentation.hero.secondaryLabel' }}
    affectedRoutes={[`/${section.slug}/`, '/']}
    mediaBinding={heroMedia.usesApprovedBaseline && proofProject
      ? { owner: { collection: 'projects', slug: proofProject.slug }, fieldPath: 'presentation.detailHeroMedia', scope: 'shared', affectedRoutes: [`/${section.slug}/`, `/vypolnennye-obekty/${proofProject.slug}/`, '/vypolnennye-obekty/'], projection: { kind: 'derived', formula: 'project presentation media roles: metalworks + hero' } }
      : undefined}
    editorSource="src/components/v2/pages/MetalworksV2Page.astro#hero"
  />

  <V2SectionNav
    items={sectionNavItems}
    label={presentation.sectionNav.label}
    editorSource="src/components/v2/pages/MetalworksV2Page.astro#sectionNavItems"
  />

  {proofProject && proofImages.length > 0 && (
    <EngineeringDirectionProof
      title={proofProject.title}
      city={proofProject.city}
      year={proofProject.year}
      description={proofProject.whatWasDone?.trim() || proofProject.shortDescription}
      href={`/design-lab/v2/vypolnennye-obekty/${proofProject.slug}/`}
      images={proofImages}
      featureIndex={1}
      bindingOwner={{ collection: 'projects', slug: proofProject.slug }}
      bindingFields={{
        title: 'title',
        city: 'city',
        year: 'year',
        description: proofDescriptionField,
        images: 'presentation.mediaRoles'
      }}
      bindingScope="shared"
      affectedRoutes={[
        `/${section.slug}/`,
        `/vypolnennye-obekty/${proofProject.slug}/`,
        '/vypolnennye-obekty/'
      ]}
      editorSource="src/components/v2/pages/MetalworksV2Page.astro#proofProject"
      eyebrow={presentation.proof?.eyebrow}
      linkLabel={presentation.proof?.linkLabel}
      eyebrowBinding={presentationBinding('proof.eyebrow')}
      linkLabelBinding={presentationBinding('proof.linkLabel', 'link-label')}
    />
  )}

  <EngineeringDirectionTasks
    eyebrow={presentation.types.eyebrow}
    title={typesBlock?.title || presentation.types.title || ''}
    description={tasksDescription}
    items={tasks}
    titleBinding={blockBinding(typesBlock, 'title', 'heading')}
    eyebrowBinding={presentationBinding('types.eyebrow')}
    descriptionBinding={blockBinding(typesBlock, 'intro', 'long-text')}
    itemsBinding={blockBinding(typesBlock, 'items', 'list', 'object')}
    editorSource="src/content/product-sections/metallokonstruktsii-dlya-biznesa.json#pageBlocks[cardGrid]"
  />

  <EngineeringDirectionScope
    eyebrow={presentation.scope.eyebrow}
    title={scopeBlock?.title || presentation.scope.title || ''}
    description={scopeDescription}
    items={scope}
    titleBinding={blockBinding(scopeBlock, 'title', 'heading')}
    eyebrowBinding={presentationBinding('scope.eyebrow')}
    descriptionBinding={blockBinding(scopeBlock, 'intro', 'long-text')}
    itemsBinding={blockBinding(scopeBlock, 'items', 'list', 'string')}
    editorSource="src/content/product-sections/metallokonstruktsii-dlya-biznesa.json#pageBlocks[listPanel:first]"
  />

  <EngineeringDirectionBrief
    eyebrow={presentation.brief.eyebrow}
    title={inputBlock?.title || presentation.brief.title || ''}
    description={briefDescription}
    items={briefInputs}
    titleBinding={blockBinding(inputBlock, 'title', 'heading')}
    eyebrowBinding={presentationBinding('brief.eyebrow')}
    descriptionBinding={blockBinding(inputBlock, 'intro', 'long-text')}
    itemsBinding={blockBinding(inputBlock, 'steps', 'list', 'object')}
    editorSource="src/content/product-sections/metallokonstruktsii-dlya-biznesa.json#pageBlocks[process]"
  />

  <DirectionV2Related
    eyebrow={presentation.related.eyebrow}
    title={presentation.related.title}
    items={related}
    relationsBinding={directionRelatedRelationsBinding(Astro.url, owner, route)}
    variant="compact"
    presentation="links"
    editorSource="src/components/v2/pages/MetalworksV2Page.astro#related"
    eyebrowBinding={presentationBinding('related.eyebrow')}
    titleBinding={presentationBinding('related.title', 'heading')}
  />

  <DirectionV2FinalCTA
    title={contactTitle}
    description={contactDescription}
    primaryLabel={telegramLabel}
    secondaryLabel={phoneLabel}
    telegramChannelLabel={telegramChannelLabel}
    eyebrow={presentation.contactEyebrow}
    phoneChannelLabel={presentation.contactPhoneChannelLabel}
    emailChannelLabel={emailLabel}
    bindingOwner={{ collection: 'product-sections', slug: section.slug }}
    bindingFields={{ eyebrow: 'directionPresentation.contactEyebrow', title: 'contactTitle', description: 'contactDescription', primaryLabel: 'contactTelegramLabel', secondaryLabel: 'contactPhoneLabel', emailChannelLabel: 'contactEmailLabel', phoneChannelLabel: 'directionPresentation.contactPhoneChannelLabel' }}
    affectedRoutes={[`/${section.slug}/`]}
    editorSource="src/components/v2/pages/MetalworksV2Page.astro#finalCta"
  />
</EngineeringDirectionV2Layout>
