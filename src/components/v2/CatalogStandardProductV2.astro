---
import { v2Href as resolveV2Href } from '../../utils/v2Routes';
const withBase = (value: string) => resolveV2Href(value, Astro.url.pathname);
import settings from '../../content/site-settings/global.json';
import CatalogV2Layout from './CatalogV2Layout.astro';
import V2Breadcrumbs from './V2Breadcrumbs.astro';
import V2ProductGallery from './V2ProductGallery.astro';
import V2ProductCard from './V2ProductCard.astro';
import V2DirectContact from './V2DirectContact.astro';
import V2HeroHandoff from './V2HeroHandoff.astro';
import V2SectionNav from './V2SectionNav.astro';
import { adminBinding, adminListField, adminListItem, isLocalAdminCanvas } from '../../admin/bindings/adminBinding';
import {
  catalogV2CategoryHref,
  catalogV2ProductHref,
  cleanTextItems,
  formatProductPrice,
  productGalleryImages,
  publicCatalogCopy,
  type CatalogProductRoute,
  type CatalogV2Links
} from './catalogV2Data';

interface Props {
  route: CatalogProductRoute;
  relatedProducts: CatalogProductRoute[];
  links: CatalogV2Links;
  currentPath: string;
}

// Compact product presentation used for ordinary catalogue items.

const { route, relatedProducts, links, currentPath } = Astro.props as Props;
const { section, category, product } = route;
const editorCanvas = isLocalAdminCanvas(Astro.url);
const standardTemplateProduct = { ...product, presentationType: 'standard' as const };
const premiumTemplateProduct = { ...product, presentationType: 'premium' as const };
const images = productGalleryImages(product);
const publicTextItems = (items: unknown) => cleanTextItems(items)
  .map((item) => publicCatalogCopy(item))
  .filter(Boolean);
const materials = publicTextItems(product.materials);
const colors = publicTextItems(product.colors);
const features = publicTextItems(product.features);
const customizationItems = publicTextItems(product.customizationItems);
const dimensions = Array.isArray(product.dimensions)
  ? product.dimensions
      .map((item, sourceIndex) => ({ ...item, sourceIndex }))
      .filter((item) => item?.isActive !== false && (item?.label?.trim() || item?.value?.trim()))
      .slice()
      .sort((a, b) => (a.order ?? 0) - (b.order ?? 0))
  : [];
const genericSpecLabels = new Set([
  'размеры и характеристики',
  'размеры',
  'характеристики'
]);
const normalizedSpecs = dimensions.map((item) => {
  const label = item.label?.trim() || '';
  const values = (item.value || '').split(/\n+/).map((line) => line.trim()).filter(Boolean);
  const isGenericLabel = genericSpecLabels.has(label.toLocaleLowerCase('ru-RU'));
  const isPair = Boolean(label && values.length > 0 && !isGenericLabel);
  return { id: item.id, label, values, isGenericLabel, isPair, sourceIndex: item.sourceIndex };
});
const pairedSpecs = normalizedSpecs.filter((item) => item.isPair);
const textualSpecs = normalizedSpecs.flatMap((item) => {
  if (item.isPair) return [];
  if (item.values.length > 0) return item.values.map((text, lineIndex) => ({ id: item.id, text, lineIndex, sourceIndex: item.sourceIndex, field: 'value', contextField: 'label' }));
  return item.label && !item.isGenericLabel ? [{ id: item.id, text: item.label, lineIndex: 0, sourceIndex: item.sourceIndex, field: 'label', contextField: 'value' }] : [];
});
const hasSpecifications = pairedSpecs.length > 0 || textualSpecs.length > 0;
const productLead = publicCatalogCopy(product.leadText) || publicCatalogCopy(product.shortDescription);
const description = publicCatalogCopy(product.description);
const descriptionParagraphs = description.split(/\n{2,}/).map((item) => item.trim()).filter(Boolean);
const rawCaption = publicCatalogCopy(product.placeholderLabel);
const isDefaultPhotoNotice = /фото\s+изделия\s+будут\s+добавлены\s+позже/i.test(rawCaption);
const galleryCaption = images.length > 0 && isDefaultPhotoNotice ? '' : rawCaption;
const deliveryText = publicCatalogCopy(product.deliveryText);
const deliveryParagraphs = deliveryText.split(/\n{2,}/).map((item) => item.trim()).filter(Boolean);
const hasTechnicalPanels = hasSpecifications || materials.length > 0 || colors.length > 0 || customizationItems.length > 0;
const finalContactTitle = product.showCustomProjectBlock !== false
  ? publicCatalogCopy(product.customProjectTitle) || settings.productUi.standardDefaultCustomTitle
  : settings.productUi.standardDefaultRegularTitle;
const customProjectText = publicCatalogCopy(product.customProjectText);
const finalContactDescription = product.showCustomProjectBlock !== false && customProjectText
  ? customProjectText
  : settings.productUi.standardDefaultDescription;
const relatedAreFromCategory = relatedProducts.every((item) => item.category.slug === category.slug);
const relatedHref = links.categoryHrefs[category.slug] || catalogV2CategoryHref(section.slug, category.slug);
const affectedRoutes = [route.href, relatedHref];
const binding = (fieldPath: string, tool = 'long-text', options: Record<string, unknown> = {}) => adminBinding(Astro.url, {
  renderer: { family: 'product-detail', variant: 'standard' }, owner: { collection: 'products', slug: product.slug },
  fieldPath, stableItemId: product.slug, scope: 'local', tool, affectedRoutes, ...options
});
const productUiBinding = (fieldPath: string, tool = 'short-text', occurrence = 'content', options: Record<string, unknown> = {}) => adminBinding(Astro.url, {
  renderer: { family: 'global-shell', variant: 'standard-product-ui' }, owner: { collection: 'site-settings', slug: 'global' },
  fieldPath: `productUi.${fieldPath}`, stableItemId: `standard-product-${fieldPath}-${occurrence}`, scope: 'global', tool, affectedRoutes: ['*'], ...options
});
const catalogUiBinding = (fieldPath: string, occurrence: string) => adminBinding(Astro.url, {
  renderer: { family: 'product-detail', variant: 'standard-breadcrumb' },
  owner: { collection: 'site-settings', slug: 'global' }, fieldPath: `catalogUi.${fieldPath}`,
  stableItemId: `${product.slug}-${occurrence}`, scope: 'global', tool: 'short-text', affectedRoutes: ['*']
});
const referenceBinding = (
  collection: string,
  slug: string,
  fieldPath: string,
  occurrence: string,
  routes: string[] = affectedRoutes
) => adminBinding(Astro.url, {
  renderer: { family: 'product-detail', variant: 'standard-reference' }, owner: { collection, slug }, fieldPath,
  stableItemId: `${product.slug}-${occurrence}`, scope: 'shared', tool: 'short-text', affectedRoutes: routes
});
const relatedTitleField = relatedAreFromCategory ? 'standardRelatedCategoryTitle' : 'standardRelatedSectionTitle';
const relatedTitle = settings.productUi[relatedTitleField];
const relatedProductHref = (item: CatalogProductRoute) => links.productHrefs[item.product.slug]
  || catalogV2ProductHref(item.section.slug, item.category.slug, item.product.slug);
const displayRelatedProducts = relatedProducts.map((item) => ({
  ...item,
  product: {
    ...item.product,
    leadText: publicCatalogCopy(item.product.leadText),
    shortDescription: publicCatalogCopy(item.product.shortDescription)
  }
}));
const relatedProductsBinding = binding('relatedProductSlugs', 'relation-list', {
  itemKind: 'string',
  relationCollections: ['products'],
  label: 'Связанные товары и их порядок',
  permissions: { edit: true, reorder: true, delete: false },
  projection: { kind: product.relatedProductSlugs?.length ? 'relation' : 'fallback', fallback: 'category order' }
});
const relatedProductsEditorMetadata = editorCanvas ? {
  'data-smu1-product-relations-variant': 'standard',
  'data-smu1-product-relations-eyebrow': settings.productUi.standardRelatedEyebrow,
  'data-smu1-product-relations-title': relatedTitle,
  'data-smu1-product-relations-category-title': settings.productUi.standardRelatedCategoryTitle,
  'data-smu1-product-relations-section-title': settings.productUi.standardRelatedSectionTitle,
  'data-smu1-product-relations-link-label': settings.productUi.standardRelatedLinkLabel,
  'data-smu1-product-relations-link-href': withBase(relatedHref),
  'data-smu1-product-card-premium-label': settings.productUi.cardPremiumLabel,
  'data-smu1-product-card-materials-missing-label': settings.productUi.cardMaterialsMissingLabel,
  'data-smu1-product-card-cta-label': settings.productUi.cardCtaLabel
} : {};
const isFenceProduct = section.slug === 'ograzhdeniya-i-zabory';
const rootClass = [
  'catalog-product',
  'catalog-product--standard',
  isFenceProduct ? 'catalog-v2--standard-fence' : '',
  images.length === 0 ? 'catalog-v2--standard-no-media' : ''
].filter(Boolean).join(' ');
const productBreadcrumbs = [
  { title: settings.catalogUi.shared.homeBreadcrumbLabel, href: '/design-lab/home-v2/', editor: catalogUiBinding('shared.homeBreadcrumbLabel', 'breadcrumb-home') },
  { title: section.title, href: links.sectionHref, editor: referenceBinding('product-sections', section.slug, 'title', 'breadcrumb-section', [route.href, links.sectionHref, relatedHref]) },
  { title: category.title, href: relatedHref, editor: referenceBinding('product-categories', category.slug, 'title', 'breadcrumb-category') },
  { title: product.title, editor: binding('title', 'heading', { stableItemId: `${product.slug}-breadcrumb-product`, role: 'breadcrumb-product' }) }
];
const sectionNavItems = [
  { id: 'product-overview', label: settings.productUi.standardNavOverviewLabel, editor: productUiBinding('standardNavOverviewLabel', 'short-text', 'nav-overview') },
  ...(descriptionParagraphs.length > 0 ? [{ id: 'product-description', label: settings.productUi.standardNavDescriptionLabel, editor: productUiBinding('standardNavDescriptionLabel', 'short-text', 'nav-description') }] : []),
  ...(hasTechnicalPanels ? [{ id: 'product-specifications', label: settings.productUi.standardNavSpecificationsLabel, editor: productUiBinding('standardNavSpecificationsLabel', 'short-text', 'nav-specifications') }] : []),
  ...(product.showDeliveryBlock !== false && deliveryParagraphs.length > 0
    ? [{ id: 'product-delivery', label: settings.productUi.standardNavDeliveryLabel, editor: productUiBinding('standardNavDeliveryLabel', 'short-text', 'nav-delivery') }]
    : []),
  ...(relatedProducts.length > 0 || editorCanvas ? [{
    id: 'related-products',
    label: settings.productUi.standardNavRelatedLabel,
    editor: {
      ...productUiBinding('standardNavRelatedLabel', 'short-text', 'nav-related'),
      ...(editorCanvas && relatedProducts.length === 0
        ? { 'data-smu1-editor-affordance': 'empty-related-products-nav' }
        : {})
    }
  }] : []),
  { id: 'contact', label: settings.productUi.standardNavContactLabel, editor: productUiBinding('standardNavContactLabel', 'short-text', 'nav-contact') }
];
const headerCtaBinding = productUiBinding('standardHeroPrimaryLabel', 'link-label', 'header-desktop');
const headerMobileCtaBinding = productUiBinding('standardHeroPrimaryLabel', 'link-label', 'header-mobile');
const mobileCtaBinding = productUiBinding('standardHeroPrimaryLabel', 'link-label', 'footer-mobile');
---

<CatalogV2Layout
  title={product.seoTitle}
  description={publicCatalogCopy(product.seoDescription) || productLead || product.title}
  canonicalPath={route.href}
  currentPath={currentPath}
  ogImage={images[0] || product.image}
  pageKind="product"
  rootClass={rootClass}
  headerCtaLabel={settings.productUi.standardHeroPrimaryLabel}
  mobileCtaLabel={settings.productUi.standardHeroPrimaryLabel}
  headerCtaBinding={headerCtaBinding}
  headerMobileCtaBinding={headerMobileCtaBinding}
  mobileCtaBinding={mobileCtaBinding}
  productFinalPrototype="standard-product"
>
  <div class="v2-standard-product-page" data-product-presentation="standard">
  <V2HeroHandoff enabled>
  <section
    class:list={[
      'v2-product-top',
      {
        'v2-product-top--no-media': images.length === 0,
        'v2-product-top--single-media': images.length === 1,
        'v2-product-top--editor-missing-media': images.length === 0 && editorCanvas
      }
    ]}
    id="product-overview"
    data-product-media-count={images.length}
    data-product-final-hero
    aria-labelledby="v2-product-title"
  >
    <div class="hv2-shell hv2-grid v2-product-top__grid" data-product-final-track>
      <article class="v2-product-summary" data-v2-page-handoff="copy">
        <div class="v2-product-summary__breadcrumbs" data-v2-entrance-role="context">
          <V2Breadcrumbs items={productBreadcrumbs} />
        </div>
        <p class="hv2-eyebrow" data-v2-reveal="entry-meta" data-v2-entrance-role="context" {...referenceBinding('product-categories', category.slug, 'title', 'hero-category-eyebrow')}>{category.title}</p>
        <h1 id="v2-product-title" data-v2-reveal="entry-title" data-v2-entrance-role="title-primary" {...binding('title', 'heading')}>{product.title}</h1>
        {productLead && <p class="v2-product-summary__lead" data-v2-reveal="entry-copy" data-v2-entrance-role="lead" {...binding('leadText', 'long-text', { projection: { kind: 'fallback', fallback: 'shortDescription' } })}>{productLead}</p>}

        <dl class="v2-product-summary__meta" data-v2-reveal="entry-price" data-v2-entrance-role="actions-meta">
          <div>
            <dt {...productUiBinding('standardPriceLabel', 'short-text', 'hero-price-label')}>{settings.productUi.standardPriceLabel}</dt>
            <dd {...binding('priceMode', 'price', { modePath: 'priceMode', valuePath: 'priceFrom', currencyPath: 'currency' })}>{formatProductPrice(product)}</dd>
          </div>
        </dl>

        {features.length > 0 && (
          <ul class="v2-product-summary__features" data-v2-reveal="entry-features" data-v2-entrance-role="support" {...binding('features', 'list', { itemKind: 'string' })}>
            {features.map((feature) => <li>{feature}</li>)}
          </ul>
        )}

        <div class="hv2-actions v2-product-summary__actions" data-v2-reveal="entry-actions" data-v2-entrance-role="actions-meta">
          <a class="hv2-button hv2-button--primary" href="#contact" {...productUiBinding('standardHeroPrimaryLabel', 'link-label')}>{settings.productUi.standardHeroPrimaryLabel}</a>
          <a class="hv2-text-link" href={settings.telegram} target="_blank" rel="noopener noreferrer" {...productUiBinding('standardHeroSecondaryLabel', 'link-label')}>
            {settings.productUi.standardHeroSecondaryLabel}
          </a>
        </div>
      </article>

      {(images.length > 0 || editorCanvas) && (
        <div
          class:list={[
            'v2-product-top__gallery',
            { 'v2-product-top__gallery--editor-affordance': images.length === 0 }
          ]}
          data-v2-reveal="entry-media"
          data-v2-entrance-role="media"
          data-smu1-editor-affordance={images.length === 0 ? 'missing-product-media' : undefined}
          {...(images.length === 0 ? binding('gallery', 'gallery', { role: 'missing-product-media', multiple: true, coverPath: 'image' }) : {})}
        >
          {images.length > 0 ? <V2ProductGallery
            images={images}
            imageMetadata={product.gallery}
            title={product.title}
            imageView={product.imageView}
            caption={galleryCaption}
            pageCritical
            mediaSizes="(max-width: 760px) calc(100vw - 32px), (max-width: 1100px) calc(100vw - 32px), 44vw"
            bindingOwner={{ collection: 'products', slug: product.slug }}
            bindingField="gallery"
            affectedRoutes={affectedRoutes}
          /> : <button class="v2-media-empty v2-media-empty--editor-affordance" type="button" data-smu1-editor-affordance="missing-product-media"><span>Добавить фотографии</span></button>}
        </div>
      )}
    </div>
  </section>
  </V2HeroHandoff>

  <V2SectionNav
    items={sectionNavItems}
    label={settings.productUi.standardSectionNavLabel}
    editor={productUiBinding('standardSectionNavLabel', 'short-text', 'section-nav-label', { projection: { kind: 'direct', target: 'attribute:aria-label' } })}
  />

  <section class="v2-product-details" aria-label="Описание и характеристики товара">
    <div class="hv2-shell">
      {descriptionParagraphs.length > 0 && (
        <article class="v2-product-description hv2-grid" id="product-description" data-v2-reveal>
          <header>
            <p class="hv2-eyebrow" {...productUiBinding('standardDescriptionEyebrow')}>{settings.productUi.standardDescriptionEyebrow}</p>
            <h2 {...productUiBinding('standardDescriptionTitle', 'heading')}>{settings.productUi.standardDescriptionTitle}</h2>
          </header>
          <div class="v2-product-description__text" {...binding('description', 'long-text', { projection: { kind: 'direct', target: 'paragraphs' } })}>
            {descriptionParagraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </article>
      )}

      {hasTechnicalPanels && <div class="v2-technical-grid" id="product-specifications" data-v2-scroll-section>
        {hasSpecifications && <section class="v2-technical-panel v2-technical-panel--specs" aria-labelledby="v2-specs-title" data-v2-reveal data-v2-scroll-role="card">
          <header>
            <p class="hv2-eyebrow" {...productUiBinding('standardSpecificationsEyebrow')}>{settings.productUi.standardSpecificationsEyebrow}</p>
            <h2 id="v2-specs-title" {...productUiBinding('standardSpecificationsTitle', 'heading')}>{settings.productUi.standardSpecificationsTitle}</h2>
          </header>
          <div class="v2-spec-content" {...binding('dimensions', 'list', {
            itemKind: 'object',
            permissions: { edit: true, reorder: true, delete: false },
            projection: { kind: 'list', target: 'product-specifications' },
            itemFields: [
              { fieldPath: 'id', tool: 'generated-id' },
              { fieldPath: 'label', label: 'Характеристика', tool: 'short-text' },
              { fieldPath: 'value', label: 'Значение', tool: 'long-text' },
              { fieldPath: 'order', tool: 'generated-order' },
              { fieldPath: 'isActive', label: 'Показывать характеристику', tool: 'visibility' }
            ]
          })}>
            {pairedSpecs.length > 0 && (
              <dl class="v2-spec-definitions">
                {pairedSpecs.map((item) => (
                  <div {...adminListItem(Astro.url, item.id)}>
                    <dt {...adminListField(Astro.url, 'label')}>{item.label}</dt>
                    <dd {...adminListField(Astro.url, 'value')} data-smu1-list-transform={editorCanvas ? 'lines' : undefined}>{item.values.map((value) => <span>{value}</span>)}</dd>
                  </div>
                ))}
              </dl>
            )}
            {textualSpecs.length === 1 ? (
              <p
                class="v2-spec-copy"
                {...adminListItem(Astro.url, textualSpecs[0].id)}
                {...adminListField(Astro.url, textualSpecs[0].field)}
                data-smu1-list-transform={editorCanvas ? 'line' : undefined}
                data-smu1-list-line={editorCanvas ? String(textualSpecs[0].lineIndex) : undefined}
                data-smu1-list-context-field={editorCanvas ? textualSpecs[0].contextField : undefined}
              >{textualSpecs[0].text}</p>
            ) : textualSpecs.length > 1 ? (
              <ul class="v2-spec-points">
                {textualSpecs.map((item) => <li
                  {...adminListItem(Astro.url, item.id)}
                  {...adminListField(Astro.url, item.field)}
                  data-smu1-list-transform={editorCanvas ? 'line' : undefined}
                  data-smu1-list-line={editorCanvas ? String(item.lineIndex) : undefined}
                  data-smu1-list-context-field={editorCanvas ? item.contextField : undefined}
                >{item.text}</li>)}
              </ul>
            ) : null}
          </div>
        </section>}

        {materials.length > 0 && <section class="v2-technical-panel" aria-labelledby="v2-materials-title" data-v2-reveal data-v2-scroll-role="card">
          <header><p class="hv2-eyebrow" {...productUiBinding('standardMaterialsEyebrow')}>{settings.productUi.standardMaterialsEyebrow}</p><h2 id="v2-materials-title" {...productUiBinding('standardMaterialsTitle', 'heading')}>{settings.productUi.standardMaterialsTitle}</h2></header>
          <ul class="v2-data-list" {...binding('materials', 'list', { itemKind: 'string' })}>{materials.map((item) => <li>{item}</li>)}</ul>
        </section>}

        {colors.length > 0 && <section class="v2-technical-panel" aria-labelledby="v2-colors-title" data-v2-reveal data-v2-scroll-role="card">
          <header><p class="hv2-eyebrow" {...productUiBinding('standardColorsEyebrow')}>{settings.productUi.standardColorsEyebrow}</p><h2 id="v2-colors-title" {...productUiBinding('standardColorsTitle', 'heading')}>{settings.productUi.standardColorsTitle}</h2></header>
          <ul class="v2-data-list" {...binding('colors', 'list', { itemKind: 'string' })}>{colors.map((item) => <li>{item}</li>)}</ul>
        </section>}

        {customizationItems.length > 0 && <section class="v2-technical-panel v2-technical-panel--custom" aria-labelledby="v2-customization-title" data-v2-reveal data-v2-scroll-role="card">
          <header><p class="hv2-eyebrow" {...productUiBinding('standardCustomizationEyebrow')}>{settings.productUi.standardCustomizationEyebrow}</p><h2 id="v2-customization-title" {...productUiBinding('standardCustomizationTitle', 'heading')}>{settings.productUi.standardCustomizationTitle}</h2></header>
          <ul class="v2-customization-list" {...binding('customizationItems', 'list', { itemKind: 'string' })}>
            {customizationItems.map((item) => <li><p>{item}</p></li>)}
          </ul>
        </section>}
      </div>}

      {product.showDeliveryBlock !== false && deliveryParagraphs.length > 0 && (
        <section class="v2-delivery-block hv2-grid" id="product-delivery" aria-labelledby="v2-delivery-title" data-v2-reveal>
          <header>
            <p class="hv2-eyebrow" {...productUiBinding('standardDeliveryEyebrow')}>{settings.productUi.standardDeliveryEyebrow}</p>
            <h2 id="v2-delivery-title" {...productUiBinding('standardDeliveryTitle', 'heading')}>{settings.productUi.standardDeliveryTitle}</h2>
          </header>
          <div {...binding('deliveryText', 'long-text')}>
            {deliveryParagraphs.map((paragraph) => <p>{paragraph}</p>)}
            <a class="hv2-text-link" href="#contact" {...productUiBinding('standardDeliveryLinkLabel', 'link-label')}>{settings.productUi.standardDeliveryLinkLabel}</a>
          </div>
        </section>
      )}

      {editorCanvas && relatedProducts.length === 0 && (
        <button
          class="v2-editor-fixed-affordance"
          type="button"
          data-smu1-editor-affordance="empty-related-products"
          aria-label="Добавить связанные товары"
          {...relatedProductsBinding}
          {...relatedProductsEditorMetadata}
        >Добавить связанные товары</button>
      )}

      {editorCanvas && (
        <template data-smu1-product-relations-template="standard">
          <span data-smu1-related-title-binding="category" {...productUiBinding('standardRelatedCategoryTitle', 'heading', 'related-title-category')}></span>
          <span data-smu1-related-title-binding="section" {...productUiBinding('standardRelatedSectionTitle', 'heading', 'related-title-section')}></span>
          <section class="v2-related-products" id="related-products" aria-labelledby="v2-related-title">
            <header class="v2-section-heading" data-v2-reveal>
              <div><p class="hv2-eyebrow" {...productUiBinding('standardRelatedEyebrow')}>{settings.productUi.standardRelatedEyebrow}</p><h2 id="v2-related-title" {...productUiBinding(relatedTitleField, 'heading', 'related-title')}>{relatedTitle}</h2></div>
              <a class="hv2-text-link" href={withBase(relatedHref)} {...productUiBinding('standardRelatedLinkLabel', 'link-label')}>{settings.productUi.standardRelatedLinkLabel}</a>
            </header>
            <div class="v2-product-grid v2-product-grid--related" role="list" {...relatedProductsBinding} {...relatedProductsEditorMetadata}>
              <div role="listitem" data-smu1-card-template-presentation="standard"><V2ProductCard product={standardTemplateProduct} href={currentPath} related /></div>
              <div role="listitem" data-smu1-card-template-presentation="premium"><V2ProductCard product={premiumTemplateProduct} href={currentPath} related /></div>
            </div>
          </section>
        </template>
      )}

      {relatedProducts.length > 0 && (
        <section class="v2-related-products" id="related-products" aria-labelledby="v2-related-title">
          <header class="v2-section-heading" data-v2-reveal>
            <div><p class="hv2-eyebrow" {...productUiBinding('standardRelatedEyebrow')}>{settings.productUi.standardRelatedEyebrow}</p><h2 id="v2-related-title" {...productUiBinding(relatedTitleField, 'heading', 'related-title')}>{relatedTitle}</h2></div>
            <a class="hv2-text-link" href={withBase(relatedHref)} {...productUiBinding('standardRelatedLinkLabel', 'link-label')}>{settings.productUi.standardRelatedLinkLabel}</a>
          </header>
          <div class="v2-product-grid v2-product-grid--related" role="list" {...relatedProductsBinding} {...relatedProductsEditorMetadata}>
            {displayRelatedProducts.map((item) => (
              <div role="listitem"><V2ProductCard product={item.product} href={relatedProductHref(item)} related /></div>
            ))}
          </div>
        </section>
      )}
    </div>
  </section>

  <V2DirectContact
    eyebrow={settings.productUi.standardContactEyebrow}
    title={finalContactTitle}
    description={finalContactDescription}
    primaryLabel={settings.productUi.standardContactPrimaryLabel}
    secondaryLabel={settings.productUi.standardContactSecondaryLabel}
    variant="product"
    eyebrowBinding={productUiBinding('standardContactEyebrow', 'short-text')}
    titleBinding={binding('customProjectTitle', 'heading', { projection: { kind: 'fallback', fallback: product.showCustomProjectBlock !== false ? 'site-settings.productUi.standardDefaultCustomTitle' : 'site-settings.productUi.standardDefaultRegularTitle' } })}
    descriptionBinding={binding('customProjectText', 'long-text', { projection: { kind: 'fallback', fallback: 'site-settings.productUi.standardDefaultDescription' } })}
    primaryLabelBinding={productUiBinding('standardContactPrimaryLabel', 'link-label')}
    secondaryLabelBinding={productUiBinding('standardContactSecondaryLabel', 'link-label')}
  />
  </div>
</CatalogV2Layout>
