---
import { getCollection } from 'astro:content';
import { v2Href } from '../../utils/v2Routes';
import { adminBinding, adminDisposition } from '../../admin/bindings/adminBinding';

interface Props { tools: string[]; compact?: boolean }
const { tools, compact = false } = Astro.props;
const available = await getCollection('tools');
const items = tools.flatMap((id) => available.filter((entry) => entry.data.id === id));
const binding = (id: string, fieldPath: string) => adminBinding(Astro.url, {
  renderer: { family: 'tool', variant: 'context-link' }, owner: { collection: 'tools', slug: id },
  fieldPath, scope: 'global', tool: 'short-text', affectedRoutes: ['*']
});
---
{items.length > 0 && <aside class="v2-task-tools hv2-shell" aria-label="Инструменты для подготовки задачи">
  <p class="hv2-eyebrow" {...adminDisposition(Astro.url, {
    kind: 'template-fixed', reason: 'Подпись контекстных переходов к инструментам подготовки задачи.',
    source: 'src/components/v2/V2TaskTools.astro#label'
  })}>Подготовить исходные данные</p>
  <ul role="list">
    {items.map(({ data }) => <li>
      <a class="hv2-text-link" href={v2Href(`/instrumenty/${data.id}/`, Astro.url.pathname)} {...binding(data.id, 'title')}>{data.title}</a>
      {!compact && <p {...binding(data.id, 'description')}>{data.description}</p>}
    </li>)}
  </ul>
</aside>}
