# Не копируйте значения вручную: `npm run admin:setup` создаёт
# `.env.admin.local` с scrypt-хэшем пароля и случайным session secret.
ADMIN_USERNAME=owner
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
ADMIN_API_HOST=127.0.0.1
ADMIN_API_PORT=8787
ADMIN_UI_HOST=127.0.0.1
ADMIN_UI_PORT=4321
ADMIN_ALLOWED_ORIGINS=http://127.0.0.1:4321
# Optional: override admin frontend API base (default is http://127.0.0.1:8787/api/admin)
PUBLIC_ADMIN_API_BASE=
CONTENT_WRITE_MODE=local
# Production publish H6 не включает: main всегда защищён.
PRODUCTION_DEPLOY_ENABLED=false
SITE_URL=
