# Не копируйте значения вручную: `npm run admin:setup` создаёт
# `.env.admin.local` с scrypt-хэшем пароля и случайным session secret.
ADMIN_USERNAME=owner
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
ADMIN_API_HOST=127.0.0.1
ADMIN_API_PORT=8787
ADMIN_UI_HOST=127.0.0.1
ADMIN_UI_PORT=4321
ADMIN_ALLOWED_ORIGINS=http://127.0.0.1:4321
# Optional: override admin frontend API base (default is http://127.0.0.1:8787/api/admin)
PUBLIC_ADMIN_API_BASE=/api/admin
CONTENT_WRITE_MODE=local
ADMIN_EXPECTED_BRANCH=v4-product-final-candidate
ADMIN_GIT_REMOTE=origin
# Нужен для exact-SHA статуса GitHub Actions/Pages.
# Plaintext GITHUB_TOKEN/GITHUB_DEPLOY_TOKEN здесь запрещены: используйте
# системный Git Credential Manager (или SSH для обычного git push).
GITHUB_REPOSITORY=owner/repo
TEST_SITE_URL=https://owner.github.io
TEST_BASE_PATH=/repo
# Production publish H6 не включает: main всегда защищён.
PRODUCTION_DEPLOY_ENABLED=false
ADMIN_ALLOW_PRODUCTION_PUBLISH=false
SITE_URL=
